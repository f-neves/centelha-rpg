---
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/cinzel/900.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import '../styles/global.css';
import { url, NAV, FERRAMENTAS } from '../lib/site';
import Referencias from '../components/Referencias.astro';
import Marcadores from '../components/Marcadores.astro';
import NestaPagina from '../components/NestaPagina.astro';
import Busca from '../components/Busca.astro';

interface Props { title: string; descricao?: string; largura?: 'prose' | 'wide' | 'full'; }
const { title, descricao = 'Centelha — sistema de RPG de mesa em d6, do mortal ao semideus.', largura = 'prose' } = Astro.props;

const here = Astro.url.pathname.replace(/\/+$/, '');
const isActive = (slug: string) => here === url(slug).replace(/\/+$/, '');
const fullTitle = title === 'Início' ? 'Centelha' : `${title} — Centelha`;
const ogUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = Astro.site ? new URL(url('icon-512.png'), Astro.site).href : url('icon-512.png');

// Trilha de navegação. O que dá para saber no build sai daqui; as páginas da
// área de jogo (mesa, personagem) completam a trilha por JS com os nomes reais
// vindos do Supabase, via lib/crumbs.ts.
const baseNoSlash = url('').replace(/\/$/, '');
const partes = here.slice(baseNoSlash.length).split('/').filter(Boolean);
const crumbs: { label: string; href?: string }[] = [{ label: 'Início', href: url('') }];
// seção do menu lateral (não tem página própria, então entra como texto)
if (partes[0] === 'regras') crumbs.push({ label: 'Regras' });
else if (FERRAMENTAS.some((f) => f.slug === partes[0])) crumbs.push({ label: 'Ferramentas' });
if (partes[0] === 'caminhos' && partes[1]) crumbs.push({ label: 'As Proezas', href: url('caminhos') });
if (partes[0] === 'artes' && partes[1]) crumbs.push({ label: 'As Artes', href: url('artes/regras') });
if (partes.length) crumbs.push({ label: title });
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={descricao} />
  <link rel="icon" href={url('favicon.svg')} />
  <link rel="manifest" href={url('manifest.webmanifest')} />
  <link rel="apple-touch-icon" href={url('icon-192.png')} />
  <meta name="theme-color" content="#0B3B47" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Centelha" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="pt_BR" />
  <meta name="twitter:card" content="summary" />
  <script is:inline>
    // PWA desativado por ora: remove qualquer service worker antigo preso (que servia
    // JS desatualizado) e limpa os caches. Sem re-registrar (evita loop de recarga).
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then((rs) => rs.forEach((r) => r.unregister())).catch(() => {});
      if (window.caches) caches.keys().then((ks) => ks.forEach((k) => caches.delete(k))).catch(() => {});
    }
  </script>
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('tema');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'classico';
        document.documentElement.dataset.theme = t;
        if (localStorage.getItem('sidebar') === 'collapsed') document.documentElement.classList.add('sidebar-collapsed');
        // preferências de diagramação (/configuracoes) aplicadas ANTES da primeira pintura,
        // senão a página abre no padrão e "pula" para a config do leitor.
        // Espelha aplicarConfig() de lib/config-site.ts — mudar lá, mudar aqui.
        var c = JSON.parse(localStorage.getItem('centelha:config') || '{}') || {};
        var de = document.documentElement, st = de.style;
        if (c.largTexto) st.setProperty('--cfg-larg-texto', c.largTexto + 'rem');
        if (c.largTabela === 0) st.setProperty('--cfg-larg-tabela', 'var(--cfg-larg-texto, 36rem)');
        else if (c.largTabela) st.setProperty('--cfg-larg-tabela', c.largTabela + 'rem');
        if (c.largFicha === 0) st.setProperty('--cfg-larg-ficha', '200rem');
        else if (c.largFicha) st.setProperty('--cfg-larg-ficha', c.largFicha + 'rem');
        if (c.fonteCorpo) st.setProperty('--fs-corpo', (c.fonteCorpo / 16) + 'rem');
        if (c.entrelinha) st.setProperty('--cfg-entrelinha', String(c.entrelinha));
        if (c.colunas === 2) de.dataset.colunas = '2';
      } catch (e) { document.documentElement.dataset.theme = document.documentElement.dataset.theme || 'classico'; }
    })();
  </script>
</head>
<body>
  <a href="#conteudo" class="skip">Pular para o conteúdo</a>

  <div class="topbar" data-pagefind-ignore>
    <button class="btn drawer-toggle" aria-label="Abrir navegação" aria-expanded="false">☰ Menu</button>
    <a class="brand" href={url('')}>Centelha <span class="d6">D6</span></a>
    {/* A busca é a função mais usada de um livro de regras em mesa, e estava escondida
        dentro da gaveta. O .busca-abrir é ligado por querySelectorAll no Busca.astro,
        então este segundo botão abre o mesmo modal sem código novo. */}
    <button class="btn busca-abrir topbar-busca" aria-label="Buscar no livro">🔍</button>
  </div>

  <div class="shell">
    <div class="scrim" data-drawer-close></div>
    <button class="btn sidebar-expand" id="sidebar-expand" aria-label="Expandir menu" title="Expandir menu">» Menu</button>
    <aside class="sidebar" id="nav" data-pagefind-ignore>
      <button class="btn drawer-close" aria-label="Fechar navegação" data-drawer-close>✕</button>
      <button class="btn sidebar-collapse" id="sidebar-collapse" aria-label="Recolher menu" title="Recolher menu">«</button>
      <a class="brand" href={url('')}>Centelha <span class="d6">D6</span>
        <small>do mortal ao semideus</small></a>

      <div style="margin-top:1rem"><Busca /></div>

      <nav class="toc" aria-label="Capítulos">
        <div class="grp">Regras</div>
        {NAV.map((n) => (
          <>
            {/* dentro do capítulo quem marca a página atual é a sub-página, não o capítulo */}
            <a href={url(n.slug)} aria-current={isActive(n.slug) && partes[0] !== (n as any).secao ? 'page' : undefined}>
              {n.numeral && <span class="num">{n.numeral}</span>}
              <span>{n.titulo}</span>
            </a>
            {partes[0] === (n as any).secao && (n as any).sub?.map((s: any) => (
              <a class="subcap" href={url(s.slug)} aria-current={isActive(s.slug) ? 'page' : undefined}>
                <span class="num">·</span><span>{s.titulo}</span>
              </a>
            ))}
          </>
        ))}
        <div class="grp">Ferramentas</div>
        {FERRAMENTAS.map((f) => (
          <a href={url(f.slug)} aria-current={isActive(f.slug) ? 'page' : undefined}>
            <span class="num">◆</span><span>{f.titulo}</span>
          </a>
        ))}
        <div class="grp">Jogo</div>
        <a href={url('mesas')} aria-current={isActive('mesas') ? 'page' : undefined}>
          <span class="num">◆</span><span>Mesas / Fichas</span>
        </a>
        <a href={url('conta')} id="conta-link" hidden aria-current={isActive('conta') ? 'page' : undefined}>
          <span class="num">◆</span><span>Minha Conta</span>
        </a>
        <a href={url('admin')} id="admin-link" hidden aria-current={isActive('admin') ? 'page' : undefined}>
          <span class="num">◆</span><span>Admin</span>
        </a>
        <a href={url('entrar')} id="auth-link" aria-current={isActive('entrar') ? 'page' : undefined}>
          <span class="num">◆</span><span class="auth-label">Entrar</span>
        </a>
      </nav>

      {/* o tema mudou-se para /configuracoes, junto com as preferências de diagramação */}
      <nav class="toc" aria-label="Preferências" style="margin-top:1.4rem">
        <div class="grp">Preferências</div>
        <a href={url('configuracoes')} aria-current={isActive('configuracoes') ? 'page' : undefined}>
          <span class="num">⚙</span><span>Configurações</span>
        </a>
      </nav>
    </aside>

    <main class="content" id="conteudo" data-pagefind-body>
      {crumbs.length > 1 && (
        <nav class="crumbs" aria-label="Trilha de navegação" data-pagefind-ignore>
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span class="crumb-sep">›</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <article class={largura === 'full' ? '' : largura}>
        <slot />
      </article>
    </main>
  </div>

  <Referencias />
  <Marcadores />
  <NestaPagina />

  <script>
    // gaveta mobile
    const body = document.body;
    const open = () => { body.classList.add('drawer-open'); document.querySelector('.drawer-toggle')?.setAttribute('aria-expanded', 'true'); };
    const close = () => { body.classList.remove('drawer-open'); document.querySelector('.drawer-toggle')?.setAttribute('aria-expanded', 'false'); };
    document.querySelector('.drawer-toggle')?.addEventListener('click', open);
    document.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    // recolher/expandir menu (desktop)
    const setSidebar = (collapsed: boolean) => {
      document.documentElement.classList.toggle('sidebar-collapsed', collapsed);
      try { localStorage.setItem('sidebar', collapsed ? 'collapsed' : 'open'); } catch {}
    };
    document.getElementById('sidebar-collapse')?.addEventListener('click', () => setSidebar(true));
    document.getElementById('sidebar-expand')?.addEventListener('click', () => setSidebar(false));

    // (os botões de tema moraram aqui; hoje vivem em /configuracoes)

    // permalink "copiar link" em títulos e em blocos com id (data-permalink)
    const copy = (hash: string) => {
      const u = location.origin + location.pathname + '#' + hash;
      navigator.clipboard?.writeText(u);
    };
    document.querySelectorAll('main h2[id], main h3[id], main [data-permalink][id]').forEach((el) => {
      const a = document.createElement('a');
      a.className = 'anchor'; a.href = '#' + el.id; a.title = 'Copiar link'; a.setAttribute('aria-label', 'Copiar link para esta seção');
      a.textContent = '🔗';
      a.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', '#' + el.id); copy(el.id); a.textContent = '✓'; setTimeout(() => (a.textContent = '🔗'), 1200); });
      el.appendChild(a);
    });

    // realce ao chegar por permalink (#id) — pisca o alvo
    const flash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove('target-flash');
      void (el as HTMLElement).offsetWidth; // reinicia a animação
      el.classList.add('target-flash');
    };
    window.addEventListener('hashchange', flash);
    setTimeout(flash, 120);

    // sombra de rolagem nos contêineres que rolam na horizontal (tabelas largas, árvore):
    // sem ela, no celular não há nenhuma pista de que existe conteúdo à direita
    document.querySelectorAll<HTMLElement>('.table-wrap, .tab-wrap, .tabela-wrap, .arv-wrap').forEach((el) => {
      const upd = () => {
        const max = el.scrollWidth - el.clientWidth;
        el.classList.toggle('tem-rolagem', max > 2);
        el.style.setProperty('--sx', el.scrollLeft + 'px');
        el.style.setProperty('--s-esq', el.scrollLeft > 2 ? '1' : '0');
        el.style.setProperty('--s-dir', el.scrollLeft < max - 2 ? '1' : '0');
      };
      el.addEventListener('scroll', upd, { passive: true });
      new ResizeObserver(upd).observe(el);
      upd();
    });

    // estado de login no menu (carrega o cliente Supabase sob demanda p/ não pesar as páginas)
    (async () => {
      const link = document.getElementById('auth-link');
      const label = link?.querySelector('.auth-label');
      if (!link || !label) return;
      try {
        const { usuarioAtual, perfilNome, sair, supabaseConfigurado } = await import('../lib/auth');
        if (!supabaseConfigurado) return;
        const user = await usuarioAtual();
        if (!user) return;
        // preferências de diagramação salvas na conta: baixa e aplica (o cache local já
        // pintou a página; isto só corrige diferenças vindas de outro aparelho)
        import('../lib/config-site').then((m) => m.sincronizarDaConta()).catch(() => {});
        const nome = await perfilNome();
        label.textContent = 'Sair' + (nome ? ' · ' + nome : '');
        link.setAttribute('href', '#');
        link.addEventListener('click', async (e) => {
          e.preventDefault();
          await sair();
          location.href = import.meta.env.BASE_URL;
        });
        const contaLink = document.getElementById('conta-link');
        if (contaLink) contaLink.hidden = false;
        try {
          const { getSupabase } = await import('../lib/supabase');
          const { data: admin } = await getSupabase().rpc('eh_admin');
          const adminLink = document.getElementById('admin-link');
          if (admin && adminLink) adminLink.hidden = false;
        } catch {}
      } catch {}
    })();
  </script>
</body>
</html>
