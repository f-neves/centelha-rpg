---
// A calculadora da bolsa de um trabalho pontual (rodada 115; desde 02/10/2026 a recompensa é o preço
// de UM TRABALHO, e desde o item 5 vale para qualquer trabalho, como guia para o Mestre: o Valor sai
// do desafio, da Dificuldade, ou do maior dos dois). As listas vêm de src/data/recompensas.json e a
// conta de src/lib/recompensa.ts; nenhum número da regra mora aqui.
// TOLERÂNCIA: a tabela de desafio do 4 em diante vale até existir onde gastar o topo dela.
// LEVANTA QUANDO: a G73 decidir os preços do sobre-humano, e o autor confirmar ou trocar o topo da tabela.
import REC from '../data/recompensas.json';
const MAX = REC.desafios.at(-1)!.desafio;
const DIF_MAX = REC.pericia.at(-1)!.dif_ate;
const x = (n: number) => String(n).replace('.', ',');
---
<div class="recompensa panel">
  <p class="muted rc-aviso"><strong>Guia para o Mestre, e não regra de mundo.</strong> O Valor por pessoa sai do <strong>desafio do trabalho</strong> (o do pior confronto que o grupo precisa vencer), da <strong>Dificuldade</strong> dos testes decisivos, ou do maior dos dois. O desafio do trabalho é absoluto: é o da ameaça, medido contra o grupo de referência (4 personagens de Centelha igual ao desafio), e não muda conforme o grupo que aceita o trabalho. Um grupo veterano que pega uma matilha de worgs recebe o mesmo que um grupo novato receberia. Semanas é a duração prevista no contrato, combinada antes do trabalho. Terminar antes ou depois não muda a bolsa: quem contrata paga pelo resultado, e não pelo tempo gasto. A tabela de desafio vai do 0 ao {MAX}, em degraus inteiros e meios degraus entre eles, e é <strong>provisória do desafio {REC.provisorio_desde} em diante</strong>; a calculadora interpola as Dificuldades entre um degrau e outro.</p>
  <div class="rc-campos">
    <label>Caminho
      <select data-rc="caminho">
        <option value="confronto">Confronto (desafio)</option>
        <option value="pericia">Perícia (Dificuldade)</option>
        <option value="ambos">Os dois (vale o maior)</option>
      </select>
    </label>
    <label data-rc-so="confronto">Desafio do trabalho<input type="number" min="0" max={MAX} step="0.5" value="1" data-rc="desafio" /></label>
    <label data-rc-so="pericia">Dificuldade<input type="number" min="0" max={DIF_MAX} step="1" value="15" data-rc="dificuldade" /></label>
    <label>Tipo de trabalho
      <select data-rc="trabalho">{REC.trabalhos.map((t) => <option value={t.id}>{t.nome}</option>)}</select>
    </label>
    <label>Variação
      <select data-rc="tarefa"></select>
    </label>
    <label>Semanas de trabalho<input type="number" min="0" step="0.5" value="1" data-rc="semanas" /></label>
    <label>Dias de viagem (ida e volta)<input type="number" min="0" value="16" data-rc="viagemDias" /></label>
    <label>Risco
      <select data-rc="risco">{REC.riscos.map((r) => <option value={r.id}>{r.nome} (×{x(r.mult)})</option>)}</select>
    </label>
    <label>Pessoas (pagas no contrato)<input type="number" min="1" step="1" value={REC.pessoas_padrao} data-rc="pessoas" /></label>
    <label>Outro × (opcional)<input type="number" min="0" step="0.05" value="1" data-rc="outro" /></label>
    <label>Tom da campanha
      <select data-rc="tom">{REC.tons.map((t) => <option value={t.id} selected={t.id === 'padrao'}>{t.nome} (×{x(t.mult)})</option>)}</select>
    </label>
    <label>Quantos vão de fato<input type="number" min="1" value={REC.pessoas_padrao} data-rc="grupo" /></label>
  </div>
  <!-- TOLERÂNCIA: a conta por equivalentes (+1/2 por dobra) vale até a bancada medir o bando com a Regra de Horda.
       LEVANTA QUANDO: a B18 (fila da B14) medir o desafio por N e o autor confirmar ou trocar a regra. -->
  <details class="rc-estimar">
    <summary>Estimar o desafio de um confronto com várias criaturas (ajuda opcional, provisória)</summary>
    <p class="muted">A criatura no desafio da mais forte conta 1, cada desafio abaixo dela divide por {REC.divisor_por_desafio}, e o confronto sobe 1/2 desafio a cada vez que esses equivalentes dobram (os degraus da Magnitude da Regra de Horda). O <strong>+1/2 a cada dobra é provisório</strong>: a bancada mediu bandos que sobem mais rápido. É só uma estimativa do desafio: não multiplica nem divide a bolsa.</p>
    <div class="rc-encontro" data-rc="encontro">
      <div class="rc-linha"><label>Desafio<input type="number" min="0" max={MAX} step="1" value="0" data-rc-l="desafio" /></label><label>Quantidade<input type="number" min="0" step="1" value="1" data-rc-l="quantidade" /></label></div>
    </div>
    <p class="rc-botoes"><button type="button" data-rc="mais">+ outra criatura</button> <button type="button" data-rc="menos">− última</button></p>
    <p class="rc-estimativa"><span data-rc="estimativa"></span> <button type="button" data-rc="usar" hidden>usar como desafio do trabalho</button></p>
  </details>
  <div class="rc-saida">
    <p class="rc-bolsa"><span data-rc="bolsa"></span></p>
    <ol class="rc-recibo" data-rc="recibo"></ol>
  </div>
</div>

<!-- is:global: o recibo, a lista de variações e a estimativa são montados por JS -->
<style is:global>
  .recompensa .rc-campos, .recompensa .rc-encontro { display: flex; gap: .7rem; flex-wrap: wrap; }
  .recompensa .rc-campos label[hidden] { display: none; }
  .recompensa .rc-linha { display: flex; gap: .5rem; padding: .3rem .4rem; border: 1px solid var(--rule); border-radius: var(--r-sm); }
  .recompensa .rc-botoes { margin: .5rem 0 .4rem; }
  .recompensa .rc-aviso { margin-top: 0; }
  .recompensa .rc-estimar { margin-top: .9rem; }
  .recompensa .rc-estimar summary { cursor: pointer; font-family: 'Cinzel'; font-size: var(--fs-aux); color: var(--ink-soft); }
  .recompensa .rc-estimar p.muted { font-size: var(--fs-aux); }
  .recompensa .rc-estimativa { margin: 0; font-size: var(--fs-aux); }
  .recompensa label { display: flex; flex-direction: column; font-size: var(--fs-micro); color: var(--ink-soft); font-family: 'Cinzel'; gap: .2rem; }
  .recompensa input, .recompensa select { width: 11rem; padding: .35rem .4rem; border: 1px solid var(--panel-border); border-radius: var(--r-sm); background: var(--bg); color: var(--ink); font-size: var(--fs-aux); }
  .recompensa input[type='number'] { width: 7rem; }
  .rc-saida { margin-top: .9rem; padding-top: .8rem; border-top: 1px solid var(--rule); }
  .rc-bolsa { font-family: 'Cinzel'; font-size: var(--fs-h3); color: var(--accent-texto); margin: 0 0 .4rem; }
  .rc-recibo { margin: 0; padding-left: 1.3rem; }
  .rc-recibo li { margin: .15rem 0; }
</style>

<script>
  import REC from '../data/recompensas.json';
  import { calcularRecompensa, desafioDoEncontro, valorDoDesafio, type EntradaRecompensa } from '../lib/recompensa';
  const ptNum = (n: number, casas = 0) => n.toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas });
  const pc = (n: number) => `${ptNum(n)} pc`;
  const m = (x: number) => x.toLocaleString('pt-BR', { maximumFractionDigits: 2 });
  const des = (d: number) => d.toLocaleString('pt-BR', { maximumFractionDigits: 2 });
  const faixa = (l: { dif_de: number; dif_ate: number }) => (l.dif_de === l.dif_ate ? String(l.dif_de) : `${l.dif_de}-${l.dif_ate}`);
  document.querySelectorAll<HTMLElement>('.recompensa').forEach((root) => {
    const campo = (k: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-rc="${k}"]`)!;
    const n = (k: string) => { const v = parseFloat(campo(k).value.replace(',', '.')); return Number.isFinite(v) ? v : 0; };
    const lido = (k: string) => { const t = campo(k).value.trim(); return t === '' ? NaN : parseFloat(t.replace(',', '.')); };
    const bolsaEl = root.querySelector<HTMLElement>('[data-rc="bolsa"]')!;
    const recibo = root.querySelector<HTMLElement>('[data-rc="recibo"]')!;
    const encontro = root.querySelector<HTMLElement>('[data-rc="encontro"]')!;
    const estimativaEl = root.querySelector<HTMLElement>('[data-rc="estimativa"]')!;
    const usar = root.querySelector<HTMLButtonElement>('[data-rc="usar"]')!;
    const tarefaSel = campo('tarefa') as HTMLSelectElement;
    const maxDesafio = REC.desafios.at(-1)!.desafio;
    const temValor = (d: number) => { try { valorDoDesafio(d, REC as any); return true; } catch { return false; } };
    let estimado: number | null = null;

    // a variação depende do tipo de trabalho
    const variacoes = () => {
      const t = REC.trabalhos.find((w) => w.id === campo('trabalho').value)!;
      // abre na variação base (×1): Matar, na caça; a primeira, nos outros tipos
      const base = (t.tarefas.find((v) => v.mult === 1) ?? t.tarefas[0]).id;
      tarefaSel.innerHTML = t.tarefas.map((v) => `<option value="${v.id}"${v.id === base ? ' selected' : ''}>${v.nome} (×${m(v.mult)})</option>`).join('');
    };
    // o caminho mostra o campo do desafio, o da Dificuldade, ou os dois
    const caminho = () => {
      const c = campo('caminho').value;
      root.querySelectorAll<HTMLElement>('[data-rc-so]').forEach((el) => { el.hidden = c !== 'ambos' && el.dataset.rcSo !== c; });
    };

    // a ajuda de estimar: só diz um desafio; não mexe na bolsa
    const estimar = () => {
      estimado = null; usar.hidden = true;
      const lidas = [...encontro.querySelectorAll<HTMLElement>('.rc-linha')].map((l) => {
        const v = (k: string) => parseFloat(l.querySelector<HTMLInputElement>(`[data-rc-l="${k}"]`)!.value.replace(',', '.'));
        return { desafio: v('desafio'), quantidade: v('quantidade') };
      });
      const fora = lidas.find((l) => !Number.isInteger(l.desafio) || l.desafio < 0 || l.desafio > maxDesafio);
      if (fora) { estimativaEl.textContent = `Cada criatura vai de desafio 0 a ${maxDesafio}, em inteiros.`; return; }
      const criaturas = lidas.map((l) => ({ desafio: l.desafio, quantidade: Number.isFinite(l.quantidade) ? Math.max(0, Math.round(l.quantidade)) : 0 }));
      if (!criaturas.some((l) => l.quantidade > 0)) { estimativaEl.textContent = 'O confronto não tem criatura nenhuma.'; return; }
      const enc = desafioDoEncontro(criaturas, REC as any);
      const eq = enc.equivalentes.toLocaleString('pt-BR', { maximumFractionDigits: 4 });
      estimativaEl.textContent = `Equivalentes ${eq} · Magnitude ${enc.magnitude} · desafio estimado ${enc.maisForte} + ${enc.magnitude} ÷ 2 = ${des(enc.desafio)} (exato ${ptNum(enc.exato, 2)})${temValor(enc.desafio) ? '.' : `, acima do fim da tabela (${maxDesafio}).`}`;
      if (temValor(enc.desafio)) { estimado = enc.desafio; usar.hidden = false; }
    };

    const semBolsa = (txt: string) => { bolsaEl.textContent = `Sem bolsa: ${txt}`; recibo.innerHTML = ''; };
    const atualizar = () => {
      const c = campo('caminho').value;
      const desafio = c === 'pericia' ? null : lido('desafio');
      const dificuldade = c === 'confronto' ? null : lido('dificuldade');
      // fora de 0 a 9, meio degrau sem vizinho ou outra fração: recusa, sem extrapolar
      if (desafio != null && !temValor(desafio)) return semBolsa(`a tabela de desafio vai de 0 a ${maxDesafio}, em degraus inteiros e meios degraus entre eles, e o desafio ${Number.isFinite(desafio) ? des(desafio) : '(vazio)'} não tem valor.`);
      const e: EntradaRecompensa = {
        desafio, dificuldade,
        trabalho: campo('trabalho').value, tarefa: tarefaSel.value,
        semanas: Math.max(0, n('semanas')), viagemDias: Math.max(0, n('viagemDias')),
        risco: campo('risco').value, tom: campo('tom').value,
        outro: campo('outro').value.trim() === '' ? 1 : Math.max(0, n('outro')),
        pessoas: Math.max(1, Math.round(n('pessoas'))), grupo: Math.max(1, Math.round(n('grupo'))),
      };
      let r: ReturnType<typeof calcularRecompensa>;
      // Dificuldade vazia, negativa ou acima do fim da tabela de perícia: recusa, sem extrapolar
      try { r = calcularRecompensa(e, REC as any); } catch (err) { return semBolsa(`${(err as Error).message}.`); }
      const sobra = r.sobra > 0 ? ` (sobram ${pc(r.sobra)}, divida como quiser)` : '';
      bolsaEl.textContent = `Bolsa: ${pc(r.bolsa)} · Parte por pessoa (vão ${e.grupo}): ${pc(r.porPessoa)}${sobra}`;
      const p = r.pericia;
      const linhaConfronto = r.valorConfronto != null ? `Confronto: desafio ${des(r.desafio!)}${r.desafio! % 1 ? ' (meio degrau)' : ''}, ${pc(r.valorConfronto)}` : null;
      const comoPericia = !p ? '' : p.como === 'degrau' ? `degrau ${faixa(p.de)}${p.desafio != null ? ` (desafio ${des(p.desafio)})` : ''}`
        : p.como === 'piso' ? 'abaixo do primeiro degrau, o piso'
        : `entre os degraus ${faixa(p.de)} (${pc(p.de.preco.pc)}) e ${faixa(p.ate)} (${pc(p.ate.preco.pc)}), interpolada e arredondada`;
      const linhaPericia = p ? `Perícia: Dificuldade ${des(r.dificuldade!)}, ${comoPericia}, ${pc(p.pc)}` : null;
      const itens = [
        ...([linhaConfronto, linhaPericia].filter(Boolean) as string[]),
        `Valor por pessoa, por semana: ${pc(r.valor)}${linhaConfronto && linhaPericia ? `, o maior dos dois (${r.caminho === 'pericia' ? 'a perícia' : 'o confronto'})` : ''}`,
        `Semanas = trabalho ${ptNum(Math.max(1, e.semanas), 1)} + metade da viagem (${ptNum(e.viagemDias)} dias ÷ 2 ÷ ${REC.dias_semana}) = ${ptNum(r.semanas, 1)}`,
        `Tom: ${r.tom.nome} ×${m(r.tom.mult)} · Tarefa: ${r.trabalho.nome}, ${r.tarefa.nome} ×${m(r.tarefa.mult)} · Risco: ${r.risco.nome} ×${m(r.risco.mult)} · Outro ×${m(r.outro)}`,
        `Bolsa = ${pc(r.valor)} × ${m(r.tom.mult)} × ${ptNum(r.semanas, 1)} × ${m(r.tarefa.mult)} × ${m(r.risco.mult)} × ${m(r.outro)} × ${r.pessoas} pessoas = ${ptNum(r.exata, r.exata % 1 ? 1 : 0)} pc, arredondada: ${pc(r.bolsa)}`,
        `Parte por pessoa = ${pc(r.bolsa)} ÷ ${e.grupo}, para baixo = ${pc(r.porPessoa)}${sobra}. O grupo que vai com mais ou menos gente divide o mesmo valor.`,
        'A bolsa paga o trabalho cumprido. Cumprir parte do trabalho não paga parte, a não ser que o Mestre decida.',
        // TOLERÂNCIA: o recibo avisa o valor do topo da tabela, que vale até existir onde gastar.
        // LEVANTA QUANDO: a G73 decidir os preços do sobre-humano, e o autor confirmar ou trocar o topo da tabela.
        ...(r.provisorio ? [`O valor do desafio ${des(r.desafioUsado!)} é provisório: do desafio ${REC.provisorio_desde} em diante, a tabela depende de existir onde gastar.`] : []),
        ...(r.desafioUsado != null && r.desafioUsado >= 5 ? ['A partir do desafio 5, a bolsa é paga em terra, título, direito ou favor, no valor da tabela.']
          : r.desafioUsado != null && r.desafioUsado > 3 ? ['Acima do desafio 3, o Mestre pode pagar parte em favor, acesso ou objeto.'] : []),
      ];
      recibo.innerHTML = itens.map((t) => `<li>${t}</li>`).join('');
    };

    const ligar = (el: Element, f: () => void) => { el.addEventListener('input', f); el.addEventListener('change', f); };
    ligar(campo('trabalho'), variacoes);
    ligar(campo('caminho'), caminho);
    root.querySelectorAll('.rc-campos input, .rc-campos select').forEach((el) => ligar(el, atualizar));
    encontro.querySelectorAll('input').forEach((el) => ligar(el, estimar));
    root.querySelector('[data-rc="mais"]')!.addEventListener('click', () => {
      const nova = encontro.querySelector('.rc-linha')!.cloneNode(true) as HTMLElement;
      nova.querySelectorAll('input').forEach((el) => ligar(el, estimar));
      encontro.appendChild(nova); estimar();
    });
    root.querySelector('[data-rc="menos"]')!.addEventListener('click', () => {
      const ls = encontro.querySelectorAll('.rc-linha'); if (ls.length > 1) { ls[ls.length - 1].remove(); estimar(); }
    });
    usar.addEventListener('click', () => { if (estimado != null) { campo('desafio').value = String(estimado); atualizar(); } });
    variacoes(); caminho(); estimar();
    atualizar();
  });
</script>
