---
// Editor de criatura: um modal que abre com os dados da criatura preenchidos e
// recalcula os derivados ao vivo, pelas mesmas fórmulas dos personagens.
//
// Onde as edições ficam: no NAVEGADOR (localStorage), por criatura. A página é
// estática e não escreve no repositório, então o modal também entrega o JSON
// pronto para colar em `src/data/inimigos-custom.json`, que é o que faz a
// criatura entrar no livro de verdade.
//
// O que se edita são os campos de ORIGEM (atributos, Vontade, porte, armadura,
// fraquezas). PV, Defesa, Absorção e Iniciativa não se editam: são calculados,
// e é isso que impede o bloco de sair fora da régua.
import { VOCAB_ELEM, PORTE_LBL } from '../lib/bestia-editor';

const ATRIB: [string, string][] = [
  ['forca', 'Força'], ['destreza', 'Destreza'], ['vigor', 'Vigor'],
  ['influencia', 'Influência'], ['perspicacia', 'Perspicácia'], ['compostura', 'Compostura'],
  ['percepcao', 'Percepção'], ['inteligencia', 'Inteligência'], ['raciocinio', 'Raciocínio'],
];
const PORTES = Object.keys(PORTE_LBL);
---

<div class="editbox" id="editbox" hidden role="dialog" aria-modal="true" aria-labelledby="ed-titulo">
  <div class="ed-card">
    <button class="ed-fechar" type="button" aria-label="Fechar">✕</button>
    <h3 id="ed-titulo" class="cinzel">Editar criatura</h3>

    <div class="ed-grid">
      <section class="ed-col">
        <h4>Identidade</h4>
        <label class="ed-f ed-wide">Nome <input type="text" data-ed="nome" /></label>
        <label class="ed-f ed-wide">Conceito <input type="text" data-ed="conceito" placeholder="músculo pesado" /></label>
        <label class="ed-f">Ameaça <input type="number" data-ed="ameaca" min="1" max="6" /></label>
        <label class="ed-f">Centelha <input type="number" data-ed="centelha" min="0" max="10" /></label>
        <label class="ed-f ed-wide">Porte
          <select data-ed="porte">{PORTES.map((p) => <option value={p}>{PORTE_LBL[p]}</option>)}</select>
        </label>

        <h4>Atributos</h4>
        <div class="ed-atr">
          {ATRIB.map(([k, lbl]) => (
            <label class="ed-f"><span>{lbl}</span><input type="number" data-ed={`atributos.${k}`} min="0" max="12" /></label>
          ))}
        </div>

        <h4>Traços</h4>
        <label class="ed-f">Vontade <input type="number" data-ed="vontade" min="0" max="12" /></label>
        <label class="ed-f">Integridade <input type="number" data-ed="integridade" min="0" max="12" /></label>
        <label class="ed-f" title="Única perícia aqui: ela entra na Iniciativa (1d6 + Raciocínio + Prontidão).">Prontidão <input type="number" data-ed="prontidao" min="0" max="12" /></label>
      </section>

      <section class="ed-col">
        <h4>Fraquezas e resistências</h4>
        <p class="ed-nota muted">Clique para alternar: nada → <b class="ed-fr">fraqueza</b> → <b class="ed-re">resistência</b>. A fraqueza passa por cima de toda absorção e é agravada; a resistência corta pela metade.</p>
        <div class="ed-elem">
          {VOCAB_ELEM.map((k) => (
            <button type="button" class="ed-el" data-el={k} data-estado="0">{k}</button>
          ))}
        </div>

        <h4>Notas</h4>
        <label class="ed-f ed-wide"><textarea data-ed="notas" rows="3" placeholder="Como usar em mesa, fraqueza tática, o que evitar…"></textarea></label>

        <h4>Derivados <span class="ed-sub muted">(calculados, não se editam)</span></h4>
        <dl class="ed-der" id="ed-der"></dl>
      </section>
    </div>

    <footer class="ed-foot">
      <button type="button" class="btn" id="ed-salvar">Salvar neste navegador</button>
      <button type="button" class="btn" id="ed-copiar">Copiar JSON</button>
      <button type="button" class="btn ed-reset" id="ed-reverter">Reverter ao original</button>
      <span class="ed-msg" id="ed-msg" role="status"></span>
    </footer>
  </div>
</div>

<style is:global>
  /* O modal é construído por JS e vive fora do escopo do componente. */
  .editbox { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; padding: 1rem; background: color-mix(in srgb, #000 62%, transparent); backdrop-filter: blur(2px); }
  .editbox[hidden] { display: none; }
  .ed-card { position: relative; width: min(60rem, 100%); max-height: 88vh; overflow: auto; background: var(--panel); border: 1px solid var(--rule); border-radius: var(--r-md); padding: 1.4rem 1.5rem 1.1rem; box-shadow: 0 18px 50px rgba(0,0,0,.5); }
  .ed-fechar { position: absolute; top: .6rem; right: .7rem; background: none; border: 0; color: var(--ink-soft); font-size: 1.1rem; cursor: pointer; }
  .ed-fechar:hover { color: var(--accent-strong); }
  .ed-card h3 { margin: 0 0 .9rem; }
  .ed-card h4 { font-family: 'Cinzel'; font-size: var(--fs-aux); color: var(--accent-strong); margin: 1rem 0 .45rem; padding-bottom: .2rem; border-bottom: 1px dotted var(--rule); }
  .ed-card h4:first-child { margin-top: 0; }
  .ed-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.6rem; }
  @media (max-width: 46rem) { .ed-grid { grid-template-columns: 1fr; } }
  .ed-f { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin: .25rem 0; font-size: var(--fs-aux); }
  .ed-f.ed-wide { display: block; }
  .ed-f.ed-wide input, .ed-f.ed-wide select, .ed-f.ed-wide textarea { width: 100%; margin-top: .18rem; }
  .ed-f input, .ed-f select, .ed-f textarea { background: var(--bg-soft); color: var(--ink); border: 1px solid var(--rule); border-radius: var(--r-sm); padding: .22rem .4rem; font: inherit; font-size: var(--fs-aux); }
  .ed-f input[type=number] { width: 4.2rem; text-align: center; font-variant-numeric: tabular-nums; }
  .ed-atr { display: grid; grid-template-columns: repeat(3, 1fr); gap: .1rem .6rem; }
  @media (max-width: 30rem) { .ed-atr { grid-template-columns: repeat(2, 1fr); } }
  .ed-nota { font-size: var(--fs-micro); margin: 0 0 .45rem; }
  .ed-fr { color: var(--dano, #d98a6a); }
  .ed-re { color: var(--accent-strong); }
  .ed-elem { display: flex; flex-wrap: wrap; gap: .3rem; }
  .ed-el { font-size: var(--fs-micro); padding: .12rem .5rem; border-radius: var(--r-sm); border: 1px solid var(--rule); background: transparent; color: var(--ink-soft); cursor: pointer; }
  .ed-el[data-estado="1"] { color: var(--dano, #d98a6a); border-color: color-mix(in srgb, var(--dano, #d98a6a) 55%, transparent); background: color-mix(in srgb, var(--dano, #d98a6a) 14%, transparent); }
  .ed-el[data-estado="2"] { color: var(--accent-strong); border-color: color-mix(in srgb, var(--accent) 45%, transparent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .ed-der { display: grid; grid-template-columns: repeat(auto-fit, minmax(5rem, 1fr)); gap: .3rem; margin: 0; }
  .ed-der div { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ed-der dt { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); text-transform: uppercase; }
  .ed-der dd { margin: 0; font-size: var(--fs-aux); font-weight: 600; font-variant-numeric: tabular-nums; }
  .ed-foot { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-top: 1.1rem; padding-top: .8rem; border-top: 1px solid var(--rule); }
  .ed-msg { font-size: var(--fs-micro); color: var(--accent-strong); }
  .ed-reset { margin-left: auto; }
  /* Marca a criatura que tem edição local guardada */
  .besta.editada .besta-nome::after { content: ' ✎'; color: var(--accent-strong); font-size: .8em; }
</style>

<script>
  import { VOCAB_ELEM, derivados, lerEdicoes, salvarEdicao, apagarEdicao, paraJson, porteSlug } from '../lib/bestia-editor';
  import type { CriaturaEdit } from '../lib/bestia-editor';

  const box = document.getElementById('editbox') as HTMLElement | null;
  if (box) {
    const q = <T extends Element>(s: string, r: ParentNode = box) => r.querySelector(s) as T | null;
    const msg = q<HTMLElement>('#ed-msg')!;
    const derBox = q<HTMLElement>('#ed-der')!;
    const titulo = q<HTMLElement>('#ed-titulo')!;
    let atual: CriaturaEdit | null = null;
    let original: CriaturaEdit | null = null;
    let cardAtual: HTMLElement | null = null;

    const campos = () => Array.from(box.querySelectorAll('[data-ed]')) as (HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)[];
    const num = (v: string) => (v === '' ? 0 : Number(v));

    /** Lê o formulário de volta para o objeto. */
    function coletar(): CriaturaEdit {
      const c: any = { ...(atual as any) };
      c.atributos = { ...(atual?.atributos || {}) };
      for (const el of campos()) {
        const chave = el.dataset.ed!;
        const bruto = (el as HTMLInputElement).value;
        const v = el.getAttribute('type') === 'number' ? num(bruto) : bruto;
        if (chave.startsWith('atributos.')) c.atributos[chave.slice(10)] = v;
        else c[chave] = v;
      }
      c.fraquezas = []; c.resistencias = [];
      for (const b of Array.from(box.querySelectorAll('.ed-el')) as HTMLElement[]) {
        const e = b.dataset.estado;
        if (e === '1') c.fraquezas.push(b.dataset.el!);
        else if (e === '2') c.resistencias.push(b.dataset.el!);
      }
      return c as CriaturaEdit;
    }

    /** Recalcula os derivados e desenha. */
    function recalcular() {
      atual = coletar();
      const d = derivados(atual);
      derBox.innerHTML = [
        ['PV', d.pv], ['Defesa', d.defesa], ['Def. Social', d.defesaSocial],
        ['Def. Mental', d.defesaMental], ['Absorção', d.absorcao], ['Iniciativa', d.iniciativa],
      ].map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
    }

    /** Preenche o formulário com uma criatura. */
    function preencher(c: CriaturaEdit) {
      atual = JSON.parse(JSON.stringify(c));
      for (const el of campos()) {
        const chave = el.dataset.ed!;
        let v = chave.startsWith('atributos.')
          ? (c.atributos || {})[chave.slice(10)]
          : (c as any)[chave];
        if (chave === 'porte') v = porteSlug(v as string);
        (el as HTMLInputElement).value = v == null ? '' : String(v);
      }
      for (const b of Array.from(box.querySelectorAll('.ed-el')) as HTMLElement[]) {
        const k = b.dataset.el!;
        b.dataset.estado = c.fraquezas?.includes(k) ? '1' : c.resistencias?.includes(k) ? '2' : '0';
      }
      recalcular();
    }

    function abrir(c: CriaturaEdit, card: HTMLElement | null, tit: string) {
      original = JSON.parse(JSON.stringify(c));
      cardAtual = card;
      titulo.textContent = tit;
      const guardada = lerEdicoes()[c.id];
      preencher(guardada ? ({ ...c, ...guardada } as CriaturaEdit) : c);
      msg.textContent = guardada ? 'Mostrando a sua versão salva neste navegador.' : '';
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      (q<HTMLInputElement>('[data-ed="nome"]'))?.focus();
    }
    function fechar() { box.hidden = true; document.body.style.overflow = ''; msg.textContent = ''; }

    // --- eventos do formulário ---
    box.addEventListener('input', (e) => { if ((e.target as HTMLElement).dataset?.ed) recalcular(); });
    box.addEventListener('click', (e) => {
      const alvo = e.target as HTMLElement;
      if (alvo.classList.contains('ed-el')) {
        alvo.dataset.estado = String((Number(alvo.dataset.estado || 0) + 1) % 3);
        recalcular();
      }
      if (alvo === box || alvo.classList.contains('ed-fechar')) fechar();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !box.hidden) fechar(); });

    q<HTMLElement>('#ed-salvar')!.addEventListener('click', () => {
      const c = coletar();
      salvarEdicao(c.id, c);
      if (cardAtual) {
        cardAtual.classList.add('editada');
        cardAtual.dataset.besta = JSON.stringify(c);
        // atualiza o que aparece no card sem recarregar a página
        const nome = cardAtual.querySelector('.besta-nome');
        if (nome && c.nome) nome.childNodes[0].textContent = c.nome;
        const d = derivados(c);
        const dds = cardAtual.querySelectorAll('.besta-stats dd');
        if (dds[0]) dds[0].textContent = String(d.pv);
        if (dds[1]) dds[1].textContent = String(d.defesa);
      }
      msg.textContent = 'Salvo neste navegador.';
    });

    q<HTMLElement>('#ed-copiar')!.addEventListener('click', async () => {
      const txt = paraJson(coletar());
      try { await navigator.clipboard.writeText(txt); msg.textContent = 'JSON copiado. Cole em src/data/inimigos-custom.json.'; }
      catch { msg.textContent = 'Não consegui copiar; o JSON está no console.'; console.log(txt); }
    });

    q<HTMLElement>('#ed-reverter')!.addEventListener('click', () => {
      if (!original) return;
      apagarEdicao(original.id);
      preencher(original);
      cardAtual?.classList.remove('editada');
      msg.textContent = 'Voltou ao original do livro.';
    });

    // --- botões da página ---
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.besta-editar') as HTMLElement | null;
      if (b) {
        const card = b.closest('.besta') as HTMLElement;
        abrir(JSON.parse(card.dataset.besta || '{}'), card, 'Editar criatura');
        return;
      }
      if ((e.target as HTMLElement).closest('#besta-nova')) {
        abrir({
          id: 'mon-nova-' + Date.now().toString(36),
          nome: '', conceito: '', ameaca: 1, centelha: 0, porte: 'medio',
          atributos: Object.fromEntries(['forca','destreza','vigor','influencia','perspicacia','compostura','percepcao','inteligencia','raciocinio'].map((k) => [k, 2])),
          vontade: 4, integridade: 2, prontidao: 1, fraquezas: [], resistencias: [], notas: '',
        } as CriaturaEdit, null, 'Nova criatura');
      }
    });

    // marca no carregamento quais criaturas têm edição local
    const guardadas = lerEdicoes();
    for (const id of Object.keys(guardadas)) document.getElementById(id)?.classList.add('editada');
    void VOCAB_ELEM;
  }
</script>
