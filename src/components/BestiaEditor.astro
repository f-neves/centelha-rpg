---
interface Props { opcoes?: unknown }
---
<div class="editbox" id="editbox" hidden role="dialog" aria-modal="true" aria-labelledby="ed-titulo">
  <section class="ed-janela panel">
    <header><h3 id="ed-titulo">Editar criatura</h3><button type="button" id="ed-fechar" class="btn">Fechar</button></header>
    <p>Edite a fonte da criatura. Os valores de jogo são recalculados enquanto você escreve.</p>
    <div class="ed-colunas">
      <label>Fonte JSON <textarea id="ed-fonte" spellcheck="false" aria-label="Fonte da criatura"></textarea></label>
      <section aria-label="Prévia"><h4>Valores calculados</h4><pre id="ed-der"></pre><p id="ed-status" role="status"></p></section>
    </div>
    <footer>
      <button type="button" class="btn" id="ed-formatar">Formatar</button>
      <button type="button" class="btn" id="ed-salvar">Salvar rascunho neste navegador</button>
      <button type="button" class="btn" id="ed-apagar">Apagar rascunho</button>
      <button type="button" class="btn" id="ed-copiar">Copiar JSON</button>
      <label class="btn">Importar JSON <input type="file" id="ed-arquivo" accept="application/json,.json" /></label>
    </footer>
    <details><summary>JSON para exportar</summary><textarea id="ed-json" readonly aria-label="JSON para exportar"></textarea></details>
  </section>
</div>
<style is:global>
  .editbox { position:fixed; inset:0; z-index:90; padding:1rem; background:#000b; display:grid; place-items:center; }
  .editbox[hidden] { display:none; }
  .ed-janela { width:min(76rem,100%); max-height:94vh; overflow:auto; padding:1.2rem; }
  .ed-janela header,.ed-janela footer { display:flex; gap:.6rem; align-items:center; flex-wrap:wrap; }
  .ed-janela header { justify-content:space-between; }
  .ed-colunas { display:grid; grid-template-columns:3fr 2fr; gap:1rem; }
  .ed-colunas label { display:grid; gap:.4rem; }
  #ed-fonte,#ed-json { width:100%; min-height:55vh; font-family:monospace; font-size:.9rem; line-height:1.45; }
  #ed-der { white-space:pre-wrap; overflow-wrap:anywhere; }
  #ed-arquivo { max-width:14rem; }
  .ed-janela footer { margin-block:1rem; }
  .besta-foot button.besta-editar,.filtros button.besta-nova { display:none !important; }
  body.pode-editar .besta-foot button.besta-editar,body.pode-editar .filtros button.besta-nova { display:inline-flex !important; }
  @media(max-width:700px) { .ed-colunas { grid-template-columns:1fr; } #ed-fonte { min-height:45vh; } }
</style>
<script>
  import { derivados, validarFonte, validarRascunho, faltasDoRascunho, paraJson, novaCriatura, lerEdicoes, salvarEdicao, apagarEdicao, type CriaturaEdit } from '../lib/bestia-editor';
  import { ehAdmin } from '../lib/auth';
  import { url } from '../lib/site';
  const box=document.getElementById('editbox')!;
  const fonte=document.getElementById('ed-fonte') as HTMLTextAreaElement;
  const saida=document.getElementById('ed-json') as HTMLTextAreaElement;
  const previa=document.getElementById('ed-der')!;
  const status=document.getElementById('ed-status')!;
  let atualId='';
  const ler=()=>validarFonte(JSON.parse(fonte.value));
  function recalcular() {
    try {
      const c=validarRascunho(JSON.parse(fonte.value)); previa.textContent=JSON.stringify(derivados(c),null,2);
      const faltas=faltasDoRascunho(c);
      if(faltas.length){ saida.value=''; status.textContent='Rascunho incompleto: faltam '+faltas.join(', ')+'. Preencha para salvar ou exportar.'; }
      else { saida.value=paraJson(c); status.textContent='Fonte válida.'; }
    }
    catch(e) { previa.textContent=''; saida.value=''; status.textContent=String((e as Error).message); }
  }
  function preencher(c:CriaturaEdit) {
    atualId=c.id; fonte.value=JSON.stringify(c,null,2); document.getElementById('ed-titulo')!.textContent='Editar '+c.nome;
    box.hidden=false; document.body.style.overflow='hidden'; recalcular(); fonte.focus();
  }
  const fechar=()=>{box.hidden=true;document.body.style.overflow='';};
  document.getElementById('ed-fechar')!.addEventListener('click',fechar);
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!box.hidden)fechar();});
  fonte.addEventListener('input',recalcular);
  document.getElementById('ed-formatar')!.addEventListener('click',()=>{try{fonte.value=paraJson(ler());recalcular();}catch(e){status.textContent=String(e);}});
  document.getElementById('ed-salvar')!.addEventListener('click',()=>{try{const c=ler();salvarEdicao(c.id,c);atualId=c.id;status.textContent='Rascunho salvo neste navegador.';}catch(e){status.textContent=String(e);}});
  document.getElementById('ed-apagar')!.addEventListener('click',()=>{apagarEdicao(atualId);status.textContent='Rascunho removido.';});
  document.getElementById('ed-copiar')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(paraJson(ler()));status.textContent='JSON copiado.';}catch(e){status.textContent=String(e);}});
  document.getElementById('ed-arquivo')!.addEventListener('change',async e=>{const f=(e.target as HTMLInputElement).files?.[0];if(f){try{preencher(validarFonte(JSON.parse(await f.text())));}catch(err){status.textContent=String(err);}}});
  document.addEventListener('click',async e=>{
    const alvo=e.target as HTMLElement;
    if(alvo.closest('#besta-nova')) { e.preventDefault(); preencher(novaCriatura()); return; }
    const botao=alvo.closest('.besta-editar'); if(!botao)return;
    e.preventDefault(); e.stopPropagation(); const id=botao.closest<HTMLElement>('.besta')?.id; if(!id)return;
    try {
      const salva=lerEdicoes()[id]; if(salva){preencher(validarFonte(salva));return;}
      const r=await fetch(url('dados/criatura/'+encodeURIComponent(id)+'.json')); if(!r.ok)throw Error('Não foi possível abrir a fonte.');
      const m=await r.json(); if(!m.edicao)throw Error('Esta criatura não tem fonte editável.');
      preencher(validarFonte({...m.edicao,revisao:[]}));
    } catch(err) { box.hidden=false; status.textContent=String(err); }
  },true);
  ehAdmin().then(ok=>{if(ok)document.body.classList.add('pode-editar');}).catch(()=>{});
</script>
