---
import { url } from '../lib/site';
const pfJs = url('pagefind/pagefind.js');
---
<button class="btn busca-abrir" aria-label="Buscar (tecle /)" style="width:100%;text-align:left">
  🔍 Buscar… <kbd class="busca-kbd">/</kbd>
</button>

<!-- A marcação é nossa e fala com o pagefind.js direto (sem o PagefindUI): o Aa precisa descartar
     resultado depois da busca, e o PagefindUI não deixa. Estilo em global.css. -->
<dialog class="busca-modal" aria-label="Busca" data-pf={pfJs}>
  <div class="busca-head">
    <strong class="cinzel">Busca</strong>
    <button class="btn busca-fechar" aria-label="Fechar">✕</button>
  </div>
  <div class="busca-opcoes">
    <fieldset class="busca-modos">
      <legend class="busca-sr">Modo de busca</legend>
      <label class="busca-chip"><input type="radio" name="busca-modo" value="palavras" checked><span>Palavras</span></label>
      <label class="busca-chip"><input type="radio" name="busca-modo" value="frase"><span>Frase exata</span></label>
    </fieldset>
    <label class="busca-chip busca-aa" title="Diferenciar maiúsculas de minúsculas">
      <input type="checkbox" class="busca-aa-caixa"><span><b>Aa</b> diferenciar maiúsculas</span>
    </label>
  </div>
  <input class="busca-entrada" type="search" placeholder="Buscar no livro" aria-label="Termo da busca"
    autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" autofocus>
  <p class="busca-msg" role="status" aria-live="polite"></p>
  <ol class="busca-lista"></ol>
  <button class="btn busca-mais" type="button" hidden></button>
  <p class="muted busca-hint">
    <b>Palavras</b> acha as páginas que têm todas as palavras digitadas, em qualquer ordem.
    <b>Frase exata</b> só acha as palavras em sequência, como foram digitadas.
    <b>Aa</b> exige a mesma caixa das letras digitadas (maiúscula ou minúscula); os acentos continuam sendo ignorados.
    Conceitos também funcionam: tente <em>willpower</em>, <em>iniciativa</em>, <em>absorção</em>.
  </p>
</dialog>

<script>
  import { tokensDe, termoPagefind, padroes, contem, realcar } from '../lib/busca';

  const dlg = document.querySelector('.busca-modal');
  const pfJs = dlg.dataset.pf;
  const entrada = dlg.querySelector('.busca-entrada');
  const lista = dlg.querySelector('.busca-lista');
  const msg = dlg.querySelector('.busca-msg');
  const mais = dlg.querySelector('.busca-mais');
  const radios = dlg.querySelectorAll('input[name="busca-modo"]');
  const caixaAa = dlg.querySelector('.busca-aa-caixa');
  const CHAVE = 'centelha-busca';
  const LOTE = 8;       // resultados por vez
  const SUBS = 3;       // seções (âncoras) mostradas por página
  const ATRASO = 150;   // ms de espera depois da última tecla

  const modo = () => dlg.querySelector('input[name="busca-modo"]:checked').value;

  // modo e Aa lembrados, mas a busca funciona igual sem o localStorage
  try {
    const s = JSON.parse(localStorage.getItem(CHAVE) || '{}');
    if (s.modo === 'frase') radios.forEach((r) => { r.checked = r.value === 'frase'; });
    caixaAa.checked = s.aa === true;
  } catch (e) { /* sem armazenamento: segue com o padrão */ }
  function salvar() {
    try { localStorage.setItem(CHAVE, JSON.stringify({ modo: modo(), aa: caixaAa.checked })); } catch (e) { /* idem */ }
  }

  // ---- pagefind.js (carga única, assíncrona) ----
  let carga = null;
  function ensure() {
    if (!carga) {
      carga = import(/* @vite-ignore */ pfJs).then((m) => { m.init?.(); return m; }).catch(() => null);
    }
    return carga;
  }

  // ---- resultados ----
  function item(d, pads) {
    const exato = !!pads;
    const li = document.createElement('li');
    li.className = 'busca-res';
    const h = document.createElement('h3');
    h.className = 'busca-res-titulo';
    const a = document.createElement('a');
    a.href = d.url;
    a.textContent = d.meta?.title || d.url;
    h.append(a);
    li.append(h);
    const tr = document.createElement('p');
    tr.className = 'busca-res-trecho';
    tr.innerHTML = exato ? realcar(d.content, pads, true) : d.excerpt;
    li.append(tr);
    const subs = (d.sub_results || []).filter((s) => s.anchor && (!exato || contem(s.plain_excerpt, pads, false))).slice(0, SUBS);
    if (subs.length) {
      const ul = document.createElement('ul');
      ul.className = 'busca-subs';
      for (const s of subs) {
        const si = document.createElement('li');
        const sa = document.createElement('a');
        sa.href = s.url;
        sa.textContent = s.title;
        const sp = document.createElement('p');
        sp.innerHTML = exato ? realcar(s.plain_excerpt, pads, false) : s.excerpt;
        si.append(sa, sp);
        ul.append(si);
      }
      li.append(ul);
    }
    return li;
  }

  let seq = 0;      // cada busca nova invalida as respostas atrasadas das anteriores
  let cand = [];    // resultados do pagefind ainda sem os dados
  let fila = [];    // com Aa: os que passaram no filtro de caixa
  let ptr = 0;
  let ativo = null; // { aa, pads, m }

  async function mostrarMais(minha) {
    if (!ativo) return;
    let restante;
    if (!ativo.aa) {
      const lote = cand.slice(ptr, ptr + LOTE);
      ptr += lote.length;
      const dados = await Promise.all(lote.map((r) => r.data()));
      if (minha !== seq) return;
      dados.forEach((d) => lista.append(item(d, null)));
      restante = cand.length - ptr;
    } else {
      const lote = fila.slice(ptr, ptr + LOTE);
      ptr += lote.length;
      lote.forEach((d) => lista.append(item(d, ativo.pads)));
      restante = fila.length - ptr;
    }
    mais.hidden = restante <= 0;
    if (restante > 0) mais.textContent = 'Mostrar mais (' + restante + ')';
  }

  async function buscar() {
    const minha = ++seq;
    // o botão da busca anterior não pode ser clicado enquanto a nova corre: ele atuaria sobre a fila nova, ainda parcial
    mais.hidden = true;
    const bruto = entrada.value.trim();
    const m = modo();
    const aa = caixaAa.checked;
    const tokens = tokensDe(bruto);
    if (!tokens.length) {
      // sem termo (vazio ou só pontuação): nada da busca anterior fica na tela
      lista.replaceChildren();
      cand = []; fila = []; ptr = 0; ativo = null;
      msg.textContent = bruto ? 'Digite ao menos uma palavra.' : '';
      return;
    }
    msg.textContent = carga ? 'Buscando…' : 'Carregando o índice…';
    const pf = await ensure();
    if (minha !== seq) return;
    if (!pf) { msg.textContent = 'A busca fica disponível no site publicado (índice gerado no build).'; return; }
    const termo = termoPagefind(tokens, m);
    const resp = await pf.debouncedSearch(termo, {}, ATRASO);
    if (resp === null || minha !== seq) return;
    // lista e estado trocam juntos, no mesmo trecho síncrono: nunca há lista de uma busca com fila de outra
    lista.replaceChildren();
    ativo = { aa, m, pads: aa ? padroes(tokens, m) : null };
    cand = resp.results; fila = []; ptr = 0;
    if (aa) {
      // o pagefind ignora a caixa, então o filtro precisa ver o texto de todos os candidatos
      for (let i = 0; i < cand.length; i += 12) {
        const dados = await Promise.all(cand.slice(i, i + 12).map((r) => r.data()));
        if (minha !== seq) return;
        dados.forEach((d) => { if (contem(d.content, ativo.pads, true)) fila.push(d); });
      }
    }
    const total = aa ? fila.length : cand.length;
    const rot = '“' + bruto + '”' + (m === 'frase' ? ' (frase exata)' : '') + (aa ? ' com Aa' : '');
    msg.textContent = total
      ? total + (total === 1 ? ' resultado para ' : ' resultados para ') + rot
      : 'Nenhum resultado para ' + rot + (aa ? '. Tente desligar o Aa.' : '.');
    if (total) await mostrarMais(minha);
  }

  entrada.addEventListener('input', buscar);
  radios.forEach((r) => r.addEventListener('change', () => { salvar(); buscar(); }));
  caixaAa.addEventListener('change', () => { salvar(); buscar(); });
  mais.addEventListener('click', () => { mostrarMais(seq); });

  // O campo já existe no HTML, então o foco é imediato mesmo na primeira abertura;
  // só o índice do pagefind chega depois, e a busca digitada nesse meio tempo espera por ele.
  function abrir() {
    if (!dlg.open) dlg.showModal();
    entrada.focus();
    ensure();
    if (entrada.value.trim() && !lista.children.length && !msg.textContent) buscar();
  }
  document.querySelectorAll('.busca-abrir').forEach((b) => b.addEventListener('click', abrir));
  dlg.querySelector('.busca-fechar')?.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const a = document.activeElement;
    const emCampo = a && (['INPUT', 'TEXTAREA', 'SELECT'].includes(a.tagName) || a.isContentEditable);
    // A / é texto quando se digita em algum campo, inclusive o da própria busca aberta. Com o
    // diálogo fechado o foco pode ter ficado no campo dele, e aí a / tem de abrir de novo.
    if (emCampo && (!dlg.contains(a) || (dlg.open && a === entrada))) return;
    e.preventDefault();
    abrir();
  });
</script>
