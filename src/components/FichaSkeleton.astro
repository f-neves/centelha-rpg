---
// Esqueleto (markup + estilos) da ficha interativa, compartilhado por /ficha e /personagem.
// O comportamento vive em src/lib/ficha-engine.ts (montarFicha).
import RoladorDados from './RoladorDados.astro';
import FormasPop from './FormasPop.astro';
import MolduraFicha from './MolduraFicha.astro';
// Arte padrão das peças de equipamento: um atlas por categoria, cada peça
// recortando o seu quadro. Gerado por scripts/gen-arte-equip.mjs.
import '../styles/arte-equip.css';
---
{/* No celular a Ficha vira um painel de abas: os vitais ficam sempre à vista, uma seção
    por vez, ações na barra inferior. No desktop os invólucros .ftab têm display: contents
    e NADA muda. A ficha inteira media ~11.700px (14 telas) numa coluna só.

    O deck mora FORA das duas molduras, e vem antes da barra de XP no documento por
    causa disto: no celular só uma moldura aparece por vez (a que tem a aba em uso), e
    se o deck vivesse dentro de uma delas ele ficaria dentro do quadro em umas abas e
    fora em outras. No desktop ele é display: none, então a posição no documento não
    muda nada por lá. */}
<div class="fdeck">
  <div id="fvitais" aria-label="Derivados vitais"></div>
  <nav class="ftab-bar" role="tablist" aria-label="Seções da ficha">
    <button type="button" role="tab" data-ftab="atrib" aria-selected="true">Atrib</button>
    <button type="button" role="tab" data-ftab="perfil" aria-selected="false">Perfil</button>
    <button type="button" role="tab" data-ftab="hab" aria-selected="false">Hab</button>
    <button type="button" role="tab" data-ftab="proezas" aria-selected="false">Proezas</button>
    <button type="button" role="tab" data-ftab="artes" aria-selected="false">Artes</button>
    <button type="button" role="tab" data-ftab="equip" aria-selected="false">Equip</button>
    <button type="button" role="tab" data-ftab="mochila" aria-selected="false">Mochila</button>
    {/* o painel de História mora na página do personagem salvo, não aqui: em /ficha
        este botão não tem para onde levar e some sozinho (ver o init das abas). */}
    <button type="button" role="tab" data-ftab="historia" aria-selected="false">História</button>
    <button type="button" role="tab" data-ftab="rolar" aria-selected="false">Rolar</button>
  </nav>
</div>

{/* ---- Primeira folha: quem o personagem é ----
    Da barra de XP até as Artes. O corte é depois do Arcano porque daí em diante o
    assunto muda: o que vem é o que ele carrega e o que se faz com a ficha na mesa. */}
<MolduraFicha>
{/* Três faixas em vez de uma fila só: os números à esquerda, os botões à direita e o
    detalhamento do gasto na linha de baixo, atravessando a barra. Antes era um flex
    plano em que o detalhamento (que cresce com o que foi comprado) empurrava os botões
    e a barra remontava sozinha a cada compra. A ordem dos números segue a conta:
    orçamento, quanto saiu, quanto sobra. */}
<div class="xpbar" id="painel">
  <div class="xp-nums">
    <label>Orçamento <input type="number" id="xpBudget" value="1500" /></label>
    <span class="big">Gasto: <b id="xpSpent">0</b></span>
    <span class="big">Restam: <b id="xpRem" class="rem ok">1500</b></span>
  </div>
  <span class="xp-btns">
    <button class="btn" id="f-export">Exportar</button>
    <button class="btn" id="f-import">Importar</button>
    {/* Imprimir e Link continuam montados (o resto do código fala com eles), só não
        aparecem na barra. Voltar é tirar o hidden. */}
    <button class="btn" id="f-print" hidden>Imprimir</button>
    <button class="btn" id="f-link" hidden>Link</button>
    <button class="btn" id="f-reset">Resetar</button>
    <input type="file" id="f-file" accept="application/json,.json" hidden />
  </span>
  <span class="breakdown" id="xpBreak"></span>
</div>

<div class="ftab" data-ftab="perfil">
<div class="idrow">
  <label>Nome<input class="txt" data-id="nome" placeholder="Seu herói" /></label>
  <label>Conceito<input class="txt" data-id="conceito" /></label>
  <label>Jogador<input class="txt" data-id="jogador" /></label>
  <label>Raça<select class="racasel" id="raca-sel"></select></label>
</div>
<div class="raca-info" id="raca-info"></div>
</div>

<div class="ftab" data-ftab="atrib">
<h2 class="barh">Atributos <small>(piso 1 · 5 + nível×5: 15/20/25/30/35)</small></h2>
<div class="cols3" id="attrs"></div>
</div>

<div class="ftab" data-ftab="perfil">
<div class="cols2">
  <div>
    <h2 class="barh">Centelha, Virtudes, Vontade &amp; Fôlego</h2>
    <div id="power"></div>
  </div>
  <div>
    <h2 class="barh">Derivados <small>(calculados)</small><button class="deriv-toggle" id="deriv-toggle" type="button">Expandir</button></h2>
    <div class="panel no-gloss" id="derived"></div>
  </div>
</div>
</div>

<div class="ftab" data-ftab="hab">
<h2 class="barh barh-tog" data-sec="skills"><span class="sec-caret">▾</span> Habilidades <small>(piso 0 · 4 + nível×2: 6/8/10/12/14/16 · especialidade 8 + nível×4: 12/16/20 · até [nível÷2] por perícia)</small></h2>
<div class="sec-body" id="sec-skills"><div class="hgrupos" id="skills"></div></div>

{/* No celular a seção se chama só "Secundárias": ao lado de "Habilidades" logo acima,
    o "Habilidades" repetido no título comia a largura sem dizer nada de novo. */}
<h2 class="barh barh-tog" data-sec="secondary"><span class="sec-caret">▾</span> <span class="so-desktop">Habilidades </span>Secundárias <small>(metade da primária: 3/4/5/6/7/8 · esp. 6/8/10 · até [nível÷2])</small></h2>
<div class="sec-body" id="sec-secondary"><div class="hgrupos" id="secondary"></div></div>
</div>

<div class="ftab" data-ftab="proezas">
<h2 class="barh barh-tog" data-sec="tecnicas"><span class="sec-caret">▾</span> Proezas &amp; Técnicas <small>(custo em XP)</small></h2>
<div class="sec-body" id="sec-tecnicas">
  <div class="cam-tools"><button class="btn" id="cam-all">Expandir todos</button></div>
  <div id="tecnicas"></div>
</div>
</div>

{/* O Arcano é aba própria no celular: são 23 Artes mais os Efeitos Especiais, e
    empilhado embaixo das Proezas ficava longe demais de quem só quer as Artes.
    No desktop as duas seções continuam uma sob a outra, como sempre. */}
<div class="ftab" data-ftab="artes">
<h2 class="barh barh-tog" data-sec="artes"><span class="sec-caret">▾</span> Arcano — Artes <small>(nível×10 · exige Centelha &gt; 0)</small></h2>
<div class="sec-body" id="sec-artes"><div class="cols3" id="artes"></div>
      <div class="ef-esp" id="efeitos-esp"></div></div>
</div>
</MolduraFicha>

{/* ---- Segunda folha: o que ele carrega e o que se faz com ele ----
    Equipamento, Mochila, Força & Arremesso e Rolar. O <slot /> no fim é por onde
    /personagem acrescenta Descrição/História/Background/Anotações e Arquivos, que só
    existem na ficha ligada à conta: assim as duas entram nesta folha em vez de virarem
    blocos soltos depois dela. */}
<MolduraFicha>
<div class="ftab" data-ftab="equip">
<h2 class="barh">Equipamento <small>(não custa XP · ajusta ataque, Defesa e Absorção)</small></h2>
<p class="equip-nota muted">Cada arma traz <strong>guardada · mão hábil · mão inábil</strong>, e é isso que o Acerto e o Dano leem. Empunhar na hábil desequipa a arma que estava lá; uma arma de <strong>duas mãos</strong> desequipa as duas. Uma arma <strong>versátil</strong> sozinha é segura com as duas mãos e soma a <strong>Força em dobro</strong>; com escudo ou outra arma na outra mão, soma simples. Nas armaduras, o botão <strong>Vestir</strong> é o que faz a peça contar, e várias podem estar vestidas ao mesmo tempo. O <strong>✎ ajustar</strong> abre os números para quando o item for melhor ou pior que o do catálogo, e o quadro de imagem aceita uma foto sua (é preciso estar logado).</p>
<div class="eq-bloco-tit">Armas do personagem <small>marque como cada uma está sendo empunhada</small></div>
{/* o seletor de "adicionar" fica FORA da grade: como as linhas são todas do mesmo
    tamanho (grid-auto-rows: 1fr), dentro dela ele virava uma linha vazia da altura de
    um card inteiro e empurrava o resto da página */}
<div id="eq-arsenal-add"></div>
<div id="eq-arsenal" class="eq-pecas"></div>

{/* Os conjuntos continuam sendo o lugar onde as mãos ficam guardadas (e o que o
    rastreador de combate da mesa lê), mas quem decide é o marcador de cada arma:
    o bloco está escondido, não removido, para poder voltar sem migração. */}
<div id="eq-conj-bloco" hidden>
  <div class="eq-bloco-tit">Conjuntos de armas <small>só um fica em uso por vez</small></div>
  <div id="eq-conjuntos"></div>
  <button class="btn" id="add-conjunto" type="button">+ conjunto de armas</button>
</div>

<div class="eq-bloco-tit">Armaduras <small>vestidas destacadas · empilháveis</small></div>
<div class="eq-arm-grid">
  <div class="eq-arm-lado">
    <div class="eq-abs" id="eq-absorcao"></div>
    <div id="eq-armaduras-add"></div>
  </div>
  <div class="eq-arm-col">
    <div id="eq-armaduras" class="eq-pecas"></div>
  </div>
</div>
<div class="panel" id="combate"></div>
</div>

{/* As bolsas viram aba própria: o que se consulta em mesa é arma e armadura, e as
    três tabelas de carga ficavam empurrando o resumo de combate para longe. */}
<div class="ftab" data-ftab="mochila">
<h2 class="barh">Mochila &amp; Bagagem <small>(o que o personagem carrega · não custa XP)</small></h2>
<div class="equip-bolsas" id="eq-bolsas"></div>
</div>

{/* Força &amp; Arremesso é uma tabela de consulta que se usa no momento de rolar, e não
    ao montar o equipamento: mudou de aba junto com o rolador. */}
<div class="ftab" data-ftab="rolar">
<h2 class="barh">Força &amp; Arremesso <small>(levantamento e alcance de arremesso · não custa XP)</small></h2>
<div class="panel" id="forca-arremesso"></div>

<h2 class="barh">Rolar</h2>
<RoladorDados compact />
</div>
<slot />
</MolduraFicha>

{/* Daqui para baixo é sobreposição: barra fixa do celular, ampliação de arte e o
    popover de formas. Nenhuma pertence a uma folha. */}
<div class="fx-bar" data-pagefind-ignore>
  <span id="fx-xp"></span>
  <button class="btn primary" id="fx-salvar" type="button" hidden>Salvar</button>
  <button class="btn" id="fx-mais" type="button" aria-expanded="false" aria-label="Mais ações">⋯</button>
</div>

{/* Ampliação da arte de uma peça, no mesmo desenho do lightbox do bestiário. */}
<div class="eq-lb" id="eq-lightbox" hidden>
  <button class="eq-lb-fechar" type="button" aria-label="Fechar">✕</button>
  <figure><img id="eq-lb-img" src="" alt="" /><figcaption id="eq-lb-cap" class="cinzel"></figcaption></figure>
</div>

<FormasPop />

<script>
  // Abas da ficha no celular. No desktop este script só garante que tudo fica visível.
  // Ampliação da arte de armas e armaduras. Delegado no documento porque os cards são
  // reconstruídos pelo motor a cada mudança.
  {
    const lb = document.getElementById('eq-lightbox');
    const lbImg = document.getElementById('eq-lb-img') as HTMLImageElement | null;
    const lbCap = document.getElementById('eq-lb-cap');
    if (lb && lbImg && lbCap) {
      const fechar = () => { lb.hidden = true; lbImg.src = ''; document.body.style.overflow = ''; };
      document.addEventListener('click', (e) => {
        const z = (e.target as HTMLElement).closest<HTMLElement>('[data-eq-zoom]');
        if (z) {
          lbImg.src = z.dataset.eqZoom!;
          lbImg.alt = 'Imagem de ' + (z.dataset.eqZoomNome || 'item');
          lbCap.textContent = z.dataset.eqZoomNome || '';
          lb.hidden = false; document.body.style.overflow = 'hidden';
          return;
        }
        if (!lb.hidden && (e.target === lb || (e.target as HTMLElement).closest('.eq-lb-fechar'))) fechar();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) fechar(); });
    }
  }

  const bar = document.querySelector<HTMLElement>('.ftab-bar');
  if (bar) {
    const mq = matchMedia('(max-width: 900px)');
    const paineis = Array.from(document.querySelectorAll<HTMLElement>('.ftab'));
    // Nem toda página monta todos os painéis: /personagem tem História, /ficha não.
    // O botão sem painel sairia levando a uma aba em branco, então sai da barra.
    const temPainel = new Set(paineis.map((t) => t.dataset.ftab));
    bar.querySelectorAll<HTMLButtonElement>('button[data-ftab]')
      .forEach((b) => { if (!temPainel.has(b.dataset.ftab!)) b.remove(); });
    const botoes = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-ftab]'));
    // a aba que abre é a primeira da barra, seja qual for: assim reordenar os botões
    // basta, sem um nome de aba escrito à parte que sai de sincronia com a ordem
    let ativa = botoes[0]?.dataset.ftab || 'atrib';

    // ARIA de tablist: o papel já estava declarado, faltava a ligação entre botão e
    // painel e o teclado. Uma aba pode ter mais de um painel (Perfil tem dois blocos),
    // por isso aria-controls recebe uma lista.
    botoes.forEach((b, i) => {
      const nome = b.dataset.ftab!;
      b.id ||= `ftab-bt-${nome}`;
      const meus = paineis.filter((t) => t.dataset.ftab === nome);
      meus.forEach((t, j) => {
        t.id ||= `ftab-p-${nome}${j ? '-' + j : ''}`;
        t.setAttribute('role', 'tabpanel');
        t.setAttribute('aria-labelledby', b.id);
      });
      if (meus.length) b.setAttribute('aria-controls', meus.map((t) => t.id).join(' '));
      b.tabIndex = i === 0 ? 0 : -1;
    });

    // a fita é criada aqui e não no markup: sem script ela não teria o que marcar
    const fita = document.createElement('span');
    fita.className = 'ftab-fita';
    fita.hidden = true;
    bar.prepend(fita);

    /** Põe a fita sobre a aba em uso. O offset é medido dentro da trilha, então vale
     *  igual com a barra rolada: a fita rola junto com os rótulos. */
    const moverFita = () => {
      const b = botoes.find((x) => x.dataset.ftab === ativa);
      if (!b || !mq.matches) { fita.hidden = true; return; }
      fita.hidden = false;
      fita.style.width = b.offsetWidth + 'px';
      fita.style.height = b.offsetHeight + 'px';
      fita.style.transform = `translate(${b.offsetLeft}px, ${b.offsetTop}px)`;
    };
    /** Traz a aba escolhida para o meio da trilha: nesta largura ela pode nascer fora da tela. */
    const centrar = (suave = true) => {
      const b = botoes.find((x) => x.dataset.ftab === ativa);
      if (!b) return;
      const max = bar.scrollWidth - bar.clientWidth;
      const x = Math.max(0, Math.min(b.offsetLeft - (bar.clientWidth - b.offsetWidth) / 2, max));
      const anima = suave && !matchMedia('(prefers-reduced-motion: reduce)').matches;
      bar.scrollTo({ left: x, behavior: anima ? 'smooth' : 'auto' });
    };
    /** Desbota a ponta só do lado em que ainda sobra trilha. */
    const marcarPontas = () => {
      const max = bar.scrollWidth - bar.clientWidth;
      bar.classList.toggle('mais-esq', bar.scrollLeft > 4);
      bar.classList.toggle('mais-dir', bar.scrollLeft < max - 4);
    };
    bar.addEventListener('scroll', marcarPontas, { passive: true });
    addEventListener('resize', () => { moverFita(); marcarPontas(); });
    // a fita nasce no lugar certo só depois que a Cinzel carrega e os rótulos assentam
    (document as any).fonts?.ready?.then(() => { moverFita(); marcarPontas(); });

    // As duas folhas da ficha. No celular, a que não contém a aba em uso fica sem
    // nada para emoldurar, e some do desenho (ver .moldura-vazia em global.css).
    const folhas = Array.from(document.querySelectorAll<HTMLElement>('.sheet-frame'));
    const aplicar = () => {
      const mob = mq.matches;
      document.body.classList.toggle('ficha-abas', mob);
      if (!mob) document.body.classList.remove('fx-aberto');
      paineis.forEach((t) => t.classList.toggle('on', !mob || t.dataset.ftab === ativa));
      folhas.forEach((f) => f.classList.toggle('moldura-vazia', mob && !f.querySelector('.ftab.on')));
      botoes.forEach((b) => {
        const on = b.dataset.ftab === ativa;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;          // tabIndex itinerante: Tab entra na barra uma vez só
      });
      moverFita();
      if (mob) { centrar(); marcarPontas(); }
    };
    const irPara = (b: HTMLButtonElement, focar = false) => {
      // o painel entra pelo lado de onde veio: para frente na fila, entra da direita
      const de = botoes.findIndex((x) => x.dataset.ftab === ativa);
      const para = botoes.indexOf(b);
      document.body.classList.toggle('volta', para < de);
      ativa = b.dataset.ftab!;
      aplicar();
      if (focar) b.focus();
    };
    botoes.forEach((b) => b.addEventListener('click', () => irPara(b)));
    // setas, Home e End percorrem as abas, como manda o padrão de tablist
    bar.addEventListener('keydown', (e) => {
      const i = botoes.findIndex((b) => b.dataset.ftab === ativa);
      const salto: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1 };
      let alvo = -1;
      if (e.key in salto) alvo = (i + salto[e.key] + botoes.length) % botoes.length;
      else if (e.key === 'Home') alvo = 0;
      else if (e.key === 'End') alvo = botoes.length - 1;
      if (alvo < 0) return;
      e.preventDefault();
      irPara(botoes[alvo], true);
    });
    mq.addEventListener('change', aplicar);
    aplicar();
    // a primeira medida espera o layout existir (a barra nasce com largura 0)
    requestAnimationFrame(() => { moverFita(); if (mq.matches) { centrar(false); marcarPontas(); } });

    // vitais sempre à vista: espelham PV / Defesa / Energia / Mana do #derived,
    // que o engine re-renderiza inteiro a cada mudança (daí o MutationObserver)
    const vit = document.getElementById('fvitais');
    const derived = document.getElementById('derived');
    const updVitais = () => {
      if (!vit || !derived) return;
      const pega = (rx: RegExp) => {
        for (const d of derived.querySelectorAll('.derv')) {
          if (rx.test(d.querySelector('.dl')?.textContent || '')) return d.querySelector('.dv')?.textContent || '—';
        }
        return '—';
      };
      vit.innerHTML = [
        ['PV', pega(/pontos de vida/i)], ['Def', pega(/defesa \(esquiva\)/i)],
        ['En', pega(/^energia/i)], ['Mana', pega(/^mana/i)],
      ].map(([k, v]) => `<span><b>${k}</b>${v}</span>`).join('');
    };
    if (derived) { new MutationObserver(updVitais).observe(derived, { childList: true, subtree: true }); updVitais(); }

    // barra inferior: saldo de XP espelhado + Salvar (quando a página injeta o botão real) + ⋯
    const fxXp = document.getElementById('fx-xp');
    const xpRem = document.getElementById('xpRem');
    const updXp = () => {
      if (!fxXp || !xpRem) return;
      fxXp.textContent = `Restam ${xpRem.textContent} XP`;
      fxXp.classList.toggle('neg', xpRem.classList.contains('neg'));
    };
    if (xpRem) { new MutationObserver(updXp).observe(xpRem, { childList: true, characterData: true, subtree: true }); updXp(); }

    const fxSalvar = document.getElementById('fx-salvar') as HTMLButtonElement | null;
    const realSalvar = () => Array.from(document.querySelectorAll<HTMLButtonElement>('.xp-btns .btn'))
      .find((b) => /salvar/i.test(b.textContent || ''));
    const updSalvar = () => { if (fxSalvar) fxSalvar.hidden = !realSalvar(); };
    fxSalvar?.addEventListener('click', () => realSalvar()?.click());
    const xpBtns = document.querySelector('.xp-btns');
    if (xpBtns) { new MutationObserver(updSalvar).observe(xpBtns, { childList: true }); updSalvar(); }

    // ⋯ abre a barra de XP (orçamento, modo, exportar…) como folha sobre a barra inferior
    const fxMais = document.getElementById('fx-mais');
    fxMais?.addEventListener('click', (e) => {
      e.stopPropagation();
      const aberto = document.body.classList.toggle('fx-aberto');
      fxMais.setAttribute('aria-expanded', String(aberto));
    });
    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('fx-aberto')) return;
      const painel = document.getElementById('painel');
      if (painel && e.target instanceof Node && !painel.contains(e.target)) {
        document.body.classList.remove('fx-aberto');
        fxMais?.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<!-- is:global porque o conteúdo (bolinhas, cards, pílulas) é criado via JS e
     não recebe o atributo de escopo do Astro -->
<style is:global>
  /* números | botões · e o detalhamento ocupando a linha inteira embaixo */
  .xpbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .45rem 1.2rem;
    align-items: center; background: var(--accent); color: var(--on-accent);
    padding: .6rem 1rem; border-radius: var(--r-md); margin: 1rem 0; }
  .xpbar .xp-nums { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem 1.2rem; min-width: 0; }
  .xpbar .big { font-family: 'Cinzel'; font-size: var(--fs-aux); white-space: nowrap; }
  .xpbar .big b { font-size: var(--fs-h3); }
  .xpbar .rem.neg { color: #ffd0cb; } .xpbar label { font-family: 'Cinzel'; font-size: var(--fs-micro); display: flex; align-items: center; gap: .4rem; }
  .xpbar input { width: 4.5rem; text-align: center; border: none; border-radius: var(--r-sm); padding: .25rem; font-family: 'Cinzel'; }
  .xpbar input:disabled { opacity: .8; cursor: not-allowed; }
  /* o detalhamento atravessa as duas colunas: é o texto que mais varia de tamanho, e
     na mesma linha dos números ele empurrava os botões a cada compra */
  .xpbar .breakdown { grid-column: 1 / -1; font-size: var(--fs-micro); opacity: .9; min-width: 0; }
  .xpbar .breakdown:empty { display: none; }
  /* flex-wrap é obrigatório: sem ele a fila de botões estoura a viewport do celular e
     põe a Ficha inteira para rolar na horizontal. */
  .xpbar .xp-btns { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem; min-width: 0; }
  /* no celular tudo vira uma coluna: números, botões (largura toda) e o detalhamento */
  @media (max-width: 640px) {
    .xpbar { grid-template-columns: minmax(0, 1fr); }
    .xpbar .xp-btns { justify-content: flex-start; }
    .xpbar .xp-btns .btn { flex: 1 1 auto; }
  }
  .xpbar .btn { background: var(--accent-strong); color: var(--on-accent-strong); border-color: transparent; padding: .25rem .6rem; font-size: var(--fs-micro); }

  .idrow { display: grid; grid-template-columns: 2fr 2fr 1fr 1.4fr; gap: 1rem; margin-bottom: .4rem; }
  /* min-width: 0 — itens de grade não encolhem abaixo do tamanho intrínseco por padrão, e o
     <select> de Raça vazava a coluna nas telas estreitas. */
  .idrow > * { min-width: 0; }
  @media (max-width: 640px) { .idrow { grid-template-columns: 1fr 1fr; } }
  .idrow select.racasel { width: 100%; margin-top: .15rem; }
  .raca-info { font-size: var(--fs-micro); color: var(--ink-soft); margin: 0 0 .6rem; line-height: 1.4; }
  .raca-info b { color: var(--accent-strong); font-family: 'Cinzel'; font-weight: 600; }
  .raca-info .mods { font-family: 'Cinzel'; }
  .idrow label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .04em; color: var(--ink-soft); text-transform: uppercase; }
  .idrow .txt { font-family: 'EB Garamond'; font-size: var(--fs-aux); border: none; border-bottom: 1px solid var(--rule); background: transparent; padding: .2rem; color: var(--ink); }
  .idrow .txt:focus { outline: none; border-bottom-color: var(--accent); }

  /* h2.barh vem do global.css: definição única da barra de seção das páginas-ferramenta */
  h2.barh.barh-tog { cursor: pointer; user-select: none; }
  h2.barh.barh-tog .sec-caret { display: inline-block; width: 1em; font-size: .85em; }
  .sec-body.sec-hidden { display: none; }
  @media print { .sec-body.sec-hidden { display: block !important; } h2.barh.barh-tog .sec-caret { display: none; } }
  .ficha-x h3, #attrs h3, #skills h3, #secondary h3, #power h3, #tecnicas h3 { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); letter-spacing: .04em; text-transform: uppercase; margin: .9rem 0 .35rem; border-bottom: 1px solid var(--rule); padding-bottom: .15rem; }

  /* `minmax(0, 1fr)` e não `1fr`: um `1fr` cru vale `minmax(auto, 1fr)`, e o
     `auto` é o min-content da coluna. Um grupo de atributos mede 206px de
     min-content (o nome mais sete bolinhas mais o dado), então três deles se
     recusavam a caber em menos de 669px e a grade transbordava a moldura em vez
     de espremer as colunas. Era o que acontecia entre 901px e ~1050px de tela,
     onde a coluna de navegação já existe mas o conteúdo ficou estreito: a
     terceira coluna saía 73px por fora do filete e a página inteira passava a
     rolar de lado. */
  .cols3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .3rem 1.6rem; }
  .cols2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .3rem 1.6rem; align-items: start; }
  /* Faixa de duas colunas. Acima de 900px a ficha sai do modo de abas e a coluna
     de navegação volta, e é justamente aí que a grade fica mais estreita: 499px
     em 901px de tela, contra 854px em 900px. O grupo mais largo dos atributos
     (Mentais: Percepção, Inteligência, Raciocínio, mais sete bolinhas e o dado)
     mede 232px, então três colunas pedem 232×3 + 25,6×2 = 747px, e a grade só
     chega lá perto de 1200px de tela. Até lá, duas. */
  @media (min-width: 901px) and (max-width: 1200px) { .cols3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* Uma coluna no celular. O corte casa com o modo de abas (body.ficha-abas), em
     vez dos 760px de antes, que deixavam três colunas apertadas em 768px. */
  @media (max-width: 900px) { .cols3, .cols2 { grid-template-columns: minmax(0, 1fr); } }

  /* Habilidades: cada grupo pega a largura toda e se abre em três colunas próprias, em
     vez de os grupos disputarem três colunas fixas. O `grid-auto-flow: column` sobre um
     número fixo de linhas (--linhas, calculado no render) é o que faz a ordem alfabética
     DESCER cada coluna em vez de atravessar a linha.

     O grid-auto-columns é o que mantém as três do mesmo tamanho: sem ele as colunas são
     implícitas e ficam `auto`, isto é, cada uma cresce até o nome mais longo que calhou
     nela (Conhecimentos Gerais alargava a primeira, Prestidigitação a segunda), e a
     largura mudava de grupo para grupo, de 270 a 342px. */
  .hgrupo { break-inside: avoid; }
  .hgrid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(var(--l3, 1), auto);
    grid-auto-columns: minmax(0, 1fr); gap: .3rem 1.6rem; }
  /* Três degraus, porque a linha "nome + pontos + especialidade" tem largura mínima real:
     abaixo de ~290px por coluna ela dobra de altura e empurra a página. Entre 901 e
     1279px a Ficha já voltou ao modo desktop mas só tem ~590px de conteúdo, e ali três
     colunas geravam 134px de rolagem horizontal. Abaixo de 900px a Ficha vira painel de
     abas e a coluna única é a leitura certa. */
  @media (max-width: 1279px) { .hgrid { grid-template-rows: repeat(var(--l2, 1), auto); } }
  @media (max-width: 900px) { .hgrid { grid-auto-flow: row; grid-template-rows: none; } }

  .trow { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .12rem 0; }
  .trow .nm { font-size: var(--fs-aux); cursor: help; } .trow .nm:hover { text-decoration: underline dotted var(--accent-soft); }
  .trow .nm small { color: var(--ink-soft); font-size: var(--fs-micro); }
  .tr-r { display: flex; align-items: center; }
  .dots { display: inline-flex; gap: 3px; align-items: center; }
  .dot { width: 15px; height: 15px; border: 1.5px solid var(--accent); border-radius: 50%; cursor: pointer; background: transparent; transition: background .08s; flex: 0 0 auto; }
  .dot.on { background: var(--accent); } .dot.free { border-color: var(--gold); } .dot.on.free { background: var(--gold); }
  .dot:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent); }
  .dots:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--r-sm); }
  .cam-tools { margin: 0 0 .5rem; }
  .dot.cap { opacity: .25; cursor: not-allowed; border-style: dotted; } .dot.cap:hover { box-shadow: none; }
  .rollv { background: none; border: none; cursor: pointer; font-size: var(--fs-rotulo); opacity: .35; margin-left: .35rem; padding: 0; line-height: 1; }
  .rollv:hover { opacity: 1; }
  .specbtn { background: none; border: none; cursor: pointer; font-size: var(--fs-micro); opacity: .4; margin-left: .35rem; padding: 0; line-height: 1; color: var(--gold); }
  .specbtn:hover, .specbtn.has { opacity: 1; }
  .specpop-h small { font-family: 'EB Garamond'; font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
  .sq { width: 14px; height: 14px; border: 1.2px solid var(--ink-soft); cursor: pointer; background: transparent; flex: 0 0 auto; border-radius: var(--r-sm); }
  .sq.on { background: var(--gold); border-color: var(--gold); }
  .sq:not(.dis):hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--gold) 35%, transparent); }
  .sq.dis { opacity: .25; cursor: not-allowed; }
  .specpop { position: absolute; z-index: 60; width: 260px; background: var(--panel); border: 1px solid var(--accent); border-radius: var(--r-lg); box-shadow: 0 6px 20px var(--shadow); padding: .6rem .7rem; }
  .specpop-h { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .03em; color: var(--accent-strong); margin-bottom: .5rem; }
  .specpop-row { display: flex; align-items: center; gap: .4rem; margin-bottom: .35rem; }
  .specpop-row input { flex: 1; min-width: 0; font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink); background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .25rem .4rem; }
  .specpop-row input:focus { outline: none; border-color: var(--accent); }
  .specpop-row .specpop-sq { display: inline-flex; gap: 3px; flex: 0 0 auto; }
  .specpop-row .spec-x { border: none; background: none; color: var(--ink-soft); cursor: pointer; font-size: var(--fs-aux); line-height: 1; padding: 0 .1rem; }
  .specpop-row .spec-x:hover { color: #b3401f; }
  .spec-add { display: block; width: 100%; font-family: 'Cinzel'; font-size: var(--fs-micro); cursor: pointer; background: none; color: var(--accent-strong); border: 1px dashed var(--panel-border); border-radius: var(--r-md); padding: .25rem; margin: .1rem 0 .4rem; }
  .spec-add:hover { border-color: var(--accent); color: var(--accent-texto); }
  .specpop-f { text-align: right; margin-top: .2rem; }
  .specpop-f .btn { padding: .2rem .7rem; font-size: var(--fs-micro); }
  .apmod { margin-left: .5rem; font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-aux); color: var(--accent-texto); }

  #derived { border: 1px solid var(--panel-border); background: var(--panel); border-left: 4px solid var(--accent); padding: .6rem .8rem; border-radius: var(--r-sm); }
  .derv { display: flex; justify-content: space-between; align-items: baseline; padding: .2rem 0; border-bottom: 1px dotted var(--rule); }
  .derv .dl { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); text-transform: uppercase; }
  .derv .dv { font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-corpo); color: var(--accent-texto); }
  .derv .fm { display: block; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; font-family: 'EB Garamond'; font-weight: 400; text-transform: none; }
  h2.barh .deriv-toggle { float: right; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: none; letter-spacing: 0; padding: .12rem .55rem; background: var(--accent-strong); color: var(--on-accent-strong); border: none; border-radius: var(--r-sm); cursor: pointer; }
  h2.barh .deriv-toggle:hover { filter: brightness(1.1); }
  #derived.collapsed .derv-extra { display: none; }
  @media print { h2.barh .deriv-toggle { display: none !important; } #derived.collapsed .derv-extra { display: flex !important; } }

  /* Efeitos Especiais das Artes: lista abaixo das Artes, só o que o personagem alcança */
  .ef-esp { margin-top: .8rem; }
  .ef-esp-head { display: flex; align-items: baseline; gap: .6rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo);
    color: var(--accent-strong); border-bottom: 1px solid var(--rule); padding-bottom: .2rem; margin-bottom: .35rem; }
  .ef-esp-head .muted { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); font-style: italic; }
  /* min(x,100%): sem isso o minimo de 24rem (384px) estoura o conteiner de 328px do celular */
  .ef-esp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(var(--card-min-md), 100%), 1fr)); gap: .2rem .8rem; }
  /* um bloco por Arte: os Efeitos de Cura ficam juntos, os de Proteção juntos, etc. */
  .ef-grupo { margin: .55rem 0 .1rem; }
  .ef-g-head { display: flex; align-items: baseline; gap: .5rem; font-family: 'Cinzel'; font-size: var(--fs-micro);
    color: var(--accent-texto); border-bottom: 1px dotted var(--rule); padding-bottom: .12rem; margin-bottom: .2rem; }
  .ef-g-nm { text-transform: uppercase; letter-spacing: .05em; }
  .ef-g-nv { font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; }
  .ef-g-qtd { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); font-style: italic; }
  .ef-item { display: flex; align-items: center; gap: .4rem; padding: .2rem .3rem; border-radius: var(--r-sm);
    font-size: var(--fs-rotulo); cursor: pointer; }
  .ef-item:hover { background: var(--panel-2); }
  .ef-item.on { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .ef-i-nv { display: inline-grid; place-items: center; width: 1.15rem; height: 1.15rem; border-radius: 50%;
    background: var(--gold); color: var(--on-accent); font-family: 'Cinzel'; font-size: var(--fs-micro); flex: none; }
  .ef-i-nm { font-weight: 600; }
  .ef-i-ar { font-size: var(--fs-micro); }
  .ef-i-par { font-size: var(--fs-micro); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ef-i-xp { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); flex: none; }
  .ef-vazio { font-size: var(--fs-micro); padding: .4rem 0; }
  /* Um grupo de Proezas por Atributo. O primeiro encosta na barra de ferramentas,
     por isso perde a folga de cima que separa um grupo do outro. */
  .camgrupo { break-inside: avoid; }
  .camgrupo:first-child h3 { margin-top: .2rem; }
  .cam { border: 1px solid var(--panel-border); border-radius: var(--r-sm); margin-bottom: .4rem; background: var(--panel); }
  .cam-head { padding: .4rem .7rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo); color: var(--accent-strong); display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .cam-nm { min-width: 0; }
  /* as bolinhas da Arte vão para a ponta direita do cabeçalho, como nos Atributos e
     nas Habilidades, e não coladas no nome */
  .cam-head .dots { margin-left: auto; }
  .cam-head[data-camtog] { cursor: pointer; } .cam-head[data-camtog]:hover { background: var(--panel-2); }
  .chev { cursor: pointer; } .chev:hover { color: var(--accent-texto); }
  .cam-body { padding: .4rem .7rem .6rem; border-top: 1px dotted var(--rule); }
  .tpill { display: inline-block; margin: .2rem .3rem 0 0; padding: .2rem .6rem; border: 1px solid var(--panel-border); border-radius: var(--r-lg); font-size: var(--fs-rotulo); cursor: pointer; background: var(--bg); }
  .tpill small { color: var(--ink-soft); font-size: var(--fs-micro); }
  .tpill.on { background: var(--accent); color: var(--on-accent); border-color: transparent; } .tpill.on small { color: var(--on-accent); opacity: .85; }
  .tpill:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent); }
  .tpill.locked { opacity: .5; cursor: not-allowed; border-style: dashed; }
  .tpill.invalid { border-color: #b3401f; box-shadow: 0 0 0 1px #b3401f inset; }
  .fxline { font-size: var(--fs-rotulo); padding: .08rem 0; color: var(--ink-soft); }
  .fxline.hi { color: var(--ink); } .fxline.hi b { color: var(--accent-strong); }
  .techrow { margin-bottom: .5rem; }
  .techrow .tpill { margin: 0; }
  .tdesc { font-size: var(--fs-micro); line-height: 1.35; color: var(--ink-soft); margin: .2rem 0 0 .15rem; }
  .tdesc strong { color: var(--accent-strong); font-weight: 600; }

  .equip-row { display: flex; gap: 1rem; flex-wrap: wrap; margin: .2rem 0 .8rem; }
  .equip-row label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); gap: .2rem; }
  .equip-row select { min-width: 10rem; }
  .equip-nota { font-size: var(--fs-rotulo); margin: .1rem 0 .5rem; }
  .equip-arm { margin: 0 0 .8rem; }
  .equip-lbl { display: block; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); margin-bottom: .35rem; }
  .equip-lbl small { font-weight: normal; }

  .fa-wrap { display: flex; flex-direction: column; gap: .6rem; }
  .fa-head { font-size: var(--fs-rotulo); line-height: 1.55; }
  .fa-head b { color: var(--accent-strong); font-family: 'Cinzel'; }
  .fa-tiers { display: flex; gap: .5rem 1.4rem; flex-wrap: wrap; margin: .25rem 0 .5rem; }
  .fa-tiers span { font-size: var(--fs-rotulo); } .fa-tiers span b { font-family: 'Cinzel'; color: var(--accent-strong); }
  .fa-row { display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: flex-start; }
  .fa-chartwrap { position: relative; flex: 1 1 22rem; width: 100%; max-width: 40rem; }
  /* No desktop os dois ficam lado a lado em proporção fixa (70/30), descontando o gap;
     no celular continuam empilhados pelo flex-wrap. */
  @media (min-width: 901px) {
    .fa-row { flex-wrap: nowrap; }
    .fa-row .fa-chartwrap { flex: 0 0 calc(70% - .6rem); max-width: calc(70% - .6rem); min-width: 0; }
    .fa-row .fa-tbl { flex: 0 0 calc(30% - .6rem); width: calc(30% - .6rem); min-width: 0; }
  }
  .fa-chart { display: block; width: 100%; height: auto; }
  .fa-chart .axis { stroke: var(--rule); stroke-width: 1; }
  .fa-chart .grid { stroke: var(--rule); stroke-width: .5; opacity: .45; }
  .fa-chart .curve { fill: none; stroke: var(--accent); stroke-width: 2; }
  .fa-chart .area { fill: var(--accent); opacity: .1; }
  .fa-chart text { fill: var(--ink-soft); font-size: 10px; font-family: 'EB Garamond'; }
  .fa-chart .axlbl { font-family: 'Cinzel'; font-size: 9px; }
  /* faixas de levantamento (Leve · Médio · Máximo) ao fundo do gráfico */
  .fa-chart .fa-band { fill: var(--accent-strong); }
  .fa-chart .fa-bandsep { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 2 4; opacity: .55; }
  .fa-chart .fa-bandlbl { fill: var(--ink-soft); font-family: 'Cinzel'; font-size: 9px; letter-spacing: .06em; }
  .fa-chart .fa-vline { stroke: var(--accent-strong); stroke-width: 1; stroke-dasharray: 3 3; opacity: .7; }
  .fa-chart .fa-dot { fill: var(--accent-strong); stroke: var(--paper, #fff); stroke-width: 1.5; }
  .fa-chartwrap .fa-tip { position: absolute; transform: translate(-50%, -140%); pointer-events: none; white-space: nowrap; background: var(--accent-strong); color: #fff; font-family: 'Cinzel'; font-size: var(--fs-micro); padding: .12rem .4rem; border-radius: var(--r-sm); box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  /* margin: 0 anula o `table { margin: 1em 0 }` global, que desalinhava o topo da
     tabela em relação ao do gráfico ao lado */
  .fa-tbl { border-collapse: collapse; font-size: var(--fs-rotulo); margin: 0; }
  .fa-tbl th, .fa-tbl td { border: 1px solid var(--rule); padding: .15rem .55rem; text-align: center; }
  .fa-tbl th { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); font-weight: 700; }
  /* o thead herda o fundo --accent-strong da regra global; com --ink-soft dava 1,5:1 */
  .fa-tbl thead th { color: var(--on-accent-strong); }
  /* ---------- Equipamento em peças (arsenal e armaduras) ----------
     O personagem POSSUI peças e usa algumas: cada peça é um card com imagem própria,
     números e o botão que a coloca em uso (vestir, ou escolher na mão). */
  .eq-bloco-tit { display: flex; align-items: center; gap: .6rem; margin: 1.1rem 0 .5rem;
    font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .1em; color: var(--accent-texto); }
  .eq-bloco-tit small { font-family: 'EB Garamond'; text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
  .eq-bloco-tit::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--rule), transparent); }

  /* grid-auto-rows: 1fr + o stretch padrão = todos os cards do mesmo tamanho, e não cada
     um com a altura do próprio conteúdo (uma arma com etiquetas ficava maior que a sem). */
  .eq-pecas { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: .7rem; grid-auto-rows: 1fr; }
  .eq-peca { position: relative; display: flex; flex-direction: column; min-width: 0;
    border: 1px solid var(--panel-border); border-radius: var(--r-lg); background: var(--panel); overflow: hidden; }
  .eq-peca.em-uso, .eq-peca.vestida { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent-soft); }
  .eq-peca-corpo { display: flex; flex-direction: column; gap: .35rem; padding: .5rem .6rem .6rem; flex: 1; }
  /* nome e etiquetas na mesma linha; se não couberem, as etiquetas descem inteiras */
  .eq-peca-cab { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .2rem .4rem; }
  .eq-peca-nome { font-family: 'EB Garamond'; font-size: var(--fs-aux); font-weight: 600; color: var(--ink); min-width: 0; }
  .eq-uso-flag { margin-left: .35rem; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .04em; color: var(--accent-texto); border: 1px solid var(--accent-soft); border-radius: 999px; padding: 0 .35rem; }
  /* ajustar e descartar dividem a mesma linha, no rodapé do card */
  .eq-acoes { display: flex; align-items: center; justify-content: space-between; gap: .4rem; }
  .eq-rm { background: none; border: 1px solid transparent; border-radius: var(--r-sm); color: var(--perigo);
    cursor: pointer; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em;
    line-height: 1; padding: .2rem .45rem; white-space: nowrap; }
  .eq-rm:hover { background: var(--perigo-bg); border-color: var(--perigo-bg); color: var(--on-perigo); }
  .eq-vestir { margin-top: auto; background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm);
    color: var(--ink-soft); font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em;
    padding: .35rem; cursor: pointer; min-height: 34px; }
  .eq-vestir:hover { border-color: var(--accent); color: var(--accent-texto); }
  .eq-vestir.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 700; }
  .eq-nome-in { font-family: 'EB Garamond'; font-size: var(--fs-aux); color: var(--ink); background: var(--bg);
    border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .2rem .35rem; min-width: 0; }
  .eq-vazio { grid-column: 1 / -1; margin: 0; }
  .eq-add { margin-top: .7rem; }
  /* o seletor das armas vem ANTES da grade, então o respiro vai embaixo dele */
  #eq-arsenal-add .eq-add { margin: 0 0 .8rem; }
  .eq-arm-col, .eq-arm-lado { min-width: 0; }
  /* Adicionar peça é um botão que abre o catálogo em diálogo. Era um <select>, que
     reservava a largura da MAIOR opção ("Placa de transição: Imp 4 · Cor 8 · Perf 3
     (N2) · Pen −3") e empurrava a grade para fora da tela no celular. */
  .eq-add-btn { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .06em; padding: .5rem .9rem; }
  /* o mesmo teto continua valendo para os seletores de mão, que seguem sendo <select> */
  .conj-esc select { width: 100%; min-width: 0; max-width: 100%; }

  /* números da peça em blocos, no lugar da linha "5/+2/1d6/+1" */
  .eq-nums { display: flex; flex-wrap: wrap; gap: .25rem; }
  .eq-n { flex: 1 1 3.2rem; min-width: 0; text-align: center; background: var(--bg); border: 1px solid var(--panel-border);
    border-radius: var(--r-sm); padding: .2rem .1rem; font-family: 'EB Garamond'; font-size: var(--fs-rotulo);
    font-weight: 700; color: var(--accent-texto); font-variant-numeric: tabular-nums; }
  .eq-n b { display: block; font-family: 'Cinzel'; font-size: var(--fs-micro); font-weight: 600; text-transform: uppercase;
    letter-spacing: .04em; color: var(--ink-soft); }
  .eq-n i { font-style: normal; opacity: .65; font-size: var(--fs-micro); margin-left: .15rem; }
  .eq-n.def { color: var(--ink); }
  .eq-n.pen { color: var(--perigo); }
  /* marcador de uso: três opções por arma (guardada / mão hábil / mão inábil) */
  .eq-uso { display: flex; gap: .2rem; }
  .eq-uso-op { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: .25rem;
    background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .25rem .15rem;
    font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .02em;
    color: var(--ink-soft); cursor: pointer; text-align: center; line-height: 1.15; min-height: 34px; }
  .eq-uso-op:hover { border-color: var(--accent); color: var(--accent-texto); }
  .eq-uso-op input { position: absolute; opacity: 0; width: 0; height: 0; }
  .eq-uso-op.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 700; }
  /* arma de duas mãos não oferece a mão inábil */
  .eq-uso-op.off { opacity: .35; cursor: not-allowed; }
  .eq-uso-op.off:hover { border-color: var(--panel-border); color: var(--ink-soft); }
  /* ampliação da arte da peça (mesmo desenho do lightbox do bestiário) */
  .eq-lb { position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center;
    padding: 1.5rem; background: color-mix(in srgb, #10161a 84%, transparent); backdrop-filter: blur(3px); }
  .eq-lb[hidden] { display: none; }
  .eq-lb figure { margin: 0; width: min(680px, 92vw); max-height: 88vh; display: flex; flex-direction: column;
    align-items: center; gap: .6rem; }
  /* A moldura tem tamanho fixo e a imagem se ajusta dentro dela: `scale-down` encolhe o
     que for grande demais e deixa o que for pequeno no tamanho natural, centrado, com a
     moldura preenchendo o resto. Sem isso o modal encolhia até a imagem, e uma arte de
     60x80 abria numa caixinha de 79x99. */
  .eq-lb img { width: 100%; height: min(78vh, 40rem); object-fit: scale-down; border-radius: var(--r-lg);
    background: var(--panel); padding: .6rem; box-shadow: 0 18px 50px rgba(0,0,0,.5); }
  .eq-lb figcaption { color: #f3e8cf; font-size: var(--fs-h3); letter-spacing: .02em; }
  .eq-lb-fechar { position: absolute; top: 1rem; right: 1.2rem; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: none; background: rgba(255,255,255,.12); color: #fff; font-size: var(--fs-h3); cursor: pointer; }
  .eq-lb-fechar:hover { background: rgba(255,255,255,.25); }
  .eq-tags { display: flex; flex-wrap: wrap; gap: .25rem; }
  .eq-tag { font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--gold);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); border-radius: 999px; padding: 0 .4rem; }

  /* espaço da imagem: convite quando vazio, a própria arte quando preenchido */
  .eq-img { position: relative; display: grid; place-items: center; background: var(--bg-soft) center/cover no-repeat;
    border-bottom: 1px solid var(--panel-border); color: var(--ink-soft); cursor: pointer; overflow: hidden; }
  /* Um quadro só para todas as peças, e a imagem cabe inteira nele: a armadura
     tinha 30rem e fazia um card de altura diferente dos outros na mesma grade. */
  .eq-img.arma, .eq-img.escudo, .eq-img.armadura { height: 20rem; }
  span.eq-img, div.eq-img { cursor: default; }
  .eq-img:hover { color: var(--accent-texto); }
  .eq-img-ph { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .06em; text-align: center; }
  .eq-img-ph b { display: block; font-size: var(--fs-h3); font-weight: 600; }
  /* A foto do jogador é um <img> e não um fundo: assim o enquadramento é um
     transform (escala + deslocamento) e a própria foto serve de prévia viva
     enquanto se mexe na barra de zoom. Escala 1 = a foto INTEIRA na moldura,
     que é onde toda imagem nova começa. */
  /* A foto é posicionada, e não item da grade do quadro. O quadro é
     `place-items: center`, e nele a linha tem altura automática: um `height: 100%`
     ali vira circular (a linha mede o conteúdo, o conteúdo mede a linha) e o
     navegador cai na altura natural da imagem. Com uma foto alta a caixa do
     <img> passava de 320 para 776px, o `contain` não tinha o que fazer e o
     quadro cortava a diferença. Com `inset: 0` a caixa é a moldura, exata. */
  .eq-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    -webkit-user-drag: none; user-select: none;
    transform: scale(var(--z, 1)) translate(var(--tx, 0px), var(--ty, 0px)); }
  /* com o ajuste aberto, o quadro vira enquadramento: arrastar desloca a foto */
  .eq-img.enq { cursor: grab; touch-action: none; box-shadow: inset 0 0 0 2px var(--accent); }
  .eq-img.enq.puxando { cursor: grabbing; }
  .eq-img.enq .eq-img-zoom { pointer-events: none; }
  .eq-enq-dica { display: none; position: absolute; left: 50%; top: .35rem; transform: translateX(-50%); z-index: 2;
    background: color-mix(in srgb, var(--bg) 85%, transparent); border-radius: 999px; padding: .1rem .5rem;
    font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .05em; color: var(--accent-texto); }
  .eq-img.enq.desloca .eq-enq-dica { display: block; }
  /* com imagem, o quadro inteiro amplia; trocar e tirar ficam nos cantos */
  .eq-img-zoom { position: absolute; inset: 0; background: none; border: none; cursor: zoom-in; }
  .eq-img-troca, .eq-img-rm { position: absolute; bottom: .3rem; z-index: 2; display: grid; place-items: center;
    min-width: 32px; min-height: 32px; background: color-mix(in srgb, var(--bg) 80%, transparent);
    border: none; border-radius: var(--r-sm); cursor: pointer; font-size: var(--fs-rotulo); line-height: 1; }
  .eq-img-troca { right: 2.4rem; color: var(--accent-texto); }
  .eq-img-rm { right: .3rem; color: var(--perigo); }
  /* Na arte do sistema não há o que tirar (ela é o padrão da peça), então o ✎
     fica sozinho e ocupa o canto que seria do ×. O ✎ só aparece no hover para
     não sujar a gravura. */
  .eq-img.arte .eq-img-troca { right: .3rem; opacity: 0; transition: opacity .12s; }
  .eq-img.arte:hover .eq-img-troca, .eq-img.arte:focus-within .eq-img-troca { opacity: 1; }
  .eq-img-troca:hover { background: var(--accent); color: var(--on-accent); }
  .eq-img-rm:hover { background: var(--perigo-bg); color: var(--on-perigo); }

  /* armaduras: painel de absorção ao lado das peças */
  .eq-arm-grid { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: .8rem; align-items: start; }
  @media (max-width: 760px) { .eq-arm-grid { grid-template-columns: minmax(0, 1fr); } }
  .eq-abs { border: 1px solid var(--accent-soft); border-radius: var(--r-lg); background: var(--panel); padding: .6rem .7rem; }
  .eq-abs h4 { margin: 0 0 .5rem; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .08em; color: var(--accent-texto); }
  .abs-t { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .3rem;
    background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .3rem .45rem; }
  .abs-l { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; color: var(--ink-soft); }
  .abs-l i { display: block; font-style: normal; font-size: var(--fs-micro); opacity: .7; letter-spacing: 0; text-transform: none; }
  .abs-v { font-family: 'EB Garamond'; font-size: var(--fs-h3); font-weight: 700; color: var(--accent-texto); font-variant-numeric: tabular-nums; }
  .abs-t.pen { border-color: color-mix(in srgb, var(--perigo) 45%, transparent); }
  .abs-t.pen .abs-v { color: var(--perigo); }
  .abs-nota { margin: .4rem 0 0; font-size: var(--fs-micro); }

  /* painel de ajuste dos números (compartilhado por arsenal e armaduras) */
  .eq-flag { display: none; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; color: var(--accent-strong); border: 1px solid var(--accent-soft); border-radius: 999px; padding: 0 .35rem; white-space: nowrap; }
  .eq-peca.ajustado .eq-flag { display: inline-block; }
  .eq-peca .eq-mod { margin: 0 .6rem .6rem; }
  .eq-ed { background: none; border: none; color: var(--accent-strong); cursor: pointer; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; line-height: 1; padding: .15rem; text-align: left; }
  .eq-ed:hover { color: var(--accent-texto); }
  .eq-mod[hidden] { display: none; }   /* o display abaixo venceria o atributo hidden */
  .eq-mod { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .4rem; margin: .3rem 0 .15rem; padding: .35rem .45rem; border: 1px dashed var(--panel-border); border-radius: var(--r-sm); background: color-mix(in srgb, var(--accent) 6%, transparent); }
  .eqm-c { display: flex; flex-direction: column; gap: .1rem; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .03em; color: var(--ink-soft); }
  .eqm-c input { width: 3.6rem; font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink); background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .15rem .3rem; }
  .eqm-c.dif span { color: var(--accent-strong); }
  .eqm-c.dif input { border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 20%, transparent); }
  .eqm-reset { margin-left: auto; background: none; border: 1px solid var(--panel-border); border-radius: var(--r-sm); color: var(--ink-soft); font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; padding: .22rem .5rem; cursor: pointer; }
  .eqm-reset:hover { border-color: var(--accent); color: var(--accent-strong); }
  /* Nome e enquadramento ocupam a linha inteira do painel: são de outra natureza
     que os campos numéricos, que vivem lado a lado. */
  .eqm-nome, .eqm-enq { flex: 1 0 100%; }
  .eqm-nome input { width: 100%; }
  .eqm-enq { display: flex; flex-direction: column; gap: .15rem; }
  .eqm-enq-rot { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .03em; color: var(--ink-soft); }
  /* o "reenquadrar" desce sozinho quando não cabe ao lado da barra */
  .eqm-enq-linha { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .4rem; min-width: 0; }
  .eqm-enq-linha input[type=range] { flex: 1; min-width: 3rem; accent-color: var(--accent); }
  .eqm-enq-v { font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--accent-texto); font-variant-numeric: tabular-nums; min-width: 3ch; }
  .eqm-enq-vazio { cursor: pointer; }
  .eqm-enq-bt { border: 1px dashed var(--panel-border); border-radius: var(--r-sm); padding: .2rem .5rem; color: var(--accent-strong); }
  .eqm-enq-vazio:hover .eqm-enq-bt { border-color: var(--accent); }
  .equip-bolsas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem .9rem; margin: 0 0 .8rem; }
  /* Mesma história dos atributos, com outros números: uma bolsa mede 173px de
     min-content (a tabela tem Peso, Preço e o botão de remover em largura fixa),
     e três delas não cabiam nos 499px de grade que sobram em 901px de tela. A
     tabela saía 40px por fora da moldura. */
  @media (min-width: 901px) and (max-width: 1000px) { .equip-bolsas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .equip-bolsas { grid-template-columns: minmax(0, 1fr); } }
  .bolsa { display: flex; flex-direction: column; gap: .25rem; }
  .bolsa-nome { font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .03em; color: var(--accent-strong); background: transparent; border: none; border-bottom: 1px solid var(--rule); padding: .1rem .1rem .2rem; text-transform: uppercase; }
  .bolsa-nome:focus { outline: none; border-bottom-color: var(--accent); }
  /* cada bolsa é uma tabela Item / Peso / Preço */
  .bolsa-tbl { width: 100%; border-collapse: collapse; table-layout: fixed; }
  /* o thead herda o fundo --accent-strong da regra global de tabelas; com --ink-soft por
     cima dava 1,07:1 no Legível e 1,5:1 no Clássico. O par certo desse fundo é o
     --on-accent-strong, o mesmo que a auditoria já usou em .fa-tbl. */
  .bolsa-tbl th { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em;
    color: var(--on-accent-strong); font-weight: 600; text-align: left; padding: .18rem .35rem; }
  .bolsa-tbl th:nth-child(2), .bolsa-tbl th:nth-child(3) { width: 4.2rem; }
  .bolsa-tbl th:nth-child(4) { width: 1.7rem; }
  .bolsa-tbl td { padding: .1rem .1rem 0 0; }
  .bolsa-tbl td:last-child { padding-right: 0; }
  .bolsa-tbl input { width: 100%; min-width: 0; font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink);
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .22rem .35rem; }
  .bolsa-tbl input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent); }
  .bolsa-tbl td:nth-child(2) input, .bolsa-tbl td:nth-child(3) input { text-align: right; font-variant-numeric: tabular-nums; }
  .bl-x button { width: 100%; background: none; border: none; color: var(--ink-soft); cursor: pointer;
    font-size: var(--fs-rotulo); line-height: 1; padding: .2rem 0; border-radius: var(--r-sm); }
  .bl-x button:hover { color: var(--on-perigo); background: var(--perigo-bg); }
  .bolsa-add { align-self: flex-start; margin-top: .3rem; background: none; border: 1px dashed var(--panel-border);
    border-radius: var(--r-sm); color: var(--accent-texto); cursor: pointer; font-family: 'Cinzel';
    font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; padding: .25rem .6rem; }
  .bolsa-add:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .conjunto { border: 1px solid var(--panel-border); border-radius: var(--r-md); padding: .5rem .6rem; margin-bottom: .5rem; background: var(--panel); }
  .conjunto.ativo { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
  .conj-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: .35rem; }
  .conj-uso { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); display: inline-flex; align-items: center; gap: .3rem; text-transform: uppercase; letter-spacing: .03em; }
  .conj-rm { background: none; border: none; color: #b3401f; cursor: pointer; font-size: var(--fs-aux); line-height: 1; }
  .conj-hands { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  @media (max-width: 560px) { .conj-hands { grid-template-columns: 1fr; } }
  .conj-mao { display: flex; flex-direction: column; gap: .35rem; min-width: 0;
    background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-md); padding: .45rem .5rem; }
  .conj-mao-rot { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); text-transform: uppercase; letter-spacing: .06em; }
  .conj-peca { display: flex; gap: .5rem; min-width: 0; }
  .conj-peca .eq-img { flex: none; width: 4.5rem; height: 5.5rem; border: 1px solid var(--panel-border); border-radius: var(--r-sm); }
  .conj-peca-corpo { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .3rem; }
  .conj-vazia { font-family: 'EB Garamond'; font-size: var(--fs-rotulo); font-style: italic; color: var(--ink-soft); padding: 1.1rem .2rem; text-align: center; }
  .conj-esc select { width: 100%; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .conj-stats { margin-top: .45rem; font-size: var(--fs-rotulo); color: var(--ink); }
  .conj-stats b { color: var(--accent-strong); font-family: 'Cinzel'; font-size: var(--fs-micro); }
  .conj-req { color: #b3401f; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .03em; }
  .conj-dupla { margin-top: .3rem; padding-top: .3rem; border-top: 1px dashed var(--panel-border); font-size: var(--fs-rotulo); color: var(--ink); }
  .conj-dupla b { color: var(--accent-strong); font-family: 'Cinzel'; font-size: var(--fs-micro); margin-right: .2rem; }
  .conj-improv { display: flex; gap: .5rem; margin-top: .3rem; flex-wrap: wrap; }
  .conj-improv label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); text-transform: uppercase; letter-spacing: .03em; gap: .15rem; }
  .conj-improv select, .conj-improv input { font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink); background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .2rem .35rem; width: 4.2rem; }
  .conj-improv-nota { display: block; margin-top: .25rem; font-size: var(--fs-micro); font-style: italic; }
  /* Item personalizado no card do arsenal: só o nome e o recado. Os números saem
     pelo "ajustar", como em qualquer outra peça. */
  .eq-improv-nota { display: block; font-size: var(--fs-micro); font-style: italic; }

  /* ---- reordenar peças: arrasta o card inteiro ----
     Pega em qualquer ponto do card; nos controles o toque continua sendo deles.
     Não há mais alça: o card é focável, e com ele em foco as setas movem uma casa. */
  .eq-peca { cursor: grab; }
  .eq-peca input, .eq-peca select, .eq-peca textarea { cursor: auto; }
  .eq-peca:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* durante o arrasto o cursor é o mesmo em toda a página, e o texto não é pintado */
  body.eq-arrastando { user-select: none; -webkit-user-select: none; cursor: grabbing; }
  body.eq-arrastando .eq-peca, body.eq-arrastando .eq-peca * { cursor: grabbing; }
  /* a vaga que o card deixou: é ela que anda na grade e mostra onde a peça vai cair.
     Sem transform aqui, que é o que anima a troca dos vizinhos (FLIP no engine). */
  .eq-peca.arrastando { opacity: .28; outline: 2px dashed var(--accent); outline-offset: -2px; }
  /* o clone que voa sob o ponteiro */
  .eq-fantasma { position: fixed; left: 0; top: 0; z-index: 70; pointer-events: none;
    transform-origin: top left; will-change: transform; border-color: var(--accent);
    box-shadow: 0 14px 34px var(--shadow); }
  /* o dedo arrasta o card; sem isto o navegador rola a página no lugar */
  .eq-pecas { touch-action: pan-y; }

  /* ---- catálogo de "adicionar item" (diálogo, lib/ui-dialog.ts) ----
     O card aqui é o da ficha sem os controles: mesma arte, mesmos blocos de
     número, mais as notas do catálogo. Vive no global porque o <dialog> nasce
     preso ao <body>, fora da árvore deste componente. */
  .ui-dlg.eq-catalogo { width: min(64rem, 94vw); }
  .ui-dlg.eq-catalogo .ui-dlg-ops { display: grid; gap: .6rem; max-height: min(62vh, 34rem);
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); }
  .ui-dlg.eq-catalogo .ui-dlg-grupo { grid-column: 1 / -1; }
  /* as peças fora do catálogo ficam numa linha só, dividindo a largura em partes
     iguais: soltas na grade elas cairiam em células estreitas, do tamanho de um
     item qualquer, e são a escolha que abre o caminho de fazer o seu */
  .ui-dlg.eq-catalogo .ui-dlg-soltas { grid-column: 1 / -1; display: grid; gap: .6rem;
    grid-template-columns: 1fr 1fr; }
  /* no celular a metade não cabe: aí elas se empilham */
  @media (max-width: 520px) { .ui-dlg.eq-catalogo .ui-dlg-soltas { grid-template-columns: 1fr; } }
  .ui-dlg.eq-catalogo .ui-dlg-nada { grid-column: 1 / -1; }
  .ui-dlg.eq-catalogo .ui-dlg-op { display: flex; flex-direction: column; gap: .4rem; align-items: stretch;
    padding: .5rem; height: 100%; text-align: left; background: var(--panel); }
  /* o `display` acima vence o [hidden] { display: none } do navegador, e sem esta
     linha o filtro marcava as peças como escondidas mas elas seguiam na tela */
  .ui-dlg.eq-catalogo .ui-dlg-op[hidden] { display: none; }
  .ui-dlg.eq-catalogo .ui-dlg-op:hover, .ui-dlg.eq-catalogo .ui-dlg-op:focus-visible {
    background: var(--bg-soft); border-color: var(--accent); }
  /* a arte do catálogo é a mesma do card, num quadro menor */
  .eqp-arte.eq-img { height: 7rem; border-bottom: 0; background: none; cursor: inherit; border-radius: var(--r-sm); }
  .eqp-arte.eq-img.arma { --arte-w: 56px; }
  .eqp-arte.eq-img.escudo { --arte-w: 112px; }
  .eqp-arte.eq-img.armadura { --arte-w: 75px; }
  .eqp-sem-arte { background: var(--bg-soft); border: 1px dashed var(--panel-border); }
  .eqp-corpo { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
  .eqp-corpo .eq-nums { margin: 0; }
  /* o card é um <button>, que herda Cinzel em versalete: nome e nota são texto
     de leitura e voltam para a fonte do corpo */
  .ui-dlg.eq-catalogo .eq-peca-nome, .eqp-nota { font-family: 'EB Garamond', Georgia, serif;
    text-transform: none; font-variant: normal; letter-spacing: normal; }
  /* a nota do catálogo é longa; três linhas bastam para escolher */
  .eqp-nota { font-size: var(--fs-micro); color: var(--ink-soft); line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  /* as peças fora do catálogo ficam deitadas, com a arte ao lado do texto: são
     escolhas de outra natureza, e a linha só delas não deixa vão na grade */
  .ui-dlg.eq-catalogo .ui-dlg-soltas .ui-dlg-op { flex-direction: row; align-items: center; gap: .8rem; }
  .ui-dlg.eq-catalogo .ui-dlg-soltas .eqp-arte { width: 7rem; flex: none; height: 5rem; }
  .ui-dlg.eq-catalogo .ui-dlg-soltas .eqp-nota { -webkit-line-clamp: 2; }
  #add-conjunto { margin-bottom: .8rem; }
  .calcpop { position: absolute; z-index: 60; max-width: 280px; background: var(--panel); color: var(--ink); border: 1px solid var(--accent); border-radius: var(--r-md); padding: .45rem .6rem; box-shadow: 0 4px 14px var(--shadow); font-size: var(--fs-rotulo); line-height: 1.4; font-family: 'EB Garamond'; }
  .derv .dv[data-calc] { cursor: help; border-bottom: 1px dotted var(--accent-soft); }
  #combate .cmb { padding: .15rem 0; font-size: var(--fs-aux); } #combate .cmb b { color: var(--accent-strong); }

  /* ---------- celular: abas + vitais + barra inferior ----------
     No desktop nada disto existe: .ftab vira display:contents (caixa transparente) e
     .fdeck/.fx-bar somem. A classe body.ficha-abas é posta pelo script só no celular. */
  .ftab { display: contents; }
  .fdeck, .fx-bar { display: none; }
  @media (max-width: 900px) {
    /* Sem margem negativa: ela nasceu para o deck sangrar até a borda do
       main.content, e hoje a ficha mora dentro da moldura ornamentada. Os -1rem
       passavam 9px por fora dela dos dois lados, e o fundo do deck apagava o
       filete dourado bem no canto onde a filigrana começa. Colada ao conteúdo
       ela cobre tudo o que passa por baixo: nada mais sangra aqui dentro. */
    body.ficha-abas .fdeck { display: block; position: sticky; top: 3.55rem; z-index: 25;
      background: var(--bg); border-bottom: 1px solid var(--rule); margin: 0; padding: .15rem 0 0; }
    #fvitais { display: flex; gap: .9rem; padding: .25rem .1rem; font-family: 'Cinzel';
      font-size: var(--fs-micro); color: var(--ink-soft); overflow-x: auto; white-space: nowrap; }
    #fvitais b { color: var(--accent-texto); margin-right: .25rem; }
    /* Barra de abas: uma linha só, que rola, com um marcador que anda.
       Os rótulos ficam parados e quietos; o que muda de lugar é a fita, que desliza da
       aba antiga até a nova mudando de largura no caminho. É o movimento que diz para
       onde você foi, e por isso é a única coisa animada aqui.
       Como a fila não cabe em 360px, duas coisas cuidam do que a rolagem esconde: a
       aba escolhida se traz para o meio da trilha, e a ponta desbota do lado em que
       ainda há aba, que é o que avisa que dá para arrastar. */
    .ftab-bar { display: flex; gap: .25rem; position: relative; padding: .35rem .1rem .5rem;
      overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
      -ms-overflow-style: none; overscroll-behavior-x: contain; }
    .ftab-bar::-webkit-scrollbar { display: none; }
    .ftab-bar.mais-esq { -webkit-mask-image: linear-gradient(90deg, transparent, #000 2rem);
      mask-image: linear-gradient(90deg, transparent, #000 2rem); }
    .ftab-bar.mais-dir { -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 2rem), transparent); }
    .ftab-bar.mais-esq.mais-dir {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 2rem, #000 calc(100% - 2rem), transparent); }
    /* a fita: vive atrás dos rótulos e é posicionada pelo script */
    .ftab-fita { position: absolute; left: 0; top: 0; z-index: 0; border-radius: var(--r-sm);
      background: var(--accent); box-shadow: 0 2px 0 0 var(--gold);
      transition: transform .26s cubic-bezier(.34, 1.1, .5, 1), width .26s cubic-bezier(.34, 1.1, .5, 1),
                  height .26s cubic-bezier(.34, 1.1, .5, 1); pointer-events: none; }
    .ftab-fita[hidden] { display: none; }
    .ftab-bar button { position: relative; z-index: 1; flex: 0 0 auto; scroll-snap-align: center;
      min-height: 36px; background: none; border: 0; border-radius: var(--r-sm);
      color: var(--ink-soft); font-family: 'Cinzel'; font-size: var(--fs-micro);
      letter-spacing: .05em; padding: .3rem .7rem; cursor: pointer; white-space: nowrap;
      transition: color .18s ease; }
    .ftab-bar button:hover { color: var(--accent-texto); }
    .ftab-bar button[aria-selected='true'] { color: var(--on-accent); font-weight: 700; }

    /* Troca de painel: o novo entra pelo lado de onde veio. Avançar na fila traz o
       painel da direita; voltar, da esquerda. São 14px de deslocamento, menos que o
       respiro lateral do conteúdo (16px), então nada transborda durante o movimento. */
    @keyframes ftab-ent-dir { from { opacity: 0; transform: translateX(14px); } }
    @keyframes ftab-ent-esq { from { opacity: 0; transform: translateX(-14px); } }
    body.ficha-abas .ftab.on { animation: ftab-ent-dir .22s ease-out both; }
    body.ficha-abas.volta .ftab.on { animation-name: ftab-ent-esq; }

    @media (prefers-reduced-motion: reduce) {
      .ftab-fita, .ftab-bar button { transition: none; }
      body.ficha-abas .ftab.on { animation: none; }
    }

    body.ficha-abas .ftab { display: none; }
    body.ficha-abas .ftab.on { display: block; }

    /* As barras que abrem e fecham traziam a conta do custo em XP no <small>:
       "piso 0 · 4 + nível×2: 6/8/10/12/14/16 · especialidade 8 + nível×4…". Numa
       tela de 360px isso vira quatro linhas de fórmula antes da primeira perícia,
       e é consulta de quem está montando, não de quem está jogando. A conta
       continua no desktop e no texto das Regras. */
    body.ficha-abas h2.barh.barh-tog small { display: none; }
    /* e "Habilidades Secundárias" fica só "Secundárias": o rótulo repetido logo
       abaixo de "Habilidades" gastava a largura sem separar uma da outra */
    body.ficha-abas .so-desktop { display: none; }

    /* a barra de XP sai do fluxo e vira a folha de ações atrás do ⋯ */
    body.ficha-abas .xpbar { display: none; }
    /* grid e não flex: a barra é uma grade (números | botões, detalhamento embaixo), e
       um display: flex aqui desmontava a grade e punha as três partes lado a lado */
    body.ficha-abas.fx-aberto .xpbar { display: grid; position: fixed; left: .5rem; right: .5rem;
      bottom: 4.4rem; z-index: 65; box-shadow: 0 12px 40px var(--shadow); max-height: 70vh; overflow-y: auto; margin: 0; }

    body.ficha-abas .fx-bar { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      align-items: center; gap: .6rem; padding: .4rem .8rem calc(.4rem + env(safe-area-inset-bottom));
      background: var(--panel); border-top: 1px solid var(--rule); }
    #fx-xp { font-family: 'Cinzel'; font-size: var(--fs-rotulo); }
    #fx-xp.neg { color: var(--perigo); }
    #fx-salvar { margin-left: auto; }
    #fx-salvar[hidden] { display: none; }
    body.ficha-abas .fx-bar #fx-mais { margin-left: 0; min-width: 44px; }
    body.ficha-abas .fx-bar #fx-salvar[hidden] ~ #fx-mais { margin-left: auto; }
    body.ficha-abas .content { padding-bottom: 7.5rem; }
    /* o sumário flutuante vira redundância com as abas */
    body.ficha-abas #otp-fab, body.ficha-abas #otp-panel { display: none; }

    /* linhas de toque: 48px por linha, dado de 44px à direita */
    body.ficha-abas .trow { min-height: 48px; align-items: center; }
    body.ficha-abas .trow .rollv { min-width: 44px; min-height: 44px; }
    body.ficha-abas .trow .specbtn { min-width: 36px; min-height: 44px; }

    /* Listas em passo de 1,5rem: a linha tem 1,5rem de altura e nada entre uma e
       outra, então o passo é exatamente 1,5rem. São listas longas (10 atributos,
       24 perícias primárias, 27 secundárias, 6 de poder, 17 derivados) e a régua de
       48px fazia cada uma virar várias telas de rolagem.

       Os botões da direita perdem o piso de 44px junto, senão eles é que mandariam na
       altura e a linha não fecharia em 1,5rem. É uma troca consciente: o alvo de toque
       encolhe. Ver o que ficou medido no comentário de cada regra. */
    /* a entrelinha entra junto: com a do corpo (1,62) o nome sozinho mede 25,9px e
       seguraria a linha acima de 1,5rem, por mais que o min-height diga o contrário */
    body.ficha-abas :is(#attrs, #skills, #secondary, #power) .trow {
      min-height: 1.5rem; height: 1.5rem; line-height: 1.5rem; padding: 0; }
    body.ficha-abas :is(#attrs, #skills, #secondary) .hgrid { row-gap: 0; }
    body.ficha-abas :is(#attrs, #skills, #secondary, #power) .trow :is(.rollv, .specbtn) {
      min-width: 24px; min-height: 24px; }        /* mínimo de alvo da WCAG 2.5.8 */
    /* O ponto continua com 15px de círculo, mas o alvo de toque ocupa a altura inteira
       da linha por um pseudo-elemento. Só na vertical: na horizontal os pontos têm 3px
       entre si, e esticar o alvo faria o alvo de um invadir o do vizinho, que numa
       régua de pontos é pior do que um alvo pequeno (marca o número errado). */
    body.ficha-abas :is(#attrs, #skills, #secondary, #power) .dot { position: relative; }
    body.ficha-abas :is(#attrs, #skills, #secondary, #power) .dot::after {
      content: ''; position: absolute; left: 0; right: 0; top: -4.5px; bottom: -4.5px; }
    /* Derivados: mesma régua. O valor é o único texto grande da linha (--fs-corpo, 21px)
       e num passo de 24px ele encosta em cima e embaixo, então desce para o tamanho
       auxiliar; continua sendo o maior e o mais forte da linha, que é o que importa. */
    body.ficha-abas #derived .derv {
      height: 1.5rem; line-height: 1.5rem; padding: 0; align-items: center; }
    body.ficha-abas #derived .derv .dv { font-size: var(--fs-aux); }
    /* marcador de uso e botão de vestir: 34px é confortável no mouse, não no polegar */
    body.ficha-abas .eq-uso-op, body.ficha-abas .eq-vestir { min-height: 44px; }
    /* parâmetros do efeito em até 2 linhas em vez de truncados numa só */
    body.ficha-abas .ef-i-par { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    /* Identidade em coluna única e no mesmo passo do resto: o rótulo sai de cima do
       campo e vai para o lado, numa faixa fixa, o que alinha os quatro campos pela
       mesma vertical e derruba a altura de ~62px por campo para 24px. O rótulo é o
       texto solto dentro do <label>: numa grade ele vira item anônimo e ocupa a
       primeira coluna sozinho, sem precisar de <span>. */
    body.ficha-abas .idrow { grid-template-columns: 1fr; gap: .3rem; }
    /* 5,5rem e nowrap na faixa do rótulo: "Conceito" mede 75px em Cinzel versalete e
       numa faixa mais estreita quebrava em duas linhas, empurrando o campo para baixo
       e fazendo a linha invadir a de baixo. "Jogador", com 71px, passava raspando. */
    body.ficha-abas .idrow label {
      display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); align-items: center;
      gap: .5rem; height: 1.5rem; line-height: 1.5rem; white-space: nowrap; }
    /* o min-height vem junto: o global.css dá 44px a todo input/select no celular, e
       min-height ganha de height. Sem derrubá-lo o campo continuava em 44px e vazava
       para fora do rótulo de 24px. */
    body.ficha-abas .idrow :is(.txt, select.racasel) {
      min-height: 1.5rem; height: 1.5rem; margin-top: 0; padding: 0 .2rem; line-height: 1.5rem; }
  }

  /* impressão: só a ficha, sem o chrome do site. As abas do celular não valem no papel:
     a página impressa pode ter menos de 900px e esconderia as seções não-ativas. */
  @media print {
    .ftab { display: contents !important; }
    .fdeck, .fx-bar { display: none !important; }
    .sidebar, .topbar, .scrim, #consulta, #otp-fab, #otp-panel, .busca-modal, .ref-pop, .xp-btns, .rollv, .rolador, .skip { display: none !important; }
    .shell { display: block !important; } .content { padding: 0 !important; }
    .cam-body { display: block !important; }
    .xpbar { background: none !important; color: var(--ink) !important; border-bottom: 2px solid var(--accent); border-radius: 0; }
    .xpbar .big b, .xpbar .rem { color: var(--accent-texto) !important; }
    h2.barh { background: none !important; color: var(--accent-texto) !important; border-bottom: 1.5px solid var(--accent); border-radius: 0; }
    a[href]::after { content: ''; }
  }
</style>
