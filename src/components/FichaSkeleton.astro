---
// Esqueleto (markup + estilos) da ficha interativa, compartilhado por /ficha e /personagem.
// O comportamento vive em src/lib/ficha-engine.ts (montarFicha).
import RoladorDados from './RoladorDados.astro';
import FormasPop from './FormasPop.astro';
// Arte padrão das peças de equipamento: um atlas por categoria, cada peça
// recortando o seu quadro. Gerado por scripts/gen-arte-equip.mjs.
import '../styles/arte-equip.css';
---
<div class="xpbar" id="painel">
  <span class="big">XP: <b id="xpSpent">0</b></span>
  <label>Orçamento <input type="number" id="xpBudget" value="1500" /></label>
  <span class="big">Restam: <b id="xpRem" class="rem ok">1500</b></span>
  <span class="breakdown" id="xpBreak"></span>
  <span class="modo-wrap"><span class="modo-lbl">Modo</span>
    <span class="modo-toggle" role="group" aria-label="Modo da ficha">
      <button class="btn" data-modo="criacao" title="Aplica os limites de criação (Atrib 4 · Hab 3 · Centelha 2)">Criação</button>
      <button class="btn" data-modo="evolucao" title="Libera além dos limites de criação (em jogo)">Evolução</button>
    </span>
  </span>
  <span class="xp-btns">
    <button class="btn" id="f-export">Exportar</button>
    <button class="btn" id="f-import">Importar</button>
    <button class="btn" id="f-print">Imprimir</button>
    <button class="btn" id="f-link">Link</button>
    <button class="btn" id="f-reset">Resetar</button>
    <input type="file" id="f-file" accept="application/json,.json" hidden />
  </span>
</div>

{/* No celular a Ficha vira um painel de abas: os vitais ficam sempre à vista, uma seção
    por vez, ações na barra inferior. No desktop os invólucros .ftab têm display: contents
    e NADA muda. A ficha inteira media ~11.700px (14 telas) numa coluna só. */}
<div class="fdeck">
  <div id="fvitais" aria-label="Derivados vitais"></div>
  <nav class="ftab-bar" role="tablist" aria-label="Seções da ficha">
    <button type="button" role="tab" data-ftab="perfil" aria-selected="true">Perfil</button>
    <button type="button" role="tab" data-ftab="atrib" aria-selected="false">Atrib</button>
    <button type="button" role="tab" data-ftab="hab" aria-selected="false">Hab</button>
    <button type="button" role="tab" data-ftab="proezas" aria-selected="false">Proezas</button>
    <button type="button" role="tab" data-ftab="equip" aria-selected="false">Equip</button>
    <button type="button" role="tab" data-ftab="rolar" aria-selected="false">Rolar</button>
  </nav>
</div>

<div class="ftab" data-ftab="perfil">
<div class="idrow">
  <label>Nome<input class="txt" data-id="nome" placeholder="Seu herói" /></label>
  <label>Conceito<input class="txt" data-id="conceito" /></label>
  <label>Jogador<input class="txt" data-id="jogador" /></label>
  <label>Raça<select class="racasel" id="raca-sel"></select></label>
</div>
<div class="raca-info" id="raca-info"></div>
</div>

<div class="ftab" data-ftab="atrib">
<h2 class="barh">Atributos <small>(piso 1 · 5 + nível×5: 15/20/25/30/35)</small></h2>
<div class="cols3" id="attrs"></div>
</div>

<div class="ftab" data-ftab="perfil">
<div class="cols2">
  <div>
    <h2 class="barh">Centelha, Virtudes, Vontade &amp; Fôlego</h2>
    <div id="power"></div>
  </div>
  <div>
    <h2 class="barh">Derivados <small>(calculados)</small><button class="deriv-toggle" id="deriv-toggle" type="button">Expandir</button></h2>
    <div class="panel no-gloss" id="derived"></div>
  </div>
</div>
</div>

<div class="ftab" data-ftab="hab">
<h2 class="barh barh-tog" data-sec="skills"><span class="sec-caret">▾</span> Habilidades <small>(piso 0 · 4 + nível×2: 6/8/10/12/14/16 · especialidade 8 + nível×4: 12/16/20 · até [nível÷2] por perícia)</small></h2>
<div class="sec-body" id="sec-skills"><div class="hgrupos" id="skills"></div></div>

<h2 class="barh barh-tog" data-sec="secondary"><span class="sec-caret">▾</span> Habilidades Secundárias <small>(metade da primária: 3/4/5/6/7/8 · esp. 6/8/10 · até [nível÷2])</small></h2>
<div class="sec-body" id="sec-secondary"><div class="hgrupos" id="secondary"></div></div>
</div>

<div class="ftab" data-ftab="proezas">
<h2 class="barh barh-tog" data-sec="tecnicas"><span class="sec-caret">▾</span> Proezas &amp; Técnicas <small>(custo em XP)</small></h2>
<div class="sec-body" id="sec-tecnicas">
  <div class="cam-tools"><button class="btn" id="cam-all">Expandir todos</button></div>
  <div class="cols3" id="tecnicas"></div>
</div>

<h2 class="barh barh-tog" data-sec="artes"><span class="sec-caret">▾</span> Arcano — Artes <small>(nível×10 · exige Centelha &gt; 0)</small></h2>
<div class="sec-body" id="sec-artes"><div class="cols3" id="artes"></div>
      <div class="ef-esp" id="efeitos-esp"></div></div>
</div>

<div class="ftab" data-ftab="equip">
<h2 class="barh">Equipamento <small>(não custa XP · ajusta ataque, Defesa e Absorção)</small></h2>
<p class="equip-nota muted">Cada arma traz <strong>guardada · mão hábil · mão inábil</strong>, e é isso que o Acerto e o Dano leem. Empunhar na hábil desequipa a arma que estava lá; uma arma de <strong>duas mãos</strong> desequipa as duas. Uma arma <strong>versátil</strong> sozinha é segura com as duas mãos e soma a <strong>Força em dobro</strong>; com escudo ou outra arma na outra mão, soma simples. Nas armaduras, o botão <strong>Vestir</strong> é o que faz a peça contar, e várias podem estar vestidas ao mesmo tempo. O <strong>✎ ajustar</strong> abre os números para quando o item for melhor ou pior que o do catálogo, e o quadro de imagem aceita uma foto sua (é preciso estar logado).</p>
<div class="eq-bloco-tit">Armas do personagem <small>marque como cada uma está sendo empunhada</small></div>
{/* o seletor de "adicionar" fica FORA da grade: como as linhas são todas do mesmo
    tamanho (grid-auto-rows: 1fr), dentro dela ele virava uma linha vazia da altura de
    um card inteiro e empurrava o resto da página */}
<div id="eq-arsenal-add"></div>
<div id="eq-arsenal" class="eq-pecas"></div>

{/* Os conjuntos continuam sendo o lugar onde as mãos ficam guardadas (e o que o
    rastreador de combate da mesa lê), mas quem decide é o marcador de cada arma:
    o bloco está escondido, não removido, para poder voltar sem migração. */}
<div id="eq-conj-bloco" hidden>
  <div class="eq-bloco-tit">Conjuntos de armas <small>só um fica em uso por vez</small></div>
  <div id="eq-conjuntos"></div>
  <button class="btn" id="add-conjunto" type="button">+ conjunto de armas</button>
</div>

<div class="eq-bloco-tit">Armaduras <small>vestidas destacadas · empilháveis</small></div>
<div class="eq-arm-grid">
  <div class="eq-arm-lado">
    <div class="eq-abs" id="eq-absorcao"></div>
    <div id="eq-armaduras-add"></div>
  </div>
  <div class="eq-arm-col">
    <div id="eq-armaduras" class="eq-pecas"></div>
  </div>
</div>
<div class="equip-bolsas" id="eq-bolsas"></div>
<div class="panel" id="combate"></div>

<h2 class="barh">Força &amp; Arremesso <small>(levantamento e alcance de arremesso · não custa XP)</small></h2>
<div class="panel" id="forca-arremesso"></div>
</div>

<div class="ftab" data-ftab="rolar">
<h2 class="barh">Rolar</h2>
<RoladorDados compact />
</div>

<div class="fx-bar" data-pagefind-ignore>
  <span id="fx-xp"></span>
  <button class="btn primary" id="fx-salvar" type="button" hidden>Salvar</button>
  <button class="btn" id="fx-mais" type="button" aria-expanded="false" aria-label="Mais ações">⋯</button>
</div>

{/* Ampliação da arte de uma peça, no mesmo desenho do lightbox do bestiário. */}
<div class="eq-lb" id="eq-lightbox" hidden>
  <button class="eq-lb-fechar" type="button" aria-label="Fechar">✕</button>
  <figure><img id="eq-lb-img" src="" alt="" /><figcaption id="eq-lb-cap" class="cinzel"></figcaption></figure>
</div>

<FormasPop />

<script>
  // Abas da ficha no celular. No desktop este script só garante que tudo fica visível.
  // Ampliação da arte de armas e armaduras. Delegado no documento porque os cards são
  // reconstruídos pelo motor a cada mudança.
  {
    const lb = document.getElementById('eq-lightbox');
    const lbImg = document.getElementById('eq-lb-img') as HTMLImageElement | null;
    const lbCap = document.getElementById('eq-lb-cap');
    if (lb && lbImg && lbCap) {
      const fechar = () => { lb.hidden = true; lbImg.src = ''; document.body.style.overflow = ''; };
      document.addEventListener('click', (e) => {
        const z = (e.target as HTMLElement).closest<HTMLElement>('[data-eq-zoom]');
        if (z) {
          lbImg.src = z.dataset.eqZoom!;
          lbImg.alt = 'Imagem de ' + (z.dataset.eqZoomNome || 'item');
          lbCap.textContent = z.dataset.eqZoomNome || '';
          lb.hidden = false; document.body.style.overflow = 'hidden';
          return;
        }
        if (!lb.hidden && (e.target === lb || (e.target as HTMLElement).closest('.eq-lb-fechar'))) fechar();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) fechar(); });
    }
  }

  const bar = document.querySelector<HTMLElement>('.ftab-bar');
  if (bar) {
    const mq = matchMedia('(max-width: 900px)');
    const botoes = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-ftab]'));
    const paineis = Array.from(document.querySelectorAll<HTMLElement>('.ftab'));
    let ativa = 'perfil';
    const aplicar = () => {
      const mob = mq.matches;
      document.body.classList.toggle('ficha-abas', mob);
      if (!mob) document.body.classList.remove('fx-aberto');
      paineis.forEach((t) => t.classList.toggle('on', !mob || t.dataset.ftab === ativa));
      botoes.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.ftab === ativa)));
    };
    botoes.forEach((b) => b.addEventListener('click', () => { ativa = b.dataset.ftab!; aplicar(); }));
    mq.addEventListener('change', aplicar);
    aplicar();

    // vitais sempre à vista: espelham PV / Defesa / Energia / Mana do #derived,
    // que o engine re-renderiza inteiro a cada mudança (daí o MutationObserver)
    const vit = document.getElementById('fvitais');
    const derived = document.getElementById('derived');
    const updVitais = () => {
      if (!vit || !derived) return;
      const pega = (rx: RegExp) => {
        for (const d of derived.querySelectorAll('.derv')) {
          if (rx.test(d.querySelector('.dl')?.textContent || '')) return d.querySelector('.dv')?.textContent || '—';
        }
        return '—';
      };
      vit.innerHTML = [
        ['PV', pega(/pontos de vida/i)], ['Def', pega(/defesa \(esquiva\)/i)],
        ['En', pega(/^energia/i)], ['Mana', pega(/^mana/i)],
      ].map(([k, v]) => `<span><b>${k}</b>${v}</span>`).join('');
    };
    if (derived) { new MutationObserver(updVitais).observe(derived, { childList: true, subtree: true }); updVitais(); }

    // barra inferior: saldo de XP espelhado + Salvar (quando a página injeta o botão real) + ⋯
    const fxXp = document.getElementById('fx-xp');
    const xpRem = document.getElementById('xpRem');
    const updXp = () => {
      if (!fxXp || !xpRem) return;
      fxXp.textContent = `Restam ${xpRem.textContent} XP`;
      fxXp.classList.toggle('neg', xpRem.classList.contains('neg'));
    };
    if (xpRem) { new MutationObserver(updXp).observe(xpRem, { childList: true, characterData: true, subtree: true }); updXp(); }

    const fxSalvar = document.getElementById('fx-salvar') as HTMLButtonElement | null;
    const realSalvar = () => Array.from(document.querySelectorAll<HTMLButtonElement>('.xp-btns .btn'))
      .find((b) => /salvar/i.test(b.textContent || ''));
    const updSalvar = () => { if (fxSalvar) fxSalvar.hidden = !realSalvar(); };
    fxSalvar?.addEventListener('click', () => realSalvar()?.click());
    const xpBtns = document.querySelector('.xp-btns');
    if (xpBtns) { new MutationObserver(updSalvar).observe(xpBtns, { childList: true }); updSalvar(); }

    // ⋯ abre a barra de XP (orçamento, modo, exportar…) como folha sobre a barra inferior
    const fxMais = document.getElementById('fx-mais');
    fxMais?.addEventListener('click', (e) => {
      e.stopPropagation();
      const aberto = document.body.classList.toggle('fx-aberto');
      fxMais.setAttribute('aria-expanded', String(aberto));
    });
    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('fx-aberto')) return;
      const painel = document.getElementById('painel');
      if (painel && e.target instanceof Node && !painel.contains(e.target)) {
        document.body.classList.remove('fx-aberto');
        fxMais?.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<!-- is:global porque o conteúdo (bolinhas, cards, pílulas) é criado via JS e
     não recebe o atributo de escopo do Astro -->
<style is:global>
  .xpbar { display: flex; gap: 1rem 1.2rem; flex-wrap: wrap; align-items: center; background: var(--accent); color: var(--on-accent); padding: .6rem 1rem; border-radius: var(--r-md); margin: 1rem 0; }
  .xpbar .big { font-family: 'Cinzel'; font-size: var(--fs-aux); } .xpbar .big b { font-size: var(--fs-h3); }
  .xpbar .rem.neg { color: #ffd0cb; } .xpbar label { font-family: 'Cinzel'; font-size: var(--fs-micro); display: flex; align-items: center; gap: .4rem; }
  .xpbar input { width: 4.5rem; text-align: center; border: none; border-radius: var(--r-sm); padding: .25rem; font-family: 'Cinzel'; }
  .xpbar input:disabled { opacity: .8; cursor: not-allowed; }
  .xpbar .breakdown { font-size: var(--fs-micro); opacity: .9; flex: 1 1 12rem; }
  /* flex-wrap é obrigatório: sem ele os 7 botões formam uma fila de 574px que estoura a
     viewport do celular e põe a Ficha inteira para rolar na horizontal. */
  .xpbar .xp-btns { display: flex; flex-wrap: wrap; gap: .4rem; margin-left: auto; min-width: 0; }
  @media (max-width: 900px) { .xpbar .xp-btns { margin-left: 0; width: 100%; } }
  .xpbar .btn { background: var(--accent-strong); color: var(--on-accent-strong); border-color: transparent; padding: .25rem .6rem; font-size: var(--fs-micro); }

  .idrow { display: grid; grid-template-columns: 2fr 2fr 1fr 1.4fr; gap: 1rem; margin-bottom: .4rem; }
  /* min-width: 0 — itens de grade não encolhem abaixo do tamanho intrínseco por padrão, e o
     <select> de Raça vazava a coluna nas telas estreitas. */
  .idrow > * { min-width: 0; }
  @media (max-width: 640px) { .idrow { grid-template-columns: 1fr 1fr; } }
  .idrow select.racasel { width: 100%; margin-top: .15rem; }
  .raca-info { font-size: var(--fs-micro); color: var(--ink-soft); margin: 0 0 .6rem; line-height: 1.4; }
  .raca-info b { color: var(--accent-strong); font-family: 'Cinzel'; font-weight: 600; }
  .raca-info .mods { font-family: 'Cinzel'; }
  .idrow label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .04em; color: var(--ink-soft); text-transform: uppercase; }
  .idrow .txt { font-family: 'EB Garamond'; font-size: var(--fs-aux); border: none; border-bottom: 1px solid var(--rule); background: transparent; padding: .2rem; color: var(--ink); }
  .idrow .txt:focus { outline: none; border-bottom-color: var(--accent); }

  /* h2.barh vem do global.css: definição única da barra de seção das páginas-ferramenta */
  h2.barh.barh-tog { cursor: pointer; user-select: none; }
  h2.barh.barh-tog .sec-caret { display: inline-block; width: 1em; font-size: .85em; }
  .sec-body.sec-hidden { display: none; }
  @media print { .sec-body.sec-hidden { display: block !important; } h2.barh.barh-tog .sec-caret { display: none; } }
  .ficha-x h3, #attrs h3, #skills h3, #secondary h3, #power h3 { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); letter-spacing: .04em; text-transform: uppercase; margin: .9rem 0 .35rem; border-bottom: 1px solid var(--rule); padding-bottom: .15rem; }

  .cols3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .3rem 1.6rem; }
  .cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: .3rem 1.6rem; align-items: start; }
  @media (max-width: 760px) { .cols3, .cols2 { grid-template-columns: 1fr; } }

  /* Habilidades: cada grupo pega a largura toda e se abre em três colunas próprias, em
     vez de os grupos disputarem três colunas fixas. O `grid-auto-flow: column` sobre um
     número fixo de linhas (--linhas, calculado no render) é o que faz a ordem alfabética
     DESCER cada coluna em vez de atravessar a linha.

     O grid-auto-columns é o que mantém as três do mesmo tamanho: sem ele as colunas são
     implícitas e ficam `auto`, isto é, cada uma cresce até o nome mais longo que calhou
     nela (Conhecimentos Gerais alargava a primeira, Prestidigitação a segunda), e a
     largura mudava de grupo para grupo, de 270 a 342px. */
  .hgrupo { break-inside: avoid; }
  .hgrid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(var(--l3, 1), auto);
    grid-auto-columns: minmax(0, 1fr); gap: .3rem 1.6rem; }
  /* Três degraus, porque a linha "nome + pontos + especialidade" tem largura mínima real:
     abaixo de ~290px por coluna ela dobra de altura e empurra a página. Entre 901 e
     1279px a Ficha já voltou ao modo desktop mas só tem ~590px de conteúdo, e ali três
     colunas geravam 134px de rolagem horizontal. Abaixo de 900px a Ficha vira painel de
     abas e a coluna única é a leitura certa. */
  @media (max-width: 1279px) { .hgrid { grid-template-rows: repeat(var(--l2, 1), auto); } }
  @media (max-width: 900px) { .hgrid { grid-auto-flow: row; grid-template-rows: none; } }

  .trow { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .12rem 0; }
  .trow .nm { font-size: var(--fs-aux); cursor: help; } .trow .nm:hover { text-decoration: underline dotted var(--accent-soft); }
  .trow .nm small { color: var(--ink-soft); font-size: var(--fs-micro); }
  .tr-r { display: flex; align-items: center; }
  .dots { display: inline-flex; gap: 3px; align-items: center; }
  .dot { width: 15px; height: 15px; border: 1.5px solid var(--accent); border-radius: 50%; cursor: pointer; background: transparent; transition: background .08s; flex: 0 0 auto; }
  .dot.on { background: var(--accent); } .dot.free { border-color: var(--gold); } .dot.on.free { background: var(--gold); }
  .dot:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent); }
  .dots:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--r-sm); }
  .cam-tools { margin: 0 0 .5rem; }
  .dot.cap { opacity: .25; cursor: not-allowed; border-style: dotted; } .dot.cap:hover { box-shadow: none; }
  .rollv { background: none; border: none; cursor: pointer; font-size: var(--fs-rotulo); opacity: .35; margin-left: .35rem; padding: 0; line-height: 1; }
  .rollv:hover { opacity: 1; }
  .modo-wrap { display: inline-flex; align-items: center; gap: .35rem; }
  .modo-lbl { font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .06em; text-transform: uppercase; opacity: .85; }
  .modo-toggle { display: inline-flex; gap: 0; border: 1px solid var(--on-accent); border-radius: var(--r-sm); overflow: hidden; }
  .modo-toggle .btn { border: none; border-radius: 0; }
  .modo-toggle .btn.primary { background: var(--on-accent); color: var(--accent-texto); }
  .specbtn { background: none; border: none; cursor: pointer; font-size: var(--fs-micro); opacity: .4; margin-left: .35rem; padding: 0; line-height: 1; color: var(--gold); }
  .specbtn:hover, .specbtn.has { opacity: 1; }
  .specpop-h small { font-family: 'EB Garamond'; font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
  .sq { width: 14px; height: 14px; border: 1.2px solid var(--ink-soft); cursor: pointer; background: transparent; flex: 0 0 auto; border-radius: var(--r-sm); }
  .sq.on { background: var(--gold); border-color: var(--gold); }
  .sq:not(.dis):hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--gold) 35%, transparent); }
  .sq.dis { opacity: .25; cursor: not-allowed; }
  .specpop { position: absolute; z-index: 60; width: 260px; background: var(--panel); border: 1px solid var(--accent); border-radius: var(--r-lg); box-shadow: 0 6px 20px var(--shadow); padding: .6rem .7rem; }
  .specpop-h { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .03em; color: var(--accent-strong); margin-bottom: .5rem; }
  .specpop-row { display: flex; align-items: center; gap: .4rem; margin-bottom: .35rem; }
  .specpop-row input { flex: 1; min-width: 0; font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink); background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .25rem .4rem; }
  .specpop-row input:focus { outline: none; border-color: var(--accent); }
  .specpop-row .specpop-sq { display: inline-flex; gap: 3px; flex: 0 0 auto; }
  .specpop-row .spec-x { border: none; background: none; color: var(--ink-soft); cursor: pointer; font-size: var(--fs-aux); line-height: 1; padding: 0 .1rem; }
  .specpop-row .spec-x:hover { color: #b3401f; }
  .spec-add { display: block; width: 100%; font-family: 'Cinzel'; font-size: var(--fs-micro); cursor: pointer; background: none; color: var(--accent-strong); border: 1px dashed var(--panel-border); border-radius: var(--r-md); padding: .25rem; margin: .1rem 0 .4rem; }
  .spec-add:hover { border-color: var(--accent); color: var(--accent-texto); }
  .specpop-f { text-align: right; margin-top: .2rem; }
  .specpop-f .btn { padding: .2rem .7rem; font-size: var(--fs-micro); }
  .apmod { margin-left: .5rem; font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-aux); color: var(--accent-texto); }

  #derived { border: 1px solid var(--panel-border); background: var(--panel); border-left: 4px solid var(--accent); padding: .6rem .8rem; border-radius: var(--r-sm); }
  .derv { display: flex; justify-content: space-between; align-items: baseline; padding: .2rem 0; border-bottom: 1px dotted var(--rule); }
  .derv .dl { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); text-transform: uppercase; }
  .derv .dv { font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-corpo); color: var(--accent-texto); }
  .derv .fm { display: block; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; font-family: 'EB Garamond'; font-weight: 400; text-transform: none; }
  h2.barh .deriv-toggle { float: right; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: none; letter-spacing: 0; padding: .12rem .55rem; background: var(--accent-strong); color: var(--on-accent-strong); border: none; border-radius: var(--r-sm); cursor: pointer; }
  h2.barh .deriv-toggle:hover { filter: brightness(1.1); }
  #derived.collapsed .derv-extra { display: none; }
  @media print { h2.barh .deriv-toggle { display: none !important; } #derived.collapsed .derv-extra { display: flex !important; } }

  /* Efeitos Especiais das Artes: lista abaixo das Artes, só o que o personagem alcança */
  .ef-esp { margin-top: .8rem; }
  .ef-esp-head { display: flex; align-items: baseline; gap: .6rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo);
    color: var(--accent-strong); border-bottom: 1px solid var(--rule); padding-bottom: .2rem; margin-bottom: .35rem; }
  .ef-esp-head .muted { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); font-style: italic; }
  /* min(x,100%): sem isso o minimo de 24rem (384px) estoura o conteiner de 328px do celular */
  .ef-esp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(var(--card-min-md), 100%), 1fr)); gap: .2rem .8rem; }
  /* um bloco por Arte: os Efeitos de Cura ficam juntos, os de Proteção juntos, etc. */
  .ef-grupo { margin: .55rem 0 .1rem; }
  .ef-g-head { display: flex; align-items: baseline; gap: .5rem; font-family: 'Cinzel'; font-size: var(--fs-micro);
    color: var(--accent-texto); border-bottom: 1px dotted var(--rule); padding-bottom: .12rem; margin-bottom: .2rem; }
  .ef-g-nm { text-transform: uppercase; letter-spacing: .05em; }
  .ef-g-nv { font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; }
  .ef-g-qtd { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); font-style: italic; }
  .ef-item { display: flex; align-items: center; gap: .4rem; padding: .2rem .3rem; border-radius: var(--r-sm);
    font-size: var(--fs-rotulo); cursor: pointer; }
  .ef-item:hover { background: var(--panel-2); }
  .ef-item.on { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .ef-i-nv { display: inline-grid; place-items: center; width: 1.15rem; height: 1.15rem; border-radius: 50%;
    background: var(--gold); color: var(--on-accent); font-family: 'Cinzel'; font-size: var(--fs-micro); flex: none; }
  .ef-i-nm { font-weight: 600; }
  .ef-i-ar { font-size: var(--fs-micro); }
  .ef-i-par { font-size: var(--fs-micro); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ef-i-xp { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); flex: none; }
  .ef-vazio { font-size: var(--fs-micro); padding: .4rem 0; }
  .cam { border: 1px solid var(--panel-border); border-radius: var(--r-sm); margin-bottom: .4rem; background: var(--panel); }
  .cam-head { padding: .4rem .7rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo); color: var(--accent-strong); display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .cam-nm { min-width: 0; }
  .cam-head[data-camtog] { cursor: pointer; } .cam-head[data-camtog]:hover { background: var(--panel-2); }
  .chev { cursor: pointer; } .chev:hover { color: var(--accent-texto); }
  .cam-meta { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; }
  .cam-body { padding: .4rem .7rem .6rem; border-top: 1px dotted var(--rule); }
  .tpill { display: inline-block; margin: .2rem .3rem 0 0; padding: .2rem .6rem; border: 1px solid var(--panel-border); border-radius: var(--r-lg); font-size: var(--fs-rotulo); cursor: pointer; background: var(--bg); }
  .tpill small { color: var(--ink-soft); font-size: var(--fs-micro); }
  .tpill.on { background: var(--accent); color: var(--on-accent); border-color: transparent; } .tpill.on small { color: var(--on-accent); opacity: .85; }
  .tpill:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent); }
  .tpill.locked { opacity: .5; cursor: not-allowed; border-style: dashed; }
  .tpill.invalid { border-color: #b3401f; box-shadow: 0 0 0 1px #b3401f inset; }
  .fxline { font-size: var(--fs-rotulo); padding: .08rem 0; color: var(--ink-soft); }
  .fxline.hi { color: var(--ink); } .fxline.hi b { color: var(--accent-strong); }
  .techrow { margin-bottom: .5rem; }
  .techrow .tpill { margin: 0; }
  .tdesc { font-size: var(--fs-micro); line-height: 1.35; color: var(--ink-soft); margin: .2rem 0 0 .15rem; }
  .tdesc strong { color: var(--accent-strong); font-weight: 600; }

  .equip-row { display: flex; gap: 1rem; flex-wrap: wrap; margin: .2rem 0 .8rem; }
  .equip-row label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); gap: .2rem; }
  .equip-row select { min-width: 10rem; }
  .equip-nota { font-size: var(--fs-rotulo); margin: .1rem 0 .5rem; }
  .equip-arm { margin: 0 0 .8rem; }
  .equip-lbl { display: block; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); margin-bottom: .35rem; }
  .equip-lbl small { font-weight: normal; }

  .fa-wrap { display: flex; flex-direction: column; gap: .6rem; }
  .fa-head { font-size: var(--fs-rotulo); line-height: 1.55; }
  .fa-head b { color: var(--accent-strong); font-family: 'Cinzel'; }
  .fa-tiers { display: flex; gap: .5rem 1.4rem; flex-wrap: wrap; margin: .25rem 0 .5rem; }
  .fa-tiers span { font-size: var(--fs-rotulo); } .fa-tiers span b { font-family: 'Cinzel'; color: var(--accent-strong); }
  .fa-row { display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: flex-start; }
  .fa-chartwrap { position: relative; flex: 1 1 22rem; width: 100%; max-width: 40rem; }
  .fa-chart { display: block; width: 100%; height: auto; }
  .fa-chart .axis { stroke: var(--rule); stroke-width: 1; }
  .fa-chart .grid { stroke: var(--rule); stroke-width: .5; opacity: .45; }
  .fa-chart .curve { fill: none; stroke: var(--accent); stroke-width: 2; }
  .fa-chart .area { fill: var(--accent); opacity: .1; }
  .fa-chart text { fill: var(--ink-soft); font-size: 10px; font-family: 'EB Garamond'; }
  .fa-chart .axlbl { font-family: 'Cinzel'; font-size: 9px; }
  .fa-chart .fa-vline { stroke: var(--accent-strong); stroke-width: 1; stroke-dasharray: 3 3; opacity: .7; }
  .fa-chart .fa-dot { fill: var(--accent-strong); stroke: var(--paper, #fff); stroke-width: 1.5; }
  .fa-chartwrap .fa-tip { position: absolute; transform: translate(-50%, -140%); pointer-events: none; white-space: nowrap; background: var(--accent-strong); color: #fff; font-family: 'Cinzel'; font-size: var(--fs-micro); padding: .12rem .4rem; border-radius: var(--r-sm); box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .fa-tbl { border-collapse: collapse; font-size: var(--fs-rotulo); }
  .fa-tbl th, .fa-tbl td { border: 1px solid var(--rule); padding: .15rem .55rem; text-align: center; }
  .fa-tbl th { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); font-weight: 700; }
  /* o thead herda o fundo --accent-strong da regra global; com --ink-soft dava 1,5:1 */
  .fa-tbl thead th { color: var(--on-accent-strong); }
  /* ---------- Equipamento em peças (arsenal e armaduras) ----------
     O personagem POSSUI peças e usa algumas: cada peça é um card com imagem própria,
     números e o botão que a coloca em uso (vestir, ou escolher na mão). */
  .eq-bloco-tit { display: flex; align-items: center; gap: .6rem; margin: 1.1rem 0 .5rem;
    font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .1em; color: var(--accent-texto); }
  .eq-bloco-tit small { font-family: 'EB Garamond'; text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
  .eq-bloco-tit::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--rule), transparent); }

  /* grid-auto-rows: 1fr + o stretch padrão = todos os cards do mesmo tamanho, e não cada
     um com a altura do próprio conteúdo (uma arma com etiquetas ficava maior que a sem). */
  .eq-pecas { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: .7rem; grid-auto-rows: 1fr; }
  .eq-peca { position: relative; display: flex; flex-direction: column; min-width: 0;
    border: 1px solid var(--panel-border); border-radius: var(--r-lg); background: var(--panel); overflow: hidden; }
  .eq-peca.em-uso, .eq-peca.vestida { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent-soft); }
  .eq-peca-corpo { display: flex; flex-direction: column; gap: .35rem; padding: .5rem .6rem .6rem; flex: 1; }
  /* nome e etiquetas na mesma linha; se não couberem, as etiquetas descem inteiras */
  .eq-peca-cab { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .2rem .4rem; }
  .eq-peca-nome { font-family: 'EB Garamond'; font-size: var(--fs-aux); font-weight: 600; color: var(--ink); min-width: 0; }
  .eq-uso-flag { margin-left: .35rem; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .04em; color: var(--accent-texto); border: 1px solid var(--accent-soft); border-radius: 999px; padding: 0 .35rem; }
  /* ajustar e descartar dividem a mesma linha, no rodapé do card */
  .eq-acoes { display: flex; align-items: center; justify-content: space-between; gap: .4rem; }
  .eq-rm { background: none; border: 1px solid transparent; border-radius: var(--r-sm); color: var(--perigo);
    cursor: pointer; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em;
    line-height: 1; padding: .2rem .45rem; white-space: nowrap; }
  .eq-rm:hover { background: var(--perigo-bg); border-color: var(--perigo-bg); color: var(--on-perigo); }
  .eq-vestir { margin-top: auto; background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm);
    color: var(--ink-soft); font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em;
    padding: .35rem; cursor: pointer; min-height: 34px; }
  .eq-vestir:hover { border-color: var(--accent); color: var(--accent-texto); }
  .eq-vestir.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 700; }
  .eq-nome-in { font-family: 'EB Garamond'; font-size: var(--fs-aux); color: var(--ink); background: var(--bg);
    border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .2rem .35rem; min-width: 0; }
  .eq-vazio { grid-column: 1 / -1; margin: 0; }
  .eq-add { margin-top: .7rem; }
  /* o seletor das armas vem ANTES da grade, então o respiro vai embaixo dele */
  #eq-arsenal-add .eq-add { margin: 0 0 .8rem; }
  .eq-arm-col, .eq-arm-lado { min-width: 0; }
  /* Adicionar peça é um botão que abre o catálogo em diálogo. Era um <select>, que
     reservava a largura da MAIOR opção ("Placa de transição: Imp 4 · Cor 8 · Perf 3
     (N2) · Pen −3") e empurrava a grade para fora da tela no celular. */
  .eq-add-btn { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .06em; padding: .5rem .9rem; }
  /* o mesmo teto continua valendo para os seletores de mão, que seguem sendo <select> */
  .conj-esc select { width: 100%; min-width: 0; max-width: 100%; }

  /* números da peça em blocos, no lugar da linha "5/+2/1d6/+1" */
  .eq-nums { display: flex; flex-wrap: wrap; gap: .25rem; }
  .eq-n { flex: 1 1 3.2rem; min-width: 0; text-align: center; background: var(--bg); border: 1px solid var(--panel-border);
    border-radius: var(--r-sm); padding: .2rem .1rem; font-family: 'EB Garamond'; font-size: var(--fs-rotulo);
    font-weight: 700; color: var(--accent-texto); font-variant-numeric: tabular-nums; }
  .eq-n b { display: block; font-family: 'Cinzel'; font-size: var(--fs-micro); font-weight: 600; text-transform: uppercase;
    letter-spacing: .04em; color: var(--ink-soft); }
  .eq-n i { font-style: normal; opacity: .65; font-size: var(--fs-micro); margin-left: .15rem; }
  .eq-n.def { color: var(--ink); }
  .eq-n.pen { color: var(--perigo); }
  /* marcador de uso: três opções por arma (guardada / mão hábil / mão inábil) */
  .eq-uso { display: flex; gap: .2rem; }
  .eq-uso-op { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: .25rem;
    background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .25rem .15rem;
    font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .02em;
    color: var(--ink-soft); cursor: pointer; text-align: center; line-height: 1.15; min-height: 34px; }
  .eq-uso-op:hover { border-color: var(--accent); color: var(--accent-texto); }
  .eq-uso-op input { position: absolute; opacity: 0; width: 0; height: 0; }
  .eq-uso-op.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); font-weight: 700; }
  /* arma de duas mãos não oferece a mão inábil */
  .eq-uso-op.off { opacity: .35; cursor: not-allowed; }
  .eq-uso-op.off:hover { border-color: var(--panel-border); color: var(--ink-soft); }
  /* ampliação da arte da peça (mesmo desenho do lightbox do bestiário) */
  .eq-lb { position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center;
    padding: 1.5rem; background: color-mix(in srgb, #10161a 84%, transparent); backdrop-filter: blur(3px); }
  .eq-lb[hidden] { display: none; }
  .eq-lb figure { margin: 0; width: min(680px, 92vw); max-height: 88vh; display: flex; flex-direction: column;
    align-items: center; gap: .6rem; }
  /* A moldura tem tamanho fixo e a imagem se ajusta dentro dela: `scale-down` encolhe o
     que for grande demais e deixa o que for pequeno no tamanho natural, centrado, com a
     moldura preenchendo o resto. Sem isso o modal encolhia até a imagem, e uma arte de
     60x80 abria numa caixinha de 79x99. */
  .eq-lb img { width: 100%; height: min(78vh, 40rem); object-fit: scale-down; border-radius: var(--r-lg);
    background: var(--panel); padding: .6rem; box-shadow: 0 18px 50px rgba(0,0,0,.5); }
  .eq-lb figcaption { color: #f3e8cf; font-size: var(--fs-h3); letter-spacing: .02em; }
  .eq-lb-fechar { position: absolute; top: 1rem; right: 1.2rem; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: none; background: rgba(255,255,255,.12); color: #fff; font-size: var(--fs-h3); cursor: pointer; }
  .eq-lb-fechar:hover { background: rgba(255,255,255,.25); }
  .eq-tags { display: flex; flex-wrap: wrap; gap: .25rem; }
  .eq-tag { font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--gold);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); border-radius: 999px; padding: 0 .4rem; }

  /* espaço da imagem: convite quando vazio, a própria arte quando preenchido */
  .eq-img { position: relative; display: grid; place-items: center; background: var(--bg-soft) center/cover no-repeat;
    border-bottom: 1px solid var(--panel-border); color: var(--ink-soft); cursor: pointer; overflow: hidden; }
  /* Um quadro só para todas as peças, e a imagem cabe inteira nele: a armadura
     tinha 30rem e fazia um card de altura diferente dos outros na mesma grade. */
  .eq-img.arma, .eq-img.escudo, .eq-img.armadura { height: 20rem; }
  span.eq-img, div.eq-img { cursor: default; }
  .eq-img:hover { color: var(--accent-texto); }
  .eq-img-ph { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .06em; text-align: center; }
  .eq-img-ph b { display: block; font-size: var(--fs-h3); font-weight: 600; }
  /* A foto do jogador é um <img> e não um fundo: assim o enquadramento é um
     transform (escala + deslocamento) e a própria foto serve de prévia viva
     enquanto se mexe na barra de zoom. Escala 1 = a foto INTEIRA na moldura,
     que é onde toda imagem nova começa. */
  /* A foto é posicionada, e não item da grade do quadro. O quadro é
     `place-items: center`, e nele a linha tem altura automática: um `height: 100%`
     ali vira circular (a linha mede o conteúdo, o conteúdo mede a linha) e o
     navegador cai na altura natural da imagem. Com uma foto alta a caixa do
     <img> passava de 320 para 776px, o `contain` não tinha o que fazer e o
     quadro cortava a diferença. Com `inset: 0` a caixa é a moldura, exata. */
  .eq-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    -webkit-user-drag: none; user-select: none;
    transform: scale(var(--z, 1)) translate(var(--tx, 0px), var(--ty, 0px)); }
  /* com o ajuste aberto, o quadro vira enquadramento: arrastar desloca a foto */
  .eq-img.enq { cursor: grab; touch-action: none; box-shadow: inset 0 0 0 2px var(--accent); }
  .eq-img.enq.puxando { cursor: grabbing; }
  .eq-img.enq .eq-img-zoom { pointer-events: none; }
  .eq-enq-dica { display: none; position: absolute; left: 50%; top: .35rem; transform: translateX(-50%); z-index: 2;
    background: color-mix(in srgb, var(--bg) 85%, transparent); border-radius: 999px; padding: .1rem .5rem;
    font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .05em; color: var(--accent-texto); }
  .eq-img.enq.desloca .eq-enq-dica { display: block; }
  /* com imagem, o quadro inteiro amplia; trocar e tirar ficam nos cantos */
  .eq-img-zoom { position: absolute; inset: 0; background: none; border: none; cursor: zoom-in; }
  .eq-img-troca, .eq-img-rm { position: absolute; bottom: .3rem; z-index: 2; display: grid; place-items: center;
    min-width: 32px; min-height: 32px; background: color-mix(in srgb, var(--bg) 80%, transparent);
    border: none; border-radius: var(--r-sm); cursor: pointer; font-size: var(--fs-rotulo); line-height: 1; }
  .eq-img-troca { right: 2.4rem; color: var(--accent-texto); }
  .eq-img-rm { right: .3rem; color: var(--perigo); }
  /* Na arte do sistema não há o que tirar (ela é o padrão da peça), então o ✎
     fica sozinho e ocupa o canto que seria do ×. O ✎ só aparece no hover para
     não sujar a gravura. */
  .eq-img.arte .eq-img-troca { right: .3rem; opacity: 0; transition: opacity .12s; }
  .eq-img.arte:hover .eq-img-troca, .eq-img.arte:focus-within .eq-img-troca { opacity: 1; }
  .eq-img-troca:hover { background: var(--accent); color: var(--on-accent); }
  .eq-img-rm:hover { background: var(--perigo-bg); color: var(--on-perigo); }

  /* armaduras: painel de absorção ao lado das peças */
  .eq-arm-grid { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: .8rem; align-items: start; }
  @media (max-width: 760px) { .eq-arm-grid { grid-template-columns: minmax(0, 1fr); } }
  .eq-abs { border: 1px solid var(--accent-soft); border-radius: var(--r-lg); background: var(--panel); padding: .6rem .7rem; }
  .eq-abs h4 { margin: 0 0 .5rem; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .08em; color: var(--accent-texto); }
  .abs-t { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .3rem;
    background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .3rem .45rem; }
  .abs-l { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; color: var(--ink-soft); }
  .abs-l i { display: block; font-style: normal; font-size: var(--fs-micro); opacity: .7; letter-spacing: 0; text-transform: none; }
  .abs-v { font-family: 'EB Garamond'; font-size: var(--fs-h3); font-weight: 700; color: var(--accent-texto); font-variant-numeric: tabular-nums; }
  .abs-t.pen { border-color: color-mix(in srgb, var(--perigo) 45%, transparent); }
  .abs-t.pen .abs-v { color: var(--perigo); }
  .abs-nota { margin: .4rem 0 0; font-size: var(--fs-micro); }

  /* painel de ajuste dos números (compartilhado por arsenal e armaduras) */
