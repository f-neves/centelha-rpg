---
// Esqueleto (markup + estilos) da ficha interativa, compartilhado por /ficha e /personagem.
// O comportamento vive em src/lib/ficha-engine.ts (montarFicha).
import RoladorDados from './RoladorDados.astro';
import FormasPop from './FormasPop.astro';
---
<div class="xpbar" id="painel">
  <span class="big">XP: <b id="xpSpent">0</b></span>
  <label>Orçamento <input type="number" id="xpBudget" value="1500" /></label>
  <span class="big">Restam: <b id="xpRem" class="rem ok">1500</b></span>
  <span class="breakdown" id="xpBreak"></span>
  <span class="modo-wrap"><span class="modo-lbl">Modo</span>
    <span class="modo-toggle" role="group" aria-label="Modo da ficha">
      <button class="btn" data-modo="criacao" title="Aplica os limites de criação (Atrib 4 · Hab 3 · Centelha 2)">Criação</button>
      <button class="btn" data-modo="evolucao" title="Libera além dos limites de criação (em jogo)">Evolução</button>
    </span>
  </span>
  <span class="xp-btns">
    <button class="btn" id="f-export">Exportar</button>
    <button class="btn" id="f-import">Importar</button>
    <button class="btn" id="f-print">Imprimir</button>
    <button class="btn" id="f-link">Link</button>
    <button class="btn" id="f-reset">Resetar</button>
    <input type="file" id="f-file" accept="application/json,.json" hidden />
  </span>
</div>

<div class="idrow">
  <label>Nome<input class="txt" data-id="nome" placeholder="Seu herói" /></label>
  <label>Conceito<input class="txt" data-id="conceito" /></label>
  <label>Jogador<input class="txt" data-id="jogador" /></label>
  <label>Raça<select class="racasel" id="raca-sel"></select></label>
</div>
<div class="raca-info" id="raca-info"></div>

<h2 class="barh">Atributos <small>(piso 1 · 5 + nível×5: 15/20/25/30/35)</small></h2>
<div class="cols3" id="attrs"></div>

<div class="cols2">
  <div>
    <h2 class="barh">Centelha, Virtudes, Vontade &amp; Fôlego</h2>
    <div id="power"></div>
  </div>
  <div>
    <h2 class="barh">Derivados <small>(calculados)</small><button class="deriv-toggle" id="deriv-toggle" type="button">Expandir</button></h2>
    <div class="panel no-gloss" id="derived"></div>
  </div>
</div>

<h2 class="barh barh-tog" data-sec="skills"><span class="sec-caret">▾</span> Habilidades <small>(piso 0 · 4 + nível×2: 6/8/10/12/14/16 · especialidade 8 + nível×4: 12/16/20 · até [nível÷2] por perícia)</small></h2>
<div class="sec-body" id="sec-skills"><div class="cols3" id="skills"></div></div>

<h2 class="barh barh-tog" data-sec="secondary"><span class="sec-caret">▾</span> Habilidades Secundárias <small>(metade da primária: 3/4/5/6/7/8 · esp. 6/8/10 · até [nível÷2])</small></h2>
<div class="sec-body" id="sec-secondary"><div class="cols3" id="secondary"></div></div>

<h2 class="barh barh-tog" data-sec="tecnicas"><span class="sec-caret">▾</span> Proezas &amp; Técnicas <small>(custo em XP)</small></h2>
<div class="sec-body" id="sec-tecnicas">
  <div class="cam-tools"><button class="btn" id="cam-all">Expandir todos</button></div>
  <div class="cols3" id="tecnicas"></div>
</div>

<h2 class="barh barh-tog" data-sec="artes"><span class="sec-caret">▾</span> Arcano — Artes <small>(nível×10 · exige Centelha &gt; 0)</small></h2>
<div class="sec-body" id="sec-artes"><div class="cols3" id="artes"></div>
      <div class="ef-esp" id="efeitos-esp"></div></div>

<h2 class="barh">Equipamento <small>(não custa XP · ajusta ataque, Defesa e Absorção)</small></h2>
<p class="equip-nota muted">Na lista de armas, os números são <strong>Velocidade / Acerto / Dano / Defesa</strong>. O <strong>✎</strong> ao lado da peça escolhida abre os valores para edição, para quando o item for de qualidade melhor ou pior que a do catálogo.</p>
<div id="eq-conjuntos"></div>
<button class="btn" id="add-conjunto" type="button">+ conjunto de armas</button>
<div class="equip-arm">
  <span class="equip-lbl">Armaduras <small>(Impacto · Corte · Perfuração (Nível) · Penalidade · empilháveis: vale a maior Absorção de cada modo, penalidades somam)</small></span>
  <div id="eq-armaduras" class="arm-checks"></div>
</div>
<div class="equip-bolsas" id="eq-bolsas"></div>
<div class="panel" id="combate"></div>

<h2 class="barh">Força &amp; Arremesso <small>(levantamento e alcance de arremesso · não custa XP)</small></h2>
<div class="panel" id="forca-arremesso"></div>

<h2 class="barh">Rolar</h2>
<RoladorDados compact />
<FormasPop />

<!-- is:global porque o conteúdo (bolinhas, cards, pílulas) é criado via JS e
     não recebe o atributo de escopo do Astro -->
<style is:global>
  .xpbar { display: flex; gap: 1rem 1.2rem; flex-wrap: wrap; align-items: center; background: var(--accent); color: var(--on-accent); padding: .6rem 1rem; border-radius: var(--r-md); margin: 1rem 0; }
  .xpbar .big { font-family: 'Cinzel'; font-size: var(--fs-aux); } .xpbar .big b { font-size: var(--fs-h3); }
  .xpbar .rem.neg { color: #ffd0cb; } .xpbar label { font-family: 'Cinzel'; font-size: var(--fs-micro); display: flex; align-items: center; gap: .4rem; }
  .xpbar input { width: 4.5rem; text-align: center; border: none; border-radius: var(--r-sm); padding: .25rem; font-family: 'Cinzel'; }
  .xpbar input:disabled { opacity: .8; cursor: not-allowed; }
  .xpbar .breakdown { font-size: var(--fs-micro); opacity: .9; flex: 1 1 12rem; }
  /* flex-wrap é obrigatório: sem ele os 7 botões formam uma fila de 574px que estoura a
     viewport do celular e põe a Ficha inteira para rolar na horizontal. */
  .xpbar .xp-btns { display: flex; flex-wrap: wrap; gap: .4rem; margin-left: auto; min-width: 0; }
  @media (max-width: 900px) { .xpbar .xp-btns { margin-left: 0; width: 100%; } }
  .xpbar .btn { background: var(--accent-strong); color: var(--on-accent-strong); border-color: transparent; padding: .25rem .6rem; font-size: var(--fs-micro); }

  .idrow { display: grid; grid-template-columns: 2fr 2fr 1fr 1.4fr; gap: 1rem; margin-bottom: .4rem; }
  /* min-width: 0 — itens de grade não encolhem abaixo do tamanho intrínseco por padrão, e o
     <select> de Raça vazava a coluna nas telas estreitas. */
  .idrow > * { min-width: 0; }
  @media (max-width: 640px) { .idrow { grid-template-columns: 1fr 1fr; } }
  .idrow select.racasel { width: 100%; margin-top: .15rem; }
  .raca-info { font-size: var(--fs-micro); color: var(--ink-soft); margin: 0 0 .6rem; line-height: 1.4; }
  .raca-info b { color: var(--accent-strong); font-family: 'Cinzel'; font-weight: 600; }
  .raca-info .mods { font-family: 'Cinzel'; }
  .idrow label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .04em; color: var(--ink-soft); text-transform: uppercase; }
  .idrow .txt { font-family: 'EB Garamond'; font-size: var(--fs-aux); border: none; border-bottom: 1px solid var(--rule); background: transparent; padding: .2rem; color: var(--ink); }
  .idrow .txt:focus { outline: none; border-bottom-color: var(--accent); }

  /* h2.barh vem do global.css: definição única da barra de seção das páginas-ferramenta */
  h2.barh.barh-tog { cursor: pointer; user-select: none; }
  h2.barh.barh-tog .sec-caret { display: inline-block; width: 1em; font-size: .85em; }
  .sec-body.sec-hidden { display: none; }
  @media print { .sec-body.sec-hidden { display: block !important; } h2.barh.barh-tog .sec-caret { display: none; } }
  .ficha-x h3, #attrs h3, #skills h3, #secondary h3, #power h3 { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); letter-spacing: .04em; text-transform: uppercase; margin: .9rem 0 .35rem; border-bottom: 1px solid var(--rule); padding-bottom: .15rem; }

  .cols3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .3rem 1.6rem; }
  .cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: .3rem 1.6rem; align-items: start; }
  @media (max-width: 760px) { .cols3, .cols2 { grid-template-columns: 1fr; } }

  .trow { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .12rem 0; }
  .trow .nm { font-size: var(--fs-aux); cursor: help; } .trow .nm:hover { text-decoration: underline dotted var(--accent-soft); }
  .trow .nm small { color: var(--ink-soft); font-size: var(--fs-micro); }
  .tr-r { display: flex; align-items: center; }
  .dots { display: inline-flex; gap: 3px; align-items: center; }
  .dot { width: 15px; height: 15px; border: 1.5px solid var(--accent); border-radius: 50%; cursor: pointer; background: transparent; transition: background .08s; flex: 0 0 auto; }
  .dot.on { background: var(--accent); } .dot.free { border-color: var(--gold); } .dot.on.free { background: var(--gold); }
  .dot:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 30%, transparent); }
  .dots:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--r-sm); }
  .cam-tools { margin: 0 0 .5rem; }
  .dot.cap { opacity: .25; cursor: not-allowed; border-style: dotted; } .dot.cap:hover { box-shadow: none; }
  .rollv { background: none; border: none; cursor: pointer; font-size: var(--fs-rotulo); opacity: .35; margin-left: .35rem; padding: 0; line-height: 1; }
  .rollv:hover { opacity: 1; }
  .modo-wrap { display: inline-flex; align-items: center; gap: .35rem; }
  .modo-lbl { font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .06em; text-transform: uppercase; opacity: .85; }
  .modo-toggle { display: inline-flex; gap: 0; border: 1px solid var(--on-accent); border-radius: var(--r-sm); overflow: hidden; }
  .modo-toggle .btn { border: none; border-radius: 0; }
  .modo-toggle .btn.primary { background: var(--on-accent); color: var(--accent-texto); }
  .specbtn { background: none; border: none; cursor: pointer; font-size: var(--fs-micro); opacity: .4; margin-left: .35rem; padding: 0; line-height: 1; color: var(--gold); }
  .specbtn:hover, .specbtn.has { opacity: 1; }
  .specpop-h small { font-family: 'EB Garamond'; font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--ink-soft); }
  .sq { width: 14px; height: 14px; border: 1.2px solid var(--ink-soft); cursor: pointer; background: transparent; flex: 0 0 auto; border-radius: var(--r-sm); }
  .sq.on { background: var(--gold); border-color: var(--gold); }
  .sq:not(.dis):hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--gold) 35%, transparent); }
  .sq.dis { opacity: .25; cursor: not-allowed; }
  .specpop { position: absolute; z-index: 60; width: 260px; background: var(--panel); border: 1px solid var(--accent); border-radius: var(--r-lg); box-shadow: 0 6px 20px var(--shadow); padding: .6rem .7rem; }
  .specpop-h { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .03em; color: var(--accent-strong); margin-bottom: .5rem; }
  .specpop-row { display: flex; align-items: center; gap: .4rem; margin-bottom: .35rem; }
  .specpop-row input { flex: 1; min-width: 0; font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink); background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-sm); padding: .25rem .4rem; }
  .specpop-row input:focus { outline: none; border-color: var(--accent); }
  .specpop-row .specpop-sq { display: inline-flex; gap: 3px; flex: 0 0 auto; }
  .specpop-row .spec-x { border: none; background: none; color: var(--ink-soft); cursor: pointer; font-size: var(--fs-aux); line-height: 1; padding: 0 .1rem; }
  .specpop-row .spec-x:hover { color: #b3401f; }
  .spec-add { display: block; width: 100%; font-family: 'Cinzel'; font-size: var(--fs-micro); cursor: pointer; background: none; color: var(--accent-strong); border: 1px dashed var(--panel-border); border-radius: var(--r-md); padding: .25rem; margin: .1rem 0 .4rem; }
  .spec-add:hover { border-color: var(--accent); color: var(--accent-texto); }
  .specpop-f { text-align: right; margin-top: .2rem; }
  .specpop-f .btn { padding: .2rem .7rem; font-size: var(--fs-micro); }
  .apmod { margin-left: .5rem; font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-aux); color: var(--accent-texto); }

  #derived { border: 1px solid var(--panel-border); background: var(--panel); border-left: 4px solid var(--accent); padding: .6rem .8rem; border-radius: var(--r-sm); }
  .derv { display: flex; justify-content: space-between; align-items: baseline; padding: .2rem 0; border-bottom: 1px dotted var(--rule); }
  .derv .dl { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-strong); text-transform: uppercase; }
  .derv .dv { font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-corpo); color: var(--accent-texto); }
  .derv .fm { display: block; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; font-family: 'EB Garamond'; font-weight: 400; text-transform: none; }
  h2.barh .deriv-toggle { float: right; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: none; letter-spacing: 0; padding: .12rem .55rem; background: var(--accent-strong); color: var(--on-accent-strong); border: none; border-radius: var(--r-sm); cursor: pointer; }
  h2.barh .deriv-toggle:hover { filter: brightness(1.1); }
  #derived.collapsed .derv-extra { display: none; }
  @media print { h2.barh .deriv-toggle { display: none !important; } #derived.collapsed .derv-extra { display: flex !important; } }

  /* Efeitos Especiais das Artes: lista abaixo das Artes, só o que o personagem alcança */
  .ef-esp { margin-top: .8rem; }
  .ef-esp-head { display: flex; align-items: baseline; gap: .6rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo);
    color: var(--accent-strong); border-bottom: 1px solid var(--rule); padding-bottom: .2rem; margin-bottom: .35rem; }
  .ef-esp-head .muted { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); font-style: italic; }
  /* min(x,100%): sem isso o minimo de 24rem (384px) estoura o conteiner de 328px do celular */
  .ef-esp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(var(--card-min-md), 100%), 1fr)); gap: .2rem .8rem; }
  /* um bloco por Arte: os Efeitos de Cura ficam juntos, os de Proteção juntos, etc. */
  .ef-grupo { margin: .55rem 0 .1rem; }
  .ef-g-head { display: flex; align-items: baseline; gap: .5rem; font-family: 'Cinzel'; font-size: var(--fs-micro);
    color: var(--accent-texto); border-bottom: 1px dotted var(--rule); padding-bottom: .12rem; margin-bottom: .2rem; }
  .ef-g-nm { text-transform: uppercase; letter-spacing: .05em; }
  .ef-g-nv { font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; }
  .ef-g-qtd { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); font-style: italic; }
  .ef-item { display: flex; align-items: center; gap: .4rem; padding: .2rem .3rem; border-radius: var(--r-sm);
    font-size: var(--fs-rotulo); cursor: pointer; }
  .ef-item:hover { background: var(--panel-2); }
  .ef-item.on { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .ef-i-nv { display: inline-grid; place-items: center; width: 1.15rem; height: 1.15rem; border-radius: 50%;
    background: var(--gold); color: var(--on-accent); font-family: 'Cinzel'; font-size: var(--fs-micro); flex: none; }
  .ef-i-nm { font-weight: 600; }
  .ef-i-ar { font-size: var(--fs-micro); }
  .ef-i-par { font-size: var(--fs-micro); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ef-i-xp { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); flex: none; }
  .ef-vazio { font-size: var(--fs-micro); padding: .4rem 0; }
  .cam { border: 1px solid var(--panel-border); border-radius: var(--r-sm); margin-bottom: .4rem; background: var(--panel); }
  .cam-head { padding: .4rem .7rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo); color: var(--accent-strong); display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .cam-nm { min-width: 0; }
  .cam-head[data-camtog] { cursor: pointer; } .cam-head[data-camtog]:hover { background: var(--panel-2); }
  .chev { cursor: pointer; } .chev:hover { color: var(--accent-texto); }
  .cam-meta { margin-left: auto; font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; }
  .cam-body { padding: .4rem .7rem .6rem; border-top: 1px dotted var(--rule); }
  .tpill { display: inline-block; margin: .2rem .3rem 0 0; padding: .2rem .6rem; border: 1px solid var(--panel-border); border-radius: var(--r-lg); font-size: var(--fs-rotulo); cursor: pointer; background: var(--bg); }
  .tpill small { color: var(--ink-soft); font-size: var(--fs-micro); }
  .tpill.on { background: var(--accent); color: var(--on-accent); border-color: transparent; } .tpill.on small { color: var(--on-accent); opacity: .85; }
  .tpill:hover { box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent); }
  .tpill.locked { opacity: .5; cursor: not-allowed; border-style: dashed; }
  .tpill.invalid { border-color: #b3401f; box-shadow: 0 0 0 1px #b3401f inset; }
  .fxline { font-size: var(--fs-rotulo); padding: .08rem 0; color: var(--ink-soft); }
  .fxline.hi { color: var(--ink); } .fxline.hi b { color: var(--accent-strong); }
  .techrow { margin-bottom: .5rem; }
  .techrow .tpill { margin: 0; }
  .tdesc { font-size: var(--fs-micro); line-height: 1.35; color: var(--ink-soft); margin: .2rem 0 0 .15rem; }
  .tdesc strong { color: var(--accent-strong); font-weight: 600; }

  .equip-row { display: flex; gap: 1rem; flex-wrap: wrap; margin: .2rem 0 .8rem; }
  .equip-row label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); gap: .2rem; }
  .equip-row select { min-width: 10rem; }
  .equip-nota { font-size: var(--fs-rotulo); margin: .1rem 0 .5rem; }
  .equip-arm { margin: 0 0 .8rem; }
  .equip-lbl { display: block; font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); margin-bottom: .35rem; }
  .equip-lbl small { font-weight: normal; }

  .fa-wrap { display: flex; flex-direction: column; gap: .6rem; }
  .fa-head { font-size: var(--fs-rotulo); line-height: 1.55; }
  .fa-head b { color: var(--accent-strong); font-family: 'Cinzel'; }
  .fa-tiers { display: flex; gap: .5rem 1.4rem; flex-wrap: wrap; margin: .25rem 0 .5rem; }
  .fa-tiers span { font-size: var(--fs-rotulo); } .fa-tiers span b { font-family: 'Cinzel'; color: var(--accent-strong); }
  .fa-row { display: flex; gap: 1.2rem; flex-wrap: wrap; align-items: flex-start; }
  .fa-chartwrap { position: relative; flex: 1 1 22rem; width: 100%; max-width: 40rem; }
  .fa-chart { display: block; width: 100%; height: auto; }
  .fa-chart .axis { stroke: var(--rule); stroke-width: 1; }
  .fa-chart .grid { stroke: var(--rule); stroke-width: .5; opacity: .45; }
  .fa-chart .curve { fill: none; stroke: var(--accent); stroke-width: 2; }
  .fa-chart .area { fill: var(--accent); opacity: .1; }
  .fa-chart text { fill: var(--ink-soft); font-size: 10px; font-family: 'EB Garamond'; }
  .fa-chart .axlbl { font-family: 'Cinzel'; font-size: 9px; }
  .fa-chart .fa-vline { stroke: var(--accent-strong); stroke-width: 1; stroke-dasharray: 3 3; opacity: .7; }
  .fa-chart .fa-dot { fill: var(--accent-strong); stroke: var(--paper, #fff); stroke-width: 1.5; }
  .fa-chartwrap .fa-tip { position: absolute; transform: translate(-50%, -140%); pointer-events: none; white-space: nowrap; background: var(--accent-strong); color: #fff; font-family: 'Cinzel'; font-size: var(--fs-micro); padding: .12rem .4rem; border-radius: var(--r-sm); box-shadow: 0 1px 4px rgba(0,0,0,.3); }
  .fa-tbl { border-collapse: collapse; font-size: var(--fs-rotulo); }
  .fa-tbl th, .fa-tbl td { border: 1px solid var(--rule); padding: .15rem .55rem; text-align: center; }
  .fa-tbl th { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); font-weight: 700; }
  /* o thead herda o fundo --accent-strong da regra global; com --ink-soft dava 1,5:1 */
  .fa-tbl thead th { color: var(--on-accent-strong); }
  .arm-checks { display: grid; gap: .1rem; }
  .arm-item { display: grid; grid-template-columns: 14rem 1fr auto auto; align-items: center; gap: .1rem 1.1rem; padding: .18rem .4rem; border-radius: var(--r-sm); }
  .arm-item:nth-of-type(odd) { background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .arm-item.vestida { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .arm-chk { display: inline-flex; align-items: center; gap: .3rem; font-family: 'EB Garamond'; font-size: var(--fs-aux); color: var(--ink); }
  .arm-item.vestida .arm-nm { font-weight: 700; }
  .arm-nums { font-family: 'EB Garamond'; font-size: var(--fs-rotulo); color: var(--ink-soft); justify-self: start; white-space: nowrap; }
  .arm-item .eq-mod { grid-column: 1 / -1; }
  @media (max-width: 560px) { .arm-item { grid-template-columns: 1fr auto; } .arm-nums { grid-column: 1 / -1; } }
  /* linha de números da peça escolhida (arma/escudo) + painel de ajuste */
