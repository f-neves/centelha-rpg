<script>
  // Fechar o modal de criatura: mesma tecla e mesmo clique em todas as abas.
  const modal = document.getElementById('card-modal');
  const fechar = () => { if (modal) { modal.hidden = true; document.body.style.overflow = ''; } };
  document.querySelectorAll('#card-modal [data-fechar]').forEach((el) => el.addEventListener('click', fechar));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal && !modal.hidden) fechar(); });

  // O menu do site volta por aqui, e só nesta visita: a preferência global de
  // barra lateral (localStorage) continua sendo do leitor, não da mesa.
  document.getElementById('mesa-menu')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('menu-mesa');
  });

  /**
   * Publica a altura real da barra em `--mesa-barra-h`. Quem gruda embaixo dela
   * (o painel do turno, os cabeçalhos de coluna) precisa desse número, e ele
   * muda: a descrição some abaixo de 1180px e as abas quebram no celular.
   */
  const barra = document.getElementById('mesa-barra');
  if (barra) {
    const medir = () => document.documentElement.style.setProperty(
      '--mesa-barra-h', Math.round(barra.getBoundingClientRect().height) + 'px');
    medir();
    new ResizeObserver(medir).observe(barra);
    addEventListener('resize', medir, { passive: true });
  }
</script>
