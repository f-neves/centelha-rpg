---
// Cartão de formas: passando o mouse (ou tabulando) por um rótulo de Área ou de
// Volume, abre um cartãozinho com os desenhos das formas em que aquele tanto de
// chão ou de espaço pode ser moldado. Marque o elemento com data-formas="area"
// ou data-formas="volume".
---

<div class="formas-fonte" hidden aria-hidden="true">
  <div id="formas-area" data-titulo="Área" data-nota="O mesmo tanto de chão, moldado de outro jeito. O quadrado da tabela é a medida; a forma é sua.">
    <figure><svg viewBox="0 0 64 52"><rect x="18" y="9" width="28" height="28" rx="1" /></svg><figcaption>Quadrado</figcaption></figure>
    <figure><svg viewBox="0 0 64 52"><rect x="6" y="14" width="52" height="18" rx="1" /></svg><figcaption>Retângulo</figcaption></figure>
    <figure><svg viewBox="0 0 64 52"><rect x="4" y="20" width="56" height="7" rx="1" /></svg><figcaption>Linha</figcaption></figure>
    <figure><svg viewBox="0 0 64 52"><circle cx="32" cy="23" r="14" /></svg><figcaption>Círculo</figcaption></figure>
    <figure><svg viewBox="0 0 64 52"><path d="M32 42 L15.9 19.1 A28 28 0 0 1 48.1 19.1 Z" /></svg><figcaption>Leque</figcaption></figure>
  </div>
  <div id="formas-volume" data-titulo="Volume" data-nota="O mesmo tanto de espaço, moldado de outro jeito. O cubo da tabela é a medida; a forma é sua.">
    <figure><svg viewBox="0 0 64 52">
      <polygon points="16,20 26,12 50,12 40,20" class="face-topo" />
      <polygon points="40,20 50,12 50,36 40,44" class="face-lado" />
      <rect x="16" y="20" width="24" height="24" />
    </svg><figcaption>Cubo</figcaption></figure>
    <figure><svg viewBox="0 0 64 52">
      <polygon points="8,26 18,18 52,18 42,26" class="face-topo" />
      <polygon points="42,26 52,18 52,34 42,42" class="face-lado" />
      <rect x="8" y="26" width="34" height="16" />
    </svg><figcaption>Paralelepípedo</figcaption></figure>
    <figure><svg viewBox="0 0 64 52">
      <circle cx="32" cy="26" r="16" />
      <ellipse cx="32" cy="26" rx="16" ry="5.5" class="linha-fina" />
    </svg><figcaption>Esfera</figcaption></figure>
    <figure><svg viewBox="0 0 64 52">
      <path d="M14 34 A18 18 0 0 1 50 34 Z" />
      <ellipse cx="32" cy="34" rx="18" ry="5" class="linha-fina" />
    </svg><figcaption>Semiesfera</figcaption></figure>
    <figure><svg viewBox="0 0 64 52">
      <path d="M18 16 V38 A14 5 0 0 0 46 38 V16" />
      <ellipse cx="32" cy="16" rx="14" ry="5" class="face-topo" />
    </svg><figcaption>Cilindro</figcaption></figure>
  </div>
</div>

<style is:global>
  .formas-fonte { display: none; }
  [data-formas] { cursor: help; text-decoration: underline dotted var(--accent); text-underline-offset: .18em; }
  .formas-pop {
    position: absolute; z-index: 90; max-width: min(35rem, 92vw); padding: .6rem .75rem;
    background: var(--panel); border: 1px solid var(--rule); border-radius: var(--r-md);
    box-shadow: 0 10px 28px rgba(0, 0, 0, .28); font-size: var(--fs-rotulo); line-height: 1.4;
    animation: formas-entra .12s ease-out;
  }
  @keyframes formas-entra { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: none; } }
  .formas-pop .formas-tit { font-family: 'Cinzel'; color: var(--accent-strong); font-size: var(--fs-rotulo);
    letter-spacing: .04em; text-transform: uppercase; display: block; margin-bottom: .15rem; }
  .formas-pop .formas-nota { display: block; color: var(--ink-soft); font-size: var(--fs-micro); margin-bottom: .5rem; }
  .formas-pop .formas-grade { display: flex; flex-wrap: wrap; gap: .5rem .7rem; }
  .formas-pop figure { margin: 0; width: 5.2rem; text-align: center; }
  .formas-pop figcaption { font-size: var(--fs-micro); color: var(--ink-soft); margin-top: .1rem; }
  .formas-pop svg { width: 100%; height: 3.2rem; display: block;
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
    stroke: var(--accent-strong); stroke-width: 1.6; stroke-linejoin: round; }
  .formas-pop svg .face-topo { fill: color-mix(in srgb, var(--accent) 30%, transparent); }
  .formas-pop svg .face-lado { fill: color-mix(in srgb, var(--accent) 24%, transparent); }
  .formas-pop svg .linha-fina { fill: none; stroke-width: 1.1; stroke-dasharray: 3 2.5; }
  @media print { .formas-pop { display: none !important; } }
</style>

<script>
  // Um único cartão por vez, posicionado abaixo do rótulo e preso ao documento,
  // do mesmo jeito que o hovercard das referências.
  let pop: HTMLDivElement | null = null;
  let alvo: HTMLElement | null = null;
  let timer = 0;
  const fechar = () => { pop?.remove(); pop = null; alvo = null; };
  const agendar = () => { clearTimeout(timer); timer = window.setTimeout(fechar, 200); };
  const cancelar = () => clearTimeout(timer);

  function abrir(el: HTMLElement) {
    const fonte = document.getElementById('formas-' + el.dataset.formas);
    if (!fonte || alvo === el) return;
    fechar();
    alvo = el;
    pop = document.createElement('div');
    pop.className = 'formas-pop';
    const t = document.createElement('span'); t.className = 'formas-tit'; t.textContent = fonte.dataset.titulo || '';
    const n = document.createElement('span'); n.className = 'formas-nota'; n.textContent = fonte.dataset.nota || '';
    const g = document.createElement('div'); g.className = 'formas-grade'; g.innerHTML = fonte.innerHTML;
    pop.append(t, n, g);
    pop.addEventListener('mouseenter', cancelar);
    pop.addEventListener('mouseleave', agendar);
    document.body.append(pop);
    const r = el.getBoundingClientRect();
    pop.style.top = window.scrollY + r.bottom + 6 + 'px';
    pop.style.left = '0px';
    const max = window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 10;
    pop.style.left = Math.max(8, Math.min(window.scrollX + r.left, max)) + 'px';
  }

  const achar = (t: EventTarget | null) => (t as HTMLElement)?.closest?.('[data-formas]') as HTMLElement | null;
  document.addEventListener('mouseover', (e) => { const el = achar(e.target); if (el) { cancelar(); abrir(el); } });
  document.addEventListener('mouseout', (e) => { if (achar(e.target)) agendar(); });
  document.addEventListener('focusin', (e) => { const el = achar(e.target); if (el) abrir(el); });
  document.addEventListener('focusout', agendar);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fechar(); });
  window.addEventListener('scroll', fechar, { passive: true });
</script>
