---
/**
 * Uma forma da criatura além da principal (o lobo e o híbrido do lobisomem, a forma de goblin do barghest).
 *
 * Tinha desenho próprio, em linha corrida e com as chaves cruas ("Força: 5 · Destreza: 4", "resistencias: corte,
 * perfuracao", "natacao: 4 m/Tick"; parecer da Veterana sobre o site da Fase 4, M9). Passa a usar o desenho da forma
 * principal do BestaCard.astro, com os mesmos rótulos e formatos (src/lib/besta-card.ts).
 */
import { loadData } from '../lib/data';
import { ELEM, ATR, locoDe, locoTxt, fmtPool, fmtDano, habilidadesDeTreino, treinoTxt, BASE_NOTA, baseTxt, linhaPVTxt } from '../lib/besta-card';
import { linhaPVNaZona, massaDaConta } from '../lib/motor';
import HAB from '../data/habilidades.json';
import SEC from '../data/habilidades-secundarias.json';
interface Props { forma: any }
const {forma} = Astro.props;
const i = forma.criatura;
const d = await loadData();
const arteNome: Record<string, string> = Object.fromEntries(d.artes.map((a) => [a.id, a.nome]));
const artes = (i.artes || []).filter((a: any) => a.nivel > 0);
// As Habilidades de treino da forma (D-270): os botões do card ficam escondidos nas outras formas, então elas vão aqui.
const notaPV = i.enxame || !i.corpo ? '' : linhaPVTxt(linhaPVNaZona(massaDaConta(i.corpo), i.atributos?.vigor ?? 0, i.corpo.linhaPV), i.combate.pv, i.corpo.linhaPVMotivo);
const treino = habilidadesDeTreino(i, Object.fromEntries([...(HAB as any[]), ...(SEC as any[])].map((h) => [h.id, h.nome])));
const ELEM_LINHAS: [string, string, string][] = [['fraquezas', 'Fraqueza', 'el-fra'], ['resistencias', 'Resiste', 'el-res'], ['imunidades', 'Imune', 'el-imu']];
---
<section data-forma-painel={forma.id} hidden>
  <p class="besta-porte"><span class="pt-lbl">{forma.nome}</span><span class="pt-cat">{i.tamanho}</span><span class="pt-sep">·</span>{i.corpo.medida}<span class="pt-sep">·</span>{i.corpo.peso}</p>
  {i.segundoTamanho && <p class="besta-porte">Segundo Tamanho: {i.segundoTamanho}</p>}
  {forma.outraForma && <p class="ib-ref">O Mestre pode escolher outra forma ({forma.outraForma}); então valem a medida e o Tamanho dela.</p>}
  {locoDe(i).length > 0 && (
    <p class="besta-porte besta-loco"><span class="pt-lbl">Desloc.</span>{locoDe(i).map((m, n) => (<>{n > 0 && <span class="pt-sep">·</span>}<span>{locoTxt(m)}</span></>))}</p>
  )}
  <dl class="besta-stats">
    <div><dt>{i.enxame ? 'PV por quadrado' : 'PV'}</dt><dd>{i.combate.pv}</dd></div>
    <div><dt>Defesa</dt><dd>{i.combate.defesa}{i.combate.defesaOutraArma && <><small> c/ {i.combate.defesaOutraArma.armaPrincipal}</small> · {i.combate.defesaOutraArma.defesa}<small> c/ {i.combate.defesaOutraArma.arma}</small></>}{i.combate.vestida && <> · {i.combate.vestida.defesa}<small> c/ equip.</small></>}</dd></div>
    <div><dt>Def. Social</dt><dd>{i.combate.defesaSocial}</dd></div>
    <div><dt>Def. Mental</dt><dd>{i.combate.defesaMental}</dd></div>
    <div><dt>Absorção</dt><dd>{i.combate.absorcao.impacto}/{i.combate.absorcao.corte}/{i.combate.absorcao.perfuracao}{i.combate.vestida && <> · {i.combate.vestida.absorcao.impacto}/{i.combate.vestida.absorcao.corte}/{i.combate.vestida.absorcao.perfuracao}<small> c/ equip.</small></>}</dd></div>
    {i.combate.couraca > 0 && <div title="O nível de Couraça da pele (0 a 12). Quanto cada nível vale na Absorção ainda não tem regra, e por isso ele não entra na conta."><dt>Couraça</dt><dd>{i.combate.couraca}</dd></div>}
    <div><dt>Iniciativa</dt><dd>{i.combate.iniciativa}</dd></div>
    {i.combate.energia != null && <div><dt>Energia</dt><dd>{i.combate.energia}</dd></div>}
  </dl>
  {notaPV && <p class="ib-ref muted besta-linhapv">{notaPV}</p>}
  {ELEM_LINHAS.some(([k]) => i.combate[k]?.length) && (
    <div class="besta-elem">
      {ELEM_LINHAS.filter(([k]) => i.combate[k]?.length).map(([k, rot, cls]) => (
        <span class="el-linha"><span class="el-lbl">{rot}</span>{i.combate[k].map((x: string) => <span class={`el ${cls}`}>{ELEM[x] ?? x}</span>)}</span>
      ))}
    </div>
  )}
  {i.atributos && (
    <div class="besta-atrib">
      <span class="atr-lbl">Atributos</span>
      <div class="atr-grid">
        {ATR.map(([k, ab, full]) => (
          <span class="atr" title={full}><span class="atr-nm"><span class="atr-ab">{ab}</span><span class="atr-full">{full}</span></span><span class="atr-v">{(i.atributos as any)[k]}</span></span>
        ))}
      </div>
    </div>
  )}
  <div class="besta-tracos">
    <div class="tr-linha">
      <span class="tr"><span class="tr-nm">Vontade</span><span class="tr-v">{i.vontade}</span></span>
      <span class="tr"><span class="tr-nm">Aparência</span><span class="tr-v">{i.aparencia}</span></span>
      {i.mana != null && <span class="tr"><span class="tr-nm">Mana</span><span class="tr-v">{i.mana}</span></span>}
    </div>
  </div>
  {artes.length > 0 && <p class="ib-ref"><b>Artes:</b> {artes.map((a: any) => `${arteNome[a.id] ?? a.id} ${a.nivel}`).join(' · ')}</p>}
  <ul class="besta-atk">
    {i.combate.ataques.map((a: any) => (
      <li><span class="atk-nome">{a.nome}</span><span class="atk-rolls">Ataque: <b>{fmtPool(a.pool)}</b> · Dano <b>{fmtDano(a.dano)}</b> · Velocidade {a.speed}</span>{a.notas ? <span class="atk-nota muted">{a.notas}</span> : null}</li>
    ))}
  </ul>
  {(i.comoLuta || []).length > 0 && <><h4>Como luta</h4><ul>{i.comoLuta.map((x:any)=><li><b>{x.nome}:</b> {x.texto}</li>)}</ul></>}
  {(i.sentidos || []).length > 0 && <><h4>Sentidos</h4><ul>{i.sentidos.map((x:any)=><li><b>{x.nome}:</b> {x.descricao}{x.classe ? ' ('+x.classe+')' : ''}</li>)}</ul></>}
  {treino.primarias.length + treino.secundarias.length > 0 && <><h4>Habilidades</h4>{treino.primarias.length > 0 && <p class="ib-ref"><b>Habilidades:</b> {treinoTxt(treino.primarias)}</p>}{treino.secundarias.length > 0 && <p class="ib-ref"><b>Secundárias:</b> {treinoTxt(treino.secundarias)}</p>}</>}
  {(i.habilidadesEspeciais || []).length > 0 && <><h4>Poderes</h4>{i.habilidadesEspeciais.some((x: any) => x.base) && <p class="ib-ref muted">{BASE_NOTA}</p>}<ul>{i.habilidadesEspeciais.map((x:any)=><li><b>{x.nome}:</b> {x.campos ? <>{x.texto}<ul class="hab-campos">{x.campos.map((c: any) => <li><span class="hc-rot">{c.rotulo}:</span> {c.valor}</li>)}</ul></> : x.descricao}{baseTxt(x.base, arteNome)}{x.classe === 'sem regra ainda' ? ' (sem regra ainda)' : ''}</li>)}</ul></>}
</section>
