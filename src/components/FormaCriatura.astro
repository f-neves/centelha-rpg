---
interface Props { forma: any }
const {forma} = Astro.props;
const i = forma.criatura;
const nomes: Record<string,string> = {forca:'Força',destreza:'Destreza',vigor:'Vigor',influencia:'Influência',perspicacia:'Perspicácia',compostura:'Compostura',percepcao:'Percepção',inteligencia:'Inteligência',raciocinio:'Raciocínio'};
---
<section data-forma-painel={forma.id} hidden>
  <p class="besta-porte"><b>{forma.nome}</b> · {i.tamanho} · {i.corpo.medida} · {i.corpo.peso}</p>
  {i.segundoTamanho && <p>Segundo Tamanho: {i.segundoTamanho}</p>}
  <dl class="besta-stats">
    <div><dt>{i.enxame ? 'PV por quadrado' : 'PV'}</dt><dd>{i.combate.pv}</dd></div><div><dt>Defesa</dt><dd>{i.combate.defesa}</dd></div>
    <div><dt>Def. Social</dt><dd>{i.combate.defesaSocial}</dd></div><div><dt>Def. Mental</dt><dd>{i.combate.defesaMental}</dd></div>
    <div><dt>Absorção</dt><dd>{Object.values(i.combate.absorcao).join('/')}</dd></div><div><dt>Iniciativa</dt><dd>{i.combate.iniciativa}</dd></div>
            {i.combate.energia != null && <div><dt>Energia</dt><dd>{i.combate.energia}</dd></div>}
  </dl>
  {i.combate.vestida && <p>Com equipamento: Defesa {i.combate.vestida.defesa} · Absorção {Object.values(i.combate.vestida.absorcao).join('/')}</p>}
  <p>{['fraquezas','resistencias','imunidades'].filter(k=>i.combate[k]?.length).map(k=>k+': '+i.combate[k].join(', ')).join(' · ')}</p>
  <p>{Object.entries(i.atributos).map(([k,v])=>nomes[k]+': '+v).join(' · ')}</p>
  <p>Aparência: {i.aparencia} · Vontade: {i.vontade}{i.mana != null ? ' · Mana: '+i.mana : ''}</p>
  <p>Deslocamento: {Object.entries(i.locomocao || {}).map(([k,v])=>k === 'terra' && v == null ? 'Terra: não anda' : k+': '+v+' m/Tick').join(' · ')}</p>
  <p>{(i.artes || []).filter((a:any)=>a.nivel>0).map((a:any)=>a.id+' '+a.nivel).join(' · ')}</p>
  <ul class="besta-atk">{i.combate.ataques.map((a:any)=><li><b>{a.nome}</b> · Ataque {a.pool} · Dano {a.dano} · Velocidade {a.speed}</li>)}</ul>
  {(i.comoLuta || []).length > 0 && <><h4>Como luta</h4><ul>{i.comoLuta.map((x:any)=><li><b>{x.nome}:</b> {x.texto}</li>)}</ul></>}
  {(i.sentidos || []).length > 0 && <><h4>Sentidos</h4><ul>{i.sentidos.map((x:any)=><li><b>{x.nome}:</b> {x.descricao}{x.classe ? ' ('+x.classe+')' : ''}</li>)}</ul></>}
  {(i.habilidadesEspeciais || []).length > 0 && <><h4>Habilidades especiais</h4><ul>{i.habilidadesEspeciais.map((x:any)=><li><b>{x.nome}:</b> {x.descricao}{x.base ? ' · base '+x.base.arte+' '+x.base.nivel : ''}{x.classe === 'sem regra ainda' ? ' (sem regra ainda)' : ''}</li>)}</ul></>}
</section>
