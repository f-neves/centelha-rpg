---
/**
 * Uma ficha do bestiário.
 *
 * Saiu de dentro de `bestiario.astro` para poder ser desenhada de dois jeitos: as
 * primeiras vão direto para a página, e as demais vão dentro de um <template>,
 * que o navegador parseia mas não estiliza, não dispõe e não pinta. A página
 * tinha 308 fichas de uma vez, 40.146 nós e levava 12,7 s até a primeira ficha
 * aparecer numa máquina modesta; com as 268 últimas adiadas, 2,8 s.
 *
 * O <template> em vez de simplesmente não escrever a ficha: o Pagefind indexa
 * lendo o HTML como TEXTO, no build, e continua enxergando o que está lá dentro.
 * Cortar de verdade tiraria 268 criaturas da busca do site.
 */
import CentelhaSpark from './CentelhaSpark.astro';
import FormaCriatura from './FormaCriatura.astro';
import { url } from '../lib/site';
import { loadData } from '../lib/data'; import { poolComPenalidade } from '../lib/defesa-vestida';
import { ELEM, ATR, locoDe, locoTxt, fmtPool, fmtDano, habilidadesDeTreino, treinoTxt } from '../lib/besta-card';
import HAB from '../data/habilidades.json';
import SEC from '../data/habilidades-secundarias.json';

interface Props { i: any }
const { i } = Astro.props;
const d = await loadData();

const ECO_TERR: Record<string, string> = { Cold: 'Gélido', Desert: 'Deserto', Forest: 'Floresta', Jungle: 'Selva', Mountain: 'Montanha', Plains: 'Planície', Swamp: 'Pântano', Underground: 'Subterrâneo', Urban: 'Urbano', Water: 'Aquático', Coast: 'Litoral', Sky: 'Céu', Ruins: 'Ruínas', Any: 'Qualquer' };
const ECO_CLIMA: Record<string, string> = { Cold: 'Frio', Temperate: 'Temperado', Tropical: 'Tropical', Extraplanar: 'Extraplanar' };
// Os rótulos (elementos, atributos, locomoção) e os formatos do ataque e do dano moram em src/lib/besta-card.ts, para
// as outras formas (FormaCriatura.astro) terem o mesmo desenho (parecer da Veterana, M9).
// Modificador social da Aparência (curva do sistema, extrapolada além de 1–10 para criaturas extremas).
const AP_CURVA: Record<number, number> = { 1: -4, 2: -2, 3: -1, 4: 0, 5: 0, 6: 0, 7: 1, 8: 2, 9: 3, 10: 4 };
const apMod = (n: number) => (n > 10 ? 4 + (n - 10) : n < 1 ? -5 - (0 - n) : AP_CURVA[n]);
const arteNome: Record<string, string> = Object.fromEntries(d.artes.map((a) => [a.id, a.nome]));
// As Habilidades de treino (D-270): o painel "Habilidades" do card, com o nome do livro.
const NOMES_HAB: Record<string, string> = Object.fromEntries([...(HAB as any[]), ...(SEC as any[])].map((h) => [h.id, h.nome]));
const treino = habilidadesDeTreino(i, NOMES_HAB);
const temTreino = treino.primarias.length + treino.secundarias.length > 0;
const tecLink = (id: string) => url(`caminhos/${d.T[id]?.caminho?.id ?? ''}`) + '#' + id;
const stars = (n: number) => '◆'.repeat(n) + '◇'.repeat(6 - n);
// Uso de um poder natural, por extenso: "1×/dia", "à vontade", "passivo", "por golpe".
const PERIODO: Record<string, string> = {
  ticks: 'Ticks', cena: 'cena', hora: 'hora', dia: 'dia', avontade: 'à vontade', passivo: 'passivo', golpe: 'por golpe',
};
const usosTxt = (u: any) => {
  if (!u) return '';
  if (u.periodo === 'avontade' || u.periodo === 'passivo' || u.periodo === 'golpe') return PERIODO[u.periodo];
  const base = u.quantidade ? `${u.quantidade}×/${PERIODO[u.periodo] || u.periodo}` : `por ${PERIODO[u.periodo] || u.periodo}`;
  return u.recarga ? `${base} (${u.recarga})` : base;
};
const RESISTE: Record<string, string> = { esquiva: 'Esquiva', corpo: 'corpo', mente: 'mente', nenhum: 'nenhuma' };
// tem conteúdo mecânico (Poderes / Técnicas / Artes) → botão "Poderes" do card flutuante (D-270: o que se chamava
// "Habilidades" eram os poderes; as Habilidades de treino têm o botão delas)
const temMec = (x: any) => !!((x.habilidadesEspeciais?.length) || (x.poderes?.length) || (x.tecnicas?.length) || (x.artes?.length));
// listas de poderes por criatura (ids p/ filtro)
const caminhosDe = (x: any) => [...new Set((x.poderes || []).filter((p: any) => p.tipo === 'proeza' && p.caminho).map((p: any) => p.caminho))];
const artesDe = (x: any) => [...new Set((x.poderes || []).filter((p: any) => p.tipo === 'feiticaria' && p.arte).map((p: any) => p.arte))];
---
<article class="besta" id={i.id} data-permalink data-categoria={i.categoria || 'Outro'}
        data-tipo={i.categoria || ''} data-terreno={(i.ecologia?.terreno || []).join(' ')} data-clima={(i.ecologia?.clima || []).join(' ')} data-semimg={i.semImagem ? '1' : ''} data-porte={i.tamanho || ''}
        data-caminhos={caminhosDe(i).join(' ')} data-artes={artesDe(i).join(' ')}
        data-nome={i.nome} data-en={i.nomeIngles || i.nome} data-pv={i.combate.pv} data-defesa={i.combate.defesa} data-centelha={i.centelha} data-ameaca={i.ameaca}
        data-txt={(i.nome + ' ' + (i.nomeIngles || '') + ' ' + i.conceito + ' ' + (i.categoria || '') + ' ' + i.tags.join(' ') + ' ' + (i.habilidadesEspeciais || []).map((h: any) => h.nome + ' ' + h.descricao).join(' ') + ' ' + (i.poderes || []).map((p: any) => p.id ? (p.nome + ' ' + p.efeito) : (p.efeito + ' ' + p.alvo)).join(' ')).toLowerCase()}
        data-besta={JSON.stringify({id:i.id})}>
        <figure class={`arte${i.imagens?.[0] ? '' : ' sem-arte'}`} data-cent={i.centelha}>
          {i.imagens?.[0]
            ? <img src={url(i.imagens?.[0])} alt={`Ilustração de ${i.nome}`} loading="lazy" decoding="async"
                   data-full={url(i.imagens?.[0])} data-nome={i.nome}
                   {...(i.imagens?.[1] ? { 'data-imagens': JSON.stringify(i.imagens.map(url)), title: 'Clique para ver a outra imagem' } : {})} />
            : <span class="capitular cinzel" aria-hidden="true">{i.nome.trim()[0]}</span>}
          {/* Duas imagens (D-179, item 16): o clique na arte troca, a lupa abre a lightbox e o
              selo diz qual está à vista. A escolha mora em src/lib/imagem-escolhida.ts. */}
          {i.imagens?.[1] && (<>
            <span class="arte-selo" aria-hidden="true">1/2</span>
            <button class="arte-lupa" type="button" title="Ampliar" aria-label="Ampliar a imagem">⌕</button>
          </>)}
          <span class="arte-ameaca" title={`Ameaça ${i.ameaca}/6`}>{stars(i.ameaca)}</span>
          {i.centelha > 0 && <span class="arte-cent" title={`Centelha ${i.centelha}`}><CentelhaSpark /> {i.centelha}</span>}
          {/* Fixar para comparar: estado mora só em localStorage (src/pages/bestiario.astro,
              PIN_KEY), nunca no servidor. O botão nasce sempre "não fixado"; o script da
              página decide o estado real ao montar (para as fichas adiadas em <template>
              também, antes de qualquer filtro/ordenação rodar). */}
          <button class="besta-pin" type="button" aria-pressed="false" title="Fixar para comparar">
            <span class="besta-pin-ic" aria-hidden="true">☆</span>
          </button>
        </figure>

        <div class="besta-corpo">
          <header class="besta-head">
            <span class="besta-nome cinzel">{i.nome}{i.nomeIngles && i.nomeIngles.toLowerCase() !== i.nome.toLowerCase() && <span class="besta-nome-en"> ({i.nomeIngles})</span>}</span>
          </header>
          {i.formas?.length > 0 && <label>Forma <select class="besta-forma-escolha" aria-label={'Forma de '+i.nome}><option value={i.formaPrincipal.id}>{i.formaPrincipal.nome}</option>{i.formas.map((f:any)=><option value={f.id}>{f.nome}</option>)}</select></label>}
          <section data-forma-painel={i.formaPrincipal?.id || 'principal'}>
          <div class="besta-badges">
            {i.categoria && <span class="badge cat">{i.categoriaNome || i.categoria}</span>}
            {(i.ecologia?.terreno || []).map((t: string) => <span class="badge terr">{ECO_TERR[t] || t}</span>)}
            {(i.ecologia?.clima || []).map((c: string) => <span class="badge clima">{ECO_CLIMA[c] || c}</span>)}
            {i.semImagem && <span class="badge sem-img" title="Arte ainda não adicionada">Sem imagem</span>}
          </div>
          {i.tamanho && (
            <p class="besta-porte"><span class="pt-lbl">Tamanho</span><span class="pt-cat">{i.tamanho}</span><span class="pt-sep">·</span>{i.corpo.medida}<span class="pt-sep">·</span>{i.corpo.peso}</p>
          )}
          {i.segundoTamanho && <p class="besta-porte">Segundo Tamanho: {i.segundoTamanho}</p>}
          {locoDe(i).length > 0 && (
            <p class="besta-porte besta-loco"><span class="pt-lbl">Desloc.</span>{locoDe(i).map((m, n) => (<>{n > 0 && <span class="pt-sep">·</span>}<span>{locoTxt(m)}</span></>))}</p>
          )}

          {i.descricao && <p class="besta-con muted">{i.descricao}</p>}

          <dl class="besta-stats">
            <div><dt>{i.enxame ? 'PV por quadrado' : 'PV'}</dt><dd>{i.combate.pv}</dd></div>
            <div><dt>Defesa</dt><dd>{i.combate.defesa}{i.combate.vestida && <> · {i.combate.vestida.defesa}<small> c/ equip.</small></>}</dd></div>
            <div><dt>Def. Social</dt><dd>{i.combate.defesaSocial}</dd></div>
            <div><dt>Def. Mental</dt><dd>{i.combate.defesaMental}</dd></div>
            <div><dt>Absorção</dt><dd>{i.combate.absorcao.impacto}/{i.combate.absorcao.corte}/{i.combate.absorcao.perfuracao}{i.combate.resistenciaPerfuracao ? `·N${i.combate.resistenciaPerfuracao}` : ''}{i.combate.vestida && <> · {i.combate.vestida.absorcao.impacto}/{i.combate.vestida.absorcao.corte}/{i.combate.vestida.absorcao.perfuracao}{i.combate.vestida.nivel ? `·N${i.combate.vestida.nivel}` : ''}<small> c/ equip.</small></>}</dd></div>
            {i.combate.couraca > 0 && <div title="O nível de Couraça da pele (0 a 12). Quanto cada nível vale na Absorção ainda não tem regra, e por isso ele não entra na conta."><dt>Couraça</dt><dd>{i.combate.couraca}</dd></div>}
            <div><dt>Iniciativa</dt><dd>{i.combate.iniciativa}</dd></div>
            {i.combate.energia != null && <div><dt>Energia</dt><dd>{i.combate.energia}</dd></div>}
          </dl>{i.combate.vestida && (<p class="ib-ref besta-vestida"><b>Com o equipamento:</b> Esquiva {i.combate.vestida.esquiva}, Bloqueio {i.combate.vestida.bloqueio}, contra tiro {i.combate.vestida.contraTiro}, Penalidade −{i.combate.vestida.penalidade}. Na mesa, o Mestre escolhe qual usar; sem escolha, vale a maior Defesa.</p>)}

          {(i.combate.fraquezas?.length || i.combate.resistencias?.length || i.combate.imunidades?.length) && (
            <div class="besta-elem">
              {i.combate.fraquezas?.length && (
                <span class="el-linha" title="Dano deste tipo não é absorvido por nada (nem armadura, nem Absorção natural, nem Centelha) e é agravado: não fecha com descanso nem com a Habilidade Cura.">
                  <span class="el-lbl">Fraqueza</span>
                  {i.combate.fraquezas.map((k: string) => <span class="el el-fra">{ELEM[k] ?? k}</span>)}
                </span>
              )}
              {i.combate.resistencias?.length && (
                <span class="el-linha" title="Dano deste tipo cai pela metade, arredondando para cima, depois da armadura e antes da Absorção.">
                  <span class="el-lbl">Resiste</span>
                  {i.combate.resistencias.map((k: string) => <span class="el el-res">{ELEM[k] ?? k}</span>)}
                </span>
              )}
              {i.combate.imunidades?.length && (
                <span class="el-linha" title="Dano deste tipo é zero.">
                  <span class="el-lbl">Imune</span>
                  {i.combate.imunidades.map((k: string) => <span class="el el-imu">{ELEM[k] ?? k}</span>)}
                </span>
              )}
            </div>
          )}

          {i.atributos && (
            <div class="besta-atrib">
              <span class="atr-lbl">Atributos</span>
              <div class="atr-grid">
                {ATR.map(([k, ab, full]) => (
                  <span class="atr" title={full}><span class="atr-nm"><span class="atr-ab">{ab}</span><span class="atr-full">{full}</span></span><span class="atr-v">{(i.atributos as any)[k]}</span></span>
                ))}
              </div>
            </div>
          )}

          {i.virtudes && (
            <div class="besta-tracos">
              <div class="tr-linha">
                <span class="tr"><span class="tr-nm">Vontade</span><span class="tr-v">{i.vontade}</span></span>
                <span class="tr"><span class="tr-nm">Aparência</span><span class="tr-v">{i.aparencia} <small class="tr-mod">({apMod(i.aparencia) >= 0 ? '+' : ''}{apMod(i.aparencia)})</small></span></span>
              </div>
              <div class="tr-virt" title="Virtudes: Compaixão · Convicção · Temperança · Bravura">
                <span class="tr-nm">Virtudes</span>
                <span class="tr-vv">Comp {i.virtudes.compaixao} · Conv {i.virtudes.conviccao} · Temp {i.virtudes.temperanca} · Brav {i.virtudes.valor}</span>
              </div>
            </div>
          )}

          <ul class="besta-atk">
            {i.combate.ataques.map((a: any) => (
              <li><span class="atk-nome">{a.nome}</span><span class="atk-rolls">Ataque: <b>{fmtPool(a.pool)}</b>{i.combate.vestida && <> sem o equipamento · <b>{fmtPool(poolComPenalidade(a.pool, i.combate.vestida.penalidade))}</b> com</>} · Dano <b>{fmtDano(a.dano)}</b> · Velocidade {a.speed}</span>{a.notas ? <span class="atk-nota muted">{a.notas}</span> : null}</li>
            ))}
          </ul>

          {(i.poderes || []).some((p: any) => p.tipo === 'natural') && (
            <ul class="besta-poderes">
              {i.poderes.filter((p: any) => p.tipo === 'natural').map((p: any) => (
                <li>
                  <span class="pn-nome">{p.nome}</span>
                  <span class="pn-meta">{usosTxt(p.usos)}{p.resiste && p.resiste !== 'nenhum' ? ` · resiste ${RESISTE[p.resiste] ?? p.resiste}` : ''}</span>
                  {p.descricao && <span class="pn-desc muted">{p.descricao}</span>}
                </li>
              ))}
            </ul>
          )}

          {(i.comoLuta || []).length > 0 && <><h4>Como luta</h4><ul>{i.comoLuta.map((x:any)=><li><b>{x.nome}:</b> {x.texto}</li>)}</ul></>}
          {(i.sentidos || []).length > 0 && <><h4>Sentidos</h4><ul>{i.sentidos.map((x:any)=><li><b>{x.nome}:</b> {x.descricao}{x.classe ? ' ('+x.classe+')' : ''}</li>)}</ul></>}
          </section>
          {(i.formas || []).map((forma:any)=><FormaCriatura forma={forma}/>)}
          {(
            <div class="besta-foot">
              <button class="besta-info besta-editar" type="button" aria-haspopup="dialog"><span class="i-ic" aria-hidden="true">✎</span> Editar</button>
              {temMec(i) && (
                <button class="besta-info besta-mech" type="button" aria-haspopup="dialog"><span class="i-ic" aria-hidden="true">✦</span> Poderes</button>
              )}
              {temTreino && (
                <button class="besta-info besta-treino" type="button" aria-haspopup="dialog"><span class="i-ic" aria-hidden="true">☰</span> Habilidades</button>
              )}
              {i.lore?.length > 0 && (
                <button class="besta-info" type="button" aria-haspopup="dialog"><span class="i-ic" aria-hidden="true">ⓘ</span> Informações</button>
              )}
              {/* Leva a criatura para o bestiário de uma campanha. Nasce neutro
                  porque o estado (em quantas mesas ela está) só se sabe depois
                  de perguntar ao banco, e perguntar por 300 cards ao carregar a
                  página seria caro para uma informação que quase nunca é olhada:
                  quem clica descobre no diálogo. */}
              <button class="besta-info besta-mesa" type="button" aria-haspopup="dialog"
                title="Separar esta criatura para o bestiário de uma campanha sua"><span class="i-ic" aria-hidden="true">⌂</span> Adicionar à Mesa</button>

              {temMec(i) && (
                <template class="mech-tpl">
                  {i.habilidadesEspeciais?.length > 0 && (<>
                    <h4>Poderes</h4>
                    <ul class="ib-hab">{i.habilidadesEspeciais.map((h: any) => (<li><b>{h.nome}</b> {h.campos ? <>{h.texto}<ul class="hab-campos">{h.campos.map((x: any) => <li><span class="hc-rot">{x.rotulo}:</span> {x.valor}</li>)}</ul></> : h.descricao}{h.base ? ` · base ${h.base.arte} ${h.base.nivel}` : ''}{h.classe === 'sem regra ainda' ? ' (sem regra ainda)' : ''}</li>))}</ul>
                  </>)}
                  {i.poderes?.length > 0 && (<>
                    <h4>Poderes <span class="ib-sub-lbl">(sistema)</span></h4>
                    <ul class="ib-pod">{i.poderes.map((p: any) => p.id
                      ? (<li class={`pw-${p.tipo}`}><span class="pw-ef">{p.nome}</span> <span class="pw-arw">→</span> <span class="pw-alvo">{p.efeito}{p.resiste !== 'nenhum' ? ` (resiste ${p.resiste})` : ''}</span></li>)
                      : (<li class={`pw-${p.tipo}`}><span class="pw-ef">{p.efeito}</span> <span class="pw-arw">→</span> <span class="pw-alvo">{p.alvo}</span></li>))}</ul>
                  </>)}
                  {(i.tecnicas.length > 0 || i.artes.length > 0) && (<>
                    <h4>Técnicas &amp; Artes</h4>
                    {i.tecnicas.length > 0 && (<p class="ib-ref"><b>Técnicas:</b> {i.tecnicas.map((t: any, n: number) => (<>{n > 0 && ' · '}<a href={tecLink(t)}>{d.T[t]?.nome ?? t}</a></>))}</p>)}
                    {i.mana != null && (<p class="ib-ref"><b>Mana:</b> {i.mana}</p>)}
                    {i.artes.length > 0 && (<p class="ib-ref"><b>Artes:</b> {i.artes.map((a: any, n: number) => (<>{n > 0 && ' · '}<a href={url('arcano') + '#' + a.id}>{arteNome[a.id] ?? a.id}</a> {a.nivel}</>))}</p>)}
                  </>)}
                </template>
              )}
              {temTreino && (
                <template class="treino-tpl">
                  <h4>Habilidades</h4>
                  <p class="ib-ref muted">O treino da criatura, que se soma ao Atributo na jogada, como no livro (Cap. II).</p>
                  {treino.primarias.length > 0 && <p class="ib-ref"><b>Habilidades:</b> {treinoTxt(treino.primarias)}</p>}
                  {treino.secundarias.length > 0 && <p class="ib-ref"><b>Secundárias:</b> {treinoTxt(treino.secundarias)}</p>}
                </template>
              )}
              {i.lore?.length > 0 && (
                <template class="lore-tpl">{i.lore.map((s: any) => (<><h4>{s.titulo}</h4><p>{s.texto}</p></>))}</template>
              )}
            </div>
          )}
        </div>
      </article>

<script>
  document.addEventListener('change', e=>{
    const seletor = (e.target as HTMLElement).closest<HTMLSelectElement>('.besta-forma-escolha');
    if (!seletor) return;
    const card = seletor.closest('.besta')!;
    card.querySelectorAll<HTMLElement>('[data-forma-painel]').forEach(p=>p.hidden=p.dataset.formaPainel!==seletor.value);
    const principal = seletor.selectedIndex === 0;
    card.querySelectorAll<HTMLElement>('.besta-mech, .besta-treino').forEach(b=>b.hidden=!principal);
  });
</script>

<style is:global>
  /* Duas imagens (D-179, item 16). O selo fica no canto de baixo à direita, livre (a
     Ameaça está no de baixo à esquerda, a Centelha e o pino nos de cima); a lupa, acima
     dele. Global porque a ficha nasce também dentro de <template>. */
  .arte img[data-img2] { cursor: pointer; }
  .arte-selo {
    position: absolute; right: .55rem; bottom: .45rem; z-index: 2;
    font-family: 'Cinzel'; font-size: var(--fs-aux); font-weight: 600; letter-spacing: .04em;
    padding: .1rem .5rem; border-radius: 999px; pointer-events: none;
    color: #f3e8cf; background: color-mix(in srgb, #1a120a 55%, transparent);
  }
  .arte-lupa {
    position: absolute; right: .5rem; bottom: 2.1rem; z-index: 3;
    width: 2.1rem; height: 2.1rem; display: flex; align-items: center; justify-content: center;
    border: none; border-radius: 50%; cursor: zoom-in;
    background: color-mix(in srgb, #1a120a 55%, transparent);
    color: #f3e8cf; font-size: var(--fs-h3); line-height: 1;
    box-shadow: 0 2px 5px rgba(0,0,0,.4);
  }
  .arte-lupa:hover { background: color-mix(in srgb, #1a120a 75%, transparent); }
</style>
