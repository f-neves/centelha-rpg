/* Animado, o desenho estático é a forma de repouso da batida (é o que aparece se
   o SMIL não rodar). Sem animação, é a variante que o chamador pediu. */
const pontos = anim ? VARIANTES[BATIDA[0].v] : (VARIANTES[v] ?? VARIANTES[1]);
---
<svg
  class:list={['orn-centelha', cls]}
  viewBox="122.29 62 779.42 900"
  fill="currentColor"
  role={alt ? 'img' : undefined}
  aria-label={alt}
  aria-hidden={alt ? undefined : 'true'}
>
  {pontos.map((p, i) => (
    <polygon points={p}>
      {anim && (
        <animate
          attributeName="points"
          values={BATIDA.map((b) => VARIANTES[b.v][i]).join(';')}
          dur={`${ORN_CICLO}s`}
          begin={`${fase}s`}
          repeatCount="indefinite"
          calcMode="spline"
          keyTimes={KEY_TIMES}
          keySplines={KEY_SPLINES}
        />
      )}
    </polygon>
  ))}
</svg>

<style>
  .orn-centelha {
    display: inline-block;
    height: 0.79em;
    width: 0.684em;
    vertical-align: -0.05em;
    flex: 0 0 auto;
  }
</style>
