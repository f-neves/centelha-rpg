    '546.64,532.00 665.00,737.00 901.71,737.00 783.35,532.00',
    '512.00,552.00 393.64,757.00 512.00,962.00 630.36,757.00',
    '477.36,532.00 240.65,532.00 122.29,737.00 359.00,737.00',
    '477.36,492.00 359.00,287.00 122.29,287.00 240.65,492.00',
