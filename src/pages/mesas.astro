---
import Base from '../layouts/Base.astro';
---
<Base title="Mesas / Fichas" descricao="Suas mesas como mestre e como jogador, e suas fichas de personagem.">
  <h1>Mesas / Fichas</h1>

  <div id="setup" class="aviso" hidden>
    <strong>Área de contas ainda não configurada.</strong>
    <p class="muted">Falta ligar o Supabase. Veja <code>supabase/README.md</code>.</p>
  </div>

  <div id="carregando" class="muted">Carregando…</div>

  <div id="mesas-conteudo" hidden>
    <section class="secao-fichas">
      <div class="secao-cab">
        <h2>Personagens</h2>
        <button class="btn primary" id="novo-pers" type="button">+ Novo Personagem</button>
      </div>
      <div id="lista-pers"></div>
    </section>

    <section class="secao-mesas">
      <h2>Mesas</h2>
      <div id="lista"></div>
    </section>

    <div class="acoes-mesa">
      <form id="form-criar" class="painel">
        <h2>Criar mesa</h2>
        <p class="muted">Você vira o <strong>mestre</strong> desta mesa.</p>
        <label>Nome da mesa<input name="nome" required maxlength="80" /></label>
        <label>Descrição (opcional)<input name="descricao" maxlength="200" /></label>
        <button class="btn primary" type="submit">Criar</button>
      </form>

      <form id="form-entrar" class="painel">
        <h2>Entrar em uma mesa</h2>
        <p class="muted">Use o <strong>código de convite</strong> que o mestre te passou.</p>
        <label>Código<input name="codigo" required maxlength="12" style="text-transform:uppercase" /></label>
        <button class="btn primary" type="submit">Entrar</button>
      </form>
    </div>
    <p id="msg" class="msg" role="status" aria-live="polite"></p>
  </div>
</Base>

<script>
  import { getSupabase } from '../lib/supabase';
  import { exigirLogin, supabaseConfigurado } from '../lib/auth';

  const base = import.meta.env.BASE_URL;
  const u = (p: string) => `${base.replace(/\/$/, '')}/${p}`;
  const msg = document.getElementById('msg')!;
  const setMsg = (t: string, erro = true) => { msg.textContent = t; msg.classList.toggle('erro', erro); };
  const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  async function main() {
    if (!supabaseConfigurado) {
      document.getElementById('carregando')!.hidden = true;
      document.getElementById('setup')!.hidden = false;
      return;
    }
    const user = await exigirLogin(base);
    if (!user) return; // já redirecionou
    document.getElementById('carregando')!.hidden = true;
    document.getElementById('mesas-conteudo')!.hidden = false;
    await Promise.all([render(user.id), renderPersonagens(user.id)]);

    document.getElementById('novo-pers')!.addEventListener('click', async () => {
      setMsg('Criando personagem…', false);
      const { data, error } = await getSupabase()
        .from('personagens')
        .insert({ dono_id: user.id, mesa_id: null, nome: 'Novo personagem' })
        .select('id')
        .single();
      if (error) return setMsg('Não deu para criar o personagem: ' + error.message);
      location.href = u('personagem') + '?id=' + data.id;
    });

    document.getElementById('form-criar')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      setMsg('Criando…', false);
      const { data, error } = await getSupabase().rpc('criar_mesa', {
        p_nome: (f.nome as any).value, p_descricao: (f.descricao as any).value,
      });
      if (error) return setMsg('Não deu para criar: ' + error.message);
      location.href = u('mesa') + '?id=' + (data as any).id;
    });

    document.getElementById('form-entrar')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      setMsg('Entrando…', false);
      const { data, error } = await getSupabase().rpc('entrar_na_mesa', {
        p_codigo: (f.codigo as any).value,
      });
      if (error) return setMsg('Código inválido ou erro: ' + error.message);
      location.href = u('mesa') + '?id=' + (data as any).id;
    });
  }

  // Cards dos personagens do usuário: retrato (quando já escolhido) e nome.
  async function renderPersonagens(userId: string) {
    const sb = getSupabase();
    const box = document.getElementById('lista-pers')!;
    // só as fichas DO usuário: como mestre ele também enxerga as dos jogadores, e essas
    // pertencem à mesa, não a esta lista.
    const { data, error } = await sb
      .from('personagens')
      .select('id, nome, conceito, imagem_path, imagem_pos, mesa_id, mesa:mesas(nome)')
      .eq('dono_id', userId)
      .order('atualizado_em', { ascending: false });
    if (error) { box.innerHTML = `<p class="erro">Erro ao carregar personagens: ${esc(error.message)}</p>`; return; }
    const pers = data || [];
    if (!pers.length) {
      box.innerHTML = '<p class="muted">Nenhum personagem ainda. Crie um em <strong>Novo Personagem</strong>, ou monte a ficha em Ferramentas › Ficha de Personagem e use <strong>Salvar ficha</strong>.</p>';
      return;
    }
    // uma URL assinada por retrato (a bucket é privada)
    const comImg = pers.filter((p: any) => p.imagem_path);
    const urls: Record<string, string> = {};
    if (comImg.length) {
      const { data: assinadas } = await sb.storage.from('personagens')
        .createSignedUrls(comImg.map((p: any) => p.imagem_path), 3600);
      (assinadas || []).forEach((a: any, i: number) => { if (a?.signedUrl) urls[comImg[i].id] = a.signedUrl; });
    }
    box.innerHTML = '<div class="pers-grid">' + pers.map((p: any) => {
      const nome = (p.nome || '').trim() || 'Sem nome';
      const src = urls[p.id];
      // mesmo enquadramento salvo na ficha: x/y vão em object-position E transform-origin,
      // z em scale() — é exatamente o que aplicarPos() faz em /personagem.
      const q = p.imagem_pos && typeof p.imagem_pos === 'object' ? p.imagem_pos : null;
      const x = q?.x ?? 50, y = q?.y ?? 50, z = q?.z ?? 1;
      const estilo = ` style="object-position:${x}% ${y}%;transform-origin:${x}% ${y}%;transform:scale(${z})"`;
      const arte = src
        ? `<img src="${esc(src)}" alt=""${estilo} loading="lazy" />`
        : '<span class="pc-vazio" aria-hidden="true">◈</span>';
      const onde = p.mesa?.nome ? esc(p.mesa.nome) : 'Ficha avulsa';
      return `<a class="pers-card" href="${u('personagem')}?id=${p.id}">
        <span class="retrato-frame pc-frame">${arte}</span>
        <span class="pc-nome cinzel">${esc(nome)}</span>
        ${p.conceito ? `<span class="pc-conceito">${esc(p.conceito)}</span>` : ''}
        <span class="pc-onde">${onde}</span>
      </a>`;
    }).join('') + '</div>';
  }

  // Só as SUAS filiações. O filtro por user_id é indispensável: a policy
  // membros_select libera todas as linhas das mesas em que você está (é o que
  // faz a lista de membros funcionar no Grupo), então sem ele a consulta volta
  // uma linha por PESSOA de cada mesa. Era isso que duplicava os cards e
  // pintava um "Mestre" com o código de convite: a linha do mestre de verdade.
  async function render(userId: string) {
    const { data, error } = await getSupabase()
      .from('mesa_membros')
      .select('papel, mesa:mesas(id, nome, descricao, codigo_convite, mestre_id)')
      .eq('user_id', userId)
      .order('entrou_em', { ascending: true });
    const lista = document.getElementById('lista')!;
    if (error) { lista.innerHTML = `<p class="erro">Erro ao carregar: ${esc(error.message)}</p>`; return; }
    const linhas = (data || []).filter((r: any) => r.mesa);
    if (!linhas.length) { lista.innerHTML = '<p class="muted">Você ainda não está em nenhuma mesa. Crie uma ou entre com um código abaixo.</p>'; return; }
    lista.classList.add('tem-mesas');
    lista.innerHTML = '<div class="mesa-grid">' + linhas.map((r: any) => {
      const m = r.mesa; const mestre = r.papel === 'mestre' || m.mestre_id === userId;
      // O Escudo é do mestre: o jogador entra pelo Grupo, que é a casa dele na
      // mesa. Mandá-lo para /mesa só produziria um redirecionamento visível.
      return `<a class="mesa-card" href="${u(mestre ? 'mesa' : 'mesa/grupo')}?id=${m.id}">
        <span class="papel ${mestre ? 'p-mestre' : 'p-jogador'}">${mestre ? 'Mestre' : 'Jogador'}</span>
        <span class="mesa-nome cinzel">${esc(m.nome)}</span>
        ${m.descricao ? `<span class="mesa-desc">${esc(m.descricao)}</span>` : ''}
        ${mestre ? `<span class="mesa-cod">Convite: <code>${esc(m.codigo_convite)}</code></span>` : ''}
      </a>`;
    }).join('') + '</div>';
  }

  main();
</script>

<!-- is:global: a lista de mesas é criada via JS -->
<style is:global>
  .secao-cab { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .secao-cab h2, .secao-mesas h2 { margin: 0; }
  .secao-fichas { margin-bottom: 2rem; }
  .secao-mesas h2 { margin-bottom: .8rem; }
  .secao-fichas #lista-pers { margin-top: .9rem; }
  /* colunas do tamanho da moldura (172px) + o respiro do card */
  .pers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
  .pers-card { display: flex; flex-direction: column; gap: .3rem; padding: .7rem; border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); text-decoration: none; color: var(--ink); transition: border-color .15s, transform .15s; }
  .pers-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  /* .retrato-frame vem de styles/global.css — a mesma moldura da ficha. Aqui só centraliza
     e mostra o placeholder de quem ainda não tem retrato. */
  .pc-frame { align-self: center; display: grid; place-items: center; }
  .pc-vazio { font-size: 2.4rem; color: var(--ink-soft); opacity: .5; }
  .pc-nome { font-size: var(--fs-aux); font-weight: 700; line-height: 1.2; margin-top: .15rem; }
  .pc-conceito { font-size: var(--fs-rotulo); color: var(--ink-soft); }
  .pc-onde { font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .05em; color: var(--ink-soft); }
  /* No celular o card de personagem vira LINHA: miniatura 64px + textos ao lado, ~88px de
     altura, 6 a 8 por tela. Antes cada card tinha ~600px (retrato grande) e cabia UM por
     tela, o oposto do que uma lista de escolha pede. O retrato grande fica na página do
     personagem, onde ele é o assunto. */
  @media (max-width: 900px) {
    .pers-grid { grid-template-columns: 1fr; gap: .55rem; }
    .pers-card { display: grid; grid-template-columns: 64px 1fr; column-gap: .85rem;
      align-items: center; padding: .55rem .8rem; }
    .pers-card .pc-frame { grid-row: 1 / span 3; width: 64px; height: 77px; align-self: center; }
    .pc-vazio { font-size: 1.6rem; }
    .pc-nome { margin-top: 0; }
  }
  .acoes-mesa { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.6rem; }
  @media (max-width: 640px) { .acoes-mesa { grid-template-columns: 1fr; } }
  .painel { border: 1px solid var(--rule); border-radius: var(--r-lg); padding: 1rem; background: var(--panel); }
  .painel h2 { margin-top: 0; }
  .painel label { display: block; margin-bottom: .7rem; font-weight: 600; }
  .painel input { display: block; width: 100%; margin-top: .25rem; padding: .5rem; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--bg); color: var(--ink); font: inherit; }
  .mesa-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .mesa-card { display: flex; flex-direction: column; gap: .35rem; padding: 1rem; border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); text-decoration: none; color: var(--ink); transition: border-color .15s, transform .15s; }
  .mesa-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .mesa-nome { font-size: var(--fs-h3); font-weight: 700; }
  .mesa-desc { color: var(--ink-soft); font-size: var(--fs-aux); }
  .mesa-cod { font-size: var(--fs-rotulo); color: var(--ink-soft); }
  .papel { align-self: flex-start; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .06em; padding: .1rem .5rem; border-radius: 999px; font-weight: 700; }
  .p-mestre { background: color-mix(in srgb, var(--gold, #b8860b) 25%, transparent); color: var(--ink); }
  .p-jogador { background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--ink); }
  .aviso { border: 1px solid var(--gold, var(--rule)); border-radius: var(--r-lg); padding: 1rem; background: color-mix(in srgb, var(--gold, #caa) 12%, transparent); max-width: 40rem; }
  .msg { margin-top: .8rem; }
  .msg.erro { color: var(--perigo); }
</style>
