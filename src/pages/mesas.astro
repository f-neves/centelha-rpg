---
import Base from '../layouts/Base.astro';
import FichaResumo from '../components/FichaResumo.astro';
---
{/* `wide` e não `prose`: a página é um painel de duas colunas, e 46rem de coluna
    de leitura partidos ao meio deixariam um card de personagem por linha. */}
<Base title="Mesas / Fichas" descricao="Suas mesas como mestre e como jogador, e suas fichas de personagem." largura="wide">
  <h1>Mesas / Fichas</h1>

  <div id="setup" class="aviso" hidden>
    <strong>Área de contas ainda não configurada.</strong>
    <p class="muted">Falta ligar o Supabase. Veja <code>supabase/README.md</code>.</p>
  </div>

  <div id="carregando" class="muted">Carregando…</div>

  <div id="mesas-conteudo" hidden>
    {/* Duas colunas, uma por assunto: à esquerda quem você é, à direita onde você
        joga. As duas listas são independentes (nenhuma decisão de uma muda a
        outra), então lê-las lado a lado poupa a rolagem que havia entre elas. */}
    {/* AS DUAS ABAS, só no telefone. Empilhadas, as duas listas viravam um
        documento: quem abre a página para entrar numa mesa passava por todos os
        personagens antes de chegar nela, e quem abre para escolher personagem
        rolava até o fim para descobrir que não havia mais nada. São dois
        assuntos independentes (nenhuma decisão de um muda o outro), e no
        notebook eles já ficam lado a lado justamente por isso. */}
    <div class="mf-abas" role="tablist" aria-label="O que mostrar">
      <button type="button" role="tab" data-p="pers" id="mf-t-pers"
        aria-selected="true" aria-controls="mf-pers">Fichas <span class="mf-n" id="mf-n-pers"></span></button>
      <button type="button" role="tab" data-p="mesas" id="mf-t-mesas"
        aria-selected="false" aria-controls="mf-mesas">Mesas <span class="mf-n" id="mf-n-mesas"></span></button>
    </div>
    <div class="mesas-colunas">
      <div class="col-pers" id="mf-pers" role="tabpanel" aria-labelledby="mf-t-pers">
        <section class="secao-fichas">
          <div class="secao-cab">
            <h2>Personagens</h2>
            <button class="btn primary" id="novo-pers" type="button">+ Novo Personagem</button>
          </div>
          <div id="lista-pers"></div>
        </section>
      </div>

      <div class="col-mesas" id="mf-mesas" role="tabpanel" aria-labelledby="mf-t-mesas">
        <section class="secao-mesas">
          <h2>Mesas</h2>
          <div id="lista"></div>
        </section>

        <div class="acoes-mesa">
          <form id="form-criar" class="painel">
            <h2>Criar mesa</h2>
            <p class="muted">Você vira o <strong>mestre</strong> desta mesa.</p>
            <label>Nome da mesa<input name="nome" required maxlength="80" /></label>
            <label>Descrição (opcional)<input name="descricao" maxlength="200" /></label>
            <button class="btn primary" type="submit">Criar</button>
          </form>

          <form id="form-entrar" class="painel">
            <h2>Entrar em uma mesa</h2>
            <p class="muted">Use o <strong>código de convite</strong> que o mestre te passou.</p>
            <label>Código<input name="codigo" required maxlength="12" style="text-transform:uppercase" /></label>
            <button class="btn primary" type="submit">Entrar</button>
          </form>
        </div>
      </div>
    </div>
    <p id="msg" class="msg" role="status" aria-live="polite"></p>
  </div>

  <FichaResumo />
</Base>

<script>
  import { getSupabase } from '../lib/supabase';
  import { exigirLogin, supabaseConfigurado } from '../lib/auth';

  const base = import.meta.env.BASE_URL;
  const u = (p: string) => `${base.replace(/\/$/, '')}/${p}`;
  const msg = document.getElementById('msg')!;
  const setMsg = (t: string, erro = true) => { msg.textContent = t; msg.classList.toggle('erro', erro); };
  const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  async function main() {
    if (!supabaseConfigurado) {
      document.getElementById('carregando')!.hidden = true;
      document.getElementById('setup')!.hidden = false;
      return;
    }
    const user = await exigirLogin(base);
    if (!user) return; // já redirecionou
    document.getElementById('carregando')!.hidden = true;
    document.getElementById('mesas-conteudo')!.hidden = false;
    ligarAbas();
    await Promise.all([render(user.id), renderPersonagens(user.id)]);

    document.getElementById('novo-pers')!.addEventListener('click', async () => {
      setMsg('Criando personagem…', false);
      const { data, error } = await getSupabase()
        .from('personagens')
        .insert({ dono_id: user.id, mesa_id: null, nome: 'Novo personagem' })
        .select('id')
        .single();
      if (error) return setMsg('Não deu para criar o personagem: ' + error.message);
      location.href = u('personagem') + '?id=' + data.id;
    });

    document.getElementById('form-criar')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      setMsg('Criando…', false);
      const { data, error } = await getSupabase().rpc('criar_mesa', {
        p_nome: (f.nome as any).value, p_descricao: (f.descricao as any).value,
      });
      if (error) return setMsg('Não deu para criar: ' + error.message);
      location.href = u('mesa') + '?id=' + (data as any).id;
    });

    document.getElementById('form-entrar')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      setMsg('Entrando…', false);
      const { data, error } = await getSupabase().rpc('entrar_na_mesa', {
        p_codigo: (f.codigo as any).value,
      });
      if (error) return setMsg('Código inválido ou erro: ' + error.message);
      location.href = u('mesa') + '?id=' + (data as any).id;
    });
  }

  /**
   * As duas abas do telefone.
   *
   * A escolha fica no aparelho, e não na conta: é preferência de quem está
   * olhando, e a mesma pessoa quer coisas diferentes no notebook (onde não há
   * aba nenhuma) e no celular.
   */
  const ABA_KEY = 'centelha:mesas:aba';
  function ligarAbas() {
    const caixa = document.getElementById('mesas-conteudo')!;
    const botoes = [...document.querySelectorAll<HTMLButtonElement>('.mf-abas button')];
    const mostrar = (qual: string) => {
      caixa.classList.toggle('aba-pers', qual !== 'mesas');
      caixa.classList.toggle('aba-mesas', qual === 'mesas');
      botoes.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.p === qual)));
      try { localStorage.setItem(ABA_KEY, qual); } catch {}
    };
    botoes.forEach((b) => b.addEventListener('click', () => mostrar(b.dataset.p!)));
    let guardada = 'pers';
    try { guardada = localStorage.getItem(ABA_KEY) || 'pers'; } catch {}
    mostrar(guardada);
  }

  /** Quantos há de cada lado, na aba. Some quando é zero: "Mesas 0" é ruído. */
  function contarAba(qual: 'pers' | 'mesas', n: number) {
    const e = document.getElementById(`mf-n-${qual}`);
    if (e) e.textContent = n ? String(n) : '';
  }

  // Cards dos personagens do usuário: retrato (quando já escolhido) e nome.
  async function renderPersonagens(userId: string) {
    const sb = getSupabase();
    const box = document.getElementById('lista-pers')!;
    // só as fichas DO usuário: como mestre ele também enxerga as dos jogadores, e essas
    // pertencem à mesa, não a esta lista.
    const { data, error } = await sb
      .from('personagens')
      .select('id, nome, conceito, imagem_path, imagem_pos, mesa_id, mesa:mesas(nome)')
      .eq('dono_id', userId)
      .order('atualizado_em', { ascending: false });
    if (error) { box.innerHTML = `<p class="erro">Erro ao carregar personagens: ${esc(error.message)}</p>`; return; }
    const pers = data || [];
    contarAba('pers', pers.length);
    if (!pers.length) {
      box.innerHTML = '<p class="muted">Nenhum personagem ainda. Crie um em <strong>Novo Personagem</strong>, ou monte a ficha em Ferramentas › Ficha de Personagem e use <strong>Salvar ficha</strong>.</p>';
      return;
    }
    // uma URL assinada por retrato (a bucket é privada)
    const comImg = pers.filter((p: any) => p.imagem_path);
    const urls: Record<string, string> = {};
    if (comImg.length) {
      const { data: assinadas } = await sb.storage.from('personagens')
        .createSignedUrls(comImg.map((p: any) => p.imagem_path), 3600);
      (assinadas || []).forEach((a: any, i: number) => { if (a?.signedUrl) urls[comImg[i].id] = a.signedUrl; });
    }
    box.innerHTML = '<div class="pers-grid">' + pers.map((p: any) => {
      const nome = (p.nome || '').trim() || 'Sem nome';
      const src = urls[p.id];
      // mesmo enquadramento salvo na ficha: x/y vão em object-position E transform-origin,
      // z em scale() — é exatamente o que aplicarPos() faz em /personagem.
      const q = p.imagem_pos && typeof p.imagem_pos === 'object' ? p.imagem_pos : null;
      const x = q?.x ?? 50, y = q?.y ?? 50, z = q?.z ?? 1;
      const estilo = ` style="object-position:${x}% ${y}%;transform-origin:${x}% ${y}%;transform:scale(${z})"`;
      const arte = src
        ? `<img src="${esc(src)}" alt=""${estilo} loading="lazy" />`
        : '<span class="pc-vazio" aria-hidden="true">◈</span>';
      const onde = p.mesa?.nome ? esc(p.mesa.nome) : 'Ficha avulsa';
      // O card deixou de ser um link inteiro: são duas leituras diferentes da
      // mesma ficha, e nenhuma delas é óbvia o bastante para ficar implícita no
      // clique. O retrato e o nome continuam levando à ficha completa, que é o
      // caminho de sempre; os dois botões dizem em palavras o que cada um faz.
      return `<article class="pers-card">
        <a class="pc-alvo" href="${u('personagem')}?id=${p.id}">
          <span class="retrato-frame pc-frame">${arte}</span>
          <span class="pc-nome cinzel">${esc(nome)}</span>
          ${p.conceito ? `<span class="pc-conceito">${esc(p.conceito)}</span>` : ''}
          <span class="pc-onde">${onde}</span>
        </a>
        <span class="pc-acoes">
          <a class="pc-b" href="${u('personagem')}?id=${p.id}">Ver ficha completa</a>
          <button class="pc-b pc-resumo" type="button" data-resumo="${p.id}"
            data-nome="${esc(nome)}" data-mesa="${p.mesa?.nome ? esc(p.mesa.nome) : ''}"
            data-img="${esc(src || '')}" data-pos="${esc(JSON.stringify(q || {}))}">Ver ficha resumida</button>
        </span>
      </article>`;
    }).join('') + '</div>';
    ligarResumos(sb);
  }

  /**
   * "Ver ficha resumida": abre o card de leitura sem sair da página.
   *
   * A ficha só é buscada no clique, e o módulo do card também: são 60 KB de
   * motor e um dicionário de nomes para uma janela que a maioria das visitas
   * nem abre, e a lista de personagens tem de aparecer rápido.
   */
  function ligarResumos(sb: any) {
    document.querySelectorAll<HTMLButtonElement>('[data-resumo]').forEach((b) => {
      b.addEventListener('click', async () => {
        const antes = b.textContent;
        b.textContent = 'abrindo…'; b.disabled = true;
        try {
          const [{ data, error }, mod] = await Promise.all([
            sb.from('personagens').select('ficha').eq('id', b.dataset.resumo).maybeSingle(),
            import('../lib/ficha-card'),
          ]);
          if (error) { setMsg('Erro ao abrir a ficha: ' + error.message); return; }
          let pos: any = null;
          try { pos = JSON.parse(b.dataset.pos || '{}'); } catch {}
          await mod.abrirFichaResumo(data?.ficha || {}, {
            nome: b.dataset.nome, mesa: b.dataset.mesa || '', retrato: b.dataset.img || null, pos,
          });
        } finally { b.textContent = antes; b.disabled = false; }
      });
    });
  }

  // Só as SUAS filiações. O filtro por user_id é indispensável: a policy
  // membros_select libera todas as linhas das mesas em que você está (é o que
  // faz a lista de membros funcionar no Grupo), então sem ele a consulta volta
  // uma linha por PESSOA de cada mesa. Era isso que duplicava os cards e
  // pintava um "Mestre" com o código de convite: a linha do mestre de verdade.
  async function render(userId: string) {
    const { data, error } = await getSupabase()
      .from('mesa_membros')
      .select('papel, mesa:mesas(id, nome, descricao, codigo_convite, mestre_id)')
      .eq('user_id', userId)
      .order('entrou_em', { ascending: true });
    const lista = document.getElementById('lista')!;
    if (error) { lista.innerHTML = `<p class="erro">Erro ao carregar: ${esc(error.message)}</p>`; return; }
    const linhas = (data || []).filter((r: any) => r.mesa);
    contarAba('mesas', linhas.length);
    if (!linhas.length) { lista.innerHTML = '<p class="muted">Você ainda não está em nenhuma mesa. Crie uma ou entre com um código abaixo.</p>'; return; }
    lista.classList.add('tem-mesas');
    lista.innerHTML = '<div class="mesa-grid">' + linhas.map((r: any) => {
      const m = r.mesa; const mestre = r.papel === 'mestre' || m.mestre_id === userId;
      // O Escudo é do mestre: o jogador entra pelo Grupo, que é a casa dele na
      // mesa. Mandá-lo para /mesa só produziria um redirecionamento visível.
      return `<a class="mesa-card" href="${u(mestre ? 'mesa' : 'mesa/grupo')}?id=${m.id}">
        <span class="papel ${mestre ? 'p-mestre' : 'p-jogador'}">${mestre ? 'Mestre' : 'Jogador'}</span>
        <span class="mesa-nome cinzel">${esc(m.nome)}</span>
        ${m.descricao ? `<span class="mesa-desc">${esc(m.descricao)}</span>` : ''}
        ${mestre ? `<span class="mesa-cod">Convite: <code>${esc(m.codigo_convite)}</code></span>` : ''}
      </a>`;
    }).join('') + '</div>';
  }

  main();
</script>

<!-- is:global: a lista de mesas é criada via JS -->
<style is:global>
  /* A página é painel, não capítulo: fica larga e continua encostada à esquerda,
     como o resto do site (o .wide de global.css centraliza). Quem escolheu
     "centralizar" em /configuracoes continua sendo obedecido.
     A largura do artigo é a das duas colunas somadas, mais o vão entre elas. */
  .content > article.wide { --col-mesas-max: 48rem; max-width: calc(var(--col-mesas-max) * 2 + 2rem); margin-inline: 0 auto; }
  html[data-alinha='centro'] .content > article.wide { margin-inline: auto; }

  /* Personagens de um lado; Mesas e as duas portas de entrada do outro.
     `align-items: start` para a coluna curta não esticar junto com a alta. */
  .mesas-colunas { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem 2rem; align-items: start; }
  /* Cada coluna para de crescer na largura que a coluna de leitura tinha antes
     das duas: em tela larga elas ficam do tamanho de sempre e sobra margem, em
     vez de esticarem até onde a janela deixar. */
  .col-pers, .col-mesas { max-width: var(--col-mesas-max); }
  /* 900px é o mesmo corte em que o card de personagem vira linha, mais abaixo:
     abaixo disso não há largura para duas colunas de nada. */
  @media (max-width: 900px) { .mesas-colunas { grid-template-columns: 1fr; gap: 2rem; } }

  /* ---- as abas do telefone ----
     O mesmo corte de 900px: onde as duas colunas deixam de caber lado a lado,
     elas deixam de ser duas colunas e passam a ser duas abas. Empilhar era a
     saída anterior, e empilhar transforma um painel em documento. */
  .mf-abas { display: none; }
  @media (max-width: 900px) {
    .mf-abas { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem;
      margin: .6rem 0 1.1rem; }
    .mf-abas button { min-height: 46px; display: inline-flex; align-items: center;
      justify-content: center; gap: .4rem; cursor: pointer;
      font-family: 'Cinzel'; font-size: var(--fs-aux); letter-spacing: .02em;
      color: var(--ink-soft); background: var(--panel);
      border: 1px solid var(--rule); border-radius: var(--r-md); }
    .mf-abas button[aria-selected='true'] { color: var(--accent-texto); font-weight: 700;
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 14%, var(--panel)); }
    .mf-n { font-size: var(--fs-micro); font-variant-numeric: tabular-nums; opacity: .75; }
    .mf-abas button[aria-selected='true'] .mf-n { opacity: 1; }
    /* Uma aba por vez. O padrão é Fichas: quem chega aqui quase sempre vem
       escolher um personagem, e quem vem para a mesa vem uma vez por semana. */
    #mesas-conteudo.aba-mesas .col-pers,
    #mesas-conteudo.aba-pers .col-mesas { display: none; }
    /* O título da seção repetiria a aba que está acesa logo acima. O botão de
       criar fica, e toma a linha inteira: é a ação daquela aba.
       O `#mesas-conteudo` não é enfeite: `.secao-mesas h2 { display: flex }`
       vem depois no arquivo, com a mesma especificidade, e ganharia. */
    #mesas-conteudo .secao-cab h2,
    #mesas-conteudo .secao-mesas h2 { display: none; }
    #novo-pers { width: 100%; }
    .mesas-colunas { gap: 1.2rem; }
  }

  .secao-cab { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .secao-cab h2, .secao-mesas h2 { margin: 0; }
  /* Os dois títulos começam na mesma linha: o de Personagens carrega um botão ao
     lado e o de Mesas não, e sem a altura mínima comum eles saem desencontrados. */
  .secao-cab, .secao-mesas h2 { min-height: 2.4rem; }
  .secao-mesas h2 { display: flex; align-items: center; }
  /* O h2 cresce até o botão para que o filete embaixo dele atravesse a coluna,
     como o de Mesas do outro lado. Sem isto um título vem sublinhado de ponta a
     ponta e o outro só embaixo da palavra, e eles estão lado a lado. */
  .secao-cab h2 { flex: 1 1 auto; }
  .secao-fichas { margin-bottom: 0; }
  .secao-mesas h2 { margin-bottom: .8rem; }
  .secao-fichas #lista-pers { margin-top: .9rem; }
  /* colunas do tamanho da moldura (172px) + o respiro do card */
  .pers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1rem; }
  .pers-card { display: flex; flex-direction: column; gap: .3rem; padding: .7rem; border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); color: var(--ink); transition: border-color .15s, transform .15s; }
  .pers-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  /* O link virou uma parte do card em vez do card inteiro: embaixo dele moram
     dois botões, e botão dentro de <a> é marcação inválida e alvo ambíguo. */
  .pc-alvo { display: flex; flex-direction: column; gap: .3rem; text-decoration: none; color: inherit; min-width: 0; }
  .pc-acoes { display: flex; flex-direction: column; gap: .25rem; margin-top: auto; padding-top: .45rem; }
  .pc-b { font: inherit; font-family: 'Cinzel'; font-size: var(--fs-micro); text-align: center;
    padding: .25rem .5rem; border: 1px solid var(--panel-border); border-radius: var(--r-md);
    background: transparent; color: var(--ink); text-decoration: none; cursor: pointer;
    transition: background .15s, border-color .15s; }
  .pc-b:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .pc-b[disabled] { opacity: .55; pointer-events: none; }
  .pc-resumo { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  /* .retrato-frame vem de styles/global.css — a mesma moldura da ficha. Aqui só centraliza
     e mostra o placeholder de quem ainda não tem retrato. */
  .pc-frame { align-self: center; display: grid; place-items: center; }
  .pc-vazio { font-size: 2.4rem; color: var(--ink-soft); opacity: .5; }
  .pc-nome { font-size: var(--fs-aux); font-weight: 700; line-height: 1.2; margin-top: .15rem; }
  .pc-conceito { font-size: var(--fs-rotulo); color: var(--ink-soft); }
  .pc-onde { font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .05em; color: var(--ink-soft); }
  /* No celular o card de personagem vira LINHA: miniatura 64px + textos ao lado, ~88px de
     altura, 6 a 8 por tela. Antes cada card tinha ~600px (retrato grande) e cabia UM por
     tela, o oposto do que uma lista de escolha pede. O retrato grande fica na página do
     personagem, onde ele é o assunto. */
  @media (max-width: 900px) {
    .pers-grid { grid-template-columns: 1fr; gap: .55rem; }
    .pers-card { padding: .55rem .8rem; }
    .pc-alvo { display: grid; grid-template-columns: 64px 1fr; column-gap: .85rem; align-items: center; }
    .pc-alvo .pc-frame { grid-row: 1 / span 3; width: 64px; height: 77px; align-self: center; }
    .pc-vazio { font-size: 1.6rem; }
    .pc-nome { margin-top: 0; }
    /* Numa linha larga e baixa os dois botões cabem lado a lado, e o card não
       cresce de altura por causa deles. */
    .pc-acoes { flex-direction: row; padding-top: .4rem; }
    .pc-b { flex: 1; }
  }
  /* O mesmo card-linha, agora por largura da COLUNA e não da tela. Desde que
     Personagens virou coluna, um notebook de 1180px dá ~390px de coluna, e a
     grade de 190px cabe uma só: o card volta a ser aquele de retrato enorme, um
     por linha, que a regra de cima existe para evitar. O corte de 27rem é onde
     dois cards de moldura (172px) deixam de caber lado a lado.
     As declarações repetem as do bloco acima de propósito: uma condição é de
     tela e a outra é de contêiner, e CSS não deixa somar as duas num seletor. */
  .col-pers { container-type: inline-size; }
  @container (max-width: 27rem) {
    .pers-grid { grid-template-columns: 1fr; gap: .55rem; }
    .pers-card { padding: .55rem .8rem; }
    .pc-alvo { display: grid; grid-template-columns: 64px 1fr; column-gap: .85rem; align-items: center; }
