  .gr-ficha.posto { opacity: .55; }
  .gr-ficha.posto:hover { opacity: 1; }
  .gr-ficha .gr-casa { font-family: 'Cinzel'; font-size: calc(var(--fs-micro) * .85);
    color: var(--accent-texto); letter-spacing: .04em; }
  /* O rótulo do grupo: uma linha fina, para separar sem virar um segundo
     cabeçalho competindo com "Em campo". */
  .gr-grupo-h { display: flex; align-items: baseline; gap: .3rem; font-family: 'Cinzel';
    font-size: calc(var(--fs-micro) * .85); text-transform: uppercase; letter-spacing: .07em;
    color: var(--ink-soft); padding: .3rem .3rem .1rem; border-bottom: 1px solid var(--rule);
    margin-bottom: .1rem; width: 100%; background: none; border-top: 0; border-left: 0;
    border-right: 0; font-weight: 400; cursor: pointer; text-align: left; }
  .gr-grupo-h:first-child { padding-top: 0; }
  .gr-grupo-h:hover { color: var(--ink); border-bottom-color: var(--accent); }
  .gr-grupo-h span { font-variant-numeric: tabular-nums; opacity: .7; }
  /* A seta gira em vez de trocar de glifo: o mesmo desenho virando é o que faz
     a ligação com as outras duas dobras desta coluna. */
  .gr-grupo-h .gg-seta { opacity: .8; display: inline-block; transition: transform .18s ease;
    font-size: 1.1em; line-height: 1; }
  .gr-grupo-h.fechado .gg-seta { transform: rotate(-90deg); }
  @media (prefers-reduced-motion: reduce) { .gr-grupo-h .gg-seta { transition: none; } }
  .gr-grupo-c { display: flex; flex-direction: column; gap: .2rem; }

  /* ---- registro ---- */
  /* Com as colunas mais estreitas, "Em campo" e o "+ NPC" já não cabem lado a
     lado: o título vira duas linhas e desalinha tudo. Quebrar a FILEIRA em vez
     do título mantém a palavra inteira e desce o botão. */
  .gr-reg-cab { display: flex; align-items: center; gap: .3rem; margin-top: .7rem; flex-wrap: wrap; }
  .gr-reg-cab .col-h { white-space: nowrap; }
  .gr-reg-cab:first-child { margin-top: 0; }
  .gr-reg-cab .col-h { flex: 1; margin: 0; }
  .gr-dobra { flex: 0 0 auto; line-height: 1; transition: transform .18s ease; }
  /* Encolhida, a lista some e o Registro fica com a coluna inteira: numa sessão
     longa o que se lê é o histórico, e não a lista de quem está em campo, que o
     próprio tabuleiro já mostra. */
  .gr-lado.dobrada #gr-lista, .gr-lado.dobrada #gr-dica { display: none; }
  .gr-lado.dobrada #gr-dobrar { transform: rotate(-90deg); }
  .gr-lado.dobrada .gr-log { max-height: calc(100vh - var(--mesa-barra-h, 66px) - 11rem); }
  /* E o contrário: recolher o Registro devolve a altura a "Em campo". Numa cena
     de quinze, a lista é que não cabe, e o histórico é o que se lê depois. */
  .gr-lado.log-dobrado #gr-log { display: none; }
  .gr-lado.log-dobrado #gr-dobrar-log { transform: rotate(-90deg); }
  .gr-lado.log-dobrado .gr-lista { max-height: calc(100vh - var(--mesa-barra-h, 66px) - 12rem); }
  /* Recolhido, o cabeçalho do Registro desce e encosta no pé da coluna: é onde
     a mão vai procurá-lo para abrir de novo. */
  .gr-lado.log-dobrado .gr-reg-log { margin-top: auto; }
  .gr-log { display: flex; flex-direction: column; gap: .1rem; max-height: 30vh; overflow-y: auto;
    font-size: var(--fs-micro); margin-top: .3rem; }
  .gr-log .lg { display: flex; gap: .35rem; align-items: baseline;
    padding: .12rem 0; border-bottom: 1px solid color-mix(in srgb, var(--rule) 55%, transparent); }
  .gr-log .lg-h { color: var(--ink-soft); font-variant-numeric: tabular-nums;
    font-size: calc(var(--fs-micro) * .85); flex: 0 0 auto; }
  .gr-log .lg-t { flex: 1; min-width: 0; }
  .gr-log .lg-so { flex: 0 0 auto; cursor: help; }
  .gr-log .casa { font-family: 'Cinzel'; color: var(--accent-texto); }
  .nota-mini { font-size: var(--fs-micro); margin: .1rem 0 .4rem; }

  /* ---- o registro inteiro ---- */
  /* A linha de instrução acompanha o tamanho da lista, e não o do corpo do
     texto: ela explica dois ícones, e lida maior que as próprias linhas fica
     com mais peso do que o conteúdo que descreve. */
  #rg-conta { font-size: var(--fs-micro); margin: 0; }
  .rg-lista { display: flex; flex-direction: column; gap: .1rem; max-height: 58vh; overflow-y: auto;
    margin: .3rem 0; padding-right: .2rem; }
  .rg-l { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; gap: .4rem;
    padding: .2rem .3rem; border-bottom: 1px solid color-mix(in srgb, var(--rule) 55%, transparent);
    font-size: var(--fs-micro); }
  .rg-l:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .rg-h { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .rg-so { cursor: help; }
  .rg-t { min-width: 0; overflow-wrap: anywhere; }
  .rg-t .casa { font-family: 'Cinzel'; color: var(--accent-texto); }
  /* Os botões só aparecem na linha sob o ponteiro: com trezentas linhas, dois
     ícones em cada uma viram uma parede de ícones e o texto some no meio. */
  .rg-acs { display: flex; gap: .1rem; opacity: 0; }
  .rg-l:hover .rg-acs, .rg-l:focus-within .rg-acs { opacity: 1; }
  .rg-acs button { background: none; border: 0; color: var(--ink-soft); cursor: pointer;
    font: inherit; padding: 0 .25rem; line-height: 1; }
  .rg-acs button:hover { color: var(--accent); }
  .rg-acs button.perigo:hover { color: var(--perigo); }
  .rg-in { width: 100%; font: inherit; font-size: var(--fs-micro); padding: .1rem .3rem;
    background: var(--panel-2, var(--panel)); color: var(--ink);
    border: 1px solid var(--accent); border-radius: var(--r-sm); }
  .rg-ef { color: var(--accent-texto); }
  .rg-vazio { color: var(--ink-soft); font-style: italic; padding: .4rem; }

  /* ---- diálogo do fundo ---- */
  .fd-lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr)); gap: .4rem;
    max-height: 46vh; overflow-y: auto; margin: .4rem 0; }
  .fd-item { border: 1px solid var(--rule); border-radius: var(--r-md); overflow: hidden;
    cursor: pointer; background: var(--panel-2, var(--panel)); }
  .fd-item.sel { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent); }
  .fd-item img { width: 100%; height: 5rem; object-fit: cover; display: block; }
  .fd-item span { display: block; padding: .2rem .35rem; font-size: var(--fs-micro);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fd-arte { position: relative; }
  /* Os botoes ficam SEMPRE a vista, e nao so sob o ponteiro: o mestre no tablet
     nao tem passagem de mouse, e e justamente la que ele arruma a mesa antes da
     sessao. A tarja atras deles e o que os salva de sumir num mapa claro. */
  .fd-acs { position: absolute; top: .2rem; right: .2rem; display: flex; gap: .1rem;
    padding: .1rem; border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--bg) 72%, transparent); }
  .fd-acs button { background: none; border: 0; color: var(--ink); cursor: pointer;
    font: inherit; font-size: var(--fs-micro); line-height: 1; padding: .12rem .28rem;
    border-radius: var(--r-sm); }
  .fd-acs button:hover { background: var(--accent); color: var(--on-accent, var(--bg)); }
  .fd-acs button.perigo:hover { background: var(--perigo); color: var(--on-perigo, #fff); }
  .fd-med { color: var(--ink-soft); padding-top: 0 !important; }
  /* A arte em pe e a que o tabuleiro nao sabe usar: ela se anuncia. */
  .fd-item.fd-empe .fd-med { color: var(--perigo); }
  .fd-item.ocupado { opacity: .45; pointer-events: none; }
</style>

<script>
  import {
    abrirMesa, u, esc, avatarHTML, urlsImagens, pctDe, novoId, debounce,
    semMigracao14, avisoMigracao, tierDe, tierCls, somarCondicoes, COND, nomesDe,
  } from '../../lib/mesa-core';
  import {
    abrirCanal, nomeParaPresenca, type Canal, type Assunto, type Motivo, type Ping,
  } from '../../lib/mesa-tempo-real';
  import { MON, resumoDe, iniDeMonstro, d6, cardCriaturaHTML, criaturaCompleta } from '../../lib/mesa-bestiario';
  import { rolarIniciativaPC, resumoFicha } from '../../lib/mesa-ficha';
  import { mana as manaDaFicha } from '../../lib/calc';
  import {
    centroHex, verticesHex, tabuleiro, medidaTabuleiro, margemTabuleiro,
    hexEmPonto, dentro, chaveHex, distanciaHex, nomeHex, larguraHex,
    offsetParaAxial, letraColuna,
  } from '../../lib/hex';
  import { uiConfirmar, uiErro, uiFormulario } from '../../lib/ui-dialog';
  import { girarMapa, excluirMapa, medidaDeMapa, type Giro } from '../../lib/mesa-mapas';
  import { caminhoSeta, SETA_PADRAO, type EstiloSeta, type TipoSeta } from '../../lib/seta';
  import {
    carregarEfeitos, efeitosAtivos, pintarEfeitos, pintarPainelEfeitos, conjurar,
    verificarEfeitos, novoNPC as novoNPCArtes, ligarBotaoFx, type CtxGrid,
  } from '../../lib/artes-grid-mesa';
  import {
    camadaDeGolpes, baterNoAlvo, voarProjetil, projetilDe,
  } from '../../lib/grid-golpe-fx';
  import { armaDoSlot } from '../../lib/equip';
  import { rolarExpr, descreverRolada, tipoDeDano } from '../../lib/rolagem';
  import { reconciliar, esquecerCaixa } from '../../lib/reconciliar';
  import {
    abrirEscolhaDoTempo, resumoDoTempo, fitaHTML, seloFaseHTML, abrirAbortar, podeAbortar,
    itensDaFila,
  } from '../../lib/mesa-tempo-ui';
  import {
    combateDaMesa, COMBATE_PADRAO, faseEm, acaoVazia, temGesto, resumoDaAcao,
    anatomia, declarar, defesaPerdida, classeDeTempo, velocidadeDaArma, tetoDaRajada,
    rolaNoSite, ticksDeDeslocamento, armaDoCatalogo,
    FASE_ROTULO, type CombateMesa, type Manobra,
  } from '../../lib/combate-tempo';

  const el = (i: string) => document.getElementById(i)!;

  let SB: any, ID = '', MESTRE = false, EU = '';
  // O contexto da mesa, guardado porque o painel do tempo precisa dele.
  let CTX: any = null;
  // Como o tempo passa nesta mesa: o sistema (normal ou P/G/R) e a marcação.
  // Mora em `mesas.combate` (migração 27) e é a MESMA escolha do rastreador de
  // combate: as duas telas leem do mesmo lugar.
  let TEMPO: CombateMesa = { ...COMBATE_PADRAO };
  let ARENAS: any[] = [];
  let ARENA: any = null;
  let ENC: any = null;
  let COMBS: any[] = [];
  let TOKENS: Record<string, { q: number; r: number }> = {};
  let IMGS: Record<string, string> = {};
  let PC_IMG: Record<string, string> = {};
  let IMG_FUNDO = '';
  let ZOOM = 1;
  // Enquadramento da arte: x e y em % do tabuleiro (0 = centrado), z sobre a
  // escala "caber". Guardar em % e não em pixels é o que faz o enquadramento
  // sobreviver a uma mudança no número de colunas.
  let FUNDO = { x: 0, y: 0, z: 1, rot: 0 };
  let GRADE: {
    cor?: string; op?: number; vezCor?: string; vezForca?: number;
    setaMov?: EstiloSeta & { cor?: string; op?: number };
    setaAtq?: EstiloSeta & { cor?: string; op?: number };
  } = {};
  /** As duas setas, e onde cada uma mora na aparência da arena. */
  const SETAS_UI = [
    { p: 'sm', chave: 'setaMov' as const, padrao: { ...SETA_PADRAO } },
    // A de ataque nasce pontilhada e mais curva: ela cruza o tabuleiro por cima
    // de tudo, e precisa não ser confundida com o caminho que alguém andou.
    { p: 'sa', chave: 'setaAtq' as const, padrao: { ...SETA_PADRAO, tipo: 'pontilhada' as TipoSeta, arco: 24, ponta: 11 } },
  ];
  const estiloSeta = (chave: 'setaMov' | 'setaAtq'): EstiloSeta => {
    const u = SETAS_UI.find((s) => s.chave === chave)!;
    return { ...u.padrao, ...(GRADE[chave] || {}) };
  };
  let BASE = 1;            // a escala que faz a arte inteira caber no tabuleiro
  let AJUSTANDO = false;
  let LOG: any[] = [];
  let ROTULOS = true;                                  // letras e números nas bordas
  let ALCANCE: { cid: string; metros: number } | null = null;  // o anel de alcance aceso
  // Bloco de combate por combatente (defesas e absorção). Só o mestre monta:
  // ele depende da ficha dos personagens, que o jogador não lê dos colegas.
  let RESUMO: Record<string, any> = {};
  // A ficha crua por personagem, que as Artes leem (Artes, Efeitos comprados,
  // Centelha e equipamento). Vem do mesmo carregamento que monta o RESUMO.
  let FICHAS: Record<string, any> = {};
  /**
   * Quais peças são MINHAS, do ponto de vista de quem está olhando.
   *
   * `MEUS` são os personagens do jogador (a RLS de `personagens` só devolve os
   * dele, então a lista chega pronta do banco). `INVOQUEI` são as peças que ele
   * trouxe ao mundo nesta sessão: a invocação não é personagem de ninguém, mas
   * quem a chamou tem de poder movê-la. O banco sabe disso pela coluna
   * `criado_por`; aqui a memória é da sessão, e por isso um F5 faz o jogador
   * perder o arrasto da própria invocação (o mestre continua movendo).
   */
  let MEUS = new Set<string>();
  const INVOQUEI = new Set<string>();
  const minhaPeca = (c: any) => !!c
    && ((c.personagem_id && MEUS.has(c.personagem_id)) || INVOQUEI.has(c.id));
  /** Quem pode mandar nesta peça: o mestre em todas, o jogador nas dele. */
  const mandoNela = (c: any) => MESTRE || minhaPeca(c);
  // A ficha DIGERIDA por combatente, e no mesmo formato para gente e para bicho:
  // a conta da ficha do personagem e o bloco do bestiário chegam aqui como a
  // mesma coisa, e quem desenha o tabuleiro não precisa saber de qual dos dois
  // veio o número. É daqui que sai a Mana, e é aqui que entram os próximos
  // (Fôlego, Energia, passivos, Artes conhecidas).
  let PERFIL: Record<string, any> = {};
  // O canal da mesa. Null enquanto a página abre, e null para sempre se o
  // realtime não subir: tudo o que depende dele é opcional por construção.
  let RT: Canal | null = null;

  /**
   * O que a aba empresta ao módulo das Artes.
   *
   * Montado na hora a cada chamada, e não guardado: `ARENA`, `COMBS` e `TOKENS`
   * trocam de identidade a cada recarga, e um contexto guardado apontaria para
   * a lista da cena anterior.
   */
  // ===================================================== quem escreve no banco
  /**
   * O mestre escreve direto na tabela; o jogador pede a uma função.
   *
   * A migração 22 explica o porquê em detalhe, e o resumo é: RLS filtra LINHA, e
   * o que precisa ser filtrado quando o jogador lança dano é COLUNA. Uma policy
   * de update em `combatentes` deixaria a mesma chamada mexer no pv_max, no
   * nome e no `oculto` do inimigo escondido. As funções `jogador_*` conferem
   * quem está pedindo e escrevem só o que aquele verbo permite.
   *
   * Do lado de cá, o formato de retorno é o mesmo dos dois lados (`{ error }`),
   * então o resto do arquivo não precisa saber quem está jogando.
   */
  const gravarPeca = (cid: string, campos: Record<string, any>) => (MESTRE
    ? SB.from('combatentes').update(campos).eq('id', cid)
    : SB.rpc('jogador_muda_peca', { p_comb: cid, p_dados: campos }));

  const gravarToken = (cid: string, q: number, r: number, em: string) => (MESTRE
    ? SB.from('arena_tokens').upsert({ arena_id: ARENA.id, combatente_id: cid, q, r, movido_em: em },
        { onConflict: 'arena_id,combatente_id' })
    : SB.rpc('jogador_mover', { p_arena: ARENA.id, p_comb: cid, p_q: q, p_r: r }));

  const apagarToken = (cid: string) => (MESTRE
    ? SB.from('arena_tokens').delete().eq('arena_id', ARENA.id).eq('combatente_id', cid)
    : SB.rpc('jogador_tira_do_mapa', { p_arena: ARENA.id, p_comb: cid }));

  /**
   * O Supabase que o módulo das Artes recebe quando quem conjura é o jogador.
   *
   * Aquele módulo escreve direto (`ctx.SB.from(...).insert(...)`), e está certo:
   * ele é a cola entre o motor e a aba, e não tem por que saber que existe
   * mestre e jogador. Então em vez de espalhar o `if` por lá, a aba entrega um
   * objeto com a mesma cara que desvia as ESCRITAS para as funções do banco. As
   * leituras passam direto, porque o próprio módulo já escolhe a view do jogador
   * quando `ctx.mestre` é falso.
   *
   * Cobre as cinco formas que aquele arquivo usa (`select`, `insert`, `upsert`,
   * `update .eq`, `delete .eq`). Uma forma nova falha alto, com função
   * inexistente, em vez de gravar errado em silêncio.
   */
  function sbDoJogador(): any {
    const pedido = (executa: (st: Record<string, any>) => Promise<any>) => {
      const st: Record<string, any> = {};
      const o: any = {
        eq: (col: string, v: any) => { st[col] = v; return o; },
        select: () => o, limit: () => o, single: () => o, maybeSingle: () => o,
        then: (ok: any, ko: any) => executa(st).then(ok, ko),
      };
      return o;
    };
    const nao = (o: string) => ({ data: null, error: { message: `Jogador não pode ${o}.` } });
    return {
      rpc: (...a: any[]) => (SB as any).rpc(...a),
      from: (tab: string) => ({
        select: (cols?: string) => SB.from(tab).select(cols),
        insert: (linha: any) => pedido(async () => {
          if (tab === 'arena_efeitos') return await SB.rpc('jogador_conjura', { p_dados: linha });
          if (tab === 'combatentes') {
            const r = await SB.rpc('jogador_invoca', { p_arena: ARENA.id, p_dados: linha });
            for (const n of r.data || []) INVOQUEI.add(n.id);
            return r;
          }
          return nao(`criar em ${tab}`);
        }),
        upsert: (linha: any) => pedido(async () => (tab === 'arena_tokens'
          ? await SB.rpc('jogador_mover',
              { p_arena: linha.arena_id, p_comb: linha.combatente_id, p_q: linha.q, p_r: linha.r })
          : nao(`gravar em ${tab}`))),
        update: (campos: any) => pedido(async (st) => {
          if (tab === 'combatentes') return await SB.rpc('jogador_muda_peca', { p_comb: st.id, p_dados: campos });
          if (tab === 'arena_efeitos') return await SB.rpc('jogador_muda_efeito', { p_id: st.id, p_dados: campos });
          return nao(`mudar ${tab}`);
        }),
        delete: () => pedido(async (st) => (tab === 'arena_efeitos'
          ? await SB.rpc('jogador_apaga_efeito', { p_id: st.id })
          : nao(`apagar de ${tab}`))),
      }),
    };
  }

  const ctxArtes = (): CtxGrid => ({
    SB: MESTRE ? SB : sbDoJogador(), arena: ARENA, enc: ENC, combs: COMBS, tokens: TOKENS,
    resumo: RESUMO, fichas: FICHAS, raio: RAIO, mestre: MESTRE,
    hexNaTela,
    // O agora do tabuleiro é o tick de quem está na vez, o mesmo que a coluna
    // de iniciativa mostra. `encontros.tick_atual` é da aba Combate.
    tickAgora: () => relogio(),
    // Tudo que o módulo das Artes escreve no registro sai marcado com `ef`.
    // É essa marca que o "refazer o log dos efeitos" usa para saber o que
    // apagar, e marcar aqui, no ponto por onde tudo passa, evita espalhar a
    // etiqueta por dez chamadas lá dentro.
    logar: (c: any, txt: string, extra: Record<string, any>) => logar(c, txt, { ...extra, ef: true }),
    // A Mana sai da reserva de quem conjurou. O módulo calcula o custo e não
    // sabe o que é reserva; a aba é dona do banco, da barra e da regra de não
    // ficar devendo.
    gastarMana,
    // O tempo sai do mesmo lugar que a Mana, e pela mesma razão: o módulo sabe
    // quanto custou, a aba sabe quem está jogando e quem pode escrever.
    declararTempo,
    // A moldura dos rótulos empurra o tabuleiro: quem desenha a grade é quem
    // sabe onde ela começa, então as camadas das Artes pedem em vez de calcular.
    margem, medida,
    // As Artes escrevem em três lugares (o efeito, a peça invocada, a Vida e as
    // condições de quem foi mordido) e sempre terminam chamando um destes dois.
    // A campainha toca AQUI, e não dentro de cada escrita lá: assim o módulo das
    // Artes continua sem saber que existe tempo real.
    recarregar: async () => { await carregar(); avisarMudancas(); },
    repintar: () => {
      repintarEfeitos();
      pintarTokens(); pintarLista(); pintarIniciativa(); pintarAlcance();
      avisarMudancas();
    },
    repintarEfeitos,
  });

  /**
   * Só as camadas que as Artes mexem.
   *
   * A névoa entra aqui porque fogo e luz clareiam: acender uma fogueira abre um
   * pedaço do mapa, e apagá-la fecha de volta.
   *
   * Separado do `repintar()` cheio porque `verificarEfeitos` roda depois de toda
   * peça movida e de toda vez encerrada, e nesses caminhos as peças, a fila e o
   * registro já foram desenhados por quem chamou. Ver `CtxGrid.repintarEfeitos`.
   */
  function repintarEfeitos() {
    pintarNevoa();
    pintarEfeitos(ctxArtes(), el('gr-efeitos') as unknown as SVGElement);
    pintarPainelEfeitos(ctxArtes(), el('gr-ef-lista'));
    avisarMudancas();
  }

  // O raio do hexágono em pixels do MUNDO. O zoom é um `scale` por cima, então
  // este número não muda: mudar o raio redesenharia o SVG a cada passo de zoom.
  const RAIO = 34;

  async function main() {
    const ctx = await abrirMesa('grid');
    if (!ctx) return;
    SB = ctx.sb; ID = ctx.id; MESTRE = ctx.ehMestre; EU = ctx.user.id; CTX = ctx;
    TEMPO = combateDaMesa(ctx.mesa);

    document.body.classList.add('pagina-grid');
    if (MESTRE) { el('gr-btns').hidden = false; el('gr-dica').hidden = false; }
    ligarBarra();
    ligarAparencia();
    ligarArrasto();
    ligarMenuToken();
    ligarMira();
    ligarNevoa();
    ligarSom();
    ligarReguaENavegacao();
    ligarTelaCheia();
    ligarCusto();
    ligarIniciativa();
    ligarBotaoFx(ctxArtes, el('gr-fx'), el('gr-fx-cfg'));
    // A altura depende do que sobra da janela: refazer no redimensionamento é o
    // que mantém o mapa colado no pé da tela quando a janela muda de tamanho.
    addEventListener('resize', debounce(() => ajustarAltura(), 150));
    await carregar();
    // Depois do primeiro desenho, e não antes: quem acaba de ler tudo não tem o
    // que ressincronizar, e um aviso chegando no meio do carregamento pediria
    // uma segunda leitura da mesma coisa.
    await ligarTempoReal(ctx);
  }

  // =============================================================== carregar
  async function carregar() {
    const aviso = el('gr-aviso');
    aviso.innerHTML = '';

    // As arenas. O mestre lê a tabela; o jogador lê a view, que só entrega a ativa.
    //
    // A ordenação é só do mestre, e isto não é detalhe: `ordem` e `criado_em`
    // são colunas de bastidor e não estão na view. Pedi-las ao jogador fazia o
    // Postgres responder "column arena_visao.ordem does not exist", que a tela
    // lia como "falta a migração 15" e mandava rodar de novo um SQL já
    // aplicado. Com uma arena ativa por mesa, a view devolve uma linha só:
    // ordenar não teria o que ordenar.
    let consulta = SB.from(MESTRE ? 'mesa_arenas' : 'arena_visao').select('*').eq('mesa_id', ID);
    if (MESTRE) consulta = consulta.order('ordem', { ascending: true }).order('criado_em', { ascending: true });
    const { data: arenas, error } = await consulta;
    if (error) {
      // Dois erros parecidos e conselhos opostos. Sem a migração, o Postgres diz
      // "does not exist" e a saída é rodar o SQL. Já o PostgREST guarda um cache
      // do schema e, nos primeiros segundos depois de uma tabela nova, responde
      // "Could not find the table … in the schema cache" — a tabela existe, e
      // mandar rodar de novo uma migração já aplicada é o pior palpite possível.
      // "relation … does not exist" é tabela faltando; "column … does not exist"
      // é consulta errada, e mandar rodar uma migração por causa dela é o pior
      // conselho possível: já aconteceu, e escondeu um bug de verdade por
      // semanas atrás de uma mensagem tranquilizadora.
      const semTabela = /relation .* does not exist|undefined table/i.test(error.message);
      const cacheVelho = error.code === 'PGRST205' || /schema cache/i.test(error.message);
      if (semTabela && !cacheVelho) {
        avisoMigracao(aviso, 'O tabuleiro de hexágonos');
        aviso.querySelector('p')!.innerHTML =
          'Rode <code>supabase/migracao-15.sql</code> no SQL Editor do Supabase para ligar esta aba.';
        return;
      }
      if (cacheVelho) {
        aviso.innerHTML = `<div class="aviso"><strong>O banco acabou de mudar.</strong>
          <p class="muted">A tabela existe; o cache de schema do Supabase ainda não a viu.
          Recarregue em alguns segundos.</p>
          <p><button class="btn mini" id="gr-tentar">Tentar de novo</button></p></div>`;
        el('gr-tentar').onclick = () => carregar();
        return;
      }
      aviso.innerHTML = `<p class="erro">${esc(error.message)}</p>`;
      return;
    }
    ARENAS = arenas || [];
    // `?arena=` é como a aba Mapas entrega uma arena recém-criada: ela ainda não
    // está em jogo (pôr em jogo troca o que o grupo vê, e isso é decisão de um
    // clique só do mestre), então sem este atalho o Grid abriria na arena antiga
    // e o mapa que acabou de ser escolhido não apareceria.
    const pedida = new URLSearchParams(location.search).get('arena');
    ARENA = (pedida && ARENAS.find((a) => a.id === pedida))
      || ARENAS.find((a) => a.ativa) || ARENAS[0] || null;

    if (!ARENA) {
      el('gr-tudo').hidden = true;
      aviso.innerHTML = MESTRE
        ? `<div class="painel"><p class="vazio">Nenhuma arena ainda. Uma arena é o chão de uma cena: a ponte, a cripta, o pátio.</p>
           <div class="bloco-acoes"><button class="btn primary" id="gr-primeira">Criar a primeira arena</button></div></div>`
        : '<div class="painel"><p class="vazio">O mestre ainda não pôs uma arena em jogo.</p></div>';
      if (MESTRE) el('gr-primeira').onclick = () => abrirArena(null);
      return;
    }
    el('gr-tudo').hidden = false;
    lerNevoa();

    await carregarCombatentes();
    await carregarTokens();
    await carregarEfeitos(ctxArtes());
    await carregarLog();
    pintar();
  }

  /**
   * O registro, pelo caminho de cada um.
   *
   * O mestre lê a coluna `log` da própria arena, que ele já tem na mão. O
   * jogador lê `arena_log_visao`, uma linha por entrada, e pede só as 60
   * últimas: antes ele baixava o log INTEIRO (até 300 entradas) a cada peça
   * movida, o que num tempo real vira a conta mais cara da página.
   *
   * Banco sem a migração 20: a view não existe, e o log volta a vir de dentro
   * de `arena_visao`, como vinha. O aviso de "rode a migração" não aparece de
   * propósito, porque nada quebrou.
   */
  let SEM_LOG_VISAO = false;
  async function carregarLog(doBanco = false) {
    if (MESTRE) {
      // Na abertura o log já veio junto com a arena, e pedir de novo seria uma
      // ida ao servidor por nada. `doBanco` é o caso do tempo real: a cópia em
      // memória desta aba é de antes do que a outra tela acabou de escrever.
      if (doBanco && ARENA?.id) {
        const { data } = await SB.from('mesa_arenas').select('log').eq('id', ARENA.id).maybeSingle();
        if (Array.isArray(data?.log) && ARENA) ARENA.log = data.log;
      }
      LOG = Array.isArray(ARENA?.log) ? ARENA.log : [];
      return;
    }
    if (!SEM_LOG_VISAO) {
      const { data, error } = await SB.from('arena_log_visao')
        .select('id, ts, txt, ord').eq('arena_id', ARENA.id)
        .order('ord', { ascending: false }).limit(60);
      // Vieram do mais novo para o mais velho, para o corte pegar o fim da
      // história; a tela lê do começo.
      if (!error) { LOG = (data || []).slice().reverse(); return; }
      // Uma vez que a view não existe, ela não vai passar a existir no meio da
      // sessão: insistir custaria uma requisição perdida por peça movida.
      SEM_LOG_VISAO = true;
    }
    // Banco anterior à migração 20: o registro ainda vem pendurado na arena, e
    // desce inteiro. Por isso só é rebuscado quando chegou linha nova de fato,
    // e nunca na abertura, quando ele já veio junto.
    if (doBanco && ARENA?.id) {
      const { data } = await SB.from('arena_visao').select('log').eq('id', ARENA.id).maybeSingle();
      if (Array.isArray(data?.log)) ARENA.log = data.log;
    }
    LOG = Array.isArray(ARENA?.log) ? ARENA.log : [];
  }

  /** O encontro ativo e quem está nele. É de lá que saem os tokens. */
  async function carregarCombatentes() {
    ENC = null; COMBS = [];
    const { data: encs } = await SB.from(MESTRE ? 'encontros' : 'encontro_visao')
      .select('*').eq('mesa_id', ID).eq('ativo', true).limit(1);
    ENC = (encs || [])[0] || null;
    if (!ENC) return;
    const { data, error } = await SB.from(MESTRE ? 'combatentes' : 'combate_visao')
      .select('*').eq('encontro_id', ENC.id);
    if (error && !MESTRE && semMigracao14(error)) {
      const r = await SB.from('combatentes').select('*').eq('encontro_id', ENC.id);
      COMBS = (r.data || []).filter((c: any) => !c.oculto);
    } else {
      COMBS = data || [];
    }
    COMBS = COMBS.filter((c: any) => c.ativo !== false)
      .sort((a: any, b: any) => (a.tick - b.tick) || String(a.nome).localeCompare(String(b.nome)));

    // Retratos: o do PC vive no bucket `personagens`, o avulso no `mesa`, e o da
    // criatura é arte estática do site.
    //
    // O caminho do retrato do PC chega de dois jeitos diferentes conforme quem
    // pergunta: `combate_visao` já entrega a coluna `retrato` pronta ao jogador,
    // mas a TABELA `combatentes`, que é o que o mestre lê, não tem essa coluna.
    // Sem esta busca o mestre via os personagens como letra dentro de um
    // círculo, justamente ele, que é quem move as peças.
    PC_IMG = {}; RESUMO = {}; PERFIL = {};
    // Quais personagens são deste jogador. A RLS de `personagens` já responde
    // isso sozinha: ao jogador ela devolve só os dele.
    if (!MESTRE) {
      // O JOGADOR DIGERE A PRÓPRIA FICHA, E SÓ ELA.
      //
      // Antes ele não digeria nenhuma: o bloco todo era do mestre, e do lado do
      // jogador `RESUMO` ficava vazio até para a peça dele. Dava para viver com
      // isso enquanto o tabuleiro só desenhava; com o ataque ligado ao P/G/R
      // deixou de dar, porque a régua sai da arma, e sem ficha ela caía no
      // atalho (leve, 5 Ticks): um jogador de martelo declararia 5 Ticks em vez
      // de 7, e o relógio dele andaria errado.
      //
      // A RLS de `personagens` responde "quais são as minhas" sozinha, então
      // esta consulta não vaza nada: a ficha do colega não vem, e a do inimigo
      // não existe. O bloco de combate dos OUTROS continua sem ser montado aqui
      // de propósito — montá-lo seria pôr a Absorção do ogro no navegador do
      // jogador, a um console.log de distância.
      const { data: meus } = await SB.from('personagens')
        .select('id, imagem_path, ficha').eq('mesa_id', ID);
      MEUS = new Set((meus || []).map((p: any) => p.id));
      const fichas: Record<string, any> = {};
      for (const p of meus || []) {
        if (p.imagem_path) PC_IMG[p.id] = p.imagem_path;
        if (p.ficha) fichas[p.id] = p.ficha;
      }
      for (const c of COMBS) {
        if (!c.personagem_id || !fichas[c.personagem_id]) continue;
        try { RESUMO[c.id] = resumoDe(c, fichas); } catch { /* ficha velha: segue sem */ }
        try { PERFIL[c.id] = perfilDe(c, fichas); } catch { /* idem */ }
      }
      FICHAS = fichas;
    }
    if (MESTRE) {
      const ids = [...new Set(COMBS.map((c: any) => c.personagem_id).filter(Boolean))];
      const fichas: Record<string, any> = {};
      if (ids.length) {
        const { data: ps } = await SB.from('personagens').select('id, imagem_path, ficha').in('id', ids);
        for (const p of ps || []) {
          if (p.imagem_path) PC_IMG[p.id] = p.imagem_path;
          if (p.ficha) fichas[p.id] = p.ficha;
        }
      }
      // As mesmas contas do rastreador: Defesa, Absorção e o resto saem de
      // `resumoDe`, que mescla o bloco de origem (ficha ou bestiário) com os
      // ajustes que o mestre salvou naquele combatente.
      for (const c of COMBS) {
        try { RESUMO[c.id] = resumoDe(c, fichas); } catch { RESUMO[c.id] = null; }
        try { PERFIL[c.id] = perfilDe(c, fichas); } catch { PERFIL[c.id] = null; }
      }
      // As Artes precisam da ficha inteira, e não só do resumo de combate: é de
      // lá que saem as Artes do personagem, os Efeitos que ele comprou, a
      // Centelha e o equipamento que um efeito pode pegar.
      FICHAS = fichas;
      await semearMana();
    }
    const daMesa = COMBS.map((c: any) => c.imagem).filter(Boolean);
    const dosPCs = [...COMBS.map((c: any) => c.retrato).filter(Boolean), ...Object.values(PC_IMG)];
    const [m1, m2] = await Promise.all([
      urlsImagens(SB, daMesa, 'mesa'),
      urlsImagens(SB, dosPCs, 'personagens'),
    ]);
    IMGS = { ...m1, ...m2 };
  }

  // ------------------------------------------------------- a ficha digerida
  /**
   * O que a ficha (ou o bloco do bestiário) diz desta peça, no mesmo formato
   * para os dois.
   *
   * O tabuleiro sempre soube ler o BLOCO DE COMBATE dos dois lados (`resumoDe`
   * faz isso desde o começo); o que faltava era o resto da ficha, que é de onde
   * saem os recursos e o repertório. Uma criatura do bestiário tem atributos,
   * Vontade, Centelha, Virtudes, Artes e Técnicas escritos exatamente como um
   * personagem tem, e o mestre precisa dos dois na mesma tela.
   */
  function perfilDe(c: any, fichas: Record<string, any>): any {
    if (c.tipo === 'pc' && fichas[c.personagem_id]) {
      const R = resumoFicha(fichas[c.personagem_id]);
      return {
        origem: 'ficha', centelha: R.centelha, vontade: R.vontade, aparencia: R.aparencia,
        // Mana só existe para quem despertou: a reserva é da Centelha, e um
        // mortal com Vontade alta continua sem uma gota.
        mana: R.centelha > 0 ? R.mana : 0,
        energia: R.energia, folego: R.folego, pv: R.pv,
        attrs: R.attrs, skills: R.skills, skills2: R.skills2, virtudes: R.virtudes,
        artes: R.artes, tecnicas: R.tecnicas, passivos: R.passivos,
        defesas: { esquiva: R.defEsquiva, bloqueio: R.defBloqueio, social: R.defSocial, mental: R.defMental },
        iniciativa: R.iniciativa, ficha: R,
      };
    }
    const m = MON[c.monstro_id];
    if (!m) return null;
    const nivelArte = (id: string) => (m.artes || []).find((a: any) => a.id === id)?.nivel || 0;
    const cent = m.centelha || 0, vont = m.vontade || 0;
    return {
      origem: 'bestiario', centelha: cent, vontade: vont, aparencia: m.aparencia || 0,
      mana: cent > 0 ? manaDaFicha({ centelha: cent, vontade: vont, manipulacao: nivelArte('manipulacao-mana') }) : 0,
      energia: m.combate?.energia ?? null, folego: m.combate?.folego ?? null, pv: m.combate?.pv ?? null,
      attrs: m.atributos || {}, skills: {}, skills2: {}, virtudes: m.virtudes || {},
      artes: m.artes || [], tecnicas: m.tecnicas || [], passivos: [],
      defesas: { esquiva: m.combate?.defesa ?? null, bloqueio: null,
        social: m.combate?.defesaSocial ?? null, mental: m.combate?.defesaMental ?? null },
      iniciativa: m.combate?.iniciativa || '', bloco: m,
    };
  }

  /**
   * A reserva de Mana de quem ainda não tem uma, escrita na linha do combatente.
   *
   * A conta é da ficha, mas o GASTO é da mesa, e por isso o número precisa morar
   * no banco: a ficha diz quanto o personagem tem em pé, não quanto sobrou
   * depois da terceira Arte da noite. Semear aqui, e não ao criar o combatente,
   * conserta sozinho os encontros que já existiam antes da migração 21.
   *
   * Quem não tem Centelha não recebe nada, e é isso que separa "reserva vazia"
   * (zero de seis) de "não lida com Mana" (nulo).
   */
  async function semearMana() {
    const faltam = COMBS.filter((c: any) => c.mana_max == null && (PERFIL[c.id]?.mana ?? 0) > 0);
    if (!faltam.length) return;
    // Uma ida ao banco para todo mundo, e não uma por peça.
    //
    // Era um `await` dentro do laço, e o laço tem o tamanho da cena: abrir um
    // encontro novo de trinta custava vinte e seis viagens EM FILA antes do
    // primeiro desenho, cada uma esperando a anterior. Semeado uma vez, o caso
    // não se repete; mas ele acontece justamente na abertura da cena, que é
    // quando a mesa está esperando.
    //
    // Agrupado por VALOR de Mana, e não por peça: uma cena de doze goblins tem
    // doze peças e um valor só. `update ... in (ids)` resolve cada grupo de uma
    // vez, e sobra uma viagem por valor distinto, que na prática é uma ou duas.
    // (Um `upsert` em lote seria mais curto e falharia: o INSERT é montado antes
    // de o conflito no id ser resolvido, e as colunas obrigatórias da linha não
    // estão aqui.)
    const porValor = new Map<number, string[]>();
    for (const c of faltam) {
      const m = PERFIL[c.id].mana;
      (porValor.get(m) || porValor.set(m, []).get(m)!).push(c.id);
    }
    const idas = await Promise.all([...porValor].map(([m, ids]) =>
      SB.from('combatentes').update({ mana_max: m, mana_atual: m }).in('id', ids)));
    // Banco sem a migração 21: não insiste, e o tabuleiro segue sem a barra.
    if (idas.some((r: any) => r.error)) return;
    for (const c of faltam) { c.mana_max = PERFIL[c.id].mana; c.mana_atual = PERFIL[c.id].mana; }
  }

  async function carregarTokens() {
    TOKENS = {};
    // `movido_em` só existe na tabela; pela view do jogador a ordem da pilha
    // cai na ordem em que as linhas vierem, que é boa o bastante para desenhar.
    const cols = MESTRE ? 'combatente_id, q, r, movido_em' : 'combatente_id, q, r';
    const { data, error } = await SB.from(MESTRE ? 'arena_tokens' : 'token_visao')
      .select(cols).eq('arena_id', ARENA.id);
    if (error) return;
    for (const t of data || []) TOKENS[t.combatente_id] = { q: t.q, r: t.r, em: t.movido_em || '' };
  }

  // ================================================================= pintar
  const pctDe100 = (c: any) => (c.pv_pct != null ? c.pv_pct
    : (c.pv_max && c.pv_atual != null ? pctDe(c.pv_atual, c.pv_max) : null));
  /**
   * A Mana em porcentagem, ou nada para quem não lida com Mana.
   *
   * O jogador recebe `mana_pct` mastigado pela view (de 5 em 5, e só quando a
   * mesa liberou); o mestre lê a linha inteira e faz a conta. Nulo em `mana_max`
   * quer dizer "não usa Mana", e não "está zerado": um lobo não tem barra, um
   * feiticeiro exausto tem uma barra vazia.
   */
  const manaDe100 = (c: any) => (c.mana_pct != null ? c.mana_pct
    : (c.mana_max ? pctDe(c.mana_atual ?? 0, c.mana_max) : null));

  // ------------------------------------------------------ tamanho no chão
  /**
   * O diâmetro que cada porte ocupa, em METROS.
   *
   * As duas âncoras são da mesa: Médio ocupa 1 m e Grande ocupa 2 m. O resto é a
   * escada dobrando para os dois lados, que é o que mantém a proporção legível
   * (um Enorme ao lado de um Médio tem quatro vezes a largura dele, e é assim
   * que se lê a cena de relance).
   *
   * Medir em metros, e não em hexágonos, é o ponto: o token não sabe qual é a
   * escala da arena. Numa arena de 1 m o Médio cobre um hexágono; na de 0,5 m o
   * MESMO Médio cobre dois de largura, sem ninguém reconfigurar nada.
   */
  const PORTE_M: Record<string, number> = {
    'Miúdo': 0.25, 'Pequeno': 0.5, 'Médio': 1, 'Grande': 2,
    'Enorme': 4, 'Imenso': 8, 'Colossal': 16,
  };
  /** Diâmetro do combatente em metros. PC e NPC de cena são médios. */
  const diametroM = (c: any): number =>
    (c.tipo === 'criatura' ? PORTE_M[MON[c.monstro_id]?.porte] : null) ?? 1;

  /**
   * Quantos pixels do mundo vale um metro.
   *
   * Um passo de hexágono vale `escala_m` metros e mede `larguraHex(RAIO)` px
   * (a distância de centro a centro entre vizinhos de linha), então a regra de
   * três sai daí. O zoom não entra: ele é um `scale` no mundo inteiro, e leva
   * os tokens junto.
   */
  /**
   * A borda do tabuleiro, já com o espaço dos rótulos de coordenada.
   *
   * Todo cálculo de posição (tokens, setas, o hexágono sob o cursor) passa por
   * aqui. Foi por isso que virou função: com o número escrito em cinco lugares,
   * ligar os rótulos deslocaria o desenho e deixaria o clique meio hexágono
   * fora, que é o tipo de bug que só aparece na mesa.
   */
  const CANTO = 15;
  const margem = () => {
    const m = margemTabuleiro(RAIO);
    return ROTULOS ? { x: m.x + CANTO, y: m.y + CANTO } : m;
  };
  const medida = () => {
    const m = medidaTabuleiro(ARENA.cols, ARENA.rows, RAIO);
    return ROTULOS ? { largura: m.largura + CANTO, altura: m.altura + CANTO } : m;
  };

  const pxPorMetro = () => larguraHex(RAIO) / (Number(ARENA?.escala_m) || 1);
  const diametroPx = (c: any) => diametroM(c) * pxPorMetro();

  /**
   * O anel de Vida em volta do retrato: cheio em 100%, três quartos em 75%.
   *
   * `stroke-dasharray` é a peça inteira do truque: o primeiro número é o traço
   * (a fração viva da circunferência) e o segundo é a lacuna. Não há máscara,
   * não há corte, e o anel anima sozinho quando o número muda.
   *
   * O raio 45 num viewBox de 100 deixa 5 de folga para a espessura não vazar.
   */
  // O anel é um HEXÁGONO, igual à casa que a peça ocupa. O viewBox é 86,6 × 100
  // porque é essa a proporção de um hexágono de ponta para cima (√3 : 2), a
  // mesma de `.tok-quadro` — assim o SVG cobre o quadro sem distorcer o traço.
  const ANEL_PTS = verticesHex(43.3, 50, 46);
  /**
   * O anel de Vida.
   *
   * `pathLength="100"` renomeia o perímetro para 100 unidades, e a partir daí a
   * Vida em porcentagem É a medida do traço, sem converter nada.
   *
   * O que anda é o `stroke-dashoffset`, e não o `dasharray`: um número só, que
   * o CSS sabe interpolar. Animar o `dasharray` (dois números que trocam ao
   * mesmo tempo) dá um salto feio, e era o que acontecia antes.
   *
   * O traço vale 100 e a lacuna vale 100. Com deslocamento −(100−p) o desenho
   * começa (100−p) unidades adiante do vértice de cima: o buraco abre NO TOPO e
   * cresce no sentido horário, que é a leitura de um relógio esvaziando. Com o
   * deslocamento em zero o anel fecha inteiro.
   */
  function anelHTML(pct: number | null) {
    if (pct == null) return '';
    const p = Math.max(0, Math.min(100, pct));
    return `<svg class="tok-anel" viewBox="0 0 86.6 100" aria-hidden="true">
      <polygon class="anel-tr" points="${ANEL_PTS}" pathLength="100" />
      <polygon class="anel-v" points="${ANEL_PTS}" pathLength="100"
        stroke-dasharray="100 100" stroke-dashoffset="${(p - 100).toFixed(2)}" />
    </svg>`;
  }

  /**
   * A barra de Mana: um sexto do hexágono, na face de cima à esquerda.
   *
   * Ela NÃO divide o traço com a Vida. O anel é o perímetro inteiro e se esvazia
   * girando; a Mana é um risco curto, do lado de fora do anel, numa face só. Uma
   * some no sentido do relógio, a outra sobe e desce no lugar, e por isso as
   * duas se leem de relance sem se confundir uma com a outra.
   *
   * A face vai do vértice de cima ao vértice de cima à esquerda (o 0 e o 5 de
   * `verticesHex`, que sai do topo e anda no sentido horário). Como é uma linha
   * de dois pontos, o `pathLength="100"` mede ESSA face: a porcentagem de Mana é
   * o comprimento do traço, sem regra de três. O desenho começa no vértice de
   * baixo, então a barra enche subindo, que é o gesto de encher.
   *
   * O COMPRIMENTO é o do lado do anel de Vida, e não o do hexágono de fora: como
   * ela mora num raio maior (53,5 contra 46), acompanhar a face inteira daquele
   * hexágono a deixaria mais comprida que os lados do anel, e as duas leituras
   * não bateriam. Num hexágono o lado é igual ao raio, então bastam 46 unidades
   * centradas no meio da face.
   */
  const MANA_PTS = (() => {
    const v = verticesHex(43.3, 50, 53.5).split(' ').map((s) => s.split(',').map(Number));
    const [ax, ay] = v[0], [bx, by] = v[5];
    const meio = { x: (ax + bx) / 2, y: (ay + by) / 2 };
    const d = Math.hypot(bx - ax, by - ay);
    const u = { x: (bx - ax) / d, y: (by - ay) / d };
    const meia = 46 / 2;
    const p = (s: number) => `${(meio.x + u.x * s * meia).toFixed(2)},${(meio.y + u.y * s * meia).toFixed(2)}`;
    return `${p(-1)} ${p(1)}`;
  })();
  function manaHTML(pct: number | null) {
    if (pct == null) return '';
    const p = Math.max(0, Math.min(100, pct));
    return `<svg class="tok-mana" viewBox="0 0 86.6 100" aria-hidden="true">
      <polyline class="mana-tr" points="${MANA_PTS}" pathLength="100" />
      <polyline class="mana-v" points="${MANA_PTS}" pathLength="100"
        stroke-dasharray="100 100" stroke-dashoffset="${(p - 100).toFixed(2)}" />
    </svg>`;
  }

  function avatarDe(c: any, extra = '') {
    const doPC = c.retrato || PC_IMG[c.personagem_id];
    const src = (c.imagem && IMGS[c.imagem])
      || (doPC && IMGS[doPC])
      // O `monstro_id` vale para qualquer tipo, e não só para a criatura: o NPC
      // de cena pode emprestar o retrato de um bicho do bestiário sem herdar o
      // bloco de combate dele.
      || (MON[c.monstro_id]?.imagem ? u(MON[c.monstro_id].imagem) : null);
    const besta = MON[c.monstro_id]?.imagem && !(c.imagem && IMGS[c.imagem]) ? ' av-besta' : '';
    return avatarHTML(c.nome, src, (extra + besta).trim(), pctDe100(c));
  }

  /** A URL assinada do fundo é buscada aqui, antes do desenho, para o resto ser síncrono. */
  async function resolverFundo() {
    IMG_FUNDO = '';
    if (!ARENA?.fundo_path) return;
    const m = await urlsImagens(SB, [ARENA.fundo_path], 'mesa');
    IMG_FUNDO = m[ARENA.fundo_path] || '';
  }

  async function pintar() {
    await resolverFundo();
    el('gr-nome').textContent = ARENA.nome || 'Arena';
    const escala = Number(ARENA.escala_m) || 1;
    // "fora de jogo" é aviso de bastidor: só o mestre abre arena que não está em
    // campo. Pela view o jogador nem recebe a coluna `ativa`, e o texto saía
    // dizendo o contrário do que acontecia.
    el('gr-medida').textContent =
      `${ARENA.cols} × ${ARENA.rows} hexágonos · 1 hex = ${escala} m${MESTRE && !ARENA.ativa ? ' · fora de jogo' : ''}`;
    const f = ARENA.fundo && typeof ARENA.fundo === 'object' ? ARENA.fundo : {};
    FUNDO = { x: +f.x || 0, y: +f.y || 0, z: +f.z || 1, rot: +f.rot || 0 };
    // A névoa é de cada arena: trocar de arena pelo seletor troca o que está
    // coberto, e sem esta leitura a nova herdaria a névoa da anterior.
    lerNevoa();
    GRADE = ARENA.grade && typeof ARENA.grade === 'object' ? { ...ARENA.grade } : {};
    // O mestre troca de arena pelo seletor sem passar por `carregar`, e o
    // registro é de cada arena: reler dele aqui é o que faz o histórico
    // acompanhar a troca. Para o jogador não existe seletor, e o log já veio
    // pela view em `carregarLog`.
    if (MESTRE) LOG = Array.isArray(ARENA.log) ? ARENA.log : [];
    pintarSeletor();
    pintarTabuleiro();
    pintarEfeitos(ctxArtes(), el('gr-efeitos') as unknown as SVGElement);
    pintarTokens();
    pintarLista();
    pintarPainelEfeitos(ctxArtes(), el('gr-ef-lista'));
    pintarIniciativa();
    pintarAlcance();
    pintarLog();
    aplicarGrade();
    sincronizarControles();
    ajustarAltura();
    marcarEstado();
  }

  function pintarSeletor() {
    const sel = el('gr-sel') as HTMLSelectElement;
    if (!MESTRE || ARENAS.length < 2) { sel.hidden = true; el('gr-nome').hidden = false; return; }
    sel.hidden = false; el('gr-nome').hidden = true;
    sel.innerHTML = ARENAS.map((a) =>
      `<option value="${a.id}"${a.id === ARENA.id ? ' selected' : ''}>${esc(a.nome)}${a.ativa ? ' ◉' : ''}</option>`).join('');
  }

  /**
   * Letras em cima, números à esquerda: o endereço de cada casa na borda.
   *
   * O registro já fala em "D5", e sem a régua na moldura o mestre tem de contar
   * hexágonos com o dedo para achar a casa que acabou de ler. A letra fica sobre
   * a coluna do topo e o número à esquerda da linha, nas próprias coordenadas
   * dos hexágonos, e não em passos regulares: as linhas são desencontradas, e
   * uma régua reta se descolaria do tabuleiro na primeira linha ímpar.
   */
  function rotulosHTML(cols: number, rows: number, mg: { x: number; y: number }) {
    if (!ROTULOS) return '';
    const out: string[] = [];
    for (let col = 0; col < cols; col++) {
      const h = offsetParaAxial(col, 0);
      const c = centroHex(h.q, h.r, RAIO);
      out.push(`<text class="rot-eixo" x="${(c.x + mg.x).toFixed(1)}" y="${(mg.y - RAIO - 3).toFixed(1)}"
        >${letraColuna(col)}</text>`);
    }
    for (let row = 0; row < rows; row++) {
      const h = offsetParaAxial(0, row);
      const c = centroHex(h.q, h.r, RAIO);
      out.push(`<text class="rot-eixo rot-lin" x="${(c.x + mg.x - larguraHex(RAIO) / 2 - 4).toFixed(1)}"
        y="${(c.y + mg.y + 4).toFixed(1)}">${row + 1}</text>`);
    }
    return `<g class="rot-eixos">${out.join('')}</g>`;
  }

  /** Desenha o SVG e posiciona a arte de fundo. Só muda quando a arena muda. */
  function pintarTabuleiro() {
    const { cols, rows } = ARENA;
    const med = medidaTabuleiro(cols, rows, RAIO);
    const mg = margem();
    const mundo = el('gr-mundo');
    mundo.style.width = med.largura + 'px';
    mundo.style.height = med.altura + 'px';

    const svg = el('gr-hexes') as unknown as SVGSVGElement;
    svg.setAttribute('viewBox', `0 0 ${med.largura} ${med.altura}`);
    // O `<marker>` da ponta saiu daqui: as setas agora trazem a própria cabeça
    // dentro da figura (lib/seta.ts), e um marcador desenharia a ponta no
    // ângulo do último segmento, o que numa curva sai torto.
    svg.innerHTML = tabuleiro(cols, rows).map((h) => {
        const c = centroHex(h.q, h.r, RAIO);
        return `<polygon class="hx" data-h="${chaveHex(h.q, h.r)}"
          points="${verticesHex(c.x + mg.x, c.y + mg.y, RAIO)}" />`;
      }).join('')
      + rotulosHTML(cols, rows, mg)
      + '<g id="gr-alcance"></g><g id="gr-seta"></g><g id="gr-pings"></g>';

    const img = el('gr-fundo') as HTMLImageElement;
    const src = ARENA.fundo_url || (ARENA.fundo_path ? IMG_FUNDO : '');
    if (src) {
      // O enquadramento depende do tamanho natural da imagem, que só existe
      // depois que ela carrega. `decode()` espera isso sem travar o desenho.
      if (img.src !== src) img.src = src;
      img.hidden = false; mundo.classList.add('com-arte');
      img.decode?.().then(aplicarFundo).catch(() => {});
      if (img.complete) aplicarFundo();
    } else {
      img.removeAttribute('src'); img.hidden = true; mundo.classList.remove('com-arte');
    }
    if (MESTRE) {
      (el('gr-ajustar') as HTMLElement).hidden = false;
      (el('gr-nevoa-btn') as HTMLElement).hidden = false;
    }
    pintarNevoa();
    aplicarTrilha();
    aplicarZoom();
  }

  // =============================================================== a trilha
  /**
   * A música da cena. O servidor não transmite som: ele diz qual é a música e se
   * ela está no ar, e o navegador de cada um toca.
   *
   * Dois volumes, de propósito. O da ARENA é do mestre, e é a mistura da cena
   * (a chuva baixinha, o tambor alto). O do APARELHO é de quem está ouvindo, e
   * fica guardado no navegador dele: forçar som na casa dos outros é falta de
   * educação, e alguém sempre está com o fone no volume errado.
   */
  const SOM_KEY = 'centelha:grid:volume';
  let VOL_LOCAL = 0.7;
  try { const v = localStorage.getItem(SOM_KEY); if (v != null) VOL_LOCAL = Math.max(0, Math.min(1, +v)); } catch {}
  let TRILHA_SRC = '';          // o endereço já resolvido do que está tocando
  let TRILHA_TRAVADA = false;   // o navegador recusou tocar sem um clique antes

  const trilhaDaArena = () => (ARENA?.trilha && typeof ARENA.trilha === 'object' ? ARENA.trilha : {});

  /** Resolve o endereço: o solto vale como está; o do balde precisa ser assinado. */
  async function enderecoDaTrilha(t: any): Promise<string> {
    if (t.url) return String(t.url);
    if (!t.path) return '';
    const { data } = await SB.storage.from('mesa').createSignedUrl(t.path, 60 * 60 * 6);
    return data?.signedUrl || '';
  }

  /** Põe o áudio no estado que a arena manda, sem recomeçar o que já está tocando. */
  async function aplicarTrilha() {
    const som = document.getElementById('gr-som') as HTMLAudioElement | null;
    if (!som) return;
    const t = trilhaDaArena();
    const btn = el('gr-som-btn') as HTMLElement;
    btn.hidden = !(t.tocando && (t.path || t.url));
    som.volume = Math.max(0, Math.min(1, (t.volume ?? 0.5) * VOL_LOCAL));
    if (!t.tocando || !(t.path || t.url)) { som.pause(); TRILHA_SRC = ''; return; }
    const src = await enderecoDaTrilha(t);
    if (!src) return;
    // Trocar o `src` recomeça a música: só quando ela mudou mesmo.
    if (src !== TRILHA_SRC) { TRILHA_SRC = src; som.src = src; }
    try { await som.play(); TRILHA_TRAVADA = false; }
    catch { TRILHA_TRAVADA = true; }   // o navegador exige um clique antes: ver `ligarSom`
    pintarSom();
  }

  function pintarSom() {
    const btn = el('gr-som-btn') as HTMLElement;
    const t = trilhaDaArena();
    btn.textContent = TRILHA_TRAVADA ? '🔈' : VOL_LOCAL === 0 ? '🔇' : '🔊';
    btn.title = TRILHA_TRAVADA
      ? 'Clique para liberar o som (o navegador pede um toque antes)'
      : `${t.nome || 'Trilha'} · volume ${Math.round(VOL_LOCAL * 100)}%`;
    btn.classList.toggle('primary', TRILHA_TRAVADA);
  }

  function ligarSom() {
    // Um clique no botão dá a volta: 100% → 60% → 30% → mudo → 100%.
    el('gr-som-btn').onclick = async () => {
      if (TRILHA_TRAVADA) { await aplicarTrilha(); return; }
      const escada = [1, 0.6, 0.3, 0];
      const i = escada.findIndex((v) => Math.abs(v - VOL_LOCAL) < 0.05);
      VOL_LOCAL = escada[(i + 1) % escada.length] ?? 0.6;
      try { localStorage.setItem(SOM_KEY, String(VOL_LOCAL)); } catch {}
      await aplicarTrilha();
    };
    // Autoplay bloqueado: o primeiro toque em qualquer lugar da página serve de
    // permissão, e é o que os navegadores esperam.
    document.addEventListener('pointerdown', () => {
      if (TRILHA_TRAVADA) aplicarTrilha();
    }, { capture: true });
  }

  /** A janela da trilha, do mestre. */
  async function abrirTrilha() {
    const dlg = el('trilha-dlg') as HTMLDialogElement;
    const t = trilhaDaArena();
    const sel = el('tr-arq') as HTMLSelectElement;
    const url = el('tr-url') as HTMLInputElement;
    const vol = el('tr-vol') as HTMLInputElement;
    const aviso = el('tr-aviso') as HTMLElement;
    url.value = t.url || '';
    vol.value = String(Math.round((t.volume ?? 0.5) * 100));
    sel.innerHTML = '<option value="">(nenhum)</option>';
    // Os arquivos da mesa que são som. A aba Arquivos guarda a linha; o balde
    // guarda o arquivo, e é ele que o navegador vai tocar.
    const { data: arqs } = await SB.from('arquivos').select('*').eq('mesa_id', ID).eq('bucket', 'mesa');
    const sons = (arqs || []).filter((a: any) => /audio/i.test(a.tipo || '')
      || /\.(mp3|ogg|wav|m4a|opus)$/i.test(a.storage_path || a.nome || ''));
    for (const a of sons) {
      const o = document.createElement('option');
      o.value = a.storage_path || ''; o.textContent = a.nome || a.storage_path;
      if (t.path && t.path === a.storage_path) o.selected = true;
      sel.appendChild(o);
    }
    aviso.hidden = !!sons.length;
    if (!sons.length) aviso.textContent = 'Nenhum som na aba Arquivos ainda. Envie um mp3 por lá, ou use um endereço.';

    const guardar = async (tocando: boolean) => {
      const escolhido = sel.value;
      const nova = {
        nome: escolhido ? (sel.options[sel.selectedIndex]?.textContent || 'Trilha') : (url.value ? 'Trilha' : ''),
        path: escolhido || null,
        url: escolhido ? null : (url.value.trim() || null),
        volume: Math.max(0, Math.min(1, (+vol.value || 0) / 100)),
        tocando: tocando && !!(escolhido || url.value.trim()),
      };
      ARENA.trilha = nova;
      const { error } = await SB.from('mesa_arenas').update({ trilha: nova }).eq('id', ARENA.id);
      if (error) return uiErro(/trilha/i.test(error.message)
        ? 'A coluna "trilha" ainda não existe. Rode supabase/migracao-24.sql.'
        : 'Erro: ' + error.message);
      avisarAgora('arena');
      await aplicarTrilha();
      await logar(null, nova.tocando ? `Trilha: ${nova.nome}` : 'Trilha parada', { acao: null });
    };
    (el('tr-tocar') as HTMLElement).onclick = async () => { await guardar(true); dlg.close(); };
    (el('tr-parar') as HTMLElement).onclick = async () => { await guardar(false); dlg.close(); };
    (el('tr-cancelar') as HTMLElement).onclick = () => dlg.close();
    // O volume da arena responde na hora, para o mestre misturar de ouvido.
    vol.oninput = () => {
      const som = document.getElementById('gr-som') as HTMLAudioElement | null;
      if (som) som.volume = Math.max(0, Math.min(1, ((+vol.value || 0) / 100) * VOL_LOCAL));
    };
    dlg.showModal();
  }

  // ============================================================ névoa de guerra
  /**
   * O que está coberto, e se a névoa está valendo nesta arena.
   *
   * A lista guarda o REVELADO, e não o escondido: assim a arena nasce coberta e
   * o mapa vai se abrindo conforme o grupo anda, que é o gesto que a névoa
   * existe para contar. Numa arena de 14×9 a lista começa vazia.
   *
   * A névoa é do GRUPO, e não de cada jogador: o que um revelou, todos veem. É a
   * mesa física, com um mapa só no meio de todo mundo.
   */
  /**
   * O estado da névoa nesta arena.
   *
   * `claros` é o pincel do mestre: casa aberta na mão, que não depende de
   * ninguém estar por perto. `explorado` é a MEMÓRIA: toda casa que já esteve
   * clara alguma vez, e é ela que separa a névoa leve da pesada.
   *
   * `visao` é o alcance de quem enxerga, em hexágonos, e é da CENA: a cripta
   * escura e o campo aberto ao meio-dia não têm o mesmo. `luz` é o halo que uma
   * Arte de fogo ou de luz acende em volta do que ela marcou no chão.
   */
  let NEVOA = {
    ligada: false, visao: 6, luz: 2,
    claros: new Set<string>(), explorado: new Set<string>(),
  };
  let NEVOANDO = false;

  function lerNevoa() {
    const n = (ARENA && ARENA.nevoa) || {};
    // `revelados` é o nome antigo do mesmo conjunto: as arenas que já existiam
    // não podem acordar cobertas por causa de uma troca de palavra.
    const claros: string[] = Array.isArray(n.claros) ? n.claros
      : Array.isArray(n.revelados) ? n.revelados : [];
    NEVOA = {
      ligada: !!n.ligada,
      visao: Math.max(0, Math.min(40, Number(n.visao ?? 6))),
      luz: Math.max(0, Math.min(20, Number(n.luz ?? 2))),
      claros: new Set(claros),
      explorado: new Set(Array.isArray(n.explorado) ? n.explorado : claros),
    };
  }

  /**
   * As casas desta arena, montadas uma vez por medida de tabuleiro.
   *
   * `tabuleiro()` devolve um vetor NOVO a cada chamada, e ele é pedido dentro de
   * laço: uma vez por peça que enxerga, mais uma por casa de fogo ou de luz.
   * Numa cena de trinta peças eram trinta vetores de 1.200 objetos por
   * repintura, jogados fora em seguida.
   */
  let CASAS: { chave: string; lista: ReturnType<typeof tabuleiro> } | null = null;
  function casasDaArena() {
    const chave = `${ARENA?.cols}x${ARENA?.rows}`;
    if (!CASAS || CASAS.chave !== chave) {
      CASAS = { chave, lista: tabuleiro(ARENA.cols, ARENA.rows) };
    }
    return CASAS.lista;
  }

  /**
   * Quem enxerga: as peças do grupo, no tabuleiro.
   *
   * O jogador consegue fazer esta mesma conta porque peça de aliado sempre
   * chega a ele: ela está, por definição, dentro do próprio campo de visão. Sem
   * isso a conta seria circular (só enxergaria quem já está claro).
   */
  const olhosNoMapa = () => COMBS.filter((c: any) =>
    TOKENS[c.id] && c.ativo !== false && (c.tipo === 'pc' || c.grupo === 'aliado'));

  /**
   * As casas claras AGORA: o pincel do mestre, o que o grupo enxerga, e o que o
   * fogo e a luz acendem. É a mesma conta que a função `casa_clara` do banco faz
   * para decidir quais peças o jogador recebe.
   */
  function casasClaras(): Set<string> {
    const claras = new Set<string>(NEVOA.claros);
    if (!NEVOA.ligada || !ARENA) return claras;
    // O tabuleiro é lido UMA vez, e não uma por olho: `tabuleiro()` monta um
    // vetor novo de cols×rows objetos a cada chamada, e numa cena de trinta
    // peças isso eram trinta vetores de 1.200 por repintura.
    const casas = casasDaArena();
    const perto = (q: number, r: number, raio: number) => {
      for (const h of casas) {
        if (distanciaHex({ q, r }, h) <= raio) claras.add(chaveHex(h.q, h.r));
      }
    };
    for (const c of olhosNoMapa()) {
      const t = TOKENS[c.id];
      perto(t.q, t.r, NEVOA.visao);
    }
    // Fogo e luz: a tocha e a fogueira são a lanterna mais antiga que existe, e
    // o Arcano já marca o chão com elas.
    for (const e of efeitosAtivos() as any[]) {
      if (e.elemento !== 'fogo' && e.elemento !== 'luz') continue;
      for (const h of (e.hexes || [])) perto(h.q, h.r, NEVOA.luz);
    }
    return claras;
  }

  /**
   * Desenha os dois pesos da névoa.
   *
   * Leve é onde já estiveram: mostra o chão e esconde quem está lá. Pesada é
   * onde ninguém foi: não mostra nem o formato do corredor. As peças em névoa
   * leve nem chegam ao navegador do jogador (a view corta antes), então aqui é
   * só o desenho do que ele já sabe.
   */
  /**
   * A camada da névoa, montada uma vez por arena.
   *
   * Um `<polygon>` por casa, nascido escondido. Daí em diante nenhuma repintura
   * cria ou destrói nó: `pintarNevoa` só troca a classe de quem mudou de estado.
   *
   * Antes a camada inteira era refeita por `innerHTML` a cada peça movida. Numa
   * arena 40×30 isso custava 148 KB de HTML e 1.100 nós recriados por
   * movimento, todos byte a byte iguais aos que já estavam na página. Medido:
   * 11,6 ms por repintura numa máquina modesta, contra 1,0 ms assim.
   */
  let NEVOA_POLI: Map<string, SVGPolygonElement> | null = null;
  let NEVOA_GEO = '';
  function montarNevoa() {
    const svg = document.getElementById('gr-nevoa');
    if (!svg || !ARENA) return;
    const med = medidaTabuleiro(ARENA.cols, ARENA.rows, RAIO);
    const mg = margem();
    svg.setAttribute('viewBox', `0 0 ${med.largura} ${med.altura}`);
    svg.innerHTML = casasDaArena().map((h) => {
      const c = centroHex(h.q, h.r, RAIO);
      // Meio pixel a mais no raio: sem isso as bordas dos hexágonos vizinhos
      // deixam uma teia de linhas claras entre as manchas.
      return `<polygon data-h="${chaveHex(h.q, h.r)}" class="nv-clara"
        points="${verticesHex(c.x + mg.x, c.y + mg.y, RAIO + 0.6)}" />`;
    }).join('');
    NEVOA_POLI = new Map([...svg.children].map((p) =>
      [(p as SVGElement).getAttribute('data-h')!, p as SVGPolygonElement]));
    // A chave da geometria carrega a margem porque ela muda com os rótulos: com
    // ela de fora, ligar a moldura deixaria a névoa meio hexágono fora do lugar.
    NEVOA_GEO = `${ARENA.cols}x${ARENA.rows}@${mg.x},${mg.y}`;
  }

  function pintarNevoa() {
    const svg = document.getElementById('gr-nevoa');
    if (!svg || !ARENA) return;
    const mg = margem();
    if (!NEVOA_POLI || NEVOA_GEO !== `${ARENA.cols}x${ARENA.rows}@${mg.x},${mg.y}`) montarNevoa();
    // Névoa desligada: uma classe apaga a camada inteira, sem tocar em nó nenhum.
    svg.classList.toggle('off', !NEVOA.ligada);
    if (!NEVOA.ligada || !NEVOA_POLI) return;
    const claras = casasClaras();
    for (const [k, p] of NEVOA_POLI) {
      const cls = claras.has(k) ? 'nv-clara'
        : NEVOA.explorado.has(k) ? 'nv-leve' : 'nv-pesada';
      if (p.getAttribute('class') !== cls) p.setAttribute('class', cls);
    }
    lembrarExplorado(claras);
  }

  /**
   * Guarda o que acabou de ser visto.
   *
   * Só o mestre escreve: a memória é uma só, e cinco navegadores gravando a
   * mesma coisa a cada passo seria cinco vezes o mesmo trabalho, com a chance de
   * um deles atrasado apagar o que o outro acabou de aprender.
   */
  function lembrarExplorado(claras: Set<string>) {
    if (!MESTRE || !NEVOA.ligada) return;
    let novo = false;
    for (const k of claras) if (!NEVOA.explorado.has(k)) { NEVOA.explorado.add(k); novo = true; }
    if (novo) salvarNevoa();
  }

  /** Grava a névoa na arena. Junta as pinceladas: uma escrita por parada de mão. */
  const salvarNevoa = debounce(async () => {
    if (!MESTRE || !ARENA) return;
    const valor = {
      ligada: NEVOA.ligada, visao: NEVOA.visao, luz: NEVOA.luz,
      claros: [...NEVOA.claros], explorado: [...NEVOA.explorado],
    };
    ARENA.nevoa = valor;
    const { error } = await SB.from('mesa_arenas').update({ nevoa: valor }).eq('id', ARENA.id);
    if (error) return uiErro(/nevoa/i.test(error.message)
      ? 'A coluna "nevoa" ainda não existe. Rode supabase/migracao-23.sql.'
      : 'Erro ao gravar a névoa: ' + error.message);
    // O jogador precisa reler a ARENA (a névoa vem nela) e os tokens (a view
    // esconde quem está coberto), e por isso o aviso é o de arena mais o de
    // tokens: uma casa aberta faz peça aparecer do outro lado.
    avisarAgora('arena'); RT?.avisar('tokens');
  }, 400);

  /** Passa o pincel numa casa. `abrir` falso fecha de volta. */
  function pincelar(q: number, r: number, abrir: boolean) {
    const k = chaveHex(q, r);
    if (abrir === NEVOA.claros.has(k)) return;
    if (abrir) { NEVOA.claros.add(k); NEVOA.explorado.add(k); }
    else NEVOA.claros.delete(k);
    pintarNevoa();
    salvarNevoa();
  }

  function modoNevoa(liga: boolean) {
    NEVOANDO = liga;
    el('gr-mundo').classList.toggle('nevoando', liga);
    (el('gr-nevoa-btn') as HTMLElement).classList.toggle('primary', liga);
    const velha = document.getElementById('nevoa-bar');
    if (velha) velha.remove();
    if (!liga) return;
    const bar = document.createElement('div');
    bar.className = 'nevoa-bar'; bar.id = 'nevoa-bar';
    bar.innerHTML = `<label><input type="checkbox" id="nv-liga"${NEVOA.ligada ? ' checked' : ''} /> névoa ligada</label>
      <label title="O quanto cada peça do grupo enxerga em volta">enxerga
        <input type="number" id="nv-visao" min="0" max="40" step="1" value="${NEVOA.visao}" /> hex</label>
      <label title="O halo que uma Arte de fogo ou de luz acende em volta do que marcou">luz
        <input type="number" id="nv-luz" min="0" max="20" step="1" value="${NEVOA.luz}" /> hex</label>
      <button class="btn mini" id="nv-tudo">Revelar tudo</button>
      <button class="btn mini" id="nv-nada">Cobrir tudo</button>
      <button class="btn mini" id="nv-esquecer" title="Volta tudo a ser desconhecido, inclusive o que já foi explorado">Esquecer</button>
      <span class="nv-dica">arraste para abrir · Alt arrasta para fechar</span>
      <button class="btn mini primary" id="nv-fim">Concluir</button>`;
    el('gr-palco').appendChild(bar);
    (el('nv-liga') as HTMLInputElement).onchange = (ev) => {
      NEVOA.ligada = (ev.target as HTMLInputElement).checked;
      pintarNevoa(); salvarNevoa();
      logar(null, `Névoa de guerra ${NEVOA.ligada ? 'ligada' : 'desligada'}`, { acao: null });
    };
    const numero = (id: string, campo: 'visao' | 'luz') => {
      (el(id) as HTMLInputElement).oninput = (ev) => {
        NEVOA[campo] = Math.max(0, Math.min(campo === 'visao' ? 40 : 20,
          parseInt((ev.target as HTMLInputElement).value, 10) || 0));
        pintarNevoa(); salvarNevoa();
      };
    };
    numero('nv-visao', 'visao'); numero('nv-luz', 'luz');
    el('nv-tudo').onclick = () => {
      for (const h of tabuleiro(ARENA.cols, ARENA.rows)) {
        NEVOA.claros.add(chaveHex(h.q, h.r)); NEVOA.explorado.add(chaveHex(h.q, h.r));
      }
      pintarNevoa(); salvarNevoa();
    };
    // Cobrir tira o pincel, e a memória FICA: o grupo continua sabendo por onde
    // andou. Para tirar a memória também existe o "Esquecer", que é outro gesto.
    el('nv-nada').onclick = () => { NEVOA.claros.clear(); pintarNevoa(); salvarNevoa(); };
    el('nv-esquecer').onclick = () => {
      NEVOA.claros.clear(); NEVOA.explorado.clear(); pintarNevoa(); salvarNevoa();
    };
    el('nv-fim').onclick = () => modoNevoa(false);
  }

  /**
   * O pincel: arrastar abre, com Alt fecha.
   *
   * Na fase de CAPTURA e no mundo inteiro, porque o arrasto de peça e o ping
   * moram nos mesmos pixels; enquanto o modo está ligado, a névoa fica na
   * frente deles.
   */
  function ligarNevoa() {
    if (!MESTRE) return;
    el('gr-nevoa-btn').onclick = () => modoNevoa(!NEVOANDO);
    let pintando = false;
    const casa = (cx: number, cy: number) => {
      const h = hexNaTela(cx, cy);
      if (h) pincelar(h.q, h.r, !ALT_PINCEL);
    };
    let ALT_PINCEL = false;
    const palco = el('gr-palco');
    palco.addEventListener('pointerdown', (ev) => {
      if (!NEVOANDO || (ev.target as HTMLElement).closest('.nevoa-bar')) return;
      ev.preventDefault(); ev.stopPropagation();
      pintando = true; ALT_PINCEL = ev.altKey;
      // A névoa só existe ligada: pintar com ela desligada seria pintar o nada.
      if (!NEVOA.ligada) {
        NEVOA.ligada = true;
        const cx = el('nv-liga') as HTMLInputElement | null; if (cx) cx.checked = true;
      }
      casa(ev.clientX, ev.clientY);
    }, true);
    palco.addEventListener('pointermove', (ev) => {
      if (!NEVOANDO || !pintando) return;
      ev.preventDefault(); ev.stopPropagation();
      casa(ev.clientX, ev.clientY);
    }, true);
    const solta = () => { pintando = false; };
    palco.addEventListener('pointerup', solta, true);
    palco.addEventListener('pointercancel', solta, true);
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && NEVOANDO) modoNevoa(false);
    });
  }

  /**
   * Estica a grade até o pé da tela.
   *
   * A conta é medida, e não escrita à mão: o que existe acima do tabuleiro (a
   * barra de abas da mesa, as margens do layout) muda com o tema, com o zoom do
   * navegador e com a largura, e um `calc(100vh - 6rem)` chutado erra em todas
   * essas situações. Aqui se pergunta ao próprio elemento onde ele começa.
   *
   * Só acima de 1100px: abaixo disso a grade vira uma pilha de blocos, e altura
   * fixa esmagaria os de baixo.
   */
  function ajustarAltura() {
    const g = document.querySelector<HTMLElement>('.gr-grade');
    if (!g) return;
    if (!matchMedia('(min-width: 1101px)').matches || document.fullscreenElement) {
      g.style.height = ''; return;
    }
    // Estica primeiro, mede a sobra depois. Não dá para calcular de uma vez o
    // que existe abaixo da grade: `scrollHeight` nunca é menor que a janela, e
    // num layout curto ele devolve o VAZIO da tela em vez do rodapé. Com a
    // altura já aplicada, a rolagem que aparecer é exatamente o excesso, e o
    // segundo passo o desconta.
    const topo = g.getBoundingClientRect().top + (window.scrollY || 0);
    const alvo = Math.max(320, Math.round(innerHeight - topo - 8));
    g.style.height = `${alvo}px`;
    const sobra = document.documentElement.scrollHeight - innerHeight;
    if (sobra > 0) g.style.height = `${Math.max(320, alvo - sobra)}px`;
  }

  // ------------------------------------------------- enquadramento da arte
  /**
   * Põe a arte no lugar. `BASE` é a escala que faz a imagem inteira caber no
   * tabuleiro, e é dela que o zoom parte: assim `z = 1` significa sempre "vejo o
   * mapa todo", independentemente de a arte ser um panorama ou um quadrado.
   */
  /**
   * O tamanho que a arte OCUPA depois de girada.
   *
   * Um mapa deitado virado de pé passa a precisar da altura do tabuleiro, e não
   * da largura. Sem esta conta, "caber" numa arte girada 90° deixaria metade
   * dela para fora, porque a medida usada seria a da imagem antes do giro.
   */
  function caixaGirada(w: number, h: number, graus: number) {
    const a = (graus * Math.PI) / 180;
    const c = Math.abs(Math.cos(a)), s = Math.abs(Math.sin(a));
    return { largura: w * c + h * s, altura: w * s + h * c };
  }

  function aplicarFundo() {
    const img = el('gr-fundo') as HTMLImageElement;
    if (img.hidden || !img.naturalWidth) return;
    const med = medida();
    const g = caixaGirada(img.naturalWidth, img.naturalHeight, FUNDO.rot || 0);
    BASE = Math.min(med.largura / g.largura, med.altura / g.altura);
    const dx = (FUNDO.x / 100) * med.largura;
    const dy = (FUNDO.y / 100) * med.altura;
    // A ordem importa: leva ao lugar, gira em torno do próprio centro, e só
    // então amplia. Girar depois de ampliar jogaria a arte para longe.
    img.style.transform = `translate(-50%, -50%) translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`
      + ` rotate(${(FUNDO.rot || 0).toFixed(1)}deg) scale(${(BASE * FUNDO.z).toFixed(4)})`;
  }

  /** O zoom que faz a arte cobrir o tabuleiro inteiro, em unidades de `z`. */
  function zPreencher() {
    const img = el('gr-fundo') as HTMLImageElement;
    if (!img.naturalWidth || !BASE) return 1;
    const med = medida();
    const g = caixaGirada(img.naturalWidth, img.naturalHeight, FUNDO.rot || 0);
    return Math.max(med.largura / g.largura, med.altura / g.altura) / BASE;
  }

  function aplicarGrade() {
    const mundo = el('gr-mundo');
    if (GRADE.cor) mundo.style.setProperty('--hex-cor', GRADE.cor);
    else mundo.style.removeProperty('--hex-cor');
    if (GRADE.op != null) mundo.style.setProperty('--hex-op', String(GRADE.op));
    else mundo.style.removeProperty('--hex-op');
    // O brilho da vez vai no CORPO, e não no mundo: ele pinta o token no
    // tabuleiro E a linha na coluna de iniciativa, que são de pais diferentes.
    const raiz = document.body;
    raiz.style.setProperty('--vez-cor', GRADE.vezCor || '#ffd76a');
    raiz.style.setProperty('--vez-forca', String(GRADE.vezForca ?? 10));
    // No CORPO e não no mundo: a prévia das setas mora dentro de um diálogo,
    // que é irmão do tabuleiro e não filho dele.
    for (const s of SETAS_UI) {
      const g: any = GRADE[s.chave] || {};
      const pre = s.p === 'sm' ? '--sm' : '--sa';
      if (g.cor) raiz.style.setProperty(`${pre}-cor`, g.cor); else raiz.style.removeProperty(`${pre}-cor`);
      if (g.op != null) raiz.style.setProperty(`${pre}-op`, String(g.op)); else raiz.style.removeProperty(`${pre}-op`);
    }
  }

  /**
   * Grava o enquadramento e o traço. Separada da versão com espera porque o
   * "Cancelar" precisa gravar NA HORA: o que ele desfaz já foi para o banco
   * enquanto o dedo arrastava a barrinha, e um desfazer que espera 600 ms é um
   * desfazer que se perde se a página for embora antes.
   */
  async function gravarAparencia() {
    const { error } = await SB.from('mesa_arenas')
      .update({ fundo: FUNDO, grade: GRADE }).eq('id', ARENA.id);
    if (error) return uiErro(/grade/i.test(error.message)
      ? 'A coluna "grade" ainda não existe. Rode supabase/migracao-16.sql.'
      : 'Erro ao salvar a aparência: ' + error.message);
    ARENA.fundo = { ...FUNDO }; ARENA.grade = { ...GRADE }; RT?.avisar('arena');
  }
  const salvarAparencia = debounce(gravarAparencia, 600);

  function sincronizarControles() {
    if (!MESTRE) return;
    (el('fa-zoom') as HTMLInputElement).value = String(FUNDO.z);
    el('fa-zval').textContent = Math.round(FUNDO.z * 100) + '%';
    (el('fa-rot') as HTMLInputElement).value = String(FUNDO.rot || 0);
    el('fa-rval').textContent = Math.round(FUNDO.rot || 0) + '°';
    (el('fa-cor') as HTMLInputElement).value = GRADE.cor || '#ffffff';
    const op = GRADE.op != null ? GRADE.op : 1;
    (el('fa-op') as HTMLInputElement).value = String(op);
    el('fa-opval').textContent = Math.round(op * 100) + '%';
    (el('fa-vez-cor') as HTMLInputElement).value = GRADE.vezCor || '#ffd76a';
    const vf = GRADE.vezForca ?? 10;
    (el('fa-vez') as HTMLInputElement).value = String(vf);
    el('fa-vezval').textContent = String(vf);
    el('fa-arte').hidden = !(ARENA.fundo_path || ARENA.fundo_url);
    pintarPosicao();
    for (const s of SETAS_UI) sincronizarSeta(s);
  }

  /**
   * Quando dois dividem a casa, nenhum fica no centro.
   *
   * O que já estava lá desliza para 45° (zero às 12h, sentido horário) e o que
   * chegou entra por −135°, o lado oposto: cada um mostra uma meia-lua e nenhum
   * some debaixo do outro. Com três ou mais, os ângulos se espalham a partir do
   * mesmo 45°, o que reduz ao par descrito quando são só dois.
   *
   * A ordem é a de chegada (`movido_em`): o mais antigo abre caminho, o mais
   * novo entra por cima, que é a leitura de "alguém pisou aqui agora".
   */
  function deslocamentoNaPilha(i: number, n: number, diamPx: number) {
    if (n < 2) return { dx: 0, dy: 0 };
    const grau = 45 + i * (360 / n);
    const rad = (grau * Math.PI) / 180;
    const passo = diamPx * 0.3;
    return { dx: Math.sin(rad) * passo, dy: -Math.cos(rad) * passo };
  }

  /**
   * Mexe no anel de uma peça SEM redesenhar o tabuleiro.
   *
   * É o que faz a Vida escoar em vez de pular: `pintarTokens()` troca o
   * innerHTML, e transição de CSS não roda em elemento recém-nascido — ele já
   * aparece no valor final. Aqui o mesmo <polygon> continua na página e só o
   * `stroke-dashoffset` muda, que é exatamente o que a transição sabe animar.
   */
  function atualizarAnel(c: any) {
    // Aqui também, e não só na repintura: curar e tirar Vida mexem no anel no
    // lugar, sem redesenhar as peças, e é justamente quando o número importa.
    conferirNumeros();
    const tok = document.querySelector<HTMLElement>(`.gr-token[data-c="${CSS.escape(c.id)}"]`);
    const arco = tok?.querySelector('.anel-v');
    if (!tok || !arco) { pintarTokens(); return; }
    const pct = pctDe100(c);
    if (pct == null) { pintarTokens(); return; }
    const faixa = tierDe(pct, 100);
    [...tok.classList].filter((k) => k.startsWith('t-')).forEach((k) => tok.classList.remove(k));
    tok.classList.add(tierCls(faixa.estado));
    tok.classList.toggle('caido', pct <= 0);
    arco.setAttribute('stroke-dashoffset', (pct - 100).toFixed(2));
    tok.title = `${c.nome} · ${diametroM(c)} m · ${faixa.estado}`;
    atualizarMana(c);
  }

  // -------------------------------------------- os números que sobem da peça
  /**
   * A Vida e a Mana de cada um na última conferência.
   *
   * O número sai da DIFERENÇA, e não de quem bateu. Amarrá-lo a `aplicarDano`
   * cobriria o golpe do mestre e mais nada: a mordida da Arte é escrita pelo
   * módulo das Artes, a queda pelo menu da peça, e o dano que o jogador lança
   * chega por tempo real, já pronto, sem passar por nenhuma função daqui.
   * Comparando o antes com o depois, todos os caminhos ganham o número de uma
   * vez, inclusive os que ainda vão existir.
   */
  let VIDA_VISTA: Record<string, number> = {};
  let MANA_VISTA: Record<string, number> = {};
  let PRIMEIRA_CONFERIDA = true;

  function conferirNumeros() {
    const nova = !PRIMEIRA_CONFERIDA;
    for (const c of COMBS) {
      const pv = c.pv_atual, mn = c.mana_atual;
      if (pv != null) {
        const antes = VIDA_VISTA[c.id];
        VIDA_VISTA[c.id] = pv;
        // Na primeira volta só se anota: acabou de abrir a página, e ninguém
        // levou dano nenhum entre não existir e existir.
        if (nova && antes != null && antes !== pv) {
          flutuar(c.id, `${pv < antes ? '−' : '+'}${Math.abs(pv - antes)}`, pv < antes ? 'dano' : 'cura');
        }
      }
      if (mn != null) {
        const antes = MANA_VISTA[c.id];
        MANA_VISTA[c.id] = mn;
        if (nova && antes != null && antes !== mn && mn < antes) {
          flutuar(c.id, `−${antes - mn} ✦`, 'mana');
        }
      }
    }
    PRIMEIRA_CONFERIDA = false;
  }

  /**
   * Solta um número em cima da peça.
   *
   * Em camada própria e não dentro do token: `pintarTokens` troca o HTML inteiro
   * das peças, e um número que morasse lá dentro sumiria no meio da animação
   * assim que qualquer coisa fosse repintada.
   */
  function flutuar(cid: string, texto: string, tipo: 'dano' | 'cura' | 'mana' | 'tempo') {
    const caixa = document.getElementById('gr-nums');
    const t = TOKENS[cid];
    if (!caixa || !t) return;
    const c = COMBS.find((z: any) => z.id === cid);
    const mg = margem();
    const p = centroHex(t.q, t.r, RAIO);
    const alto = (c ? diametroPx(c) : RAIO) * 0.6;
    const n = document.createElement('span');
    n.className = `gr-num ${tipo}`;
    n.textContent = texto;
    n.style.left = `${p.x + mg.x}px`;
    n.style.top = `${p.y + mg.y - alto}px`;
    // Dois danos no mesmo instante na mesma peça se escondem um atrás do outro;
    // um empurrãozinho lateral por número já vivo ali resolve.
    const juntos = caixa.querySelectorAll(`[data-c="${CSS.escape(cid)}"]`).length;
    if (juntos) n.style.marginLeft = `${juntos * 18}px`;
    n.dataset.c = cid;
    n.addEventListener('animationend', () => n.remove());
    // Rede de segurança: aba em segundo plano não dispara `animationend`, e sem
    // isto a camada acumularia números invisíveis até a página ser recarregada.
    setTimeout(() => n.remove(), 4000);
    caixa.appendChild(n);
  }

  /**
   * A barra de Mana no lugar, sem repintar a peça.
   *
   * Mesmo motivo do anel: repintar joga fora o nó e mata a transição, e a Mana
   * caindo de repente é justamente o que se quer ver andar.
   */
  function atualizarMana(c: any) {
    conferirNumeros();
    const tok = document.querySelector<HTMLElement>(`.gr-token[data-c="${CSS.escape(c.id)}"]`);
    const barra = tok?.querySelector('.mana-v');
    const mn = manaDe100(c);
    // Ganhou ou perdeu a barra inteira (nasceu a reserva, ou zerou o teto): aí
    // não há o que mexer, é desenho novo.
    if (!tok || (!barra && mn != null) || (barra && mn == null)) { pintarTokens(); return; }
    if (barra && mn != null) barra.setAttribute('stroke-dashoffset', (mn - 100).toFixed(2));
  }

  /**
   * Os ícones de condição colados na peça.
   *
   * Estavam só no card do rastreador, e o mestre que estava olhando o mapa não
   * tinha como saber que aquele goblin está Cego sem trocar de aba. Quatro no
   * máximo, e um "+n" para o resto: a fileira não pode ficar mais larga que a
   * própria peça. Some nas peças pequenas, onde não caberia nada.
   */
  function condIconesHTML(c: any, px: number) {
    if (px < 34) return '';
    const cs = (c.condicoes || []).map((k: any) => ({ ...(COND[k.id] || {}), ...k }));
    if (!cs.length) return '';
    const mostra = cs.slice(0, 4);
    return `<span class="tok-conds">${mostra.map((x: any) =>
      `<span class="tok-cond cond-${esc(x.cor || 'neutro')}" title="${esc(x.nome || x.id)}">${esc(x.icone || '•')}</span>`).join('')}${
      cs.length > 4 ? `<span class="tok-cond mais" title="${esc(cs.slice(4).map((x: any) => x.nome).join(', '))}">+${cs.length - 4}</span>` : ''}</span>`;
  }

  /**
   * O anel de alcance: todas as casas a até N metros de uma peça.
   *
   * É o que um tabuleiro hexagonal existe para responder ("eu chego nele?") e
   * era justamente o que faltava: sem isso o mestre conta hexágonos com o dedo,
   * que é lento e erra nas diagonais, onde a contagem hexagonal não bate com a
   * intuição do quadrado.
   */
  function pintarAlcance() {
    const g = document.getElementById('gr-alcance');
    if (!g) return;
    if (!ALCANCE || !TOKENS[ALCANCE.cid]) { g.innerHTML = ''; return; }
    const de = TOKENS[ALCANCE.cid];
    const escala = Number(ARENA.escala_m) || 1;
    const passos = Math.floor(ALCANCE.metros / escala);
    const mg = margem();
    const casas = tabuleiro(ARENA.cols, ARENA.rows)
      .filter((h) => distanciaHex(de, h) <= passos && distanciaHex(de, h) > 0);
    g.innerHTML = casas.map((h) => {
      const c = centroHex(h.q, h.r, RAIO);
      return `<polygon class="hx-alc" points="${verticesHex(c.x + mg.x, c.y + mg.y, RAIO)}" />`;
    }).join('');
  }

  /**
   * A ação declarada de um combatente, ou nada.
   *
   * Quem escreve nela é o rastreador de combate (a aba ao lado); aqui só se lê.
   * Banco sem a migração 27 devolve `undefined`, e o tabuleiro segue igual ao
   * que sempre foi: sem anel de Golpe, sem fita, sem erro.
   */
  const acaoNo = (c: any) => (c && c.acao && !acaoVazia(c.acao) ? c.acao : null);
  /** Só quem tem agenda de golpe: Pressão sozinha não desenha fita nem anel. */
  const gestoNo = (c: any) => (temGesto(c?.acao) ? c.acao : null);

  function pintarTokens() {
    const mg = margem();
    const box = el('gr-tokens');
    const postos = COMBS.filter((c: any) => TOKENS[c.id]);
    // Agrupa por casa para saber quem está dividindo com quem.
    const pilhas: Record<string, any[]> = {};
    for (const c of postos) {
      const t = TOKENS[c.id];
      (pilhas[chaveHex(t.q, t.r)] ||= []).push(c);
    }
    for (const k of Object.keys(pilhas)) {
      pilhas[k].sort((a, b) => String(TOKENS[a.id].em || '').localeCompare(String(TOKENS[b.id].em || '')));
    }
    // Desenha na ordem das pilhas: dentro de cada casa, o mais novo por último
    // (e portanto por cima).
    const ordenados = Object.values(pilhas).flat();
    // A aura acende em TODOS do tick corrente, e não só em quem age primeiro:
    // eles estão agindo no mesmo instante, e a mesa precisa ver isso no chão.
    const naVez = new Set(grupoDaVez().map((c: any) => c.id));
    const agoraTick = relogio();
    reconciliar(box, ordenados.map((c: any) => {
      const t = TOKENS[c.id];
      const p = centroHex(t.q, t.r, RAIO);
      const pilha = pilhas[chaveHex(t.q, t.r)];
      const desl = deslocamentoNaPilha(pilha.indexOf(c), pilha.length, diametroPx(c));
      p.x += desl.dx; p.y += desl.dy;
      const px = diametroPx(c);
      const pct = pctDe100(c);
      const mn = manaDe100(c);
      const faixa = tierDe(pct == null ? null : pct, pct == null ? null : 100);
      const caido = pct != null && pct <= 0;
      // A fase do tempo, quando há ação no ar. É a peça que torna a
      // sincronização jogável: o jogador VÊ que o martelo cai agora, e decide.
      // Ver `combate-tempo.ts` e Combate_Tempo.md §14.7.1.
      const fase = faseEm(gestoNo(c), agoraTick);
      const clsFase = fase === 'golpe' ? ' golpe' : fase === 'preparo' ? ' montando' : '';
      // Abaixo de uns 34px o nome fica mais largo que a peça e vira sujeira em
      // cima do vizinho; nesse tamanho o título do mouse dá conta.
      return { chave: c.id, html: `<div class="gr-token g-${esc(c.grupo || 'inimigo')} ${tierCls(faixa.estado)}${c.oculto ? ' oculto' : ''}${px < 34 ? ' mini' : ''}${caido ? ' caido' : ''}${naVez.has(c.id) ? ' vez' : ''}${clsFase}"
        data-c="${c.id}" style="left:${p.x + mg.x}px; top:${p.y + mg.y}px; --tok:${px.toFixed(1)}px"
        title="${esc(c.nome)} · ${diametroM(c)} m${pct != null ? ` · ${faixa.estado}` : ''}${
          mn != null ? ` · Mana ${c.mana_max != null && c.mana_atual != null
            ? `${c.mana_atual}/${c.mana_max}` : `${Math.round(mn)}%`}` : ''}${
          clsFase ? ` · ${esc(resumoDaAcao(gestoNo(c), agoraTick))}` : ''}">
        <span class="tok-quadro">${avatarDe(c)}${anelHTML(pct)}${manaHTML(mn)}</span>
        ${condIconesHTML(c, px)}
        <span class="gr-tn">${esc(c.nome)}</span>
      </div>` };
    }));
    conferirNumeros();
    // A névoa anda com as peças: quem se move leva o campo de visão junto.
    pintarNevoa();
  }

  // ======================================================== iniciativa
  /**
   * A ordem da fila: tick menor age antes; empatando, iniciativa maior; e no
   * empate dos dois, quem entrou no tabuleiro primeiro.
   *
   * O último critério é o que cumpre "todos começam em 0, na ordem em que foram
   * postos no grid": sem ele, dez peças zeradas ficariam numa ordem qualquer,
   * mudando a cada repintura.
   */
  const naFila = () => COMBS.filter((c: any) => TOKENS[c.id]).slice().sort((a: any, b: any) =>
    ((a.tick ?? 0) - (b.tick ?? 0))
    || ((b.iniciativa ?? 0) - (a.iniciativa ?? 0))
    || String(TOKENS[a.id]?.em || '').localeCompare(String(TOKENS[b.id]?.em || ''))
    || String(a.nome).localeCompare(String(b.nome)));

  /**
   * O tick em que a cena está: o menor entre quem ainda pode agir.
   *
   * Com as ações custando Ticks diferentes, o relógio deixa de andar de um em
   * um e passa a pular para onde está a próxima pessoa. Quem está caído não
   * segura o relógio: ele não vai agir, e o mundo não espera por ele.
   */
  function tickDaVez(): number | null {
    const emPe = naFila().filter((c: any) => !noChao(c));
    return emPe.length ? (emPe[0].tick ?? 0) : null;
  }

  /**
   * Quem está na vez. Agora é um GRUPO, e não uma pessoa.
   *
   * Duas ações podem terminar no mesmo Tick, e aí as duas criaturas agem no
   * mesmo instante: é o que um relógio de Ticks faz, e esconder isso atrás de
   * "um por vez" inventaria uma ordem que a regra não tem. Todos os do tick
   * corrente acendem no tabuleiro; a ORDEM entre eles é a da fila, e o mestre
   * a arrasta na coluna quando quiser escolher quem age primeiro.
   */
  function grupoDaVez(): any[] {
    const t = tickDaVez();
    if (t == null) return [];   // todos no chão: não é a vez de ninguém
    return naFila().filter((c: any) => !noChao(c) && (c.tick ?? 0) === t);
  }

  /** Quem recebe o custo da próxima ação: o primeiro do grupo. */
  const daVez = (): any | null => grupoDaVez()[0] || null;

  /**
   * Onde a cena está, mesmo quando ninguém está de pé.
   *
   * `tickDaVez` devolve nada com todos no chão, e nada não serve para medir
   * efeito nem para escrever na tela: o relógio não voltou a zero, ele PAROU no
   * ponto mais adiantado a que a briga chegou. É esse ponto que fica valendo até
   * alguém levantar.
   */
  function relogio(): number {
    const t = tickDaVez();
    if (t != null) return t;
    const f = naFila();
    return f.length ? Math.max(0, ...f.map((c: any) => c.tick ?? 0)) : (ENC?.tick_atual ?? 0);
  }

  // ------------------------------------------------ quem caiu, quem levantou
  /**
   * O atraso de quem volta a ficar de pé, em Ticks.
   *
   * Levantar não é de graça: quem estava no chão não age no instante em que
   * abre os olhos. Cinco Ticks é o preço de uma ação comum, então quem acorda
   * entra na fila como se tivesse acabado de agir.
   */
  const DELAY_AO_LEVANTAR = 5;
  /** Quem estava no chão na conferência anterior. `null` = ainda não olhamos. */
  let CHAO_ANTES: Set<string> | null = null;
  let LEVANTANDO = false;
  const noChaoAgora = () => new Set(naFila().filter((c: any) => noChao(c)).map((c: any) => c.id));

  /**
   * Confere o chão a cada repintura e cobra o atraso de quem levantou.
   *
   * Mora no desenho, e não em cada lugar que cura, porque ficar de pé acontece
   * por caminhos demais: a cura do menu, a Arte que devolve Vida, a condição
   * "inconsciente" que o mestre tira, o efeito que venceu sozinho e até a
   * campainha do tempo real trazendo isso pronto de fora. Todos terminam
   * repintando a coluna, então é aqui que dá para pegar todos de uma vez.
   *
   * A primeira conferência só anota: no F5 de uma cena com gente de pé, ninguém
   * "acabou de levantar", e cobrar atraso ali empurraria a fila inteira.
   */
  function conferirChao() {
    const agora = noChaoAgora();
    const antes = CHAO_ANTES;
    CHAO_ANTES = agora;
    if (!antes || LEVANTANDO || !MESTRE) return;
    const gente = [...antes].filter((id) => !agora.has(id))
      // Sair do tabuleiro também tira da fila, e isso não é levantar.
      .map((id) => COMBS.find((c: any) => c.id === id && TOKENS[id])).filter(Boolean) as any[];
    if (gente.length) void levantar(gente);
  }

  /**
   * Levantou: volta para a fila com o atraso, contado do agora da cena.
   *
   * O tick antigo dele é lixo, e não ponto de partida: parou no instante em que
   * ele caiu, muitas vezes dezenas de Ticks atrás, e usá-lo faria o curado agir
   * várias vezes seguidas até a cena o alcançar. O agora é medido SEM contar
   * quem acabou de levantar, justamente porque o tick dele ainda é o velho.
   */
  async function levantar(gente: any[]) {
    const ids = new Set(gente.map((c) => c.id));
    const outros = naFila().filter((c: any) => !noChao(c) && !ids.has(c.id));
    const agora = outros.length ? (outros[0].tick ?? 0)
      : Math.max(0, ...naFila().map((c: any) => c.tick ?? 0));
    const tick = agora + DELAY_AO_LEVANTAR;
    LEVANTANDO = true;
    try {
      for (const c of gente) {
        // Quem já estava adiante do atraso não é puxado para trás: o atraso é
        // piso, e não um lugar marcado na fila.
        if ((c.tick ?? 0) >= tick) continue;
        const { error } = await SB.from('combatentes').update({ tick }).eq('id', c.id);
        if (error) { uiErro('Erro: ' + error.message); continue; }
        c.tick = tick;
        await logar(c, `${c.nome} está de pé · volta a agir no tick ${tick}`
          + ` (+${DELAY_AO_LEVANTAR} do tick ${agora})`, { acao: null });
      }
    } finally { LEVANTANDO = false; }
    CHAO_ANTES = noChaoAgora();
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
  }

  // ------------------------------------------------ o custo da próxima ação
  /**
   * Quantos Ticks a próxima ação adianta o relógio de quem age.
   *
   * Fica no aparelho e não na arena: é o número que o mestre acabou de digitar
   * para o golpe que está acontecendo, não uma propriedade da cena. O padrão 5
   * é o do ataque comum; um golpe pesado custa mais, uma ação rápida custa
   * menos, e quem sabe disso é quem está na mesa.
   */
  const CUSTO_KEY = 'centelha:grid:custo-tick';
  function custoAtual(): number {
    const el0 = document.getElementById('ini-custo') as HTMLInputElement | null;
    const v = parseInt(el0?.value || '', 10);
    return Math.max(1, Math.min(60, Number.isFinite(v) ? v : 5));
  }
  function ligarCusto() {
    if (!MESTRE) return;
    const inp = el('ini-custo') as HTMLInputElement;
    el('ini-custo-cx').hidden = false;
    let guardado = 5;
    try { guardado = parseInt(localStorage.getItem(CUSTO_KEY) || '5', 10) || 5; } catch {}
    inp.value = String(Math.max(1, Math.min(60, guardado)));
    const pinta = () => {
      const c = custoAtual();
      el('ini-prox').textContent = `⏭ próximo (+${c}t)`;
      try { localStorage.setItem(CUSTO_KEY, String(c)); } catch {}
    };
    inp.oninput = pinta;
    // A roda do mouse sobre o campo mexeria no número sem querer enquanto se
    // rola a coluna; o campo não é lugar de rolagem.
    inp.addEventListener('wheel', (ev) => ev.preventDefault(), { passive: false });
    pinta();
  }

  function pintarIniciativa() {
    const box = el('gr-ini');
    // Antes de desenhar, porque é o desenho que revela quem levantou.
    conferirChao();
    const fila = naFila();
    const emPe = fila.filter((c: any) => !noChao(c));
    pintarChao(fila.filter((c: any) => noChao(c)));
    if (!fila.length) {
      esquecerCaixa(box);
      box.innerHTML = `<p class="ini-vazio">${MESTRE
        ? 'Ninguém no tabuleiro ainda. Quem entra no mapa entra na fila.'
        : 'Ninguém em cena.'}</p>`;
      return;
    }
    const grupo = grupoDaVez();
    const naVez = new Set(grupo.map((c: any) => c.id));
    const age = grupo[0]?.id;
    // A rodada sai do tick, como no rastreador: seis ticks fecham uma rodada.
    const tick = relogio();
    // Só o NÚMERO: a palavra "Tick" é estática no cabeçalho, ao lado dele, e
    // escrevê-la aqui de novo dava "TICK 0 TICK" na tela.
    el('ini-tk').textContent = String(tick);
    el('ini-rd').textContent = `Rodada ${Math.floor(tick / 6) + 1}`;
    if (MESTRE) {
      (el('ini-rolar') as HTMLElement).hidden = false;
      const prox = el('ini-prox') as HTMLButtonElement;
      prox.hidden = false;
      // Sem ninguém de pé não há vez para encerrar, e o botão passaria a ser um
      // clique que não faz nada.
      prox.disabled = !emPe.length;
      prox.title = emPe.length ? '' : 'Ninguém de pé: a cena espera alguém levantar.';
    }
    if (!emPe.length) {
      esquecerCaixa(box);
      box.innerHTML = `<p class="ini-vazio">Todos no chão. O relógio parou no tick ${tick}.</p>`;
      return;
    }
    // Quem monta os cartões é `itensDaFila`, no `mesa-tempo-ui`: o rastreador
    // de combate desenha a mesma tira, e duas cópias da mesma escada divergiriam
    // no primeiro conserto.
    const itens = itensDaFila(emPe.map((c: any) => ({
      id: c.id, nome: c.nome, tick: c.tick ?? 0, iniciativa: c.iniciativa ?? 0,
      grupo: c.grupo, avatar: avatarDe(c, 'av-p'), pct: pctDe100(c),
      acao: acaoNo(c), segura: c.acao?.tipo === 'segura',
      vez: naVez.has(c.id), age: c.id === age,
    })), tick, { marcacao: TEMPO.marcacao });
    reconciliar(box, itens);
    pintarLinhaDoTempo(tick);
  }

  /**
   * A LINHA DO TEMPO: uma régua de Ticks, e não uma fila.
   *
   * A tira de iniciativa responde "de quem é a vez", que é uma pergunta de ordem. O
   * P/G/R criou outra, que é de simultaneidade: o martelo cai antes ou depois de
   * a flecha sair? Uma lista ordenada não tem como responder isso, porque ela
   * empilha PESSOAS e o que se precisa comparar são INSTANTES.
   *
   * Aqui os Ticks são colunas e as pessoas são linhas, todas partindo da mesma
   * coluna do agora. Duas fitas quaisquer se comparam com o olho parado.
   *
   * MOSTRA POUCA GENTE de propósito: quem tem gesto no ar, mais os próximos a
   * agir. A cena inteira viraria uma parede de doze linhas em que nada salta, e
   * o que interessa é sempre o punhado que está prestes a acontecer.
   */
  function pintarLinhaDoTempo(tick: number) {
    const cx = el('gr-linha');
    if (!ARENA || !LINHA_LIGADA || TEMPO.marcacao !== 'fita') { cx.hidden = true; aplicarLinha(); return; }
    const emPe = naFila().filter((c: any) => !noChao(c));
    const comGesto = emPe.filter((c: any) => gestoNo(c));
    const proximos = emPe.filter((c: any) => !gestoNo(c)).slice(0, Math.max(0, 6 - comGesto.length));
    const linhas = [...comGesto, ...proximos].slice(0, 8)
      .sort((a: any, b: any) => (a.tick ?? 0) - (b.tick ?? 0));
    cx.hidden = !linhas.length;
    aplicarLinha();
    if (!linhas.length) return;

    // A largura da régua: o suficiente para caber o ciclo mais longo em cena,
    // entre 8 e 16. Fixá-la em 12 cortava o martelo ao meio numa cena lenta e
    // desperdiçava metade da faixa numa cena de adagas.
    const fim = Math.max(...linhas.map((c: any) => c.tick ?? 0), tick + 7);
    const largura = Math.min(16, Math.max(8, fim - tick + 1));
    const corpo = el('lt-corpo');
    corpo.style.gridTemplateColumns = `7rem repeat(${largura}, minmax(0, 1fr)) auto`;
    const cel = (fase: string, agora: boolean, txt = '') =>
      `<i class="lt-c ${fase}${agora ? ' agora' : ''}">${txt}</i>`;
    const cab = `<div class="lt-l lt-cab"><span class="lt-n"></span>${
      Array.from({ length: largura }, (_, i) => cel('', i === 0, String(tick + i))).join('')
    }<span class="lt-fim"></span></div>`;
    corpo.innerHTML = cab + linhas.map((c: any) => {
      const a = gestoNo(c);
      const cels = Array.from({ length: largura }, (_, i) => {
        const f = faseEm(a, tick + i);
        return cel(f === 'preparo' ? 'f-prep' : f === 'golpe' ? 'f-golpe'
          : f === 'recuperacao' ? 'f-rec' : '', i === 0);
      }).join('');
      const falta = Math.max(0, (c.tick ?? 0) - tick);
      const fim2 = a ? `livre no ${a.livre}` : falta === 0 ? 'age agora' : `age em ${falta}`;
      return `<div class="lt-l g-${esc(c.grupo || 'inimigo')}${falta === 0 ? ' agora' : ''}" data-c="${c.id}"
        title="${esc(c.nome)}${a ? ' · ' + esc(resumoDaAcao(a, tick)) : ''}">
        <span class="lt-n">${esc(c.nome)}</span>${cels}<span class="lt-fim">${esc(fim2)}</span>
      </div>`;
    }).join('');
  }

  /** A faixa sai da grade quando está oculta, e o tabuleiro recupera a altura. */
  function aplicarLinha() {
    const g = document.querySelector<HTMLElement>('.gr-grade');
    g?.classList.toggle('sem-linha', !!(el('gr-linha') as HTMLElement).hidden);
  }

  /** A tira dos caídos, no pé da coluna. Sem números: eles não estão na ordem. */
  function pintarChao(caidos: any[]) {
    const tira = el('ini-chao') as HTMLElement;
    tira.hidden = !caidos.length;
    if (!caidos.length) { esquecerCaixa(tira); tira.innerHTML = ''; return; }
    reconciliar(tira, [
      { chave: '#h', html: `<div class="ini-chao-h">No chão · ${caidos.length}</div>` },
      ...caidos.map((c: any) => {
        const pct = pctDe100(c);
        return { chave: c.id, html: `<div class="ini-caido g-${esc(c.grupo || 'inimigo')}" data-c="${c.id}"
          title="${esc(c.nome)} · fora da fila até voltar a ficar de pé${
            pct != null ? ` · ${Math.round(pct)}%` : ''}">
          <span>${avatarDe(c, 'av-p')}</span><span class="nm">${esc(c.nome)}</span>
        </div>` };
      }),
    ]);
  }

  /**
   * O clique, o botão direito e o arrasto da coluna de iniciativa.
   *
   * Ligado UMA vez, no contêiner, e não a cada desenho: `pintarIniciativa`
   * troca o innerHTML inteiro, e ouvintes presos aos itens morreriam junto com
   * eles a cada repintura (que agora acontece a cada movimento de peça).
   */
  function ligarIniciativa() {
    if (!MESTRE) return;
    const box = el('gr-ini');
    let arr: { id: string; tick: string; no: HTMLElement } | null = null;
    // A tira deitou, então o arrasto deitou junto: quem reordena um tick agora
    // empurra a peça para os lados, e não para cima e para baixo.
    let mexeu = false, x0 = 0;

    box.addEventListener('click', (ev) => {
      const it = (ev.target as HTMLElement).closest<HTMLElement>('.ini-item');
      // Depois de arrastar, o navegador ainda manda o clique: sem esta trava,
      // toda reordenação terminaria com o menu da peça aberto na cara.
      if (!it || mexeu) return;
      abrirMenu(it.dataset.c!, ev.clientX, ev.clientY);
    });
    box.addEventListener('contextmenu', (ev) => {
      const it = (ev.target as HTMLElement).closest<HTMLElement>('.ini-item');
      if (!it) return;
      ev.preventDefault();
      editarIniciativa(it.dataset.c!);
    });
    // A tira dos caídos abre o mesmo menu: é dali que sai a cura que põe a
    // pessoa de pé, e obrigar o mestre a caçar a peça no tabuleiro para isso
    // seria tirar da mão dele o único movimento que a tira admite.
    el('ini-chao').addEventListener('click', (ev) => {
      const it = (ev.target as HTMLElement).closest<HTMLElement>('.ini-caido');
      if (it) abrirMenu(it.dataset.c!, ev.clientX, ev.clientY);
    });

    box.addEventListener('pointerdown', (ev) => {
      const it = (ev.target as HTMLElement).closest<HTMLElement>('.ini-item');
      if (!it) return;
      arr = { id: it.dataset.c!, tick: it.dataset.t!, no: it };
      mexeu = false; x0 = ev.clientX;
    });
    box.addEventListener('pointermove', (ev) => {
      if (!arr) return;
      if (!mexeu) {
        if (Math.abs(ev.clientX - x0) < 6) return;   // ainda pode ser um clique
        mexeu = true;
        arr.no.classList.add('movendo');
        box.setPointerCapture?.(ev.pointerId);
      }
      const sob = document.elementFromPoint(ev.clientX, ev.clientY)?.closest<HTMLElement>('.ini-item');
      // Só dentro do MESMO tick: a ordem entre ticks diferentes é do relógio, e
      // não do mestre. Arrastar para fora do grupo não faz nada, de propósito.
      if (!sob || sob === arr.no || sob.dataset.t !== arr.tick) return;
      const r = sob.getBoundingClientRect();
      sob.parentElement!.insertBefore(arr.no, ev.clientX > r.left + r.width / 2 ? sob.nextSibling : sob);
    });
    const soltar = async () => {
      if (!arr) return;
      const { tick } = arr;
      const arrastou = mexeu;
      arr.no.classList.remove('movendo');
      arr = null;
      if (!arrastou) return;
      await gravarOrdemDoTick(tick);
      // A trava do clique só sai depois que o evento de clique já passou.
      setTimeout(() => { mexeu = false; }, 0);
    };
    box.addEventListener('pointerup', soltar);
    box.addEventListener('pointercancel', soltar);
  }

  /**
   * Grava a ordem que o mestre arrastou dentro de um tick.
   *
   * O desempate dentro do tick é a `iniciativa`, então é ela que muda. Os
   * NÚMEROS ROLADOS são preservados: o conjunto de valores do grupo é o mesmo,
   * só passa para a ordem nova. Empate ainda cairia no desempate velho e
   * desfaria o arrasto, então a sequência é forçada a cair de um em um quando
   * dois valores se encontram.
   */
  async function gravarOrdemDoTick(tick: string) {
    const ids = [...el('gr-ini').querySelectorAll<HTMLElement>(`.ini-item[data-t="${CSS.escape(tick)}"]`)]
      .map((e) => e.dataset.c!);
    const membros = ids.map((i) => COMBS.find((c: any) => c.id === i)).filter(Boolean) as any[];
    if (membros.length < 2) return;
    const valores = membros.map((c) => c.iniciativa ?? 0).sort((a, b) => b - a);
    for (let i = 1; i < valores.length; i++) {
      if (valores[i] >= valores[i - 1]) valores[i] = valores[i - 1] - 1;
    }
    const mudaram = membros.filter((c, i) => c.iniciativa !== valores[i]);
    if (!mudaram.length) return;
    membros.forEach((c, i) => { c.iniciativa = valores[i]; });
    for (const c of mudaram) {
      const { error } = await SB.from('combatentes').update({ iniciativa: c.iniciativa }).eq('id', c.id);
      if (error) { await carregarCombatentes(); pintarIniciativa(); return uiErro('Erro: ' + error.message); }
    }
    avisarAgora('combatentes');
    pintarIniciativa(); pintarTokens();
    await logar(null, `Ordem do tick ${tick}: ${membros.map((c) => c.nome).join(' → ')}`, { acao: null });
  }

  /**
   * Rola a iniciativa de todo mundo que está no tabuleiro.
   *
   * Cada tipo usa a regra dele, e não um d6 genérico: o personagem soma
   * Raciocínio e Prontidão da ficha (a mesma conta do rastreador), a criatura
   * soma o bônus escrito no bloco do bestiário, e o figurante de cena, que não
   * tem ficha nem bloco, rola o dado limpo. Os ticks voltam a zero, porque uma
   * iniciativa nova é uma cena nova.
   */
  async function rolarIniciativas() {
    const fila = naFila();
    if (!fila.length) return;
    if (!await uiConfirmar(`Rolar a iniciativa dos ${fila.length} no tabuleiro? Os ticks voltam a zero.`,
      { titulo: 'Rolar iniciativa', ok: 'Rolar' })) return;
    const fichas: Record<string, any> = {};
    const ids = [...new Set(fila.map((c: any) => c.personagem_id).filter(Boolean))];
    if (ids.length) {
      const { data } = await SB.from('personagens').select('id, ficha').in('id', ids);
      for (const p of data || []) fichas[p.id] = p.ficha;
    }
    const rolado: { c: any; v: number }[] = [];
    for (const c of fila) {
      let v: number;
      if (c.tipo === 'pc' && fichas[c.personagem_id]) v = rolarIniciativaPC(fichas[c.personagem_id]);
      else if (c.tipo === 'criatura' && MON[c.monstro_id]) v = iniDeMonstro(MON[c.monstro_id]);
      else v = d6();
      rolado.push({ c, v });
    }
    for (const r of rolado) {
      await SB.from('combatentes').update({ iniciativa: r.v, tick: 0 }).eq('id', r.c.id);
      r.c.iniciativa = r.v; r.c.tick = 0;
    }
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
    const ordem = rolado.slice().sort((a, b) => b.v - a.v).map((r) => `${r.c.nome} ${r.v}`).join(' · ');
    await logar(null, `Iniciativa rolada: ${ordem}`, { acao: null });
    await verificarEfeitos(ctxArtes());
  }

  async function editarIniciativa(cid: string) {
    const c = COMBS.find((x: any) => x.id === cid); if (!c) return;
    const v = await uiFormulario(`Ordem de ${c.nome}`, [
      { nome: 'tick', rotulo: 'Tick (menor age antes)', tipo: 'numero', valor: c.tick ?? 0, min: 0 },
      { nome: 'ini', rotulo: 'Iniciativa (desempata, maior primeiro)', tipo: 'numero', valor: c.iniciativa ?? 0 },
    ], { ok: 'Salvar' });
    if (!v) return;
    const tick = Math.max(0, parseInt(v.tick, 10) || 0);
    const ini = parseInt(v.ini, 10) || 0;
    const { error } = await SB.from('combatentes').update({ tick, iniciativa: ini }).eq('id', cid);
    if (error) return uiErro('Erro: ' + error.message);
    c.tick = tick; c.iniciativa = ini;
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
    // Mexer no tick à mão também adianta o relógio, e um efeito pode ter
    // vencido nesse pulo. Sem esta conferência ele sumia do desenho (que já
    // filtra o que venceu) sem nunca escrever "acabou" no registro.
    await verificarEfeitos(ctxArtes());
  }

  /**
   * Agiu: o relógio DELE anda o custo da ação.
   *
   * Era "vai para o fim da fila" (o maior tick da mesa mais um), que é a régua
   * de quem não tem custo de ação: todo mundo agia uma vez por rodada, na mesma
   * cadência, e uma estocada rápida valia o mesmo que uma marreta. Agora o
   * número vem do campo ao lado da rodada, e é ele que decide quando esta
   * criatura volta a aparecer na fila. Quem gastou 3 age de novo antes de quem
   * gastou 7, e é assim que o relógio de Ticks conta a briga.
   */
  async function encerrarVez(cid: string, custo = custoAtual()) {
    const c = COMBS.find((x: any) => x.id === cid); if (!c) return;
    const gasto = Math.max(1, Math.min(60, Math.round(custo)));
    const tick = Math.max(0, (c.tick ?? 0) + gasto);
    const { error } = await SB.from('combatentes').update({ tick }).eq('id', cid);
    if (error) return uiErro('Erro: ' + error.message);
    c.tick = tick;
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
    const prox = daVez();
    await logar(c, `${c.nome} agiu · +${gasto} tick${gasto > 1 ? 's' : ''} (volta no ${tick})`
      + (prox && prox.id !== cid ? ` · agora é ${prox.nome}` : ''),
      { acao: null });
    // O relógio andou: é aqui que o fogo que não apaga volta a queimar, e que o
    // efeito vencido sai do tabuleiro levando a condição que tinha posto.
    await verificarEfeitos(ctxArtes());
  }

  /**
   * Abortar o gesto de quem está em Preparo, do tabuleiro.
   *
   * Ao contrário de `encerrarVez`, o Tick aqui é ABSOLUTO: quem desiste fica
   * livre no Tick de agora mais o deslocamento, e não onde o ciclo terminaria.
   * A ação sai junto, senão o anel de Golpe continuaria acendendo para um golpe
   * que não vai mais sair.
   */
  async function abortarGesto(cid: string) {
    const c = COMBS.find((x: any) => x.id === cid); if (!c) return;
    const a = acaoNo(c); if (!a) return;
    abrirAbortar({ nome: c.nome, acao: a, tick: relogio() }, async (r) => {
      const { error } = await SB.from('combatentes')
        .update({ tick: r.novoTick, acao: {} }).eq('id', cid);
      if (error) return uiErro('Erro: ' + error.message);
      c.tick = r.novoTick; c.acao = {};
      pintarIniciativa(); pintarTokens();
      avisarAgora('combatentes');
      await logar(c, `${r.frase} · próxima ação no tick ${r.novoTick} (sairia no ${a.livre})`, { acao: null });
    });
  }

  function pintarLista() {
    const box = el('gr-lista');
    if (!ENC) {
      esquecerCaixa(box);
      box.innerHTML = `<p class="vazio">${MESTRE
        ? 'Nenhum combate em andamento. O tabuleiro puxa quem está no encontro ativo.'
        : 'Sem combate ativo.'}</p>`;
      return;
    }
    if (!COMBS.length) { esquecerCaixa(box); box.innerHTML = '<p class="vazio">Ninguém em campo.</p>'; return; }
    // Gente primeiro, bicho depois.
    //
    // A lista vinha na ordem do tick, e numa cena com doze goblins os quatro
    // personagens ficavam espalhados no meio deles. Quem o mestre procura para
    // arrastar é quase sempre uma pessoa nomeada; a criatura ele chama pelo
    // número, e vem em bando. Dentro de cada grupo a ordem do combate é
    // mantida, que é a ordem em que a mesa fala dos dois.
    const ficha = (c: any) => {
      const t = TOKENS[c.id];
      return `<div class="gr-ficha${t ? ' posto' : ''}" data-c="${c.id}" title="${esc(c.nome)}">
        ${avatarDe(c, 'av-p')}
        <span class="gr-fn">${esc(c.nome)}</span>
        ${c.mana_max ? `<span class="gr-mn" title="Mana">✦ ${c.mana_atual ?? 0}/${c.mana_max}</span>` : ''}
        ${t ? `<span class="gr-fq">no mapa</span>` : ''}
      </div>`;
    };
    const gente = COMBS.filter((c: any) => c.tipo !== 'criatura');
    const bichos = COMBS.filter((c: any) => c.tipo === 'criatura');
    // O rótulo do grupo só aparece quando há os dois: com uma cena só de
    // criaturas, "Criaturas" escrito em cima delas não informa nada. Sem
    // rótulo não há o que recolher, e o bloco sai solto, como antes.
    const doisGrupos = !!gente.length && !!bichos.length;
    const grupos = [
      { chave: 'gente', titulo: 'Personagens e NPCs', lista: gente },
      { chave: 'bichos', titulo: 'Criaturas', lista: bichos },
    ].filter((g) => g.lista.length);

    // Dois níveis: o de cima são os cabeçalhos e as caixas de cada grupo, o de
    // baixo são os retratos dentro delas. A caixa nasce vazia e com HTML fixo,
    // então ela nunca é refeita: o `hidden` do recolhimento entra por
    // propriedade, fora da string, para não contar como mudança de conteúdo.
    if (!doisGrupos) {
      reconciliar(box, grupos.flatMap((g) => g.lista.map((c: any) => ({ chave: c.id, html: ficha(c) }))));
    } else {
      reconciliar(box, grupos.flatMap((g) => {
        const fechado = GRUPO_FECHADO[g.chave];
        return [
          { chave: `h:${g.chave}`, html: `<button type="button" class="gr-grupo-h${fechado ? ' fechado' : ''}" data-g="${g.chave}"
            aria-expanded="${!fechado}" title="${fechado ? 'Mostrar' : 'Recolher'} ${g.titulo.toLowerCase()}">
            <span class="gg-seta">▾</span>${g.titulo} <span>${g.lista.length}</span></button>` },
          { chave: `c:${g.chave}`, html: `<div class="gr-grupo-c" data-gc="${g.chave}"></div>` },
        ];
      }));
      for (const g of grupos) {
        const caixa = box.querySelector<HTMLElement>(`.gr-grupo-c[data-gc="${g.chave}"]`);
        if (!caixa) continue;
        caixa.hidden = !!GRUPO_FECHADO[g.chave];
        reconciliar(caixa, g.lista.map((c: any) => ({ chave: c.id, html: ficha(c) })));
      }
    }
    box.querySelectorAll<HTMLElement>('.gr-grupo-h').forEach((h) => h.onclick = () => {
      const g = h.dataset.g!;
      GRUPO_FECHADO[g] = !GRUPO_FECHADO[g];
      try { localStorage.setItem(GRUPO_KEY, JSON.stringify(GRUPO_FECHADO)); } catch {}
      pintarLista();
    });
  }

  /**
   * Que grupos de "Em campo" estão recolhidos. Fica no aparelho, e não na
   * arena: é preferência de quem está olhando, e o mestre no notebook não tem
   * por que impor a escolha ao jogador no celular.
   */
  const GRUPO_KEY = 'centelha:grid:grupos-fechados';
  let GRUPO_FECHADO: Record<string, boolean> = (() => {
    try { return JSON.parse(localStorage.getItem(GRUPO_KEY) || '{}') || {}; } catch { return {}; }
  })();

  // ================================================================== zoom
  function aplicarZoom() {
    const mundo = el('gr-mundo');
    mundo.style.transform = `scale(${ZOOM})`;
    // O palco precisa reservar o espaço do mundo JÁ ESCALADO: `transform` não
    // muda o tamanho que o pai enxerga, e sem isto a barra de rolagem mede o
    // tabuleiro sem zoom e corta o que passa disso.
    const med = medida();
    mundo.style.marginRight = `${med.largura * (ZOOM - 1)}px`;
    mundo.style.marginBottom = `${med.altura * (ZOOM - 1)}px`;
    el('gr-zval').textContent = Math.round(ZOOM * 100) + '%';
  }
  const mudarZoom = (z: number) => { ZOOM = Math.max(0.3, Math.min(2.5, z)); aplicarZoom(); };

  function caber() {
    const med = medida();
    const palco = el('gr-palco');
    mudarZoom(Math.min((palco.clientWidth - 8) / med.largura, (palco.clientHeight - 8) / med.altura));
  }

  // ============================================================== arrastar
  /**
   * Arrastar com pointer events, e não com o drag-and-drop do HTML.
   *
   * O nativo não funciona em toque (o mestre no tablet ficaria de fora), não
   * deixa desenhar o fantasma sem uma imagem inventada, e não avisa por cima de
   * qual hexágono o dedo está — que é justamente o retorno que faz o gesto
   * parecer um tabuleiro e não um formulário.
   */
  let ARR: { id: string; deOnde: 'lista' | 'mapa'; ghost: HTMLElement } | null = null;
  let ALVO: { q: number; r: number } | null = null;

  function ligarArrasto() {
    const palco = el('gr-palco');

    document.addEventListener('pointerdown', (ev) => {
      const alvo = ev.target as HTMLElement;
      const naLista = alvo.closest<HTMLElement>('.gr-ficha');
      const noMapa = alvo.closest<HTMLElement>('.gr-token');
      const fonte = naLista || noMapa;
      if (!fonte || AJUSTANDO || NEVOANDO || MIRA) return;
      const cid = fonte.dataset.c!;
      const c = COMBS.find((x: any) => x.id === cid);
      if (!c) return;
      // O jogador arrasta a peça DELE, e só. Sair calado, e não avisar: tentar
      // arrastar o goblin é gesto exploratório, não erro, e um aviso a cada
      // toque no mapa alheio viraria ruído.
      if (!mandoNela(c)) return;
      ev.preventDefault();

      const ghost = document.createElement('div');
      ghost.className = 'gr-ghost';
      ghost.innerHTML = avatarDe(c);
      // O fantasma é `position: fixed`, então fica FORA do `scale` do mundo: sem
      // multiplicar pelo zoom, a peça encolheria ao ser levantada e cresceria ao
      // ser solta. Com ele, o que se arrasta tem o tamanho do que vai pousar.
      (ghost.firstElementChild as HTMLElement)?.style
        .setProperty('--av-t', `${(diametroPx(c) * ZOOM).toFixed(1)}px`);
      // Em tela cheia só o palco é desenhado: um fantasma pendurado no <body>
      // ficaria invisível justamente durante o arrasto.
      (document.fullscreenElement || document.body).appendChild(ghost);
      moverGhost(ghost, ev.clientX, ev.clientY);

      ARR = { id: cid, deOnde: naLista ? 'lista' : 'mapa', ghost };
      if (noMapa) noMapa.classList.add('arrastando');
      (ev.target as HTMLElement).setPointerCapture?.(ev.pointerId);
    });

    document.addEventListener('pointermove', (ev) => {
      if (!ARR) return;
      moverGhost(ARR.ghost, ev.clientX, ev.clientY);
      marcarAlvo(ev.clientX, ev.clientY);
      // Soltar sobre a lista tira do mapa: destacar a coluna diz isso antes de
      // o dedo levantar.
      el('gr-lado').classList.toggle('solta', ARR.deOnde === 'mapa' && sobreALista(ev.clientX, ev.clientY));
    });

    document.addEventListener('pointerup', async (ev) => {
      if (!ARR) return;
      const { id, deOnde } = ARR;
      ARR.ghost.remove();
      el('gr-lado').classList.remove('solta');
      document.querySelectorAll('.gr-token.arrastando').forEach((t) => t.classList.remove('arrastando'));
      const destino = ALVO;
      limparAlvo(); limparSeta();
      ARR = null;

      if (deOnde === 'mapa' && sobreALista(ev.clientX, ev.clientY)) { await tirarDoMapa(id); return; }
      // SOLTAR EM CIMA DE ALGUÉM É ATACAR.
      //
      // A casa ocupada recusa o movimento, então este gesto terminava em nada:
      // o mestre arrastava, a peça voltava, e ele ia pelo menu. Três toques
      // (botão direito, ⚔, clique) viraram um arrasto, que é o gesto que a mão
      // já estava fazendo.
      const sob = document.elementFromPoint(ev.clientX, ev.clientY) as HTMLElement | null;
      const tokAlvo = sob?.closest<HTMLElement>('.gr-token');
      const outro = tokAlvo && tokAlvo.dataset.c && tokAlvo.dataset.c !== id
        ? COMBS.find((c: any) => c.id === tokAlvo.dataset.c) : null;
      const eu = COMBS.find((c: any) => c.id === id);
      if (outro && eu && TOKENS[id]) { await resolverAtaque(eu, outro); return; }
      if (!destino) return;
      await porNoMapa(id, destino.q, destino.r);
    });

    palco.addEventListener('pointercancel', () => {
      if (!ARR) return;
      ARR.ghost.remove(); ARR = null; limparAlvo(); limparSeta();
      document.querySelectorAll('.gr-token.arrastando').forEach((t) => t.classList.remove('arrastando'));
    });
  }

  // ================================================== ajustar a aparência
  /**
   * Um modo, e não controles sempre ligados: enquanto se alinha a arte, o
   * tabuleiro inteiro vira superfície de arrasto, e um clique num token moveria
   * a peça em vez do mapa. Entrar no modo desliga o arrasto de tokens.
   */
  /**
   * O estado da aparência no instante em que a janela abriu. É o que o
   * "Cancelar" devolve. Guardado como cópia, e não como referência: `FUNDO` e
   * `GRADE` são mexidos no lugar pelas barrinhas.
   */
  let AJUSTE_ANTES: { fundo: typeof FUNDO; grade: typeof GRADE } | null = null;

  function modoAjuste(liga: boolean) {
    AJUSTANDO = liga;
    el('gr-mundo').classList.toggle('ajustando', liga);
    (el('gr-ajustar') as HTMLElement).hidden = liga || !MESTRE;
    const dlg = el('arte-dlg') as HTMLDialogElement;
    if (liga) {
      if (!dlg.open) {
        AJUSTE_ANTES = { fundo: { ...FUNDO }, grade: { ...GRADE } };
        // Em tela cheia de elemento, nada fora do palco é desenhado: a janela
        // se muda para dentro dele, senão simplesmente não apareceria. Quando
        // quem está em tela cheia é o documento, o corpo continua servindo.
        const palco = el('gr-palco');
        const casa = document.fullscreenElement === palco ? palco : document.body;
        // A conferência do pai não é zelo: `appendChild` no pai que já é o pai
        // ainda ARRANCA e recoloca o nó, e quem estivesse segurando uma
        // referência a ele (um clique a caminho, um teste) fica com um nó que
        // não pertence mais ao documento.
        if (dlg.parentElement !== casa) casa.appendChild(dlg);
        // Modal, como "medidas" e "fundo". O `catch` não é decoração: um
        // navegador que recuse o modal ainda abre a janela solta, e aí o
        // tabuleiro atrás continua aceitando o arrasto da arte.
        try { dlg.showModal(); } catch { dlg.show(); }
      }
      sincronizarControles();
    } else if (dlg.open) dlg.close();
  }

  /** Devolve a arte e o traço ao que eram quando a janela abriu. */
  function cancelarAjuste() {
    if (!AJUSTE_ANTES) return;
    FUNDO = { ...AJUSTE_ANTES.fundo };
    GRADE = { ...AJUSTE_ANTES.grade };
    AJUSTE_ANTES = null;
    aplicarFundo(); aplicarGrade(); sincronizarControles();
    gravarAparencia();
  }

  /**
   * A cruz de posição, no lugar do arrasto.
   *
   * Com a janela modal aberta o tabuleiro fica inerte atrás dela, e o gesto de
   * empurrar o mapa com o ponteiro não chega mais lá. Um passo são 2% da
   * largura do tabuleiro, que é fino o bastante para alinhar uma ponte e grosso
   * o bastante para atravessar o mapa em vinte cliques.
   */
  const PASSO_POS = 2;
  function moverArte(dir: string) {
    if (dir === 'centro') { FUNDO.x = 0; FUNDO.y = 0; }
    else if (dir === 'cima') FUNDO.y -= PASSO_POS;
    else if (dir === 'baixo') FUNDO.y += PASSO_POS;
    else if (dir === 'esq') FUNDO.x -= PASSO_POS;
    else if (dir === 'dir') FUNDO.x += PASSO_POS;
    else return;
    // O teto é generoso de propósito: com a arte muito ampliada, empurrar duas
    // vezes a largura do tabuleiro ainda é enquadramento legítimo.
    FUNDO.x = Math.max(-200, Math.min(200, +FUNDO.x.toFixed(2)));
    FUNDO.y = Math.max(-200, Math.min(200, +FUNDO.y.toFixed(2)));
    aplicarFundo(); pintarPosicao(); salvarAparencia();
  }

  /** O rótulo da posição: "centro", ou o quanto se andou para cada lado. */
  function pintarPosicao() {
    const alvo = document.getElementById('fa-pval');
    if (!alvo) return;
    const x = Math.round(FUNDO.x || 0), y = Math.round(FUNDO.y || 0);
    alvo.textContent = !x && !y ? 'centro'
      : `${x ? `${x > 0 ? '→' : '←'} ${Math.abs(x)}%` : ''}${x && y ? ' · ' : ''}${y ? `${y > 0 ? '↓' : '↑'} ${Math.abs(y)}%` : ''}`;
  }

  function ligarAparencia() {
    if (!MESTRE) return;
    const zoomEl = el('fa-zoom') as HTMLInputElement;
    const opEl = el('fa-op') as HTMLInputElement;
    const corEl = el('fa-cor') as HTMLInputElement;

    const mudarZ = (z: number) => {
      FUNDO.z = Math.max(0.2, Math.min(4, +z.toFixed(3)));
      zoomEl.value = String(FUNDO.z);
      el('fa-zval').textContent = Math.round(FUNDO.z * 100) + '%';
      // "caber" e "preencher" recentralizam a arte, então o rótulo da posição
      // muda junto: ele é atualizado aqui, e não só na cruz.
      aplicarFundo(); pintarPosicao(); salvarAparencia();
    };
    el('gr-ajustar').onclick = () => modoAjuste(true);
    el('fa-concluir').onclick = () => { AJUSTE_ANTES = null; modoAjuste(false); };
    el('fa-cancelar').onclick = () => { cancelarAjuste(); modoAjuste(false); };
    // O Esc é um cancelamento, e não um "concluir sem clicar": é o que ele
    // significa nos outros dois diálogos, onde nada foi gravado até o Salvar.
    // Aqui a gravação já aconteceu, então cancelar é desfazer de verdade.
    el('arte-dlg').addEventListener('cancel', () => cancelarAjuste());
    // Fechar por qualquer via sai do modo de ajuste: ficar com o tabuleiro em
    // modo de ajuste, sem nada na tela dizendo isso, é a pior das duas metades.
    el('arte-dlg').addEventListener('close', () => { if (AJUSTANDO) modoAjuste(false); });
    el('arte-dlg').querySelectorAll<HTMLElement>('.fa-dpad [data-mv]')
      .forEach((b) => b.onclick = () => moverArte(b.dataset.mv!));
    el('fa-menos').onclick = () => mudarZ(FUNDO.z - 0.1);
    el('fa-mais').onclick = () => mudarZ(FUNDO.z + 0.1);
    zoomEl.oninput = () => mudarZ(+zoomEl.value);
    el('fa-caber').onclick = () => { FUNDO.x = 0; FUNDO.y = 0; mudarZ(1); };
    el('fa-preencher').onclick = () => { FUNDO.x = 0; FUNDO.y = 0; mudarZ(zPreencher()); };

    // Girar. O `caber` reavalia junto porque a caixa que a arte ocupa muda com
    // o ângulo: um mapa deitado, de pé, passa a pedir a altura do tabuleiro.
    const rotEl = el('fa-rot') as HTMLInputElement;
    const mudarRot = (g: number) => {
      let v = Math.round(g);
      // Mantém a volta dentro de −180..180 para a barra não bater na trave.
      while (v > 180) v -= 360;
      while (v < -180) v += 360;
      FUNDO.rot = v;
      rotEl.value = String(v);
      el('fa-rval').textContent = v + '°';
      aplicarFundo(); salvarAparencia();
    };
    rotEl.oninput = () => mudarRot(+rotEl.value);
    // Um quarto de volta por clique: é o giro que se usa de verdade, quando o
    // mapa foi digitalizado deitado.
    el('fa-girar').onclick = () => mudarRot((FUNDO.rot || 0) + 90);

    const vezCorEl = el('fa-vez-cor') as HTMLInputElement;
    const vezEl = el('fa-vez') as HTMLInputElement;
    vezCorEl.oninput = () => { GRADE.vezCor = vezCorEl.value; aplicarGrade(); salvarAparencia(); };
    vezEl.oninput = () => {
      GRADE.vezForca = +vezEl.value;
      el('fa-vezval').textContent = String(GRADE.vezForca);
      aplicarGrade(); salvarAparencia();
    };

    ligarSetas();

    corEl.oninput = () => { GRADE.cor = corEl.value; aplicarGrade(); salvarAparencia(); };
    opEl.oninput = () => {
      GRADE.op = +opEl.value;
      el('fa-opval').textContent = Math.round(GRADE.op * 100) + '%';
      aplicarGrade(); salvarAparencia();
    };

    // Arrastar a arte. Em % do tabuleiro, e não em pixels: mudar o número de
    // colunas depois não desalinha o que já foi enquadrado.
    const mundo = el('gr-mundo');
    let puxando = false, lx = 0, ly = 0;
    mundo.addEventListener('pointerdown', (ev) => {
      if (!AJUSTANDO) return;
      ev.preventDefault();
      puxando = true; lx = ev.clientX; ly = ev.clientY;
      mundo.classList.add('puxando');
      mundo.setPointerCapture?.(ev.pointerId);
    });
    mundo.addEventListener('pointermove', (ev) => {
      if (!AJUSTANDO || !puxando) return;
      const med = medida();
      FUNDO.x += ((ev.clientX - lx) / ZOOM / med.largura) * 100;
      FUNDO.y += ((ev.clientY - ly) / ZOOM / med.altura) * 100;
      lx = ev.clientX; ly = ev.clientY;
      aplicarFundo();
    });
    const soltar = () => {
      if (!puxando) return;
      puxando = false; mundo.classList.remove('puxando'); salvarAparencia();
    };
    mundo.addEventListener('pointerup', soltar);
    mundo.addEventListener('pointercancel', soltar);
    // A roda amplia a ARTE no modo de ajuste (fora dele ela rola a página, que é
    // o que se espera de uma roda).
    mundo.addEventListener('wheel', (ev) => {
      if (!AJUSTANDO) return;
      ev.preventDefault();
      mudarZ(FUNDO.z * (ev.deltaY < 0 ? 1.08 : 1 / 1.08));
    }, { passive: false });
  }

  // ------------------------------------------------------------ as setas
  /**
   * A cor que o seletor mostra quando o mestre ainda não escolheu nenhuma.
   *
   * Sai do tema, e não de um hex escrito aqui: o `--accent` é outro em cada um
   * dos três temas, e um seletor abrindo em verde-água sobre um tema claro
   * mentiria sobre a cor que está no tabuleiro.
   */
  function corPadraoSeta(p: string): string {
    if (p === 'sa') return '#cf3327';
    const v = getComputedStyle(document.body).getPropertyValue('--accent').trim();
    return /^#[0-9a-f]{6}$/i.test(v) ? v : '#00bab4';
  }

  /** Põe os controles de uma seta no valor atual e redesenha a prévia. */
  function sincronizarSeta(s: { p: string; chave: 'setaMov' | 'setaAtq' }) {
    const e = estiloSeta(s.chave) as Required<EstiloSeta>;
    const g: any = GRADE[s.chave] || {};
    const põe = (campo: string, valor: any) => {
      const inp = document.getElementById(`${s.p}-${campo}`) as HTMLInputElement | null;
      if (inp) inp.value = String(valor);
    };
    const rot = (campo: string, txt: string) => {
      const n = document.getElementById(`${s.p}-${campo}val`);
      if (n) n.textContent = txt;
    };
    põe('tipo', e.tipo); põe('base', e.base); põe('ponta', e.ponta);
    põe('arco', e.arco); põe('cabeca', e.cabeca);
    põe('op', g.op ?? 0.95);
    põe('cor', g.cor || corPadraoSeta(s.p));
    rot('base', `${e.base}px`); rot('ponta', `${e.ponta}px`);
    rot('arco', `${e.arco}°`); rot('cabeca', `×${e.cabeca}`);
    const prev = document.getElementById(`${s.p}-prev`);
    if (prev) {
      // A prévia é a própria seta, desenhada pela mesma função do tabuleiro:
      // uma amostra desenhada à parte acabaria mentindo na primeira mudança.
      prev.innerHTML = `<path class="seta-fig ${s.p === 'sm' ? 'seta-mov' : 'seta-atq'}"
        d="${caminhoSeta({ x: 12, y: 32 }, { x: 200, y: 14 }, e)}" />`;
    }
  }

  function ligarSetas() {
    if (!MESTRE) return;
    for (const s of SETAS_UI) {
      for (const campo of ['cor', 'tipo', 'op', 'base', 'ponta', 'arco', 'cabeca']) {
        const inp = document.getElementById(`${s.p}-${campo}`) as HTMLInputElement | null;
        if (!inp) continue;
        const muda = () => {
          const texto = campo === 'tipo' || campo === 'cor';
          GRADE[s.chave] = { ...(GRADE[s.chave] || {}), [campo]: texto ? inp.value : +inp.value } as any;
          aplicarGrade(); sincronizarSeta(s); salvarAparencia();
        };
        inp.oninput = muda;
        inp.onchange = muda;
      }
      sincronizarSeta(s);
    }
  }

  const moverGhost = (g: HTMLElement, x: number, y: number) => { g.style.left = x + 'px'; g.style.top = y + 'px'; };

  /**
   * O que está debaixo do dedo, medido por coordenada e não por `ev.target`.
   *
   * `setPointerCapture` redireciona todos os eventos seguintes para o elemento
   * que começou o arrasto, então `ev.target` no `pointerup` é sempre o próprio
   * token — nunca a lista. Perguntar ao documento quem ocupa aquele pixel é o
   * que faz "soltar na coluna para tirar do mapa" funcionar.
   */
  const sobreALista = (x: number, y: number) =>
    !!document.elementFromPoint(x, y)?.closest('#gr-lado');

  /** Do ponto na tela ao hexágono, descontando o zoom e a rolagem do palco. */
  function hexNaTela(cx: number, cy: number) {
    const mundo = el('gr-mundo');
    const cai = mundo.getBoundingClientRect();
    const mg = margem();
    // getBoundingClientRect já vem escalado, então dividir por ZOOM devolve o
    // pixel do mundo (que é o sistema em que o SVG foi desenhado).
    const x = (cx - cai.left) / ZOOM - mg.x;
    const y = (cy - cai.top) / ZOOM - mg.y;
    const h = hexEmPonto(x, y, RAIO);
    return dentro(h, ARENA.cols, ARENA.rows) ? h : null;
  }

  function marcarAlvo(cx: number, cy: number) {
    const h = hexNaTela(cx, cy);
    if (h && ALVO && h.q === ALVO.q && h.r === ALVO.r) return;
    limparAlvo();
    ALVO = h;
    if (!h) { limparSeta(); return; }
    const poly = el('gr-hexes').querySelector(`.hx[data-h="${chaveHex(h.q, h.r)}"]`);
    // Um hexágono já ocupado é recusa e não erro: a mesa decide se dois corpos
    // dividem um metro quadrado, e por ora a resposta é não.
    poly?.classList.add(ocupadoPor(h.q, h.r, ARR?.id) ? 'proibido' : 'alvo');
    desenharSeta(h);
  }
  function limparAlvo() {
    el('gr-hexes').querySelectorAll('.hx.alvo, .hx.proibido').forEach((p) => p.classList.remove('alvo', 'proibido'));
    ALVO = null;
  }

  /**
   * A seta do caminho, com a distância em metros.
   *
   * Só sai quando o arrasto começou NO tabuleiro: vindo da lista lateral não
   * existe origem em hexágono nenhuma, e uma seta saindo da coluna seria uma
   * medida inventada. A distância é a de hexágonos (contagem de passos, que num
   * tabuleiro hexagonal já é a distância real) vezes a escala da arena.
   */
  function desenharSeta(ate: { q: number; r: number }) {
    const g = document.getElementById('gr-seta');
    if (!g) return;
    const de = ARR && ARR.deOnde === 'mapa' ? TOKENS[ARR.id] : null;
    if (!de) { g.innerHTML = ''; return; }
    const mg = margem();
    const a = centroHex(de.q, de.r, RAIO), b = centroHex(ate.q, ate.r, RAIO);
    const passos = distanciaHex(de, ate);
    const metros = passos * (Number(ARENA.escala_m) || 1);
    // O texto sai do meio do caminho e sobe um pouco, para não deitar em cima
    // da própria linha.
    const mx = (a.x + b.x) / 2 + mg.x, my = (a.y + b.y) / 2 + mg.y - 8;
    const rotulo = `${Number.isInteger(metros) ? metros : metros.toFixed(1)} m`;
    const d = caminhoSeta({ x: a.x + mg.x, y: a.y + mg.y }, { x: b.x + mg.x, y: b.y + mg.y },
      estiloSeta('setaMov'));
    g.innerHTML = `<path class="seta-fig seta-mov" d="${d}" />
      <text class="seta-txt" x="${mx.toFixed(1)}" y="${my.toFixed(1)}">${rotulo}<\/text>
      <text class="seta-sub" x="${mx.toFixed(1)}" y="${(my + 13).toFixed(1)}">${passos} hex</text>`;
  }
  const limparSeta = () => { const g = document.getElementById('gr-seta'); if (g) g.innerHTML = ''; };
  // ------------------------------------------------ quem divide o espaço
  const NO_CHAO = new Set(['caido', 'inconsciente', 'morrendo', 'estabilizado', 'morto']);
  /** Está no chão: sem Vida, ou com uma condição que o derruba. */
  function noChao(c: any): boolean {
    if (c.pv_max != null && (c.pv_atual ?? 0) <= 0) return true;
    return (c.condicoes || []).some((k: any) => NO_CHAO.has(k.id) || COND[k.id]?.foraDeCombate);
  }
  /**
   * Dois corpos no mesmo lugar: quando isso é aceitável.
   *
   * Gente miúda cabe junta, e quem está caído virou parte do chão: passa-se por
   * cima. Fora esses dois casos, um metro quadrado é de um só.
   */
  const podeDividir = (a: any, b: any) =>
    noChao(a) || noChao(b) || (diametroM(a) <= 0.5 && diametroM(b) <= 0.5);

  /**
   * O DESLOCAMENTO PAGO (K20, §14.10 do `Combate_Tempo.md`).
   *
   * Andar durante a Recuperação custa **2 Ticks por metro**: o golpe já saiu, a
   * guarda ainda não voltou, e sair do lugar nesse intervalo é comprar tempo
   * com tempo. O Grid é o único que sabe quantos metros foram, então é ele que
   * cobra, e cobra sozinho: o número aparece em cima da peça e a linha entra no
   * registro, que é o que o mestre desfaz se a mesa decidiu outra coisa.
   *
   * QUANDO NÃO COBRA: quem está livre, quem está montando o gesto e quem está
   * no Golpe. Livre é o caso que a regra não decidiu (mover fora da Recuperação
   * ainda não tem preço escrito), e inventar um aqui seria escrever regra na
   * tela. No Preparo o que existe é o abortar, que tem preço próprio (1 Tick
   * por metro) e caixa própria.
   */
  async function cobrarDeslocamento(c: any, metros: number) {
    if (!c || !(metros > 0)) return;
    const acao = acaoNo(c);
    if (faseEm(acao, relogio()) !== 'recuperacao') return;
    const custo = ticksDeDeslocamento(metros);
    if (!custo) return;
    const novoTick = (c.tick ?? 0) + custo;
    // A Recuperação ESTICA junto: o relógio dela é o mesmo `livre`, e mover os
    // dois separados deixaria a fita dizendo "livre no 9" numa peça que só age
    // no 15.
    const nova = { ...(acao || {}), livre: novoTick };
    if (MESTRE) {
      const { error } = await SB.from('combatentes')
        .update({ tick: novoTick, acao: nova }).eq('id', c.id);
      if (error) return avisarSemTempo(error);
    } else {
      const { error } = await SB.rpc('jogador_declara',
        { p_comb: c.id, p_tick: novoTick, p_acao: nova, p_alvo: null, p_golpes: 0 });
      if (error) return avisarSemTempo(error);
    }
    c.tick = novoTick; c.acao = nova;
    flutuar(c.id, `+${custo} ⏱`, 'tempo');
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
    await logar(c, `${c.nome} andou ${fmtM(metros)} na Recuperação: +${custo} Ticks (livre no ${novoTick})`,
      { acao: null });
  }

  /**
   * Se este ponto está bloqueado. A conta é em METROS, e não em hexágonos.
   *
   * Comparar a casa exata funcionava enquanto todo mundo ocupava um hexágono.
   * Com o token no tamanho físico, dois Médios numa arena de 0,5 m ficariam
   * montados um no outro em casas vizinhas, porque cada um tem 1 m de largura e
   * as casas distam 0,5 m. A regra é a de dois círculos: encostam quando a
   * distância entre os centros é menor que a soma dos raios. Encostar só é
   * proibido para quem não pode dividir o espaço.
   */
  function ocupadoPor(q: number, r: number, exceto?: string) {
    const escala = Number(ARENA?.escala_m) || 1;
    const meu = exceto ? COMBS.find((x: any) => x.id === exceto) : null;
    const raioMeu = (meu ? diametroM(meu) : 1) / 2;
    return Object.entries(TOKENS).some(([cid, t]) => {
      if (cid === exceto) return false;
      const outro = COMBS.find((x: any) => x.id === cid);
      if (!outro) return false;
      if (meu && podeDividir(meu, outro)) return false;
      const metros = distanciaHex({ q, r }, t) * escala;
      return metros + 1e-9 < raioMeu + diametroM(outro) / 2;
    });
  }

  // ============================================================== gravar
  async function porNoMapa(cid: string, q: number, r: number, registrar = true) {
    if (ocupadoPor(q, r, cid)) return;
    const antes = TOKENS[cid] ? { ...TOKENS[cid] } : null;
    if (antes && antes.q === q && antes.r === r) return;   // largou onde já estava
    // Otimista: o token pula na hora. O carimbo entra junto porque é ele que
    // ordena a pilha quando dois dividem a casa, e quem acabou de chegar tem de
    // aparecer por cima já no primeiro desenho.
    const agora = new Date().toISOString();
    TOKENS[cid] = { q, r, em: agora };
    pintarTokens(); pintarLista(); pintarIniciativa(); pintarAlcance();
    const { error } = await gravarToken(cid, q, r, agora);
    if (error) {
      if (antes) TOKENS[cid] = antes; else delete TOKENS[cid];
      pintarTokens(); pintarLista(); pintarIniciativa(); pintarAlcance();
      return uiErro('Não deu para mover: ' + error.message);
    }
    avisarAgora('tokens');
    if (!registrar) return;
    const c = COMBS.find((x: any) => x.id === cid);
    const casa = nomeHex(q, r);
    if (antes) {
      const passos = distanciaHex(antes, { q, r });
      const m = passos * (Number(ARENA.escala_m) || 1);
      await logar(c, `${c?.nome} foi de ${nomeHex(antes.q, antes.r)} para ${casa} · ${fmtM(m)} (${passos} hex)`,
        { acao: 'mover', cid, de: antes, para: { q, r } });
    } else {
      await logar(c, `${c?.nome} entrou em ${casa}`, { acao: 'por', cid, de: null, para: { q, r } });
    }
    if (antes) await cobrarDeslocamento(c, distanciaHex(antes, { q, r }) * (Number(ARENA.escala_m) || 1));
    // Andar é o gesto que faz alguém pisar numa zona de fogo ou sair de uma
    // aura, então é aqui que os efeitos são reconferidos.
    await verificarEfeitos(ctxArtes());
  }

  async function tirarDoMapa(cid: string, registrar = true) {
    const antes = TOKENS[cid] ? { ...TOKENS[cid] } : null;
    delete TOKENS[cid];
    pintarTokens(); pintarLista(); pintarIniciativa(); pintarAlcance();
    const { error } = await apagarToken(cid);
    if (error) {
      if (antes) TOKENS[cid] = antes;
      pintarTokens(); pintarLista(); pintarIniciativa(); pintarAlcance();
      return uiErro('Não deu para tirar: ' + error.message);
    }
    avisarAgora('tokens');
    if (!registrar || !antes) return;
    const c = COMBS.find((x: any) => x.id === cid);
    await logar(c, `${c?.nome} saiu do mapa (estava em ${nomeHex(antes.q, antes.r)})`,
      { acao: 'tirar', cid, de: antes, para: null });
  }

  // ====================================================== menu do token
  /**
   * Botão direito abre o menu; no toque, segurar meio segundo sem arrastar faz
   * o mesmo. O `mover` cancela porque arrastar e segurar começam idênticos: sem
   * essa desistência, todo movimento terminaria com um menu na cara.
   */
  function ligarMenuToken() {
    const palco = el('gr-palco');
    palco.addEventListener('contextmenu', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>('.gr-token');
      if (!t || AJUSTANDO || NEVOANDO) return;
      ev.preventDefault();
      abrirMenu(t.dataset.c!, ev.clientX, ev.clientY);
    });

    let toque: any = null, x0 = 0, y0 = 0;
    palco.addEventListener('pointerdown', (ev) => {
      if (ev.pointerType === 'mouse' || AJUSTANDO) return;
      const t = (ev.target as HTMLElement).closest<HTMLElement>('.gr-token');
      if (!t) return;
      x0 = ev.clientX; y0 = ev.clientY;
      toque = setTimeout(() => { toque = null; abrirMenu(t.dataset.c!, x0, y0); }, 500);
    });
    const desiste = (ev?: PointerEvent) => {
      if (!toque) return;
      if (ev && Math.hypot(ev.clientX - x0, ev.clientY - y0) < 8) return;
      clearTimeout(toque); toque = null;
    };
    palco.addEventListener('pointermove', desiste);
    palco.addEventListener('pointerup', () => { if (toque) { clearTimeout(toque); toque = null; } });
    document.addEventListener('pointerdown', (ev) => {
      if (!(ev.target as HTMLElement).closest('#tok-menu')) fecharMenu();
    }, true);
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return;
      fecharMenu(); cancelarMira();
      // O Esc do ajuste passa por AQUI antes de chegar ao diálogo, e fechar na
      // mão dispara `close` sem disparar `cancel`. Sem desfazer explicitamente,
      // o Esc viraria um "concluir" silencioso, que é o contrário do que ele
      // significa nos outros diálogos. Chamar duas vezes é inofensivo: o
      // segundo cancelamento não tem mais o que devolver.
      if (AJUSTANDO) { cancelarAjuste(); modoAjuste(false); }
    });
  }

  const fecharMenu = () => { const m = el('tok-menu'); m.hidden = true; m.innerHTML = ''; };

  function abrirMenu(cid: string, x: number, y: number) {
    const c = COMBS.find((z: any) => z.id === cid); if (!c) return;
    const m = el('tok-menu');
    const item = (id: string, txt: string, cls = '') => `<button data-a="${id}" class="${cls}">${txt}</button>`;
    const ehAVez = grupoDaVez().some((z: any) => z.id === cid);
    // O cabeçalho vira porta para o card do bestiário quando a peça TEM bloco.
    // Vale para a criatura e para o figurante que pegou o retrato emprestado de
    // uma: quem tem `monstro_id` tem card, e olhar a ficha do bicho no meio da
    // luta era trocar de aba e perder o mapa de vista.
    const bloco = MON[c.monstro_id];
    // O menu muda com quem abriu. O jogador age pela peça dele (atacar,
    // conjurar, gastar Mana) e pode lançar dano em qualquer um, porque é ele que
    // acabou de rolar o golpe. O que é da mesa (curar, adiantar o relógio,
    // mexer na ordem, tirar do mapa) continua sendo do mestre.
    const meu = mandoNela(c);
    const sep = '<div class="tm-sep"></div>';
    const linhas = [
      meu ? item('ataque', '⚔ Ataque') : '',
      MESTRE ? item('curar', '✚ Recuperar Vida') : '',
      item('dano', '✖ Tirar Vida'),
      temMana(c) && meu ? item('mana', '✦ Mana') : '',
      meu ? item('arte', '✶ Arte') : '',
      sep,
      item('alcance', ALCANCE?.cid === cid ? '◎ Apagar o alcance' : '◎ Mostrar alcance'),
      MESTRE ? sep : '',
      // Abortar só aparece para quem está em Preparo, e é assim que a regra se
      // ensina: no Golpe e na Recuperação o item simplesmente não está lá.
      // Mestre só, como o resto do que mexe no relógio: o jogador escreve em
      // `combatentes` pelas funções `jogador_*` da migração 22, e não há uma
      // para isto ainda.
      MESTRE && podeAbortar(acaoNo(c), relogio()) ? item('abortar', '✋ Abortar o gesto') : '',
      MESTRE ? item('encerrar', `⏭ ${ehAVez ? 'Agiu' : 'Adiantar o relógio dele'} (+${custoAtual()} ticks)`) : '',
      MESTRE ? item('ordem', '↕ Iniciativa e ticks') : '',
      MESTRE ? sep : '',
      MESTRE ? item('tirar', '⏏ Tirar do mapa', 'perigo') : '',
    ];
    m.innerHTML = `<div class="tm-cab${bloco ? ' tem-card' : ''}"${bloco
        ? ' role="button" tabindex="0" title="Ver o card completo da criatura"' : ''}
      >${avatarDe(c, 'av-p')}<span class="tm-nome">${esc(c.nome)}</span>${
        seloFaseHTML(acaoNo(c), relogio())}${
        bloco ? '<span class="tm-card-i" aria-hidden="true">▤</span>' : ''}</div>`
      + linhas.filter(Boolean).join('');
    m.hidden = false;
    // Encosta na borda? O menu volta para dentro em vez de sair da tela.
    const r = m.getBoundingClientRect();
    m.style.left = Math.min(x, innerWidth - r.width - 8) + 'px';
    m.style.top = Math.min(y, innerHeight - r.height - 8) + 'px';
    const cab = m.querySelector<HTMLElement>('.tm-cab.tem-card');
    if (cab) cab.onclick = () => { fecharMenu(); abrirCard(cid); };
    m.querySelectorAll<HTMLElement>('button').forEach((b) => b.onclick = () => {
      fecharMenu();
      const a = b.dataset.a;
      if (a === 'ataque') iniciarMira(cid);
      else if (a === 'curar') curar(cid);
      else if (a === 'dano') tirarVida(cid);
      else if (a === 'mana') ajustarMana(cid);
      else if (a === 'arte') usarArte(cid);
      else if (a === 'alcance') alternarAlcance(cid);
      else if (a === 'abortar') abortarGesto(cid);
      else if (a === 'encerrar') encerrarVez(cid);
      else if (a === 'ordem') editarIniciativa(cid);
      else if (a === 'tirar') tirarDoMapa(cid);
    });
  }

  /**
   * A mira intercepta o clique ANTES do arrasto (fase de captura no palco,
   * contra os ouvintes de `document` que movem a peça). Sem isso, escolher o
   * alvo arrastaria o alvo.
   */
  function ligarMira() {
    el('gr-palco').addEventListener('pointerdown', (ev) => {
      if (!MIRA) return;
      ev.preventDefault(); ev.stopPropagation();
      const t = (ev.target as HTMLElement).closest<HTMLElement>('.gr-token');
      if (t && t.dataset.c !== MIRA.atacante) escolherAlvo(t.dataset.c!);
      else cancelarMira();
    }, true);
    document.addEventListener('pointermove', (ev) => { if (MIRA) moverMira(ev.clientX, ev.clientY); });
  }

  // ---------------------------------------------------------- tela cheia
  /**
   * Tela cheia de verdade (a do navegador), e não uma classe que estica a
   * página: o que atrapalha num mapa de batalha é a barra do navegador e a do
   * sistema, e só a Fullscreen API tira as duas.
   */
  function ligarTelaCheia() {
    const btn = el('gr-cheia');
    const pinta = () => {
      const cheia = !!document.fullscreenElement;
      btn.textContent = cheia ? '⤡' : '⛶';
      btn.title = cheia ? 'Sair da tela cheia (Esc)' : 'Tela cheia (F)';
      document.body.classList.toggle('tela-cheia', cheia);
      // Quando quem foi para a tela cheia é o DOCUMENTO (o segundo degrau da
      // escada abaixo), o palco continua sendo um elemento comum da página: a
      // regra de reserva do CSS é que o estica, e o menu não pode se mudar para
      // dentro do <html>.
      // O menu do token é irmão do tabuleiro, e em tela cheia de ELEMENTO só o
      // elemento é desenhado: fora dele, o menu simplesmente não apareceria.
      // Mudá-lo de casa é o preço de projetar só o tabuleiro.
      const palco = el('gr-palco');
      const casa = document.fullscreenElement === palco ? palco : document.body;
      for (const id of ['tok-menu', 'gr-sair-cheia', 'arte-dlg']) {
        const n = document.getElementById(id);
        if (n && n.parentElement !== casa) casa.appendChild(n);
      }
      // O palco mede a altura da janela, que acabou de mudar: reencaixar o
      // tabuleiro é o gesto que o mestre faria na mão logo em seguida.
      ajustarAltura();
      if (ARENA) setTimeout(() => { ajustarAltura(); caber(); }, 150);
    };
    /**
     * Uma escada de três degraus, e não uma tentativa só.
     *
     * 1. O PALCO vai para a tela cheia. É o que um player de vídeo faz, e o
     *    navegador projeta o elemento no monitor inteiro por conta própria.
     * 2. Se o navegador recusar o elemento, tenta o DOCUMENTO. Alguns contextos
     *    liberam um e não o outro, e o resultado na tela é o mesmo: o monitor
     *    inteiro, com o palco esticado pela regra de reserva do CSS.
     * 3. Se recusar os dois, o palco toma a janela e a página diz o que houve.
     *
     * O degrau 2 é novo: antes, uma recusa caía direto no 3, e a diferença
     * entre "o navegador não deixou" e "tomou só a janela" ficava por conta de
     * quem estava olhando.
     */
    const alterna = async () => {
      if (document.fullscreenElement) { try { await document.exitFullscreen(); } catch {} return; }
      const alvo = el('gr-palco');
      let erro: any = null;
      try {
        await alvo.requestFullscreen({ navigationUI: 'hide' } as any);
        conferirCobertura();
        return;
      } catch (e) { erro = e; }
      try {
        await document.documentElement.requestFullscreen({ navigationUI: 'hide' } as any);
        conferirCobertura();
        return;
      } catch (e) { erro = e; }
      // `pinta()` não serve aqui: ele lê `document.fullscreenElement`, que é
      // nulo, e desfaria a classe que acabou de entrar.
      document.body.classList.add('tela-cheia');
      btn.textContent = '⤡';
      if (ARENA) setTimeout(() => caber(), 150);
      uiErro('O navegador recusou a tela cheia do monitor, então o tabuleiro tomou só a janela. '
        + 'Isso costuma acontecer quando a página está aberta dentro de outra (um painel de '
        + 'pré-visualização, por exemplo): abrindo em uma aba normal do navegador, a tela cheia funciona.'
        + (erro?.name ? ` (${erro.name})` : ''));
    };

    /**
     * O navegador aceitou. Mas deu mesmo o monitor?
     *
     * Há um caso em que ele diz sim e entrega só a janela, e ele é traiçoeiro
     * porque não levanta erro nenhum: a página rodando dentro de outra (um
     * painel de pré-visualização, uma moldura). A conta é com `outerWidth`, que
     * é a janela em pixels do sistema, e não com `innerWidth`, que o zoom da
     * página encolhe e faria a conferência gritar à toa a 125%.
     *
     * O aviso sai DENTRO do palco: em tela cheia de elemento, nada fora dele é
     * desenhado, e um diálogo pendurado no corpo da página não apareceria.
     */
    function conferirCobertura() {
      setTimeout(() => {
        if (!document.fullscreenElement) return;
        if (outerWidth >= screen.width - 2 && outerHeight >= screen.height - 2) return;
        const av = document.createElement('div');
        av.className = 'mira-aviso gr-aviso-cheia';
        av.textContent = `O navegador deu ${outerWidth}×${outerHeight} de ${screen.width}×${screen.height}: `
          + 'a tela cheia ficou do tamanho da janela. Abra a página numa aba normal do navegador.';
        el('gr-palco').appendChild(av);
        setTimeout(() => av.remove(), 7000);
      }, 400);
    }
    btn.onclick = alterna;
    (el('gr-sair-cheia') as HTMLElement).onclick = alterna;
    document.addEventListener('fullscreenchange', pinta);
    // "F" só quando não se está digitando: senão escrever "Ferido" numa nota
    // jogaria a página em tela cheia no meio da palavra.
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'f' && ev.key !== 'F') return;
      const a = document.activeElement as HTMLElement | null;
      if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.tagName === 'SELECT' || a.isContentEditable)) return;
      if (document.querySelector('dialog[open]')) return;
      ev.preventDefault(); alterna();
    });
  }

  // ============================================================ alcance
  let ULTIMO_ALCANCE = 5;
  async function alternarAlcance(cid: string) {
    if (ALCANCE?.cid === cid) { ALCANCE = null; pintarAlcance(); return; }
    const c = COMBS.find((x: any) => x.id === cid);
    const v = await uiFormulario(`Alcance de ${c?.nome}`, [
      { nome: 'm', rotulo: 'Metros', tipo: 'numero', valor: ULTIMO_ALCANCE, min: 1 },
    ], { msg: 'Acende as casas que a peça alcança. Serve para deslocamento e para o alcance de uma arma.', ok: 'Mostrar' });
    if (!v) return;
    ULTIMO_ALCANCE = Math.max(1, parseInt(v.m, 10) || 5);
    ALCANCE = { cid, metros: ULTIMO_ALCANCE };
    pintarAlcance();
  }

  // ====================================================== régua e navegação
  /**
   * Régua, roda e arrasto do mapa.
   *
   * Convenção de mesa virtual, e não invenção: arrastar no vazio mede, a roda
   * aproxima e o botão do meio empurra o mapa. Cada gesto num botão diferente
   * porque os três acontecem no mesmo lugar (o chão vazio) e disputá-lo no
   * mesmo botão faria um atrapalhar o outro.
   */
  function ligarReguaENavegacao() {
    const palco = el('gr-palco');
    let regua: { x: number; y: number } | null = null;
    let pan: { x: number; y: number; sx: number; sy: number } | null = null;

    palco.addEventListener('pointerdown', (ev) => {
      if (AJUSTANDO || MIRA || ARR) return;
      if (ev.button === 1) {                       // botão do meio: empurra o mapa
        ev.preventDefault();
        pan = { x: ev.clientX, y: ev.clientY, sx: palco.scrollLeft, sy: palco.scrollTop };
        palco.setPointerCapture?.(ev.pointerId);
        palco.classList.add('arrastando-mapa');
        return;
      }
      if (ev.button !== 0) return;
      if ((ev.target as HTMLElement).closest('.gr-token')) return;   // peça é assunto do arrasto
      regua = { x: ev.clientX, y: ev.clientY };
    });

    palco.addEventListener('pointermove', (ev) => {
      if (pan) {
        palco.scrollLeft = pan.sx - (ev.clientX - pan.x);
        palco.scrollTop = pan.sy - (ev.clientY - pan.y);
        return;
      }
      if (!regua) return;
      // Só vira régua depois de andar um pouco: senão todo clique no vazio
      // desenharia uma linha de zero metro.
      if (Math.hypot(ev.clientX - regua.x, ev.clientY - regua.y) < 6) return;
      desenharRegua(regua, { x: ev.clientX, y: ev.clientY });
    });

    const fim = () => {
      if (pan) { pan = null; palco.classList.remove('arrastando-mapa'); }
      if (regua) { regua = null; limparSeta(); }
    };
    palco.addEventListener('pointerup', fim);
    palco.addEventListener('pointercancel', fim);
    palco.addEventListener('pointerleave', fim);
    // O botão do meio abre aba nova por padrão em alguns navegadores.
    palco.addEventListener('auxclick', (ev) => { if (ev.button === 1) ev.preventDefault(); });

    palco.addEventListener('wheel', (ev) => {
      if (AJUSTANDO) return;                       // ajustando, a roda é da arte
      ev.preventDefault();
      // Aproxima no ponto do cursor, e não no canto: é o que faz o zoom parecer
      // que se está chegando perto do que se olha.
      const antes = ZOOM;
      mudarZoom(ZOOM * (ev.deltaY < 0 ? 1.12 : 1 / 1.12));
      const f = ZOOM / antes;
      const r = palco.getBoundingClientRect();
      palco.scrollLeft = (palco.scrollLeft + ev.clientX - r.left) * f - (ev.clientX - r.left);
      palco.scrollTop = (palco.scrollTop + ev.clientY - r.top) * f - (ev.clientY - r.top);
    }, { passive: false });
  }

  /** A linha da régua entre dois pontos da tela, com a distância em metros. */
  function desenharRegua(de: { x: number; y: number }, ate: { x: number; y: number }) {
    const g = document.getElementById('gr-seta');
    if (!g) return;
    const mundo = el('gr-mundo').getBoundingClientRect();
    const mg = margem();
    const p = (t: { x: number; y: number }) => ({ x: (t.x - mundo.left) / ZOOM, y: (t.y - mundo.top) / ZOOM });
    const a = p(de), b = p(ate);
    const ha = hexEmPonto(a.x - mg.x, a.y - mg.y, RAIO);
    const hb = hexEmPonto(b.x - mg.x, b.y - mg.y, RAIO);
    const passos = distanciaHex(ha, hb);
    const metros = passos * (Number(ARENA.escala_m) || 1);
    g.innerHTML = `
      <line class="seta regua" x1="${a.x.toFixed(1)}" y1="${a.y.toFixed(1)}"
        x2="${b.x.toFixed(1)}" y2="${b.y.toFixed(1)}" />
      <text class="seta-txt" x="${((a.x + b.x) / 2).toFixed(1)}" y="${((a.y + b.y) / 2 - 8).toFixed(1)}"
        >${fmtM(metros)}</text>
      <text class="seta-sub" x="${((a.x + b.x) / 2).toFixed(1)}" y="${((a.y + b.y) / 2 + 5).toFixed(1)}"
        >${passos} hex · ${nomeHex(ha.q, ha.r)}→${nomeHex(hb.q, hb.r)}</text>`;
  }

  // ============================================================ tempo real
  /**
   * O tabuleiro ao vivo.
   *
   * A regra é a mesma da campainha em `mesa-tempo-real.ts`: quem escreve avisa
   * com uma palavra, quem ouve relê aquele pedaço pela própria view. Nada de
   * estado viaja pelo canal, e por isso o jogador não recebe aqui uma vírgula a
   * mais do que a migração 14 já lhe dava — a peça oculta continua sem sair de
   * `token_visao`, e a Vida exata do inimigo continua sem sair de
   * `combate_visao`.
   *
   * O que se ganha com isso é a mesa: o mestre arrasta o goblin e os cinco
   * celulares em volta da mesa mostram o goblin andando, sem ninguém apertar
   * nada. Era a última coisa que separava este Grid de uma mesa virtual.
   */
  let EU_NOME = '', EU_PAPEL: 'mestre' | 'jogador' = 'jogador';

  async function ligarTempoReal(ctx: any) {
    EU_PAPEL = MESTRE ? 'mestre' : 'jogador';
    let perfil = '';
    try { perfil = (await nomesDe(SB, [EU]))[EU] || ''; } catch {}
    EU_NOME = nomeParaPresenca(perfil || ctx?.user?.user_metadata?.nome, EU_PAPEL);
    RT = abrirCanal({
      sb: SB, mesa: ID,
      eu: { id: EU, nome: EU_NOME, papel: EU_PAPEL, aba: 'grid' },
      // Redesenhar por baixo da mão é pior do que atrasar um segundo: quem está
      // arrastando uma peça, mirando um ataque, alinhando a arte ou com um
      // diálogo aberto perderia o gesto no meio. O aviso espera e entra depois.
      ocupado: () => !!ARR || !!MIRA || AJUSTANDO
        || !el('tok-menu').hidden || !!document.querySelector('dialog[open]'),
      aoAvisar: aplicarAvisos,
      aoPingar: mostrarPing,
      aoPresenca: pintarPresenca,
      aoEstado: pintarPresenca,
    });
    pintarPresenca();
    ligarPing();
  }

  /**
   * A campainha toca pelo que MUDOU, e não por quem mexeu.
   *
   * `verificarEfeitos` roda toda vez que alguém anda (hoje só repinta quando há
   * Arte no chão). Tocar cego ali custava caro do outro lado: um
   * aviso de "combatentes" obriga a reler a lista inteira com as fichas e os
   * retratos, e ainda por cima descarta a peça deslizando, porque o desenho
   * completo troca o nó. A assinatura abaixo é o preço certo: três linhas de
   * texto comparadas na memória decidem se vale acordar a mesa.
   */
  let ASSIN = { combs: '', tokens: '', efeitos: '' };
  const assinatura = () => ({
    combs: COMBS.map((c: any) =>
      `${c.id}:${c.pv_atual}:${c.tick}:${c.iniciativa}:${(c.condicoes || []).length}`).join('|'),
    tokens: Object.keys(TOKENS).sort().map((k) => `${k}:${TOKENS[k].q},${TOKENS[k].r}`).join('|'),
    // O painel lateral é desenhado a partir dos efeitos vivos: o texto dele
    // muda exatamente quando eles mudam, e sai de graça.
    efeitos: el('gr-ef-lista').textContent || '',
  });
  /** Guarda o estado atual sem tocar nada. Usado depois de todo desenho completo. */
  const marcarEstado = () => { ASSIN = assinatura(); };
  /**
   * Toca a campainha e dá o que mudou por conferido.
   *
   * Sem o "por conferido" a mudança seria anunciada duas vezes: uma aqui, na
   * hora, e outra quando `verificarEfeitos` terminasse em `repintar()` e a
   * conferência ainda a visse como novidade. O outro lado pagaria duas
   * releituras por peça movida.
   */
  const avisarAgora = (...a: Assunto[]) => { RT?.avisar(...a); marcarEstado(); };
  function avisarMudancas() {
    const a = assinatura();
    const mudou: Assunto[] = [];
    if (a.combs !== ASSIN.combs) mudou.push('combatentes');
    if (a.tokens !== ASSIN.tokens) mudou.push('tokens');
    if (a.efeitos !== ASSIN.efeitos) mudou.push('efeitos');
    ASSIN = a;
    if (mudou.length) RT?.avisar(...mudou);
  }

  /**
   * O que reler quando a campainha toca.
   *
   * Cirúrgico de propósito. `carregar()` inteiro custa a lista de combatentes,
   * as fichas dos personagens, as URLs assinadas dos retratos e o redesenho do
   * SVG do tabuleiro; fazer isso a cada peça movida seria trocar o poll de oito
   * segundos por um poll a cada movimento, que é pior. Só a troca de arena e a
   * troca de encontro mudam o chão o bastante para valer a recarga completa.
   */
  async function aplicarAvisos(assuntos: Set<Assunto>, motivo: Motivo) {
    if (!ARENA || motivo !== 'aviso' || assuntos.has('arena') || assuntos.has('encontro')) {
      await carregar();
      return;
    }
    let redesenhar = false;
    if (assuntos.has('combatentes')) { await carregarCombatentes(); redesenhar = true; }
    if (assuntos.has('tokens')) {
      const antes = TOKENS;
      await carregarTokens();
      // Deslizar em vez de repintar: é a diferença entre a peça andar e a peça
      // piscar de um lado para o outro. Só vale quando nada mais mudou, porque
      // uma repintura já joga fora o nó com a transição.
      if (redesenhar || !deslizarTokens(antes)) redesenhar = true;
      else { pintarLista(); pintarIniciativa(); pintarAlcance(); }
    }
    if (redesenhar) { pintarTokens(); pintarLista(); pintarIniciativa(); pintarAlcance(); }
    if (assuntos.has('efeitos')) {
      await carregarEfeitos(ctxArtes());
      pintarEfeitos(ctxArtes(), el('gr-efeitos') as unknown as SVGElement);
      pintarPainelEfeitos(ctxArtes(), el('gr-ef-lista'));
    }
    if (assuntos.has('registro')) { await carregarLog(true); pintarLog(); }
    // O que veio de fora não é mudança minha: guardar o estado agora evita que a
    // próxima conferência o devolva ao remetente.
    marcarEstado();
  }

  /**
   * Move as peças que andaram sem redesenhar o tabuleiro.
   *
   * `pintarTokens` troca o innerHTML da camada inteira, e transição de CSS não
   * roda em elemento recém-nascido: ele nasce no valor final. Mexendo só no
   * `left`/`top` do nó que já está na página, o mesmo elemento continua vivo e
   * a transição faz o resto. É o mesmo motivo pelo qual o anel de Vida tem o
   * `atualizarAnel`.
   *
   * Desiste (e deixa o desenho completo assumir) sempre que o arranjo mudou de
   * verdade: alguém entrou, alguém saiu, ou a casa é dividida — nesse caso as
   * duas peças da casa se deslocam em ângulo, e isso é conta do desenho.
   */
  function deslizarTokens(antes: Record<string, any>): boolean {
    const a = Object.keys(antes), b = Object.keys(TOKENS);
    if (a.length !== b.length || b.some((i) => !(i in antes))) return false;
    const mudaram = b.filter((i) => antes[i].q !== TOKENS[i].q || antes[i].r !== TOKENS[i].r);
    if (!mudaram.length) return true;
    const quantos = (mapa: Record<string, any>, q: number, r: number) =>
      Object.values(mapa).filter((t: any) => t.q === q && t.r === r).length;
    for (const i of mudaram) {
      if (quantos(antes, antes[i].q, antes[i].r) > 1) return false;
      if (quantos(TOKENS, TOKENS[i].q, TOKENS[i].r) > 1) return false;
    }
    const mg = margem();
    for (const i of mudaram) {
      const no = document.querySelector<HTMLElement>(`.gr-token[data-c="${CSS.escape(i)}"]`);
      if (!no) return false;
      const p = centroHex(TOKENS[i].q, TOKENS[i].r, RAIO);
      no.classList.add('andando');
      no.style.left = `${(p.x + mg.x).toFixed(1)}px`;
      no.style.top = `${(p.y + mg.y).toFixed(1)}px`;
    }
    // A peça deslizou sem repintura, mas o campo de visão dela andou junto.
    pintarNevoa();
    return true;
  }

  /** O contador de quem está vendo, e o sinal de que o canal está de pé. */
  function pintarPresenca() {
    const caixa = el('gr-vivo');
    const num = el('gr-vivo-n');
    if (!RT) { caixa.hidden = true; return; }
    caixa.hidden = false;
    const ligado = RT.ligado();
    const gente = RT.presentes();
    caixa.classList.toggle('off', !ligado);
    num.textContent = ligado ? String(Math.max(1, gente.length)) : '—';
    caixa.title = ligado
      ? `Ao vivo · ${gente.length ? gente.map((g) =>
          `${g.nome} (${g.papel === 'mestre' ? 'mestre' : 'jogador'}${g.aba ? ' · ' + g.aba : ''})`).join(', ')
        : 'só você'}\nDois cliques no mapa apontam uma casa para todo mundo.`
      : 'Sem tempo real agora. O ↻ ao lado busca as posições na mão.';
  }

  /**
   * O ping: dois cliques numa casa e ela pisca na tela de todo mundo.
   *
   * É a coisa que a mesa faz o tempo todo em volta de um tabuleiro de verdade,
   * apontando com o dedo, e que some quando o tabuleiro é uma tela. Vale para
   * o jogador também, de propósito: "cuidado com aquele canto" é fala dele.
   */
  function ligarPing() {
    el('gr-palco').addEventListener('dblclick', (ev) => {
      if (AJUSTANDO || MIRA) return;
      const h = hexNaTela(ev.clientX, ev.clientY);
      if (!h) return;
      ev.preventDefault();
      const casa = nomeHex(h.q, h.r);
      // O eco local é imediato e não depende do servidor: quem apontou tem de
      // ver que apontou, mesmo com a rede ruim.
      mostrarPing({ q: h.q, r: h.r, casa, nome: EU_NOME, papel: EU_PAPEL });
      RT?.pingar({ q: h.q, r: h.r, casa });
    });
  }

  /** Dois anéis abrindo em cima da casa, e o nome de quem apontou. */
  function mostrarPing(p: Ping) {
    const g = document.getElementById('gr-pings');
    if (!g || !ARENA || !dentro({ q: p.q, r: p.r }, ARENA.cols, ARENA.rows)) return;
    const mg = margem();
    const c = centroHex(p.q, p.r, RAIO);
    const x = (c.x + mg.x).toFixed(1);
    const y = (c.y + mg.y).toFixed(1);
    const no = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    no.setAttribute('class', 'gr-ping' + (p.papel === 'mestre' ? ' de-mestre' : ''));
    no.innerHTML = `<circle class="pg-o" cx="${x}" cy="${y}" r="${RAIO}" />
      <circle class="pg-o pg-2" cx="${x}" cy="${y}" r="${RAIO}" />
      <circle class="pg-c" cx="${x}" cy="${y}" r="5" />
      <text class="pg-n" x="${x}" y="${(+y + RAIO + 14).toFixed(1)}">${esc(p.nome)}</text>`;
    g.appendChild(no);
    setTimeout(() => no.remove(), 2600);
  }

  // ============================================================== ataque
  let MIRA: { atacante: string } | null = null;

  /** O centro de uma peça em pixels do mundo: é onde o golpe acontece. */
  function pontoDaPeca(cid: string): { x: number; y: number } | null {
    const t = TOKENS[cid];
    if (!t) return null;
    const mg = margem();
    const c = centroHex(t.q, t.r, RAIO);
    return { x: c.x + mg.x, y: c.y + mg.y };
  }

  /**
   * A marca do golpe no alvo, na direção de quem bateu.
   *
   * A direção não é enfeite: é ela que gira o crescente do corte e aponta a
   * lança da perfuração. Um corte que varre sempre para o mesmo lado, com o
   * inimigo vindo de outro, lê como decalque.
   */
  function marcarGolpe(atacante: any, alvo: any, tipo: string, espera?: number) {
    const a = pontoDaPeca(atacante?.id), p = pontoDaPeca(alvo?.id);
    if (!p) return;
    const dir = a ? Math.atan2(p.y - a.y, p.x - a.x) : 0;
    baterNoAlvo(camadaDeGolpes(), p, tipo, dir, RAIO, espera);
  }

  function iniciarMira(cid: string) {
    if (!TOKENS[cid]) return uiErro('Ponha o atacante no mapa antes de mirar.');
    MIRA = { atacante: cid };
    el('gr-palco').classList.add('mirando');
    document.querySelector(`.gr-token[data-c="${CSS.escape(cid)}"]`)?.classList.add('atacante');
    const av = document.createElement('div');
    av.className = 'mira-aviso'; av.id = 'mira-aviso';
    av.textContent = 'Escolha o alvo · Esc cancela';
    el('gr-palco').appendChild(av);
  }

  function cancelarMira() {
    if (!MIRA) return;
    MIRA = null;
    el('gr-palco').classList.remove('mirando');
    document.getElementById('mira-aviso')?.remove();
    document.querySelectorAll('.gr-token.atacante, .gr-token.alvo-mira')
      .forEach((t) => t.classList.remove('atacante', 'alvo-mira'));
    limparSeta();
  }

  /**
   * O ponto da borda da peça que fica de frente para quem atira.
   *
   * A peça é um hexágono de ponta para cima, e não um círculo: a distância do
   * centro até a borda muda com a direção. Do centro até uma FACE é sempre
   * metade da largura (o apótema), e as seis faces têm as normais de 60 em 60
   * graus, então o raio naquela direção é o apótema dividido pelo cosseno do
   * desvio até a normal mais próxima. Nos vértices isso dá os 2/√3 do apótema,
   * que é o raio maior do hexágono, como tem de ser.
   *
   * O recuo nunca passa de quase toda a distância: com um Colossal encostado num
   * Miúdo, a borda do grandão fica atrás de quem atira, e a seta viraria do
   * avesso.
   */
  function naBordaDaPeca(alvo: { x: number; y: number }, deOnde: { x: number; y: number },
                         larguraPx: number) {
    const dx = alvo.x - deOnde.x, dy = alvo.y - deOnde.y;
    const dist = Math.hypot(dx, dy);
    if (!dist) return alvo;
    const apotema = larguraPx / 2;
    const ang = Math.atan2(-dy, -dx);              // do alvo de volta para a origem
    const passo = Math.PI / 3;
    const desvio = ang - Math.round(ang / passo) * passo;
    const raio = Math.min(apotema / Math.cos(desvio), larguraPx / Math.sqrt(3));
    // Dois pixels de folga: a ponta encosta na borda em vez de morder o retrato.
    const recuo = Math.max(0, Math.min(raio + 2, dist * 0.9));
    return { x: alvo.x - (dx / dist) * recuo, y: alvo.y - (dy / dist) * recuo };
  }

  /** A mira desenha a mesma seta do movimento, em vermelho e até o cursor. */
  function moverMira(cx: number, cy: number) {
    if (!MIRA) return;
    const sob = document.elementFromPoint(cx, cy)?.closest<HTMLElement>('.gr-token');
    document.querySelectorAll('.gr-token.alvo-mira').forEach((t) => t.classList.remove('alvo-mira'));
    if (sob && sob.dataset.c !== MIRA.atacante) sob.classList.add('alvo-mira');
    const de = TOKENS[MIRA.atacante];
    const g = document.getElementById('gr-seta');
    if (!de || !g) return;
    const mg = margem();
    const a = centroHex(de.q, de.r, RAIO);
    const mundo = el('gr-mundo').getBoundingClientRect();
    const bx = (cx - mundo.left) / ZOOM, by = (cy - mundo.top) / ZOOM;
    // A distância sai do hexágono sob o cursor, e não do pixel: é a medida que
    // a regra usa, e é a que o mestre vai declarar em voz alta.
    const h = hexEmPonto(bx - mg.x, by - mg.y, RAIO);
    const metros = distanciaHex(de, h) * (Number(ARENA.escala_m) || 1);
    // A ponta acompanha o cursor, mas quando ele está sobre um alvo ela pousa na
    // BORDA da peça, do lado de quem atira.
    //
    // Mirava no centro, e no centro a seta some: o retrato do alvo é opaco e
    // fica por cima da camada das setas, então a ponta (justamente a parte
    // grossa, a que diz para onde o golpe vai) ficava enterrada debaixo da peça.
    // Encostando na borda, a seta aparece inteira e continua apontando para
    // dentro do alvo, que é o que ela precisa dizer. O alvo escolhido não fica
    // por isso menos escolhido: quem marca isso é o halo em volta dele.
    let fim = { x: bx, y: by };
    if (sob) {
      const t = TOKENS[sob.dataset.c!];
      const alvo = COMBS.find((z: any) => z.id === sob.dataset.c);
      if (t) {
        const p = centroHex(t.q, t.r, RAIO);
        fim = naBordaDaPeca({ x: p.x + mg.x, y: p.y + mg.y },
          { x: a.x + mg.x, y: a.y + mg.y }, alvo ? diametroPx(alvo) : RAIO);
      }
    }
    const d = caminhoSeta({ x: a.x + mg.x, y: a.y + mg.y }, fim, estiloSeta('setaAtq'));
    g.innerHTML = `<path class="seta-fig seta-atq" d="${d}" />
      <text class="seta-txt" x="${((a.x + mg.x + fim.x) / 2).toFixed(1)}"
        y="${((a.y + mg.y + fim.y) / 2 - 8).toFixed(1)}">${fmtM(metros)}</text>`;
  }

  async function escolherAlvo(cid: string) {
    if (!MIRA || cid === MIRA.atacante) return;
    const atacante = COMBS.find((c: any) => c.id === MIRA!.atacante);
    const alvo = COMBS.find((c: any) => c.id === cid);
    cancelarMira();
    if (atacante && alvo) await resolverAtaque(atacante, alvo);
  }

  /**
   * Um ataque, do começo ao fim.
   *
   * Separado da mira porque agora há dois caminhos até aqui: o menu da peça
   * (botão direito, ⚔, clique no alvo) e o ARRASTO de uma peça em cima de
   * outra, que antes não fazia nada, porque a casa ocupada recusava o
   * movimento. Um gesto que não significava coisa alguma passou a significar a
   * única coisa que se faz com quem está no caminho.
   */
  async function resolverAtaque(atacante: any, alvo: any) {
    const res = await folhaDaAcao(atacante, alvo);
    if (!res) return;                       // fechou a caixa: desistiu, não gastou nada
    const { acertou, an, manobra } = res;
    // O motivo do ajuste avulso vai junto de tudo o que este ataque escrever no
    // registro: uma semana depois, "+2" sozinho não conta história nenhuma.
    const porque = res.ajuste && res.motivo ? ` [${sinalTxt(res.ajuste)}: ${res.motivo}]`
      : res.ajuste ? ` [${sinalTxt(res.ajuste)}]` : '';
    const dados = res.rolado ? ` (${res.rolado})` : '';

    // O TIRO SAI QUANDO A MESA JÁ DECIDIU, E NUNCA ANTES.
    //
    // Enquanto há caixa aberta na tela, o que aconteceu ainda está sendo
    // combinado: o mestre está lendo a Defesa, conferindo a rolagem, às vezes
    // voltando atrás. Uma flecha cruzando o tabuleiro no meio disso conta o fim
    // da história antes de a história ter fim, e some antes de alguém olhar,
    // porque ninguém está olhando o tabuleiro: estão olhando a caixa.
    //
    // Então o voo espera o ÚLTIMO clique de cada caminho:
    //   errou   → sai ao fechar a caixa de acerto, e a flecha PASSA pelo alvo;
    //   acertou → sai no "Aplicar", junto com a marca do golpe e o dano.
    //
    // No acerto os dois viram uma coisa só: a flecha chega, e o impacto abre onde
    // ela chegou. É o mesmo par de tempos do golpe perfurante, agora esticado
    // pelo tabuleiro inteiro.
    const proj = projetilDe(
      atacante, FICHAS[atacante.personagem_id], MON[atacante.monstro_id], armaDoSlot,
    );
    const de = pontoDaPeca(atacante.id), pa = pontoDaPeca(alvo.id);
    // Devolve se ALGUMA COISA voou, e não só se terminou: quem esperou uma
    // flecha atravessar o tabuleiro já cumpriu a pausa, e a marca do golpe tem de
    // abrir no instante em que a ponta encosta, e não meio segundo depois.
    const atirar = async (): Promise<boolean> => {
      if (!(proj && de && pa)) return false;
      await voarProjetil(camadaDeGolpes(), de, pa, {
        tipo: proj, errou: !acertou, raioPx: RAIO,
        pxPorM: larguraHex(RAIO) / (Number(ARENA?.escala_m) || 1),
      });
      return true;
    };

    // O GESTO SAI DO MESMO JEITO, ACERTANDO OU NÃO.
    //
    // Errar não devolve o Tick nem fecha a guarda de quem apanhou: a Guarda sob
    // pressão conta o ATAQUE, e não o acerto, e o braço que passou perto gastou
    // o mesmo tempo do braço que pegou. Por isso a declaração acontece aqui, no
    // meio dos dois caminhos, e não dentro de um deles.
    await declararNoTabuleiro(atacante, alvo, an, manobra);

    if (!acertou) {
      await atirar();
      await logar(atacante, `${atacante.nome} atacou ${alvo.nome} e errou${dados}${porque}`, { acao: null });
      return;
    }
    // A caixa já fechou, o projétil voa, e só então a Vida muda: o tabuleiro
    // está livre para ser olhado, e o número no anel do alvo cai no instante em
    // que a ponta encosta, e não meio segundo antes dela sair.
    const voou = await atirar();
    await aplicarDano(atacante, alvo, res.dano, res.tipo, voou ? 0 : undefined, dados + porque);
  }

  /**
   * O ataque do tabuleiro entra na linha do tempo.
   *
   * É o que faltava para o Grid PARTICIPAR do P/G/R em vez de só desenhá-lo:
   * a agenda de golpes nasce, o relógio do atacante anda até o fim do ciclo, e
   * o alvo leva a Guarda sob pressão. É o mesmo trio que `avancarTick` faz na
   * aba Combate, e de propósito: as duas telas escrevem a mesma coisa, senão a
   * fita conta uma história diferente conforme onde a luta foi resolvida.
   *
   * Quem escreve depende de quem está jogando. O mestre vai direto na tabela; o
   * jogador passa por `jogador_declara` (migração 28), que confere que a peça é
   * dele antes de deixar o relógio andar. Banco sem a 28: o ataque continua
   * valendo, o dano continua chegando, e o que não acontece é o relógio andar
   * sozinho — exatamente o que acontecia antes desta mudança.
   */
  async function declararNoTabuleiro(atacante: any, alvo: any, an: any, manobra: string) {
    const t0 = atacante.tick ?? 0;
    const acao = declarar(t0, an, {
      tipo: (an.golpes > 1 ? manobra : 'simples') as Manobra,
      arma: RESUMO[atacante.id]?.arma || null,
      alvo: alvo?.id || null,
    });
    const novoTick = acao.livre;
    if (MESTRE) {
      const { error } = await SB.from('combatentes')
        .update({ tick: novoTick, acao }).eq('id', atacante.id);
      if (error) return avisarSemTempo(error);
      // A Pressão no alvo: soma na chave e preserva o resto, porque o alvo pode
      // estar no meio do próprio golpe e a agenda dele não é da conta de quem ataca.
      const antes = alvo.acao && Object.keys(alvo.acao).length
        ? alvo.acao : { golpes: [], livre: alvo.tick ?? 0 };
      const nova = { ...antes, pressao: (antes.pressao || 0) + an.golpes };
      await SB.from('combatentes').update({ acao: nova }).eq('id', alvo.id);
      alvo.acao = nova;
    } else {
      const { error } = await SB.rpc('jogador_declara', {
        p_comb: atacante.id, p_tick: novoTick, p_acao: acao,
        p_alvo: alvo?.id || null, p_golpes: an.golpes,
      });
      if (error) return avisarSemTempo(error);
    }
    atacante.tick = novoTick; atacante.acao = acao;
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
  }

  /** Banco velho: diz o que falta, uma vez, sem travar o ataque. */
  let JA_AVISOU_TEMPO = false;
  function avisarSemTempo(error: any) {
    if (JA_AVISOU_TEMPO) return;
    JA_AVISOU_TEMPO = true;
    uiErro(/jogador_declara|function|acao/i.test(error.message || '')
      ? 'O ataque não conseguiu empurrar o relógio: falta a migração 28 (supabase/migracao-28.sql).'
      + ' O dano continua funcionando; o Tick você empurra no ⏭.'
      : 'Erro ao declarar a ação: ' + error.message);
  }

  /**
   * A FOLHA DA AÇÃO: uma caixa só, do acerto ao dano.
   *
   * Eram duas em sequência. A primeira mostrava as Defesas e perguntava
   * "acertou?"; a segunda abria com ZERO no campo e Impacto no modo, sem saber
   * quem tinha batido nem com o quê. Entre as duas, o mestre transcrevia dois
   * números que estavam escritos na tela um centímetro acima.
   *
   * Agora tudo o que o Grid já sabe vem preenchido:
   *
   *   · a Defesa do alvo COM A ESCADA do P/G/R (§14.11), somada ao ferimento e
   *     às condições, e com a conta escrita embaixo;
   *   · o bolo de dados de quem ataca, já descontado o ferimento e as condições
   *     DELE, mais a penalidade da manobra;
   *   · o modo do dano, lido da arma (`1d6 +2 (C)` abre em Cortante);
   *   · o custo em Ticks pela régua P/G/R;
   *   · a Absorção do alvo, descontada ao vivo.
   *
   * E tudo continua editável, que é o contrato: o Grid propõe, a mesa decide.
   * Quem rola os dados é escolha da mesa (`combate.rolagem`), e o modo decide
   * só o que acontece SOZINHO: o ⚄ continua ali para o caso avulso, mesmo na
   * mesa que rola tudo na mão.
   *
   * Devolve `null` quando a caixa é fechada no Escape: desistir não gasta o
   * Tick de ninguém, e quem chamou distingue isso de "errou".
   */
  interface Folha {
    acertou: boolean; an: any; manobra: string;
    dano: number; tipo: string; ajuste: number; motivo: string; rolado: string;
  }
  function folhaDaAcao(atacante: any, alvo: any): Promise<Folha | null> {
    const dlg = el('alvo-dlg') as HTMLDialogElement;
    const r = RESUMO[alvo.id];
    const ra = RESUMO[atacante.id];
    const cd = somarCondicoes((alvo.condicoes || []).map((k: any) => ({ ...(COND[k.id] || {}), ...k })));
    const fer = tierDe(alvo.pv_atual, alvo.pv_max).penDefesa ?? 0;
    const dv = defesaPerdida(acaoNo(alvo), relogio(), { segura: alvo.acao?.tipo === 'segura' });
    const def = r?.defesa != null ? r.defesa + fer + (cd.defesaCaC || 0) + dv.total : null;
    const men = r?.defesaMental ?? null;
    const de = TOKENS[atacante.id], pa = TOKENS[alvo.id];
    const hexes = de && pa ? distanciaHex(de, pa) : null;
    const dist = hexes != null ? hexes * (Number(ARENA.escala_m) || 1) : null;
    (el('al-titulo') as HTMLElement).textContent = `${atacante.nome} ataca ${alvo.nome}`;
    (el('al-linha') as HTMLElement).textContent = dist != null
      ? `Distância: ${fmtM(dist)}${pa ? ` · alvo em ${nomeHex(pa.q, pa.r)}` : ''}` : '';
    const cel = (l: string, v: any, n = '') => `<div class="d"><span class="d-l">${l}</span>
      <span class="d-v">${v ?? '—'}</span>${n ? `<span class="d-n">${n}</span>` : ''}</div>`;
    // SEM O NÚMERO, OS MODIFICADORES CALAM.
    //
    // Do lado do jogador o bloco do inimigo não é montado (é o que impede a
    // Absorção do ogro de viajar até o navegador do grupo), então a Defesa sai
    // como travessão. Os descontos continuavam escritos embaixo, e "— condições
    // −4" não é leitura de coisa nenhuma: é um desconto sem conta de onde sair.
    el('al-defesas').innerHTML =
      cel('Defesa', def, def == null ? 'o mestre tem o número' : [
        fer ? `ferimento ${fer}` : '',
        cd.defesaCaC ? `condições ${cd.defesaCaC}` : '',
        dv.acao ? `${FASE_ROTULO[dv.fase]} ${dv.acao}` : '',
        dv.pressao ? `pressão ${dv.pressao}` : '',
      ].filter(Boolean).join(' · '))
      + cel('Mental', men)
      + cel('Absorção', r ? `${r.soak.impacto}/${r.soak.corte}/${r.soak.perfuracao}` : null,
        r?.resistPerf ? `gate N${r.resistPerf}` : '');

    // ---- a manobra de quem ataca, e o tempo que ela custa ----
    const classe = classeDeTempo(ra?.arma, ra?.velocidade);
    const vel = ra?.velocidade ?? velocidadeDaArma(ra?.arma, 5);
    const manSel = el('al-manobra') as HTMLSelectElement;
    const golInp = el('al-golpes') as HTMLInputElement;
    const cj = (FICHAS[atacante.personagem_id]?.conjuntos || []).find((x: any) => x.ativo);
    const inabil = cj ? armaDoSlot(cj.inabil) : null;
    const duasMaos = cj ? armaDoSlot(cj.habil)?.maos === 2 : false;
    const podeDupla = !cj || (!!inabil && !duasMaos);
    const podeRajada = tetoDaRajada(classe) > 1;
    for (const o of Array.from(manSel.options)) {
      const cabe = o.value === 'simples' || (o.value === 'rajada' ? podeRajada : podeDupla);
      o.hidden = !cabe; o.disabled = !cabe;
    }
    manSel.value = 'simples'; golInp.value = '2';
    golInp.max = String(Math.max(2, tetoDaRajada(classe)));
    const anat = () => anatomia({
      classe, velocidade: vel, sistema: TEMPO.sistema, manobra: manSel.value as Manobra,
      golpes: Math.max(2, parseInt(golInp.value || '2', 10) || 2),
    });

    // ---- O ALCANCE: a única coisa que só o tabuleiro sabe ----
    //
    // Ninguém mais na mesa sabe quantos metros separam duas peças, e até agora
    // esse número não entrava em nada. Ele AVISA e não impede: a caixa não
    // recusa ataque nenhum, porque a última palavra é de quem está mestrando.
    const arma = armaDoCatalogo(ra?.arma);
    const avisoAlcance = (() => {
      if (hexes == null) return '';
      if (classe === 'distancia' || classe === 'arremesso') {
        const max = arma?.distMax;
        return max && dist! > max ? `Além do alcance da arma (${max} m).` : '';
      }
      const teto = classe === 'haste' ? 2 : 1;
      return hexes > teto
        ? `Corpo a corpo a ${fmtM(dist!)}: ${classe === 'haste' ? 'a haste alcança 2' : 'a arma alcança 1'} hexágono.`
        : '';
    })();
    const cxAviso = el('al-aviso') as HTMLElement;
    cxAviso.hidden = !avisoAlcance;
    cxAviso.textContent = avisoAlcance;

    // ---- o acerto, o ajuste e o dano ----
    const totalInp = el('al-total') as HTMLInputElement;
    const modInp = el('al-mod') as HTMLInputElement;
    const motivoInp = el('al-motivo') as HTMLInputElement;
    const dnInp = el('al-dn') as HTMLInputElement;
    const dnTipo = el('al-dn-tipo') as HTMLSelectElement;
    totalInp.value = ''; modInp.value = ''; motivoInp.value = ''; dnInp.value = '';
    // O modo do dano vem da arma. Perguntar o que está escrito na linha de cima
    // era o atrito mais barato de tirar da frente, e o mais fácil de errar: a
    // caixa abria em Impacto e o mestre aplicava couro contra espada.
    dnTipo.value = tipoDeDano(ra?.dano || '') || 'impacto';
    // O bolo de quem ataca, já com o que a situação cobra DELE.
    const ajAtq = (() => {
      const f = tierDe(atacante.pv_atual, atacante.pv_max).penAcao ?? 0;
      const c2 = somarCondicoes((atacante.condicoes || []).map((k: any) => ({ ...(COND[k.id] || {}), ...k })));
      return { flat: f + (c2.acao || 0) + (c2.ataque || 0), dados: c2.dados || 0 };
    })();
    let rolado = '';
    const pintarPool = () => {
      const pen = anat().penDados[0] || 0;
      const partes = [esc(ra?.ataque || '—')];
      if (ajAtq.flat) partes.push(sinalTxt(ajAtq.flat));
      if (ajAtq.dados + pen) partes.push(`${sinalTxt(ajAtq.dados + pen)}d6`);
      (el('al-pool') as HTMLElement).innerHTML = partes.join(' ');
      (el('al-dn-pool') as HTMLElement).innerHTML = esc(ra?.dano || '—');
    };
    const pintarVeredito = () => {
      const t = parseInt(totalInp.value || '', 10);
      const m = parseInt(modInp.value || '0', 10) || 0;
      const cx = el('al-vered') as HTMLElement;
      const sim = el('al-sim') as HTMLElement, nao = el('al-nao') as HTMLElement;
      if (!Number.isFinite(t) || def == null) {
        cx.innerHTML = '';
        sim.classList.add('primary'); nao.classList.remove('primary');
        return;
      }
      const soma = t + m;
      // A regra é `total > Defesa`, e não `>=`: empate não passa.
      const ok = soma > def;
      cx.innerHTML = ok
        ? `<span class="ok">acerta (${soma} &gt; ${def})</span>`
        : `<span class="ruim">erra por ${def - soma + 1}</span>`;
      // O botão que a conta indica vira o principal: com a rolagem no site, o
      // caminho comum passa a ser um clique só, e ele já está debaixo do dedo.
      sim.classList.toggle('primary', ok);
      nao.classList.toggle('primary', !ok);
    };
    const pintarDano = () => {
      const bruto = Math.max(0, parseInt(dnInp.value || '0', 10) || 0);
      const cx = el('al-dn-conta') as HTMLElement;
      if (!bruto) { cx.innerHTML = ''; return; }
      // A Absorção do alvo é informação do mestre: ela sai do bloco do bestiário
      // ou da ficha, e o jogador não lê nem um nem outro. Então na tela dele o
      // dano vai inteiro e a caixa diz isso, em vez de descontar zero calado e
      // deixá-lo achar que o couro do ogro não valeu nada.
      if (!MESTRE) {
        cx.innerHTML = `Vai <b>${bruto}</b> inteiro · a Absorção do alvo quem desconta é o mestre`;
        return;
      }
      const sk = soakDe(alvo, dnTipo.value);
      const liq = Math.max(0, bruto - sk);
      const pv = Math.max(0, (alvo.pv_atual ?? 0) - liq);
      cx.innerHTML = `Absorção <b>${sk}</b> · passa <b>${liq}</b>`
        + (alvo.pv_max ? ` · Vida ficaria <b>${pv}/${alvo.pv_max}</b> (${tierDe(pv, alvo.pv_max).estado})` : '');
    };
    const pintarTempo = () => {
      el('al-golpes').style.display = manSel.value === 'rajada' ? '' : 'none';
      const a = anat();
      const t0 = atacante.tick ?? 0;
      const linha = TEMPO.sistema === 'pgr'
        ? `<b>Preparo ${a.preparo}</b> · <b>Golpe ${a.golpes}</b> · <b>Recuperação ${a.recuperacao}</b>`
        : `Resolve agora · <b>${a.ciclo} Ticks</b>`;
      const dados = a.penDados.map((x, i) => `${i + 1}º ${x ? `${x}d6` : 'cheio'}`).join(' · ');
      (el('al-tempo') as HTMLElement).innerHTML =
        `<div>${linha} = <b>${a.ciclo}</b> Ticks</div>
         <div class="muted">golpe${a.golpes > 1 ? 's' : ''} no Tick ${a.offs.map((o) => t0 + o).join(', ')}
           · livre no ${t0 + a.ciclo} · dados: ${esc(dados)}</div>
         ${a.aviso ? `<div class="ruim">${esc(a.aviso)}</div>` : ''}`;
      pintarPool();
    };
    // UM GOLPE, UMA ROLAGEM: a rajada e a empunhadura dupla têm penalidade
    // própria por golpe, e somá-las numa jogada só seria mentir na primeira e na
    // última ao mesmo tempo. O campo fica com o PRIMEIRO golpe, que é o que
    // decide se o ataque pegou; os outros aparecem escritos ao lado.
    const rolarAcerto = () => {
      const pen = anat().penDados;
      const linhas = pen.map((pn) => rolarExpr(ra?.ataque || '0d6', ajAtq.dados + pn, ajAtq.flat));
      totalInp.value = String(linhas[0].total);
      rolado = linhas.map(descreverRolada).join(' · ');
      (el('al-pool') as HTMLElement).textContent = rolado;
      pintarVeredito();
    };
    const rolarDano = () => {
      const d = rolarExpr(ra?.dano || '0d6');
      dnInp.value = String(d.total);
      (el('al-dn-pool') as HTMLElement).textContent = descreverRolada(d);
      pintarDano();
    };
    manSel.onchange = pintarTempo; golInp.oninput = pintarTempo;
    totalInp.oninput = pintarVeredito; modInp.oninput = pintarVeredito;
    dnInp.oninput = pintarDano; dnTipo.onchange = pintarDano;
    (el('al-rolar') as HTMLElement).onclick = rolarAcerto;
    (el('al-dn-rolar') as HTMLElement).onclick = rolarDano;
    pintarTempo(); pintarVeredito(); pintarDano();
    // O MODO DA MESA DECIDE O QUE ACONTECE SOZINHO. No `mesa` (o padrão) nada
    // rola: os campos abrem vazios e quem joga escreve o que caiu na mão.
    if (rolaNoSite(TEMPO.rolagem, atacante.tipo === 'pc')) { rolarAcerto(); rolarDano(); }

    return new Promise((resolve) => {
      let respondeu = false;
      const fim = (v: boolean) => {
        respondeu = true; dlg.close();
        const a = anat();
        resolve({
          acertou: v, an: a, manobra: a.golpes > 1 ? manSel.value : 'simples',
          dano: Math.max(0, parseInt(dnInp.value || '0', 10) || 0),
          tipo: dnTipo.value,
          ajuste: parseInt(modInp.value || '0', 10) || 0,
          motivo: motivoInp.value.trim(),
          rolado,
        });
      };
      (el('al-sim') as HTMLElement).onclick = () => fim(true);
      (el('al-nao') as HTMLElement).onclick = () => fim(false);
      // Fechar no Escape é DESISTIR, e não "errou": desistir não gasta o Tick de
      // ninguém. Por isso o null, que quem chamou distingue do erro.
      dlg.addEventListener('close', () => { if (!respondeu) resolve(null); }, { once: true });
      dlg.showModal();
    });
  }

  /** `+2` ou `−1`, com o menos do projeto. */
  const sinalTxt = (n: number) => (n > 0 ? `+${n}` : `−${Math.abs(n)}`);

  const CAT_SOAK: Record<string, string> = { impacto: 'impacto', corte: 'corte', perfurante: 'perfuracao' };
  const TIPO_LBL: Record<string, string> = { impacto: 'Impacto', corte: 'Corte', perfurante: 'Perfuração' };
  function soakDe(c: any, tipo: string) {
    const r = RESUMO[c.id];
    const cd = somarCondicoes((c.condicoes || []).map((k: any) => ({ ...(COND[k.id] || {}), ...k })));
    return (r?.soak?.[CAT_SOAK[tipo]] ?? 0) + (cd.soak || 0);
  }

  /**
   * Tira Vida, do jeito de quem está pedindo.
   *
   * O mestre manda o valor FINAL, porque ele sabe quanto o alvo tem. O jogador
   * manda QUANTO TIRAR, porque ele não sabe: a view esconde a Vida do inimigo
   * (ele lê "Ferido", e não "14/20"), e do lado dele `pv_atual` chega nulo.
   * Mandando o valor pronto, o primeiro golpe zerava o goblin.
   *
   * Devolve o que o registro precisa: a frase do estado (vazia para quem não
   * pode saber) e o inverso, que é o que o desfazer do mestre lê depois.
   */
  async function baixarVida(c: any, quanto: number):
      Promise<{ erro?: string; inverso: any; estado: string }> {
    if (MESTRE) {
      const antes = c.pv_atual ?? 0;
      const pv = Math.max(0, antes - quanto);
      const { error } = await gravarPeca(c.id, { pv_atual: pv });
      if (error) return { erro: error.message, inverso: null, estado: '' };
      c.pv_atual = pv;
      return {
        inverso: { acao: 'vida', cid: c.id, de: antes, para: pv },
        estado: c.pv_max ? ` · ${pv}/${c.pv_max} (${tierDe(pv, c.pv_max).estado})` : '',
      };
    }
    const { error } = await SB.rpc('jogador_dano', { p_comb: c.id, p_quanto: quanto });
    if (error) return { erro: error.message, inverso: null, estado: '' };
    // Quando a Vida é conhecida (a peça é dele), acompanha aqui e já dá o número
    // por conferido, senão a peça ganharia dois: este e o da diferença.
    if (c.pv_atual != null) { c.pv_atual = Math.max(0, c.pv_atual - quanto); VIDA_VISTA[c.id] = c.pv_atual; }
    flutuar(c.id, `−${quanto}`, 'dano');
    return { inverso: { acao: 'vida-menos', cid: c.id, quanto }, estado: '' };
  }

  /**
   * Mesma conta do rastreador: bruto − absorção, e o resto sai da Vida.
   *
   * @param esperaMarca zero quando um projétil já voou até aqui; deixado de fora
   *   no golpe corpo a corpo, para a marca esperar o olhar chegar ao tabuleiro.
   */
  async function aplicarDano(
    atacante: any, alvo: any, bruto: number, tipo: string, esperaMarca?: number, nota = '',
  ) {
    // Pelo lado do jogador a Absorção não existe (ver `folhaDaAcao`): o dano vai
    // inteiro, o registro diz que foi inteiro, e o mestre corrige se for o caso.
    const s = MESTRE ? soakDe(alvo, tipo) : 0;
    const liquido = Math.max(0, bruto - s);
    const r = await baixarVida(alvo, liquido);
    if (r.erro) return uiErro('Erro ao aplicar o dano: ' + r.erro);
    // A marca sai antes do registro: o texto explica o que a imagem já mostrou.
    // Não é esperada (nem podia): ela tem a pausa dela, e segurar a Vida por meio
    // segundo travaria a caixa por um enfeite.
    marcarGolpe(atacante, alvo, tipo, esperaMarca);
    // A fila também: Vida a zero tira da ordem na hora, sem esperar a próxima
    // repintura vinda de outro lugar.
    atualizarAnel(alvo); pintarLista(); pintarIniciativa();
    avisarAgora('combatentes');
    await logar(alvo, `${atacante.nome} acertou ${alvo.nome}: ${liquido} de dano (${TIPO_LBL[tipo]})`
      + (s > 0 ? ` [${bruto} − ${s} abs]` : '') + (MESTRE ? '' : ' [sem Absorção]') + nota + r.estado,
      r.inverso);
  }

  async function curar(cid: string) {
    const c = COMBS.find((x: any) => x.id === cid); if (!c) return;
    const v = await uiFormulario(`Recuperar Vida · ${c.nome}`, [
      { nome: 'q', rotulo: 'Quanto', tipo: 'numero', valor: 5, min: 1 },
    ], { ok: 'Recuperar' });
    if (!v) return;
    const q = Math.max(1, parseInt(v.q, 10) || 0);
    const antesPv = c.pv_atual ?? 0;
    const pv = Math.min(c.pv_max ?? antesPv + q, antesPv + q);
    const { error } = await gravarPeca(cid, { pv_atual: pv });
    if (error) return uiErro('Erro: ' + error.message);
    c.pv_atual = pv;
    atualizarAnel(c); pintarLista();
    avisarAgora('combatentes');
    await logar(c, `${c.nome} recuperou ${q}${c.pv_max ? ` · ${pv}/${c.pv_max}` : ''}`,
      { acao: 'vida', cid, de: antesPv, para: pv });
    // Depois do registro, e não antes: quem estava no chão volta à fila aqui, e
    // a linha do atraso tem de vir DEPOIS da linha da cura para a história ficar
    // na ordem em que aconteceu.
    pintarIniciativa();
  }

  /**
   * Tirar Vida na mão, sem passar pela conta do combate.
   *
   * É o contrário do "Recuperar Vida", e de propósito NÃO é o "⚔ Ataque": o
   * ataque rola contra a Defesa, desconta a Absorção pelo tipo de dano e pede um
   * atacante. Aqui a Vida some direto, e é isso que a mesa precisa quando o dano
   * não veio de um golpe: a queda, o veneno que já passou pelo teste, o fogo da
   * cena, a decisão do mestre. Resistência e Absorção, se existirem, já foram
   * consideradas antes de digitar o número.
   */
  async function tirarVida(cid: string) {
    const c = COMBS.find((x: any) => x.id === cid); if (!c) return;
    const v = await uiFormulario(`Tirar Vida · ${c.nome}`, [
      { nome: 'q', rotulo: 'Quanto', tipo: 'numero', valor: 5, min: 1,
        dica: 'Direto na Vida: sem rolagem, sem Absorção e sem resistência.' },
      { nome: 'causa', rotulo: 'De quê (opcional)', tipo: 'texto', valor: '' },
    ], { ok: 'Tirar' });
    if (!v) return;
    const q = Math.max(1, parseInt(v.q, 10) || 0);
    const r = await baixarVida(c, q);
    if (r.erro) return uiErro('Erro: ' + r.erro);
    atualizarAnel(c); pintarLista();
    avisarAgora('combatentes');
    const causa = (v.causa || '').trim();
    await logar(c, `${c.nome} perdeu ${q} de Vida${causa ? ` (${causa})` : ''}` + r.estado, r.inverso);
    // Depois do registro: a Vida a zero tira da fila aqui, e a linha da queda tem
    // de vir depois da linha do dano.
    pintarIniciativa();
  }

  // ================================================================== Mana
  /** Esta peça lida com Mana? A reserva no banco manda; o perfil é o palpite. */
  const temMana = (c: any) => c.mana_max != null || (PERFIL[c.id]?.mana ?? 0) > 0;

  /**
   * A reserva de Mana na mão do mestre.
   *
   * O teto vem junto porque ele muda em cena: o perfil de invocação, a Arte
   * Manipulação de Mana e o item que empresta reserva mexem no máximo, e não só
   * no que sobrou. Deixar os dois no mesmo lugar evita a ida à aba Combate para
   * corrigir um número que a briga acabou de mudar.
   */
  async function ajustarMana(cid: string) {
    const c = COMBS.find((x: any) => x.id === cid); if (!c) return;
    const teto = c.mana_max ?? PERFIL[c.id]?.mana ?? 0;
    // O teto é do mestre: a reserva total sai da ficha e do que a mesa conceder,
    // e não de quem está gastando. O jogador só mexe no que sobrou.
    const v = await uiFormulario(`Mana · ${c.nome}`, [
      { nome: 'atual', rotulo: 'Mana agora', tipo: 'numero', valor: c.mana_atual ?? teto, min: 0 },
      ...(MESTRE ? [{ nome: 'max', rotulo: 'Reserva total', tipo: 'numero' as const, valor: teto, min: 0 }] : []),
    ], { ok: 'Salvar', msg: PERFIL[c.id]?.mana
      ? `A ficha dá ${PERFIL[c.id].mana} (Centelha ${PERFIL[c.id].centelha}, Vontade ${PERFIL[c.id].vontade}).`
      : undefined });
    if (!v) return;
    const max = MESTRE ? Math.max(0, parseInt(v.max, 10) || 0) : teto;
    const atual = Math.max(0, Math.min(max, parseInt(v.atual, 10) || 0));
    const antes = c.mana_atual ?? 0;
    const { error } = MESTRE
      ? await SB.from('combatentes').update({ mana_max: max, mana_atual: atual }).eq('id', cid)
      : await gravarPeca(cid, { mana_atual: atual });
    if (error) return uiErro('Erro: ' + error.message);
    c.mana_max = max; c.mana_atual = atual;
    atualizarMana(c); pintarLista();
    avisarAgora('combatentes');
    const dif = atual - antes;
    await logar(c, `${c.nome} · Mana ${atual}/${max}`
      + (dif ? ` (${dif > 0 ? '+' : ''}${dif})` : ''), { acao: null });
  }

  /**
   * Desconta Mana de quem acabou de conjurar.
   *
   * Fica aqui, e não dentro do assistente de Artes: o módulo calcula o custo e
   * não sabe o que é uma reserva. Vai a zero e para: a regra de ficar devendo
   * Mana é da mesa, e inventá-la em silêncio seria pior que travar.
   */
  /**
   * A conjuração entra na linha do tempo.
   *
   * A ANATOMIA DA ARTE É PRÓPRIA: ela resolve no ÚLTIMO Tick da montagem, e não
   * no primeiro. Então o ciclo inteiro é Preparo menos um, o Golpe é o último
   * Tick, e não há Recuperação — a mesma forma que a arma de distância tem, e
   * pelo mesmo motivo: o que custa é armar, não recompor.
   *
   * A Velocidade vem da caixa de conjuração (`plano.velocidadeTicks`), que a
   * mesa negocia, e não de uma régua nova. Zero é ação livre: não há gesto para
   * mostrar nem relógio para mexer.
   *
   * A guarda do "desistiu no meio" é a mesma da Mana, e pela mesma razão: o
   * assistente pode ser abandonado depois de escolher tudo, e o que separa uma
   * conjuração feita de uma abandonada é a linha no registro.
   */
  async function declararTempo(cid: string, ticks: number) {
    if (MARCO_LOG >= 0 && LOG.length <= MARCO_LOG) return;
    if (!(ticks > 0)) return;                     // ação livre: não gasta a vez
    const c = COMBS.find((x: any) => x.id === cid);
    if (!c) return;
    const t0 = c.tick ?? 0;
    const acao = declarar(t0, {
      preparo: ticks - 1, golpes: 1, recuperacao: 0, ciclo: ticks,
      offs: [ticks - 1], penDados: [0],
    }, { tipo: 'simples' as Manobra, arma: 'Arte', alvo: null });
    if (MESTRE) {
      const { error } = await SB.from('combatentes')
        .update({ tick: acao.livre, acao }).eq('id', cid);
      if (error) return avisarSemTempo(error);
    } else {
      const { error } = await SB.rpc('jogador_declara', {
        p_comb: cid, p_tick: acao.livre, p_acao: acao, p_alvo: null, p_golpes: 0,
      });
      if (error) return avisarSemTempo(error);
    }
    c.tick = acao.livre; c.acao = acao;
    pintarIniciativa(); pintarTokens();
    avisarAgora('combatentes');
  }

  async function gastarMana(cid: string, quanto: number) {
    // Desistir de posicionar a Arte não paga. O assistente avisa o custo ao sair
    // (inclusive quando a pessoa desistiu no meio), e o que separa uma
    // conjuração feita de uma abandonada é a linha no registro: toda Arte que
    // aconteceu escreve uma, e nenhuma que foi cancelada escreve.
    if (MARCO_LOG >= 0 && LOG.length <= MARCO_LOG) return;
    const c = COMBS.find((x: any) => x.id === cid);
    if (!c || !(quanto > 0) || c.mana_max == null) return;
    const atual = Math.max(0, (c.mana_atual ?? 0) - Math.round(quanto));
    if (atual === c.mana_atual) return;
    const { error } = await gravarPeca(cid, { mana_atual: atual });
    if (error) return;
    c.mana_atual = atual;
    atualizarMana(c); pintarLista();
    avisarAgora('combatentes');
  }

  /**
   * O card do bestiário, o mesmo das abas Criaturas e Combate.
   *
   * A prosa da criatura (habilidades, poderes, lore) não vem no pacote da
   * página: ela é buscada agora, por criatura. A janela abre na hora com o que
   * já se tem, e o texto entra quando chegar, porque esperar a rede para mostrar
   * um card que já está quase todo pronto seria pior do que vê-lo completar.
   */
  async function abrirCard(cid: string) {
    const c = COMBS.find((x: any) => x.id === cid);
    const m = c && MON[c.monstro_id]; if (!m) return;
    el('card-modal-body').innerHTML = cardCriaturaHTML(m);
    (el('card-modal') as HTMLElement).hidden = false;
    document.body.style.overflow = 'hidden';
    const cheia = await criaturaCompleta(c.monstro_id);
    // Fechou antes de chegar: não escreve por cima de uma janela que já não é
    // esta.
    if (cheia && !(el('card-modal') as HTMLElement).hidden) {
      el('card-modal-body').innerHTML = cardCriaturaHTML(cheia);
    }
  }

  /**
   * Arte: o assistente inteiro mora em `artes-grid-*`.
   *
   * Aqui ficou só a chamada porque a mecânica é grande (24 Artes, 139 Efeitos,
   * parâmetros, molde, Mana e o teste da matéria) e nada dela é específico deste
   * arquivo. O contexto abaixo é tudo o que aquele módulo não tem como saber
   * sozinho: a conexão, a arena, quem está em campo e onde.
   */
  let MARCO_LOG = -1;
  async function usarArte(cid: string) {
    MARCO_LOG = LOG.length;
    try { await conjurar(ctxArtes(), cid, el('gr-palco')); }
    finally { MARCO_LOG = -1; }
  }

  // =============================================================== NPC
  /**
   * Um figurante para a cena: só nome e Vida.
   *
   * Ele nasce como `combatentes` do tipo `custom`, e é exatamente isso que faz
   * dele descartável: essa linha pertence ao ENCONTRO, e some com ele. Nada vai
   * para o compêndio nem para o bestiário. O taberneiro que entrou na briga não
   * merece uma ficha permanente, e o mestre não deveria ter de limpar depois.
   */
  async function novoNPC() {
    // Nome e Vida continuam sendo o caminho curto; a "ficha avançada" abre o
    // resto (defesas, absorção, ataque, retrato do bestiário) para o figurante
    // que vai brigar de verdade, e é o mesmo formulário que uma invocação usa.
    await novoNPCArtes(ctxArtes());
  }

  // ============================================================= registro
  const fmtM = (m: number) => `${Number.isInteger(m) ? m : m.toFixed(1)} m`;

  /**
   * Escreve no registro em duas redações, como o log do combate.
   *
   * `pub` é o que o jogador lê, e vira null quando a peça está OCULTA: mover um
   * combatente escondido não pode aparecer no registro do grupo, senão a
   * emboscada se anuncia por escrito, com casa e tudo.
   */
  async function logar(c: any, txt: string, extra: Record<string, any>) {
    const linha = { id: novoId(), ts: new Date().toISOString(), txt, pub: c?.oculto ? null : txt, ...extra };
    LOG.push(linha);
    if (LOG.length > 300) LOG = LOG.slice(-300);
    pintarLog();
    await persistirLog(linha);
  }

  /**
   * Grava o registro. Os dois papéis escrevem de jeitos diferentes, de propósito.
   *
   * O mestre sobe o array inteiro, e é isso que lhe permite editar e apagar
   * linhas. O jogador ACRESCENTA uma linha por uma função do banco: ele não
   * reescreve o que já está lá, então não há como uma tela atrasada dele apagar
   * o que aconteceu enquanto isso, nem como ele mexer no que o mestre escreveu.
   */
  async function persistirLog(linha?: any) {
    if (!MESTRE) {
      if (!linha || !ARENA) return;
      const { error } = await SB.rpc('jogador_registra', { p_arena: ARENA.id, p_linha: linha });
      if (!error) RT?.avisar('registro');
      else uiErro('Erro ao registrar: ' + error.message);
      return;
    }
    const { error } = await SB.from('mesa_arenas').update({ log: LOG }).eq('id', ARENA.id);
    if (!error) RT?.avisar('registro');
    if (error) uiErro(/log/i.test(error.message)
      ? 'A coluna "log" da arena ainda não existe. Rode supabase/migracao-17.sql.'
      : 'Erro ao gravar o registro: ' + error.message);
  }

  /** Realça as casas (D5, H7) no meio da frase, que é o que o olho procura. */
  const realcarCasas = (t: string) =>
    esc(t).replace(/\b([A-Z]{1,2}\d{1,2})\b/g, '<span class="casa">$1</span>');

  function pintarLog() {
    const box = el('gr-log');
    // O botão é ajustado ANTES da saída antecipada: ele nasce escondido no HTML,
    // e sair aqui deixava o mestre sem o desfazer para sempre.
    const btn = el('gr-desfazer') as HTMLButtonElement;
    btn.hidden = !MESTRE;
    btn.disabled = !LOG.some((e: any) => e.acao);
    if (!LOG.length) { esquecerCaixa(box); box.innerHTML = '<p class="vazio">Nada movido ainda.</p>'; return; }
    const hora = (ts: string) => { try { return new Date(ts).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }); } catch { return ''; } };
    // Uma linha do registro nunca muda depois de escrita: a chave é o id dela, e
    // uma peça movida acrescenta UM nó em vez de refazer os sessenta.
    reconciliar(box, LOG.slice().reverse().slice(0, 60).map((e: any, i: number) => ({
      chave: String(e.id ?? `${e.ts}#${i}`),
      html: `<div class="lg">
      <span class="lg-h">${hora(e.ts)}</span>
      ${(MESTRE && e.pub == null) ? '<span class="lg-so" title="Só você lê esta linha">🔒</span>' : ''}
      <span class="lg-t">${realcarCasas(e.txt)}</span>
    </div>`,
    })));
  }

  /**
   * Desfaz a última ação. Lê `acao`, `de` e `para` da entrada, e não a frase:
   * o texto é para o humano, o inverso é para a máquina. A entrada desfeita sai
   * do registro em vez de virar uma linha nova, senão desfazer três vezes
   * deixaria seis linhas contando uma história que não aconteceu.
   */
  /** Põe a Vida de volta onde estava. Usado só pelo desfazer. */
  async function devolverVida(cid: string, pv: number | null) {
    const c = COMBS.find((x: any) => x.id === cid);
    if (!c || pv == null) return;
    const { error } = await gravarPeca(cid, { pv_atual: pv });
    if (error) return uiErro('Erro: ' + error.message);
    c.pv_atual = pv;
    atualizarAnel(c); pintarLista(); pintarIniciativa();
    avisarAgora('combatentes');
  }

  async function desfazer() {
    const i = [...LOG].reverse().findIndex((e: any) => e.acao);
    if (i < 0) return;
    const idx = LOG.length - 1 - i;
    const e = LOG[idx];
    if (e.acao === 'por') await tirarDoMapa(e.cid, false);
    else if (e.acao === 'mover') await porNoMapa(e.cid, e.de.q, e.de.r, false);
    else if (e.acao === 'tirar') await porNoMapa(e.cid, e.de.q, e.de.r, false);
    // A Vida volta ao número que tinha ANTES, e não "soma o que foi tirado": se
    // duas coisas bateram na mesma peça, somar de volta desfaria a errada.
    else if (e.acao === 'vida') await devolverVida(e.cid, e.de);
    // Dano de jogador é relativo: ele não sabia o número, então o que voltou
    // para o registro foi o QUANTO. Devolver é somar de volta, com o teto.
    else if (e.acao === 'vida-menos') {
      const c = COMBS.find((x: any) => x.id === e.cid);
      if (c) await devolverVida(e.cid, Math.min(c.pv_max ?? Infinity, (c.pv_atual ?? 0) + (e.quanto || 0)));
    }
    LOG.splice(idx, 1);
    pintarLog();
    await persistirLog();
  }

  // ====================================================== o registro inteiro
  /**
   * O registro sai da coluna e abre inteiro, para ser arrumado.
   *
   * A coluna mostra as 60 últimas e não deixa mexer em nada, que é o certo
   * durante a cena. Depois dela sobra trabalho de arquivo: a linha que ficou de
   * uma tentativa, o nome escrito errado no calor do combate, o efeito que foi
   * conjurado três vezes até a mesa entender a regra. É isto aqui.
   */
  function abrirRegistro() {
    pintarRegistro();
    (el('reg-dlg') as HTMLDialogElement).showModal();
  }

  function pintarRegistro() {
    const box = el('rg-lista');
    const n = LOG.length;
    el('rg-conta').textContent = n
      ? `${n} linha${n > 1 ? 's' : ''}, a mais nova em cima. O ✎ corrige o texto e o ✕ apaga a linha.`
      : '';
    if (!n) { box.innerHTML = '<p class="rg-vazio">Nada registrado nesta arena ainda.</p>'; return; }
    const hora = (ts: string) => {
      try { return new Date(ts).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }); }
      catch { return ''; }
    };
    box.innerHTML = LOG.slice().reverse().map((e: any) => `<div class="rg-l" data-id="${esc(e.id)}">
      <span class="rg-h">${hora(e.ts)}</span>
      <span>${e.pub == null ? '<span class="rg-so" title="Só você lê esta linha">🔒</span>' : ''}${
        e.ef ? '<span class="rg-ef rg-so" title="Linha de Arte: o &quot;refazer&quot; troca estas">✶</span>' : ''}</span>
      <span class="rg-t">${realcarCasas(e.txt)}</span>
      <span class="rg-acs">
        <button type="button" data-a="ed" title="Editar o texto">✎</button>
        <button type="button" data-a="rm" class="perigo" title="Excluir esta linha">✕</button>
      </span>
    </div>`).join('');
    box.querySelectorAll<HTMLElement>('.rg-acs button').forEach((b) => b.onclick = () => {
      const id = b.closest<HTMLElement>('.rg-l')!.dataset.id!;
      if (b.dataset.a === 'ed') editarLinha(id);
      else excluirLinha(id);
    });
  }

  /**
   * Editar no lugar, e não num diálogo por cima do diálogo.
   *
   * A redação pública acompanha a do mestre SE ela existia: corrigir o nome de
   * quem levou o golpe tem de corrigir nos dois lados. Se a linha era secreta
   * (peça oculta), ela continua secreta, e por isso o `pub` nulo não vira texto.
   */
  function editarLinha(id: string) {
    const linha = el('rg-lista').querySelector<HTMLElement>(`.rg-l[data-id="${CSS.escape(id)}"]`);
    const e = LOG.find((x: any) => x.id === id);
    const alvo = linha?.querySelector('.rg-t');
    if (!linha || !e || !alvo) return;
    const inp = document.createElement('input');
    inp.className = 'rg-in';
    inp.value = e.txt || '';
    alvo.replaceWith(inp);
    inp.focus(); inp.select();
    let fechado = false;
    const fim = async (salvar: boolean) => {
      if (fechado) return;
      fechado = true;
      const novo = inp.value.trim();
      if (salvar && novo && novo !== e.txt) {
        if (typeof e.pub === 'string') e.pub = novo;
        e.txt = novo;
        pintarLog();
        await persistirLog();
      }
      pintarRegistro();
    };
    inp.onkeydown = (ev) => {
      if (ev.key === 'Enter') { ev.preventDefault(); fim(true); }
      // O Esc aqui desiste da EDIÇÃO. Sem segurar a tecla, ele fecharia o
      // diálogo inteiro, que é o que o Esc faz num modal.
      else if (ev.key === 'Escape') { ev.preventDefault(); ev.stopPropagation(); fim(false); }
    };
    inp.onblur = () => fim(true);
  }

  async function excluirLinha(id: string) {
    const i = LOG.findIndex((x: any) => x.id === id);
    if (i < 0) return;
    LOG.splice(i, 1);
    pintarLog(); pintarRegistro();
    await persistirLog();
  }

  /**
   * Refaz as linhas de Arte a partir do que está no chão AGORA.
   *
   * O assistente de conjuração deixa rastro: a tentativa que não foi adiante, o
   * efeito que já venceu, a mordida que a mesa refez. Este botão joga fora tudo
   * que veio dele (as linhas marcadas com `ef`) e escreve uma linha por efeito
   * que ainda está no tabuleiro, lida do banco.
   *
   * O que ele NÃO alcança são as linhas de antes desta marca existir: elas não
   * têm como ser reconhecidas, e ficam para o ✕ apagar à mão.
   */
  async function refazerLogEfeitos() {
    const { data, error } = await SB.from('arena_efeitos').select('*').eq('arena_id', ARENA.id);
    if (error) return uiErro(/arena_efeitos/i.test(error.message)
      ? 'A tabela dos efeitos ainda não existe. Rode supabase/migracao-19.sql.'
      : 'Não deu para ler os efeitos: ' + error.message);
    const vivos = data || [];
    const marcadas = LOG.filter((e: any) => e.ef).length;
    if (!marcadas && !vivos.length) return uiErro('Não há linhas de Arte nem efeitos no tabuleiro.');
    if (!await uiConfirmar(
      `Apagar ${marcadas} linha${marcadas === 1 ? '' : 's'} de Arte do registro e escrever `
      + `${vivos.length} no lugar, uma por efeito que está no tabuleiro?`,
      { titulo: 'Refazer o log dos efeitos', ok: 'Refazer', perigo: marcadas > 0 })) return;

    LOG = LOG.filter((e: any) => !e.ef);
    const agora = daVez()?.tick ?? 0;
    const nomeDe = (id: string) => COMBS.find((c: any) => c.id === id)?.nome || '';
    // Na ordem em que entraram em cena, que é a ordem em que a mesa os viu.
    for (const ef of vivos.slice().sort((a: any, b: any) => (a.desde_tick ?? 0) - (b.desde_tick ?? 0))) {
      const casas = Array.isArray(ef.hexes) ? ef.hexes.length : 0;
      const quem = nomeDe(ef.conjurador_id);
      // Um turno são seis ticks: o que a mesa pergunta é quantos turnos faltam.
      const turnos = Math.max(0, Math.ceil(((ef.ate_tick ?? 0) - agora) / 6));
      const txt = `${ef.nome} no tabuleiro${quem ? `, de ${quem}` : ''}`
        + (casas ? ` · ${casas} casa${casas > 1 ? 's' : ''}` : '')
        + ` · ${turnos} turno${turnos === 1 ? '' : 's'}`;
      LOG.push({ id: novoId(), ts: new Date().toISOString(), txt, pub: ef.oculto ? null : txt,
        acao: null, ef: true });
    }
    pintarLog(); pintarRegistro();
    await persistirLog();
  }

  // ============================================================ a barra
  /**
   * Encolher a lista dá a altura dela ao Registro. Fica guardado no aparelho
   * (e não na arena): é preferência de quem está olhando, e o mestre no
   * notebook não tem por que impor a escolha dele ao jogador no celular.
   */
  const DOBRA_KEY = 'centelha:grid:lista-dobrada';
  const DOBRA_LOG_KEY = 'centelha:grid:log-dobrado';
  /**
   * Duas dobras, uma para cada lado.
   *
   * Recolher "Em campo" dá a altura ao Registro, e recolher o Registro devolve a
   * altura a "Em campo". A coluna é uma só e as duas coisas crescem por dentro
   * dela; qual das duas merece o espaço muda com a cena, e por isso a escolha é
   * de quem está olhando e fica guardada no aparelho.
   */
  function dobra(btnId: string, classe: string, chave: string, dicaAbre: string, dicaFecha: string) {
    const btn = el(btnId);
    const aplica = (dobrada: boolean) => {
      el('gr-lado').classList.toggle(classe, dobrada);
      btn.setAttribute('aria-expanded', String(!dobrada));
      btn.title = dobrada ? dicaAbre : dicaFecha;
    };
    let dobrada = false;
    try { dobrada = localStorage.getItem(chave) === '1'; } catch {}
    aplica(dobrada);
    btn.onclick = () => {
      dobrada = !dobrada;
      aplica(dobrada);
      try { localStorage.setItem(chave, dobrada ? '1' : '0'); } catch {}
    };
  }
  /**
   * As dobras das caixas do painel.
   *
   * Recolher não é esconder: a caixa fica reduzida ao próprio cabeçalho, que é
   * como "Em campo" e "Registro" já fazem, e a escolha fica no aparelho de quem
   * está olhando. A tira de iniciativa recolhida guarda o relógio, que é a
   * última coisa que alguém quer perder de vista.
   */
  const DOBRA_INI_KEY = 'centelha:grid:fila-dobrada';
  const LINHA_KEY = 'centelha:grid:linha-tempo';
  function dobraCaixa(btnId: string, caixaId: string, classe: string, chave: string,
    dicaAbre: string, dicaFecha: string) {
    const btn = el(btnId);
    if (!btn) return;
    const aplica = (dobrada: boolean) => {
      el(caixaId).classList.toggle(classe, dobrada);
      document.querySelector('.gr-grade')?.classList.toggle(`${classe}-fora`, dobrada);
      btn.setAttribute('aria-expanded', String(!dobrada));
      btn.title = dobrada ? dicaAbre : dicaFecha;
    };
    let dobrada = false;
    try { dobrada = localStorage.getItem(chave) === '1'; } catch {}
    aplica(dobrada);
    btn.onclick = () => {
      dobrada = !dobrada; aplica(dobrada);
      try { localStorage.setItem(chave, dobrada ? '1' : '0'); } catch {}
      ajustarAltura();
    };
  }

  function ligarDobra() {
    dobra('gr-dobrar', 'dobrada', DOBRA_KEY,
      'Mostrar a lista de quem está em campo', 'Ocultar a lista e dar a altura ao Registro');
    dobra('gr-dobrar-log', 'log-dobrado', DOBRA_LOG_KEY,
      'Mostrar o registro', 'Recolher o registro e dar a altura a Em campo');
    dobraCaixa('ini-dobrar', 'gr-ini-col', 'fila-dobrada', DOBRA_INI_KEY,
      'Mostrar a fila de iniciativa', 'Recolher a fila e dar o espaço ao tabuleiro');
    ligarLinhaDoTempo();
  }

  /**
   * O INTERRUPTOR DA LINHA DO TEMPO.
   *
   * Ela não é uma terceira coluna a recolher: é uma leitura EXTRA do mesmo
   * relógio que a tira já dá, e uma leitura extra que não está ajudando é peso.
   * Por isso nasce desligada e some inteira quando se desliga (a fileira sai da
   * grade e o mapa recebe a altura de volta), em vez de recolher para um
   * cabeçalho que continuaria ocupando lugar.
   *
   * Fica no aparelho de quem olha, e não na mesa: o mestre com dois monitores
   * pode querê-la, e o jogador no tablet quase certamente não.
   */
  let LINHA_LIGADA = false;
  function ligarLinhaDoTempo() {
    try { LINHA_LIGADA = localStorage.getItem(LINHA_KEY) === '1'; } catch {}
    const btn = el('gr-linha-btn');
    const aplica = () => {
      btn?.setAttribute('aria-pressed', String(LINHA_LIGADA));
      if (btn) btn.title = LINHA_LIGADA
        ? 'Esconder a linha do tempo'
        : 'Mostrar a linha do tempo: uma régua de Ticks debaixo do tabuleiro';
      pintarLinhaDoTempo(relogio());
      ajustarAltura();
    };
    const virar = (ligada: boolean) => {
      LINHA_LIGADA = ligada;
      try { localStorage.setItem(LINHA_KEY, ligada ? '1' : '0'); } catch {}
      aplica();
    };
    if (btn) btn.onclick = () => virar(!LINHA_LIGADA);
    const fechar = el('lt-fechar');
    if (fechar) fechar.onclick = () => virar(false);
    aplica();
  }

  function ligarBarra() {
    ligarDobra();
    el('gr-recarregar').onclick = () => carregar();
    el('gr-menos').onclick = () => mudarZoom(ZOOM - 0.15);
    el('gr-mais').onclick = () => mudarZoom(ZOOM + 0.15);
    el('gr-caber').onclick = () => caber();
    (el('gr-sel') as HTMLSelectElement).onchange = async (e) => {
      ARENA = ARENAS.find((a) => a.id === (e.target as HTMLSelectElement).value) || ARENA;
      await carregarTokens();
      pintar();
    };
    if (!MESTRE) return;
    (el('gr-npc') as HTMLElement).hidden = false;
    el('gr-npc').onclick = () => novoNPC();
    el('gr-trilha').onclick = () => abrirTrilha();
    el('ini-rolar').onclick = () => rolarIniciativas();
    el('ini-prox').onclick = () => { const v = daVez(); if (v) encerrarVez(v.id); };
    // Espaço encerra a vez de quem está agindo: é o gesto mais repetido de uma
    // sessão inteira, e tirar a mão do teclado para caçar o menu custa caro.
    /**
     * OS ATALHOS.
     *
     * A sequência de uma luta é sempre a mesma: escolher quem, escolher o que,
     * passar a vez. Com o teclado ela vira três teclas e a mão não sai do
     * lugar. Nenhum deles inventa ação nenhuma: todos abrem a mesma caixa que o
     * mouse abriria, e por isso não há atalho para "aplicar dano" nem para
     * "acertou" — o que decide continua passando pela caixa.
     *
     *   Espaço  encerra a vez de quem age
     *   A       ataca com quem age (abre a mira)
     *   1..9    abre o menu da enésima peça da fila
     *   Z       desfaz a última coisa
     *   F       tela cheia · Esc cancela o que estiver no ar
     */
    document.addEventListener('keydown', (ev) => {
      const a = document.activeElement as HTMLElement | null;
      if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.tagName === 'SELECT' || a.isContentEditable)) return;
      if (document.querySelector('dialog[open]') || AJUSTANDO) return;
      if (ev.ctrlKey || ev.metaKey || ev.altKey) return;
      if (ev.code === 'Space') {
        if (!MESTRE || MIRA) return;
        const v = daVez(); if (!v) return;
        ev.preventDefault(); encerrarVez(v.id);
        return;
      }
      if (ev.key === 'z' || ev.key === 'Z') {
        if (!MESTRE || MIRA) return;
        ev.preventDefault(); desfazer();
        return;
      }
      if (ev.key === 'a' || ev.key === 'A') {
        if (MIRA) return;
        // Ataca com quem está agindo, quando essa peça é sua: para o jogador é a
        // dele, para o mestre é a da vez. Sem peça na mão, a tecla não faz nada,
        // que é melhor do que escolher alguém por ele.
        const v = daVez();
        if (!v || !mandoNela(v) || !TOKENS[v.id]) return;
        ev.preventDefault(); iniciarMira(v.id);
        return;
      }
      if (/^[1-9]$/.test(ev.key)) {
        if (MIRA) return;
        const fila = naFila().filter((c: any) => !noChao(c));
        const c = fila[parseInt(ev.key, 10) - 1];
        if (!c) return;
        ev.preventDefault();
        // No lugar da peça, e não no canto da tela: o menu que abre longe de
        // quem ele governa faz o olho procurar duas vezes.
        const t = document.querySelector<HTMLElement>(`.gr-token[data-c="${CSS.escape(c.id)}"]`);
        const r = t?.getBoundingClientRect();
        abrirMenu(c.id, r ? r.right : innerWidth / 2, r ? r.top : innerHeight / 2);
      }
    });
    el('gr-desfazer').onclick = () => desfazer();
    el('gr-registro').onclick = () => abrirRegistro();
    el('rg-fechar').onclick = () => (el('reg-dlg') as HTMLDialogElement).close();
    el('rg-refazer').onclick = () => refazerLogEfeitos();
    el('gr-nova').onclick = () => abrirArena(null);
    el('gr-editar').onclick = () => abrirArena(ARENA);
    el('gr-fundo-btn').onclick = () => abrirFundo();
    (el('gr-tempo') as HTMLElement).title = `Como o tempo passa nesta mesa: ${resumoDoTempo(TEMPO)}`;
    el('gr-tempo').onclick = () => abrirEscolhaDoTempo(
      CTX, { emAndamento: COMBS.filter((c: any) => acaoNo(c)).length },
      async (novo) => {
        TEMPO = novo;
        (el('gr-tempo') as HTMLElement).title = `Como o tempo passa nesta mesa: ${resumoDoTempo(novo)}`;
        await carregar();
      });
    el('gr-ativar').onclick = async () => {
      const { error } = await SB.rpc('ativar_arena', { p_id: ARENA.id });
      if (error) return uiErro('Erro: ' + error.message);
      await carregar();
      // Pôr outra arena em jogo troca o chão debaixo do grupo inteiro: é o
      // aviso que mais precisa chegar, e o único em que o jogador pode estar
      // olhando um mapa que deixou de existir para ele.
      RT?.avisar('arena');
    };
    el('gr-excluir').onclick = async () => {
      if (!await uiConfirmar(`Excluir a arena "${ARENA.nome}"? As posições dos tokens nela somem junto.`,
        { titulo: 'Excluir arena', ok: 'Excluir', perigo: true })) return;
      const { error } = await SB.from('mesa_arenas').delete().eq('id', ARENA.id);
      if (error) return uiErro('Erro: ' + error.message);
      await carregar();
      RT?.avisar('arena');
    };
  }

  // ---- criar / editar arena ----
  function abrirArena(arena: any) {
    const dlg = el('arena-dlg') as HTMLDialogElement;
    const g = (i: string) => el(i) as HTMLInputElement;
    (el('ar-titulo') as HTMLElement).textContent = arena ? `Editar ${arena.nome}` : 'Nova arena';
    g('ar-nome').value = arena?.nome || '';
    g('ar-cols').value = String(arena?.cols ?? 24);
    g('ar-rows').value = String(arena?.rows ?? 16);
    g('ar-escala').value = String(arena?.escala_m ?? 1);
    el('ar-cancelar').onclick = () => dlg.close();
    el('ar-salvar').onclick = async () => {
      const linha = {
        nome: g('ar-nome').value.trim() || 'Arena',
        cols: Math.max(2, Math.min(60, +g('ar-cols').value || 24)),
        rows: Math.max(2, Math.min(60, +g('ar-rows').value || 16)),
        escala_m: Math.max(0.25, +g('ar-escala').value || 1),
      };
      dlg.close();
      if (arena) {
        const { error } = await SB.from('mesa_arenas').update(linha).eq('id', arena.id);
        if (error) return uiErro('Erro: ' + error.message);
      } else {
        const { data, error } = await SB.from('mesa_arenas')
          .insert({ ...linha, mesa_id: ID, ordem: ARENAS.length }).select('id').single();
        if (error) return uiErro('Erro: ' + error.message);
        // A primeira arena da mesa já entra em jogo: criar e não pôr em campo
        // seria um passo a mais para chegar ao lugar óbvio.
        if (!ARENAS.length) await SB.rpc('ativar_arena', { p_id: data.id });
      }
      await carregar();
      RT?.avisar('arena');
    };
    dlg.showModal();
  }

  // ---- a arte de fundo ----
  async function abrirFundo() {
    const dlg = el('fundo-dlg') as HTMLDialogElement;
    await pintarMapas(dlg);
    (el('fd-file') as HTMLInputElement).onchange = async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      dlg.close();
      await subirFundo(file);
    };
    el('fd-tirar').onclick = async () => { dlg.close(); await gravarFundo(null, null); };
    el('fd-cancelar').onclick = () => dlg.close();
    dlg.showModal();
    // O `showModal` acende o PRIMEIRO focável de dentro, e aqui o primeiro é uma
    // palavra do texto de ajuda que o glossário virou link. Com ele aceso, um
    // Enter distraído leva o mestre para fora da mesa no meio da sessão.
    (el('fd-cancelar') as HTMLElement).focus();
  }

  /**
   * A lista de artes da caixa, com o que dá para fazer com cada uma.
   *
   * Está fora da `abrirFundo` porque girar e excluir REFAZEM a lista sem fechar
   * a caixa: quem entrou aqui para arrumar três mapas tortos arruma os três de
   * uma vez, e não reabre o diálogo entre um e outro.
   *
   * A medida ("1024×1792 · retrato") só existe depois que a miniatura carrega,
   * porque é dela que sai o tamanho natural. É a legenda que responde à única
   * pergunta que se faz aqui, que é qual das artes está em pé.
   */
  async function pintarMapas(dlg: HTMLDialogElement) {
    const { data } = await SB.from('arquivos').select('id, nome, storage_path')
      .eq('mesa_id', ID).eq('categoria', 'mapa').order('criado_em', { ascending: false });
    const mapas = data || [];
    const urls = await urlsImagens(SB, mapas.map((m: any) => m.storage_path), 'mesa');
    const lista = el('fd-lista');
    lista.innerHTML = mapas.length
      ? mapas.map((m: any) => `<div class="fd-item${m.storage_path === ARENA.fundo_path ? ' sel' : ''}"
          data-p="${esc(m.storage_path)}" data-a="${m.id}" data-n="${esc(m.nome || '')}">
          <div class="fd-arte">
            <img src="${esc(urls[m.storage_path] || '')}" alt="" loading="lazy" />
            <div class="fd-acs">
              <button type="button" data-g="-90" title="Deitar a arte para a esquerda">↺</button>
              <button type="button" data-g="90" title="Deitar a arte para a direita">↻</button>
              <button type="button" data-rm="1" class="perigo" title="Excluir esta arte da mesa">✕</button>
            </div>
          </div>
          <span class="fd-nome">${esc(m.nome)}</span><span class="fd-med"></span>
        </div>`).join('')
      : '<p class="vazio">Nenhum mapa na aba Mapas ainda. Envie um aqui embaixo.</p>';

    lista.querySelectorAll<HTMLElement>('.fd-item').forEach((it) => {
      const arq = { id: it.dataset.a!, nome: it.dataset.n!, storage_path: it.dataset.p! };
      const img = it.querySelector('img') as HTMLImageElement;
      const medir = () => {
        if (!img.naturalWidth) return;
        it.querySelector('.fd-med')!.textContent = medidaDeMapa(img.naturalWidth, img.naturalHeight);
        it.classList.toggle('fd-empe', img.naturalHeight > img.naturalWidth);
      };
      if (img.complete) medir(); else img.onload = medir;

      it.onclick = async () => { dlg.close(); await gravarFundo(arq.storage_path, arq.id); };

      // O clique nos botões não pode subir até o item: lá em cima ele significa
      // "usa esta arte", e girar não é escolher.
      it.querySelectorAll<HTMLElement>('[data-g]').forEach((b) => b.onclick = async (ev) => {
        ev.stopPropagation();
        it.classList.add('ocupado');
        const novo = await girarMapa(SB, {
          mesaId: ID, arquivo: arq, url: img.src, graus: Number(b.dataset.g) as Giro,
        });
        it.classList.remove('ocupado');
        if (novo) await depoisDeMexerNoMapa(dlg, arq.storage_path);
      });
      (it.querySelector('[data-rm]') as HTMLElement).onclick = async (ev) => {
        ev.stopPropagation();
        if (await excluirMapa(SB, { mesaId: ID, arquivo: arq })) {
          await depoisDeMexerNoMapa(dlg, arq.storage_path);
        }
      };
    });
  }

  /**
   * O arquivo mudou de endereço (ou sumiu). Quem estava olhando precisa saber.
   *
   * `carregar` só é chamado se a arte mexida for a DESTA arena: sem isso o
   * tabuleiro continuaria com a URL antiga, que aponta para um arquivo que já
   * não existe, e a arte sumiria na próxima vez que alguém abrisse a página,
   * sem nada na tela explicando por quê.
   */
  async function depoisDeMexerNoMapa(dlg: HTMLDialogElement, caminho: string) {
    if (ARENA.fundo_path === caminho) { await carregar(); RT?.avisar('arena'); }
    await pintarMapas(dlg);
  }

  /** Envia para o mesmo bucket e registra em `arquivos`: a arte aparece na aba Mapas também. */
  async function subirFundo(file: File) {
    const seguro = file.name.replace(/[^\w.\-]+/g, '_');
    const path = `${ID}/mapas/${Date.now()}-${seguro}`;
    const { error } = await SB.storage.from('mesa').upload(path, file, { contentType: file.type });
    if (error) return uiErro('Erro ao enviar: ' + error.message);
    const { data, error: e2 } = await SB.from('arquivos').insert({
      mesa_id: ID, dono_id: EU, nome: file.name.replace(/\.[^.]+$/, ''), storage_path: path,
      bucket: 'mesa', tipo: file.type, categoria: 'mapa', visivel_jogadores: false,
    }).select('id').single();
    if (e2) return uiErro('Enviado, mas erro ao registrar: ' + e2.message);
    await gravarFundo(path, data.id);
  }

  async function gravarFundo(path: string | null, arquivoId: string | null) {
    const { error } = await SB.from('mesa_arenas')
      .update({ fundo_path: path, arquivo_id: arquivoId, fundo_url: null }).eq('id', ARENA.id);
    if (error) return uiErro('Erro: ' + error.message);
    await carregar();
    RT?.avisar('arena');
  }

  main();
</script>
