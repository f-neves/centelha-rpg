---
import Base from '../../layouts/Base.astro';
import MesaCab from '../../components/MesaCab.astro';
---
<Base title="Combate" largura="full" telaCheia descricao="Rastreador de combate da mesa: Ticks, dano, condições.">
  <MesaCab aba="combate">

    <div id="enc-vazio" hidden></div>

    <div id="enc-tudo" hidden>
      {/* Uma barra só para tudo que é do ENCONTRO (o que ele é, o que se faz com
          ele, quem entra nele). Eram duas caixas empilhadas; juntas custavam
          uma faixa inteira de card num notebook. */}
      <div class="enc-barra">
        <span class="enc-id">
          <span class="enc-rot">Encontro</span>
          <strong id="enc-nome" class="cinzel"></strong>
          <span class="enc-relogio"><span id="enc-rodada"></span> · <span id="enc-tick"></span></span>
        </span>
        <span class="enc-add" id="enc-add" hidden>
          <span class="sep-v"></span>
          <button class="btn mini" id="add-pcs">+ PCs</button>
          <button class="btn mini" id="add-criatura">+ criatura</button>
          <button class="btn mini" id="add-npc">+ NPC</button>
          <button class="btn mini" id="add-avulso">+ avulso</button>
          <label class="mini-chk"><input type="checkbox" id="ver-ocultos" checked /> ocultos</label>
        </span>
        <span class="espaco"></span>
        <span class="enc-btns" id="enc-btns"></span>
        <span class="enc-add" id="enc-add2" hidden>
          <button class="btn mini" id="btn-desfazer" disabled title="Desfaz a última alteração de Vida ou de Tick">↶</button>
          <button class="btn mini" id="btn-recarregar" title="Buscar o estado mais recente">↻</button>
        </span>
      </div>

      <!-- ---------- corpo em duas colunas ---------- -->
      <div class="cmb-grade">
        <div class="cmb-col-ordem">
          <div id="cmb-lista" class="cmb-lista"></div>
          <div id="cmb-fora-wrap" hidden>
            <h3 class="col-h col-h-fora">Fora de combate</h3>
            <div id="cmb-fora" class="cmb-lista cmb-lista-fora"></div>
          </div>
        </div>

        <aside class="cmb-col-lado">
          <div id="painel-turno" class="painel-turno"></div>
          <div class="log-caixa">
            <div class="log-cab">
              <h3 class="col-h">Registro</h3>
              <span class="log-add" id="log-add" hidden>
                <input type="text" id="log-nota" placeholder="anotar (todos leem)…" />
                <button class="btn mini" id="log-nota-btn">+</button>
              </span>
            </div>
            <div id="cmb-log" class="cmb-log"></div>
          </div>
        </aside>
      </div>
    </div>

  </MesaCab>

  <!-- ======================= diálogos ======================= -->
  <dialog id="acao-dlg" class="mesa-dlg dlg-larga">
    <form method="dialog">
      <h3 id="acao-titulo">Ação</h3>
      <div class="grade2">
        <label>O que faz
          <select id="acao-tipo">
            <option value="ataque">Ataque físico</option>
            <option value="social">Ataque social</option>
            <option value="mental">Ataque mental</option>
            <option value="acao">Outra ação</option>
            <option value="esperar">Esperar / preparar</option>
          </select>
        </label>
        <label id="acao-alcance-wrap">Alcance
          <select id="acao-alcance">
            <option value="cac">Corpo a corpo</option>
            <option value="dist">À distância</option>
          </select>
        </label>
      </div>
      <label id="acao-alvo-wrap">Alvo
        <select id="acao-alvo"></select>
      </label>
      <label id="acao-outro-wrap">Descrição
        <input type="text" id="acao-outro" placeholder="descreva…" />
      </label>

      <div id="acao-conta" class="acao-conta" hidden></div>

      <div class="acao-rolar" id="acao-rolar" hidden>
        <button type="button" class="btn mini" id="acao-rolar-atq">Rolar acerto</button>
        <span id="acao-res-atq" class="acao-res"></span>
      </div>

      <div id="acao-dano-wrap" class="grade3">
        <label>Dano bruto <input type="number" id="acao-dano" min="0" placeholder="0" /></label>
        <label>Tipo
          <select id="acao-dano-tipo">
            <option value="impacto">Impacto</option>
            <option value="corte">Cortante</option>
            <option value="perfurante">Perfurante</option>
          </select>
        </label>
        <label>&nbsp;<button type="button" class="btn mini" id="acao-rolar-dano">Rolar dano</button></label>
      </div>
      <div id="acao-dano-conta" class="acao-conta" hidden></div>

      <label>Velocidade (Ticks até a próxima ação)
        <input type="number" id="acao-speed" min="0" value="5" />
      </label>
      <div class="dlg-btns">
        <button type="button" class="btn" id="acao-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="acao-confirmar">Confirmar</button>
      </div>
    </form>
  </dialog>

  <dialog id="edit-dlg" class="mesa-dlg dlg-larga">
    <form method="dialog">
      <h3 id="edit-titulo">Combatente</h3>
      <div class="grade2">
        <label>Nome <input type="text" id="edit-nome" /></label>
        <label>Lado
          <select id="edit-grupo">
            <option value="inimigo">Inimigo</option>
            <option value="aliado">Aliado</option>
            <option value="neutro">Neutro</option>
          </select>
        </label>
      </div>
      <div class="grade3">
        <label>Vida máx. <input type="number" id="edit-pvmax" min="0" /></label>
        <label>Vida atual <input type="number" id="edit-pvat" min="0" /></label>
        <label>Iniciativa <input type="number" id="edit-ini" /></label>
      </div>
      <div class="grade3">
        <label>Energia máx. <input type="number" id="edit-enmax" min="0" /></label>
        <label>Energia atual <input type="number" id="edit-enat" min="0" /></label>
        <label>Tick <input type="number" id="edit-tick" min="0" /></label>
      </div>
      <div class="grade2">
        <label>Ataque <input type="text" id="edit-atq" placeholder="4d6+2 +1" /></label>
        <label>Dano <input type="text" id="edit-dano" placeholder="3d6 +2 (C)" /></label>
      </div>
      <div class="grade3">
        <label>Defesa física <input type="number" id="edit-def" /></label>
        <label>Defesa social <input type="number" id="edit-defs" /></label>
        <label>Defesa mental <input type="number" id="edit-defm" /></label>
      </div>
      <div class="grade3">
        <label>Abs. Impacto <input type="number" id="edit-abs-i" min="0" /></label>
        <label>Abs. Corte <input type="number" id="edit-abs-c" min="0" /></label>
        <label>Abs. Perfuração <input type="number" id="edit-abs-p" min="0" /></label>
      </div>
      <div class="grade2">
        <label>Resist. Perfuração (Nível) <input type="number" id="edit-rperf" min="0" /></label>
        <label>Velocidade padrão <input type="number" id="edit-vel" min="0" placeholder="5" /></label>
      </div>
      <label>Retrato (URL ou caminho no bucket) <input type="text" id="edit-img" placeholder="https://… " /></label>
      <label>Notas do mestre <textarea id="edit-notas" rows="2"></textarea></label>
      <label class="chk"><input type="checkbox" id="edit-oculto" /> oculto dos jogadores</label>
      {/* A exceção à regra da mesa: o chefe que o grupo já estudou, o aliado
          contratado cujos números eles conhecem. */}
      <div class="grade2">
        <label>Vida deste, para os jogadores
          <select id="edit-rev-vida">
            <option value="">padrão da mesa</option>
            <option value="numero">o número exato</option>
            <option value="estado">só o estado</option>
            <option value="nada">só a cor do retrato</option>
          </select>
        </label>
        <label>Números deste (atq/dano/def)
          <select id="edit-rev-stats">
            <option value="">padrão da mesa</option>
            <option value="1">mostrar</option>
            <option value="0">esconder</option>
          </select>
        </label>
      </div>
      <div class="dlg-btns">
        <button type="button" class="btn" id="edit-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="edit-salvar">Salvar</button>
      </div>
    </form>
  </dialog>

  <dialog id="cond-dlg" class="mesa-dlg dlg-larga">
    <form method="dialog">
      <h3 id="cond-titulo">Condições</h3>
      <input type="search" id="cond-busca" placeholder="Filtrar condições…" autocomplete="off" />
      <div id="cond-ativas" class="conds cond-ativas"></div>
      <div id="cond-catalogo" class="cond-catalogo"></div>
      <details class="cond-custom">
        <summary>Condição caseira</summary>
        <div class="grade2">
          <label>Nome <input type="text" id="cc-nome" placeholder="Perna quebrada" /></label>
          <label>Ação (flat) <input type="number" id="cc-acao" value="0" /></label>
        </div>
        <div class="grade3">
          <label>Dados (d6) <input type="number" id="cc-dados" value="0" /></label>
          <label>Defesa <input type="number" id="cc-defesa" value="0" /></label>
          <label>Dano/rodada <input type="number" id="cc-rodada" min="0" value="0" /></label>
        </div>
        <label>Nota <input type="text" id="cc-nota" /></label>
        <button type="button" class="btn mini" id="cc-add">Aplicar condição caseira</button>
      </details>
      <div class="dlg-btns">
        <button type="button" class="btn primary" id="cond-fechar">Pronto</button>
      </div>
    </form>
  </dialog>

  <dialog id="add-dlg" class="mesa-dlg dlg-larga">
    <form method="dialog">
      <h3 id="add-titulo">Adicionar</h3>
      <input type="search" id="add-busca" placeholder="Buscar…" autocomplete="off" />
      <div id="add-lista" class="add-lista"></div>
      <div class="grade2">
        <label>Quantidade <input type="number" id="add-qtd" min="1" max="24" value="1" /></label>
        <label>Lado
          <select id="add-grupo">
            <option value="inimigo">Inimigo</option>
            <option value="aliado">Aliado</option>
            <option value="neutro">Neutro</option>
          </select>
        </label>
      </div>
      <label class="chk"><input type="checkbox" id="add-oculto" /> entrar oculto (emboscada)</label>
      <div class="dlg-btns">
        <button type="button" class="btn" id="add-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="add-confirmar" disabled>Adicionar</button>
      </div>
    </form>
  </dialog>

  <dialog id="reset-dlg" class="mesa-dlg">
    <form method="dialog">
      <h3>Reiniciar o combate</h3>
      <p class="muted dlg-txt">Escolha o que volta ao início. Nada some: os combatentes continuam na lista.</p>
      <label class="chk"><input type="checkbox" id="rs-tick" checked /> zerar os Ticks</label>
      <label class="chk"><input type="checkbox" id="rs-ini" checked /> rolar iniciativa de novo</label>
      <label class="chk"><input type="checkbox" id="rs-pv" checked /> restaurar a Vida ao máximo</label>
      <label class="chk"><input type="checkbox" id="rs-cond" checked /> limpar as condições</label>
      <label class="chk"><input type="checkbox" id="rs-fora" checked /> trazer de volta quem estava fora</label>
      <label class="chk"><input type="checkbox" id="rs-log" /> apagar o registro</label>
      <div class="dlg-btns">
        <button type="button" class="btn" id="rs-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="rs-ok">Reiniciar</button>
      </div>
    </form>
  </dialog>

  <dialog id="rev-dlg" class="mesa-dlg">
    <form method="dialog">
      <h3>O que os jogadores veem</h3>
      <p class="muted dlg-txt">Vale para inimigos e neutros desta mesa, em todos os encontros. Os personagens
        do grupo aparecem sempre inteiros: a ficha deles já está na mesa.</p>
      <label>Vida do inimigo
        <select id="rv-vida">
          <option value="numero">o número exato (41/60)</option>
          <option value="estado">só o estado (Ferido, Grave…)</option>
          <option value="nada">nada além da cor do retrato</option>
        </select>
      </label>
      <label class="chk"><input type="checkbox" id="rv-stats" /> mostrar ataque, dano, defesa e absorção</label>
      <label class="chk"><input type="checkbox" id="rv-cond" /> mostrar as condições (cego, sangrando, caído…)</label>
      <p class="muted dlg-txt">O retrato escurece sozinho a partir da metade da Vida, de âmbar a vermelho,
        em qualquer um dos três modos. Um inimigo específico pode fugir da regra pelo <strong>✎</strong> dele.</p>
      <div class="dlg-btns">
        <button type="button" class="btn" id="rv-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="rv-salvar">Salvar</button>
      </div>
    </form>
  </dialog>

  <dialog id="enc-dlg" class="mesa-dlg dlg-larga">
    <form method="dialog">
      <h3>Encontros da mesa</h3>
      <div class="enc-novo-linha">
        <input type="text" id="enc-novo-nome" placeholder="Nome do encontro" />
        <button type="button" class="btn mini" id="enc-novo-prep">Preparar</button>
        <button type="button" class="btn mini primary" id="enc-novo-agora">Iniciar agora</button>
      </div>
      <div id="enc-lista" class="enc-lista"></div>
      <div class="dlg-btns"><button type="button" class="btn" id="enc-fechar">Fechar</button></div>
    </form>
  </dialog>
</Base>

<style is:global>
  /* ---------------- barra do encontro ---------------- */
  .enc-barra { display: flex; align-items: center; gap: .2rem .35rem; flex-wrap: wrap;
    border: 1px solid var(--rule); border-radius: var(--r-lg);
    background: var(--panel); padding: .3rem .6rem; margin-bottom: .45rem; }
  .enc-id { display: inline-flex; align-items: baseline; gap: .45rem; flex-wrap: wrap; min-width: 0; margin-right: .3rem; }
  .enc-rot { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .06em; color: var(--ink-soft); }
  .enc-id strong { font-size: var(--fs-aux); }
  .enc-relogio { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--accent-texto);
    font-variant-numeric: tabular-nums; }
  .enc-btns { display: inline-flex; gap: .3rem; flex-wrap: wrap; }
  .enc-add { display: inline-flex; gap: .3rem; flex-wrap: wrap; align-items: center; }
  .enc-barra .espaco { flex: 1 1 auto; }
  .enc-add .sep-v { width: 1px; height: 1.1rem; background: var(--rule); margin: 0 .15rem; }
  .mini-chk { display: inline-flex; align-items: center; gap: .3rem; font-size: var(--fs-micro); color: var(--ink-soft); }

  /* ---------------- grade ----------------
     A coluna lateral é GRUDADA: num notebook a lista de combatentes passa da
     altura da tela, e o painel de quem age não pode sumir junto com ela. */
  .cmb-grade { display: grid; grid-template-columns: minmax(0, 1fr) 21rem; gap: .9rem; align-items: start; }
  .cmb-col-lado { position: sticky; top: calc(var(--mesa-barra-h, 66px) + .4rem); }
  /* Numa coluna só, o painel de quem age tem de vir ANTES da lista: no celular
     o mestre olha primeiro "de quem é a vez", e rolar até o fim para descobrir
     isso é o oposto do que a página promete. O `display: contents` dissolve a
     coluna lateral para os dois blocos entrarem na grade e poderem ser ordenados. */
  @media (max-width: 1180px) {
    .cmb-grade { grid-template-columns: 1fr; }
    .cmb-col-lado { display: contents; position: static; }
    .painel-turno { order: -1; position: sticky; top: calc(var(--mesa-barra-h, 66px) + .3rem); z-index: 20; }
    .cmb-col-ordem { order: 0; }
    .log-caixa { order: 1; }
  }
  /* Duas colunas de lista foram medidas e DESCARTADAS: numa tela de 1920 cada
     coluna fica com ~700px, o miolo do card quebra em duas faixas e o card sobe
     de 101px para 126px. Resultado: 6 combatentes visíveis contra 8 em coluna
     única. Só compensaria acima de ~1950px, que é fora do alvo (13" a 17"). */
  @media (min-width: 1750px) { .cmb-grade { grid-template-columns: minmax(0, 1fr) 23rem; } }
  .col-h { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .07em;
    color: var(--ink-soft); margin: 0 0 .3rem; border-bottom: 1px solid var(--rule); padding-bottom: .15rem; }
  .col-h-fora { margin-top: .8rem; }
  .cmb-lista { display: flex; flex-direction: column; gap: .4rem; }
  .cmb-lista-fora { opacity: .72; }

  /* ---------------- card do combatente ---------------- */
  /* Flex e não grade: o card tem um número variável de faixas (barras, stats,
     condições, nota), e com `grid-row: span N` no avatar as que faltam ou sobram
     empurram as outras para cima da linha de botões. */
  .cbt { display: flex; align-items: flex-start; gap: .55rem;
    border: 1px solid var(--rule); border-left: 4px solid var(--rule); border-radius: var(--r-lg);
    background: var(--panel); padding: .38rem .55rem; position: relative; }
  .cbt.g-aliado  { border-left-color: var(--accent); }
  .cbt.g-inimigo { border-left-color: #c1352c; }
  .cbt.g-neutro  { border-left-color: var(--gold); }
  .cbt.atual { box-shadow: 0 0 0 2px var(--accent), 0 6px 20px rgba(0,0,0,.18);
    background: color-mix(in srgb, var(--accent) 7%, var(--panel)); }
  .cbt.fora { filter: grayscale(.6); }
  .cbt.oculto { border-style: dashed; }
  .cbt-tick { flex: 0 0 2rem; align-self: center; text-align: center; font-family: 'Cinzel';
    font-weight: 700; font-size: var(--fs-aux); color: var(--accent-texto); font-variant-numeric: tabular-nums; line-height: 1.05; }
  .cbt.atual .cbt-tick { font-size: var(--fs-h3); }
  .cbt-tick small { display: block; font-size: calc(var(--fs-micro) * .85); font-weight: 400; color: var(--ink-soft); letter-spacing: .04em; }
  .cbt-av { flex: 0 0 auto; position: relative; }
  .cbt-av .av { --av-t: 2.7rem; }
  .cbt.atual .cbt-av .av { --av-t: 3.6rem; box-shadow: 0 0 0 2px var(--accent); }
  .cbt-olho { position: absolute; right: -.2rem; bottom: -.2rem; font-size: .65rem; background: var(--panel);
    border: 1px solid var(--rule); border-radius: 50%; width: 1.1rem; height: 1.1rem; display: grid; place-items: center; }
  .cbt-corpo { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .16rem; }
  .cbt-topo { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; min-width: 0; }
  /* Barras e números na mesma faixa: são as duas coisas que o mestre lê de
     relance, e lado a lado economizam uma linha por combatente. */
  .cbt-meio { display: flex; align-items: center; gap: .25rem .9rem; flex-wrap: wrap; }
  .cbt-meio .cbt-barras { flex: 1 1 20rem; }
  .cbt-meio .cbt-stats { flex: 1 1 16rem; }
  .cbt-nome { font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-aux); line-height: 1.15; }
  .cbt.atual .cbt-nome { font-size: var(--fs-h3); color: var(--accent-texto); }
  .cbt-meta { font-size: var(--fs-micro); color: var(--ink-soft); }
  .cbt-rev { font-size: calc(var(--fs-micro) * .9); padding: .02rem .35rem; border-radius: 999px;
    background: color-mix(in srgb, var(--gold) 26%, transparent); white-space: nowrap; cursor: help; }
  /* Vida e Energia lado a lado, e não empilhadas: é uma faixa de 20px a menos
     por combatente, o que numa tela de 720px vale um card inteiro. */
  .cbt-barras { display: flex; flex-flow: row wrap; gap: .25rem .4rem; max-width: 34rem; }
  .cbt-linha { display: flex; align-items: center; gap: .3rem; flex: 1 1 11rem; min-width: 9rem; }
  .cbt-stats { font-size: var(--fs-micro); }
  .cbt-acoes { display: flex; gap: .2rem; flex-wrap: wrap; align-items: center; margin-top: .1rem; }
  .cbt-acoes .hp-amt { width: 2.9rem; padding: .12rem .25rem; }
  .cbt-acoes .btn.mini { padding: .12rem .45rem; }
  .cbt-acoes .hp-tipo { font-size: var(--fs-micro); padding: .15rem .2rem; }
  .cbt-acoes .btn.agir { border-color: var(--accent); color: var(--accent-texto); font-weight: 700; }
  .cbt-acoes .btn.agir:hover { background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .hp-fb { font-size: var(--fs-micro); font-weight: 700; font-variant-numeric: tabular-nums;
    color: var(--accent-strong); opacity: 0; transform: translateY(.2rem); transition: opacity .2s, transform .2s; }
  .hp-fb.mostra { opacity: 1; transform: translateY(0); }
  .cbt-nota { font-size: var(--fs-micro); font-style: italic; color: var(--ink-soft); }

  /* ---------------- painel do turno ---------------- */
  .painel-turno { border: 1px solid var(--accent); border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--accent) 8%, var(--panel)); padding: .55rem .75rem; margin-bottom: .6rem; }
  .painel-turno h3 { margin: 0 0 .3rem; font-family: 'Cinzel'; font-size: var(--fs-micro);
    text-transform: uppercase; letter-spacing: .07em; color: var(--accent-strong); }
  .pt-quem { display: flex; align-items: center; gap: .6rem; margin-bottom: .5rem; }
  .pt-quem .av { --av-t: 3rem; }
  .pt-nome { font-family: 'Cinzel'; font-size: var(--fs-h3); line-height: 1.1; }
  .pt-sub { font-size: var(--fs-micro); color: var(--ink-soft); }
  .pt-stats { display: flex; flex-direction: column; gap: .15rem; font-size: var(--fs-micro); margin-bottom: .5rem; }
  .pt-stats b { color: var(--accent-strong); font-family: 'Cinzel'; font-weight: 700; }
  .pt-btns { display: flex; gap: .3rem; flex-wrap: wrap; }
  .pt-prox { margin-top: .55rem; padding-top: .5rem; border-top: 1px dotted var(--rule);
    font-size: var(--fs-micro); color: var(--ink-soft); }
  .pt-prox .av { --av-t: 1.6rem; vertical-align: middle; }

  /* ---------------- log ---------------- */
  .log-caixa { border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); padding: .6rem .75rem; }
  .log-cab { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
  .log-cab .col-h { border: none; margin: 0; padding: 0; }
  .log-add { display: inline-flex; gap: .25rem; }
  .log-add input { min-width: 8rem; font-size: var(--fs-micro); padding: .15rem .35rem; }
  /* O registro come o que sobrar da altura da janela e nada mais: sem o teto
     calculado ele empurrava o painel grudado para fora da tela num notebook. */
  .cmb-log { display: flex; flex-direction: column; gap: .05rem; margin-top: .35rem; overflow-y: auto;
    max-height: clamp(8rem, calc(100vh - var(--mesa-barra-h, 66px) - 22rem), 26rem); }
  .log-linha { display: flex; align-items: baseline; gap: .4rem; padding: .18rem .1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 55%, transparent); font-size: var(--fs-micro); }
  .log-linha:last-child { border-bottom: none; }
  .log-hora { font-variant-numeric: tabular-nums; color: var(--ink-soft); flex-shrink: 0; }
  .log-so { flex-shrink: 0; font-size: .8em; opacity: .7; cursor: help; }
  .log-txt { flex: 1; min-width: 0; }
  .log-linha.l-dano .log-txt { color: var(--perigo); }
  .log-linha.l-cura .log-txt { color: var(--ok); }
  .log-linha.l-sistema .log-txt { color: var(--ink-soft); font-style: italic; }
  .log-inp { flex: 1; font: inherit; font-size: var(--fs-micro); padding: .1rem .3rem;
    border: 1px solid var(--accent); border-radius: var(--r-sm); background: var(--bg); color: var(--ink); }
  .log-edit, .log-del { background: none; border: none; cursor: pointer; padding: 0 .15rem;
    font-size: var(--fs-micro); line-height: 1; opacity: 0; transition: opacity .15s; flex-shrink: 0; }
  .log-linha:hover .log-edit, .log-linha:hover .log-del { opacity: .65; }
  .log-edit:hover, .log-del:hover { opacity: 1; }
  .log-del { color: var(--perigo); }

  /* ---------------- diálogos do combate ---------------- */
  .acao-conta { font-size: var(--fs-micro); background: var(--panel-2); border: 1px dotted var(--rule);
    border-radius: var(--r-md); padding: .45rem .6rem; line-height: 1.5; }
  .acao-conta b { color: var(--accent-strong); font-variant-numeric: tabular-nums; }
  .acao-conta .ok { color: var(--ok); font-weight: 700; }
  .acao-conta .ruim { color: var(--perigo); font-weight: 700; }
  .acao-rolar { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .acao-res { font-size: var(--fs-micro); font-variant-numeric: tabular-nums; }
  .mesa-dlg label.chk { flex-direction: row; align-items: center; gap: .4rem; text-transform: none; }
  .dlg-txt { font-size: var(--fs-rotulo); margin: 0; }
  .cond-catalogo { display: flex; flex-direction: column; gap: .5rem; max-height: 40vh; overflow-y: auto;
    border: 1px solid var(--rule); border-radius: var(--r-md); padding: .5rem; }
  .cond-grupo-t { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .05em; color: var(--accent-strong); margin-bottom: .2rem; }
  .cond-grupo .conds .cond { cursor: pointer; }
  .cond-grupo .conds .cond:hover { outline: 1px solid var(--accent); }
  .cond-ativas { min-height: 1.6rem; padding: .35rem; border: 1px dashed var(--rule); border-radius: var(--r-md); }
  .cond-custom summary { cursor: pointer; font-size: var(--fs-micro); color: var(--accent-texto); font-family: 'Cinzel'; }
  .cond-custom > * + * { margin-top: .4rem; }
  .add-lista { display: flex; flex-direction: column; gap: .1rem; max-height: 40vh; overflow-y: auto;
    border: 1px solid var(--rule); border-radius: var(--r-md); }
  .add-item { display: flex; align-items: center; gap: .5rem; padding: .3rem .5rem; cursor: pointer; }
  .add-item:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .add-item.sel { background: color-mix(in srgb, var(--accent) 22%, transparent); }
  .add-item .av { --av-t: 2rem; }
  .add-item .ai-n { flex: 1; font-size: var(--fs-rotulo); }
  .add-item .ai-m { font-size: var(--fs-micro); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .enc-novo-linha { display: flex; gap: .35rem; flex-wrap: wrap; }
  .enc-novo-linha input { flex: 1; min-width: 10rem; }
  .enc-lista { display: flex; flex-direction: column; gap: .3rem; max-height: 40vh; overflow-y: auto; }
  .enc-item { display: flex; align-items: center; gap: .5rem; padding: .35rem .5rem;
    border: 1px solid var(--rule); border-radius: var(--r-md); }
  .enc-item .ei-n { flex: 1; font-size: var(--fs-rotulo); }
  .enc-item .ei-e { font-size: var(--fs-micro); padding: .05rem .4rem; border-radius: 999px; }
  .ei-e.e-ativo { background: color-mix(in srgb, var(--accent) 26%, transparent); }
  .ei-e.e-preparado { background: color-mix(in srgb, var(--gold) 26%, transparent); }
  .ei-e.e-encerrado { background: color-mix(in srgb, var(--ink) 12%, transparent); }
</style>

<script>
  import {
    abrirMesa, u, esc, norm, sinal, avatarHTML, urlsImagens, hpBarHTML, hpBarPctHTML, atualizarBarra,
    tierDe, pctDe, condChipHTML, somarCondicoes, COND, COND_LISTA, COND_GRUPOS, novoId, bancoAntigo,
    revelarDaMesa, REVELAR_PADRAO, semMigracao14,
  } from '../../lib/mesa-core';
  import type { Condicao, NivelVida, Revelar } from '../../lib/mesa-core';
  import { MON, MON_LIST, cardCriaturaHTML, resumoDe, iniDeMonstro, d6 } from '../../lib/mesa-bestiario';
  import { rolarIniciativaPC } from '../../lib/mesa-ficha';
  import { pv as pvDe } from '../../lib/calc';
  import { uiConfirmar, uiErro, uiPerguntar } from '../../lib/ui-dialog';

  const el = (i: string) => document.getElementById(i)!;
  const CAT_SOAK: Record<string, 'impacto' | 'corte' | 'perfuracao'> = { impacto: 'impacto', corte: 'corte', perfurante: 'perfuracao' };
  const TIPO_LBL: Record<string, string> = { impacto: 'Impacto', corte: 'Cortante', perfurante: 'Perfurante' };
  const GRUPO_LBL: Record<string, string> = { aliado: 'Aliado', inimigo: 'Inimigo', neutro: 'Neutro' };

  // ---- estado da página ----
  let SB: any, MESA_ID = '', EH_MESTRE = false, MESA: any = null;
  let REV: Revelar = { ...REVELAR_PADRAO };
  // O jogador lê pela view `combate_visao`, que já desce mascarada. Quando o
  // banco ainda não tem a migração 14 isto cai para false e a máscara passa a
  // ser só de tela: o que muda é a honestidade da coisa, não o desenho.
  let PELA_VISTA = false;
  let ENC: any = null;
  let COMBS: any[] = [];
  let FICHAS: Record<string, any> = {};
  let IMGS: Record<string, string> = {};
  let RESUMO: Record<string, any> = {};
  let LOG: any[] = [];
  let VER_OCULTOS = true;
  const DESFAZER: { rotulo: string; volta: () => Promise<void> }[] = [];

  /**
   * Atualiza um combatente tolerando banco sem a migração 11: se o Postgres
   * reclamar de uma coluna, ela sai do pacote e a gravação segue com o resto.
   */
  async function upComb(cid: string, cols: Record<string, any>): Promise<any> {
    const { error } = await SB.from('combatentes').update(cols).eq('id', cid);
    if (error) {
      const m = /column "?([a-z_]+)"?/i.exec(error.message || '');
      if (m && m[1] in cols) { const c2 = { ...cols }; delete c2[m[1]]; return upComb(cid, c2); }
    }
    return { error };
  }
  async function insComb(linhas: Record<string, any>[]): Promise<any> {
    const { error } = await SB.from('combatentes').insert(linhas);
    if (error) {
      const m = /column "?([a-z_]+)"?/i.exec(error.message || '');
      if (m && linhas[0] && m[1] in linhas[0]) {
        return insComb(linhas.map((l) => { const c = { ...l }; delete c[m[1]]; return c; }));
      }
    }
    return { error };
  }

  // ================================================================ carregar
  async function main() {
    const ctx = await abrirMesa('combate');
    if (!ctx) return;
    SB = ctx.sb; MESA_ID = ctx.id; EH_MESTRE = ctx.ehMestre; MESA = ctx.mesa;
    REV = revelarDaMesa(MESA);
    await carregar();
    // O jogador não recebe eventos do banco; um pulso de oito segundos mantém a
    // tela dele perto da verdade sem transformar a página num relógio.
    if (!EH_MESTRE) setInterval(() => carregar(true), 8000);
  }

  async function carregar(silencioso = false) {
    // O log mora numa coluna de `encontros`, e o log conta tudo. Para o jogador
    // o encontro também vem por uma view, que entrega só as linhas com redação
    // pública.
    const buscarEnc = (t: string) => SB.from(t).select('*').eq('mesa_id', MESA_ID)
      .eq('ativo', true).order('criado_em', { ascending: false }).limit(1);
    let { data: encs, error } = await buscarEnc(EH_MESTRE ? 'encontros' : 'encontro_visao');
    if (error && !EH_MESTRE && semMigracao14(error)) ({ data: encs, error } = await buscarEnc('encontros'));
    if (error) { el('enc-vazio').hidden = false; el('enc-vazio').innerHTML = `<p class="erro">${esc(error.message)}</p>`; return; }
    ENC = (encs || [])[0] || null;
    if (!ENC) return semEncontro();

    el('enc-vazio').hidden = true;
    el('enc-tudo').hidden = false;

    COMBS = await lerCombatentes();
    LOG = Array.isArray(ENC.log) ? ENC.log.slice() : [];

    // Fichas dos PCs em campo: a base dos números que o rastreador mostra.
    const pcIds = [...new Set(COMBS.filter((c) => c.tipo === 'pc' && c.personagem_id).map((c) => c.personagem_id))];
    if (pcIds.length) {
      const { data: fichas } = await SB.from('personagens').select('id, ficha, imagem_path').in('id', pcIds);
      FICHAS = Object.fromEntries((fichas || []).map((f: any) => [f.id, f.ficha]));
      const caminhos = (fichas || []).map((f: any) => f.imagem_path).filter(Boolean);
      const m1 = await urlsImagens(SB, caminhos, 'personagens');
      for (const f of fichas || []) if (f.imagem_path && m1[f.imagem_path]) IMGS['pc:' + f.id] = m1[f.imagem_path];
    }
    const proprias = COMBS.map((c) => c.imagem).filter(Boolean);
    if (proprias.length) {
      const m2 = await urlsImagens(SB, proprias, 'mesa');
      for (const c of COMBS) if (c.imagem && m2[c.imagem]) IMGS['own:' + c.id] = m2[c.imagem];
    }

    // O resumo NÃO é montado para quem está com os números escondidos. Ele sai
    // do `monsters.json`, que mora no próprio bundle: se eu montasse e só
    // deixasse de desenhar, o bloco de combate do inimigo estaria no
    // navegador do jogador, a um `console.log` de distância.
    RESUMO = {};
    for (const c of COMBS) {
      if (!verStats(c)) continue;
      const r = resumoDe(c, FICHAS); if (r) RESUMO[c.id] = r;
    }

    pintar();
    if (!silencioso) ligarBarra();
  }

  /**
   * Lê os combatentes pelo caminho certo para quem está olhando.
   *
   * Mestre lê a tabela (precisa escrever nela). Jogador lê a view, que devolve
   * a linha já sem a Vida, sem os números e sem as notas do mestre quando a
   * mesa mandou esconder. É a diferença entre não desenhar e não enviar.
   */
  async function lerCombatentes(): Promise<any[]> {
    if (EH_MESTRE) {
      const { data } = await SB.from('combatentes').select('*').eq('encontro_id', ENC.id);
      return data || [];
    }
    const { data, error } = await SB.from('combate_visao').select('*').eq('encontro_id', ENC.id);
    if (!error) { PELA_VISTA = true; return data || []; }
    if (!semMigracao14(error)) { PELA_VISTA = false; return []; }
    PELA_VISTA = false;
    const r = await SB.from('combatentes').select('*').eq('encontro_id', ENC.id);
    return r.data || [];
  }

  // ------------------------------------------------------- o que se revela
  // Duas perguntas diferentes, e confundi-las é o bug clássico daqui: "o que a
  // mesa mostra deste combatente" (a regra, do ponto de vista do jogador) e "o
  // que ESTA tela desenha" (que para o mestre é sempre tudo). O registro
  // precisa da primeira mesmo estando na tela do mestre, porque ele escreve a
  // linha que o jogador vai ler.
  /** A regra, do ponto de vista do jogador. */
  function revelaVida(c: any): NivelVida {
    if (c.tipo === 'pc') return 'numero';
    return (c.revelar?.vida as NivelVida) || REV.vidaInimigo;
  }
  function revelaStats(c: any): boolean {
    if (c.tipo === 'pc') return true;
    if (c.revelar?.stats != null) return !!c.revelar.stats;
    return REV.statsInimigo;
  }
  /** O que esta tela desenha. O jogador já recebeu a linha mascarada. */
  const verVida = (c: any): NivelVida =>
    EH_MESTRE ? 'numero' : ((c.ver_vida as NivelVida) || revelaVida(c));
  const verStats = (c: any): boolean =>
    EH_MESTRE ? true : (c.ver_stats != null ? !!c.ver_stats : revelaStats(c));
  /** Vida restante em porcentagem, que é o que pinta o retrato. */
  function pctVida(c: any): number | null {
    if (c.pv_pct != null) return c.pv_pct;
    if (c.pv_max == null || c.pv_max <= 0 || c.pv_atual == null) return null;
    return pctDe(c.pv_atual, c.pv_max);
  }

  function semEncontro() {
    el('enc-tudo').hidden = true;
    const vazio = el('enc-vazio'); vazio.hidden = false;
    vazio.innerHTML = EH_MESTRE
      ? `<div class="painel"><p class="vazio">Nenhum combate em andamento.</p>
         <div class="bloco-acoes"><button class="btn primary" id="ini-agora">Iniciar um encontro</button>
         <button class="btn" id="ini-lista">Ver encontros preparados</button></div></div>`
      : '<div class="painel"><p class="vazio">Sem combate ativo. O mestre avisa quando começar.</p></div>';
    if (!EH_MESTRE) return;
    el('ini-agora').onclick = async () => {
      const nome = await uiPerguntar('Nome do encontro', 'Encontro', { titulo: 'Iniciar encontro', ok: 'Iniciar' });
      if (nome === null) return;
      await criarEncontro(nome.trim() || 'Encontro', true);
    };
    el('ini-lista').onclick = () => abrirEncontros();
  }

  async function criarEncontro(nome: string, ativar: boolean) {
    if (ativar) await SB.from('encontros').update({ ativo: false, estado: 'encerrado' }).eq('mesa_id', MESA_ID).eq('ativo', true);
    const linha: any = { mesa_id: MESA_ID, nome, ativo: ativar, estado: ativar ? 'ativo' : 'preparado' };
    let { error } = await SB.from('encontros').insert(linha);
    if (error && /estado/i.test(error.message)) { delete linha.estado; ({ error } = await SB.from('encontros').insert(linha)); }
    if (error) return uiErro('Erro: ' + error.message);
    await carregar();
  }

  // ================================================================== pintar
  const avatarDe = (c: any) => {
    const src = IMGS['own:' + c.id]
      || (c.tipo === 'pc' ? IMGS['pc:' + c.personagem_id] : null)
      || (c.tipo === 'criatura' && MON[c.monstro_id]?.imagem ? u(MON[c.monstro_id].imagem) : null);
    const cls = c.tipo === 'criatura' && !IMGS['own:' + c.id] ? 'av-besta' : '';
    return avatarHTML(c.nome, src, cls, pctVida(c));
  };

  /** Condições: o mestre vê sempre; o jogador vê se a mesa deixar. */
  const verCondJogador = (c: any) => c.tipo === 'pc' || REV.condInimigo;
  const verCond = (c: any) => EH_MESTRE || verCondJogador(c);
  const condsDe = (c: any): Condicao[] =>
    (Array.isArray(c.condicoes) ? c.condicoes : []).map((k: any) => ({ ...(COND[k.id] || {}), ...k }));

  /** Defesa que vale AGORA: base do bloco + ferimento + condições. */
  function defesaAtual(c: any, alcance: 'cac' | 'dist' = 'cac') {
    const base = RESUMO[c.id]?.defesa ?? null;
    if (base == null) return null;
    const ferimento = tierDe(c.pv_atual, c.pv_max).penDefesa ?? 0;
    const cd = somarCondicoes(condsDe(c));
    const cond = alcance === 'dist' ? cd.defesaDist : cd.defesaCaC;
    return { base, ferimento, cond, total: base + ferimento + cond };
  }

  /** Ajustes que entram na jogada de acerto de quem está agindo. */
  function ataqueAtual(c: any) {
    const ferimento = tierDe(c.pv_atual, c.pv_max).penAcao ?? 0;
    const cd = somarCondicoes(condsDe(c));
    return { ferimento, acao: cd.acao, ataque: cd.ataque, dados: cd.dados, flat: ferimento + cd.acao + cd.ataque };
  }

  const ordenar = (a: any, b: any) => (a.tick - b.tick) || ((b.iniciativa || 0) - (a.iniciativa || 0)) || String(a.nome).localeCompare(String(b.nome));

  function visiveis() {
    return COMBS.filter((c) => (EH_MESTRE ? (VER_OCULTOS || !c.oculto) : !c.oculto));
  }

  function pintar() {
    const emCampo = visiveis().filter((c) => c.ativo !== false).sort(ordenar);
    const fora = visiveis().filter((c) => c.ativo === false).sort(ordenar);
    const atual = emCampo[0] || null;

    el('enc-nome').textContent = ENC.nome;
    const tick = atual?.tick ?? 0;
    el('enc-rodada').textContent = `Rodada ${Math.floor(tick / 6) + 1}`;
    el('enc-tick').textContent = `Tick ${tick}`;

    el('cmb-lista').innerHTML = emCampo.length
      ? emCampo.map((c, i) => cardCombatente(c, i === 0)).join('')
      : '<p class="vazio">Ninguém em campo. Adicione personagens e criaturas.</p>';
    el('cmb-fora-wrap').hidden = !fora.length;
    el('cmb-fora').innerHTML = fora.map((c) => cardCombatente(c, false)).join('');

    pintarPainel(atual, emCampo);
    pintarLog();
    ligarCards();
  }

  function cardCombatente(c: any, atual: boolean) {
    const r = RESUMO[c.id];
    const mostra = verStats(c);
    const vida = verVida(c);
    const pct = pctVida(c);
    const conds = verCond(c) ? condsDe(c) : [];
    const def = defesaAtual(c);
    const tipoTxt = c.tipo === 'pc' ? 'PC' : c.tipo === 'criatura' ? (MON[c.monstro_id]?.nome || 'Criatura') : 'NPC';
    const stats = (mostra && r) ? `<div class="cbt-stats pilha">
      ${r.ataque ? `<span class="pl"><span class="pl-l">Atq</span><span class="pl-v">${esc(r.ataque)}</span></span>` : ''}
      ${r.dano ? `<span class="pl"><span class="pl-l">Dano</span><span class="pl-v">${esc(r.dano)}</span></span>` : ''}
      ${def ? `<span class="pl" title="base ${def.base}${def.ferimento ? ` · ferimento ${def.ferimento}` : ''}${def.cond ? ` · condições ${sinal(def.cond)}` : ''}"><span class="pl-l">Def</span><span class="pl-v">${def.total}${def.total !== def.base ? '*' : ''}</span></span>` : ''}
      ${r.defesaSocial != null ? `<span class="pl"><span class="pl-l">Soc</span><span class="pl-v">${r.defesaSocial}</span></span>` : ''}
      ${r.defesaMental != null ? `<span class="pl"><span class="pl-l">Men</span><span class="pl-v">${r.defesaMental}</span></span>` : ''}
      <span class="pl"><span class="pl-l">Abs</span><span class="pl-v">${r.soak.impacto}/${r.soak.corte}/${r.soak.perfuracao}${r.resistPerf ? `·N${r.resistPerf}` : ''}</span></span>
    </div>` : '';
    // Três barras possíveis: a com número, a cega (largura e palavra, sem
    // conta) e nenhuma, quando só a cor do retrato conta a história.
    const barras = vida === 'numero'
      ? (c.pv_max != null ? `<div class="cbt-barras">
          <div class="cbt-linha">${hpBarHTML(c.pv_atual, c.pv_max, c.id)}<span class="hp-fb" data-c="${c.id}"></span></div>
          ${c.energia_max ? `<div class="cbt-linha"><div class="hpbar mini enbar"><div class="hpbar-fill" style="width:${Math.max(0, Math.min(100, ((c.energia_atual ?? 0) / c.energia_max) * 100))}%"></div><span class="hpbar-txt">En ${c.energia_atual ?? 0}<span class="hp-sep">/</span>${c.energia_max}</span></div></div>` : ''}
        </div>` : '')
      : vida === 'estado' && pct != null
        ? `<div class="cbt-barras"><div class="cbt-linha">${hpBarPctHTML(pct)}</div></div>`
        : '';
    const acoes = EH_MESTRE ? `<div class="cbt-acoes">
      <button class="btn mini agir" data-c="${c.id}">agir ▸</button>
      <input type="number" class="hp-amt" data-c="${c.id}" min="1" value="5" title="Quantidade" aria-label="Quantidade" />
      <select class="hp-tipo" data-c="${c.id}" title="Tipo de dano"><option value="impacto">I</option><option value="corte">C</option><option value="perfurante">P</option></select>
      <button class="btn mini perigo hp-dano" data-c="${c.id}" title="Aplicar dano abatendo a Absorção">−</button>
      <button class="btn mini ok hp-cura" data-c="${c.id}" title="Curar">＋</button>
      <button class="btn-fant cond-btn" data-c="${c.id}" title="Condições">✚cond</button>
      <button class="btn-fant editc" data-c="${c.id}" title="Editar">✎</button>
      <button class="btn-fant olho" data-c="${c.id}" title="${c.oculto ? 'Revelar aos jogadores' : 'Esconder dos jogadores'}">${c.oculto ? '🙈' : '👁'}</button>
      <button class="btn-fant fora-btn" data-c="${c.id}" title="${c.ativo === false ? 'Voltar ao combate' : 'Tirar de combate'}">${c.ativo === false ? '↩' : '⏏'}</button>
      ${c.tipo === 'criatura' ? `<button class="btn-fant ver-card" data-mon="${esc(c.monstro_id || '')}" title="Ver o card completo">☰</button>` : ''}
      <button class="btn-fant perigo rm" data-c="${c.id}" title="Remover do encontro">✕</button>
    </div>` : '';
    return `<div class="cbt g-${esc(c.grupo || 'inimigo')}${atual ? ' atual' : ''}${c.ativo === false ? ' fora' : ''}${c.oculto ? ' oculto' : ''}" data-c="${c.id}">
      <div class="cbt-tick">${c.tick}<small>tick</small></div>
      <div class="cbt-av">${avatarDe(c)}${c.oculto ? '<span class="cbt-olho" title="Oculto">🙈</span>' : ''}</div>
      <div class="cbt-corpo">
        <div class="cbt-topo">
          <span class="cbt-nome">${esc(c.nome)}</span>
          <span class="cbt-meta">${esc(tipoTxt)} · ini ${c.iniciativa ?? 0} · ${GRUPO_LBL[c.grupo] || 'Inimigo'}</span>
          ${(EH_MESTRE && c.revelar && (c.revelar.vida || c.revelar.stats != null))
            ? `<span class="cbt-rev" title="Este foge da regra da mesa: vida ${esc(c.revelar.vida || 'padrão')}, números ${c.revelar.stats == null ? 'padrão' : (c.revelar.stats ? 'à vista' : 'escondidos')}">👁 exceção</span>` : ''}
          ${conds.length ? `<span class="conds">${conds.map((x) => condChipHTML(x, EH_MESTRE, c.id)).join('')}</span>` : ''}
        </div>
        <div class="cbt-meio">${barras}${stats}</div>
        ${acoes}
        ${(EH_MESTRE && c.notas) ? `<div class="cbt-nota">${esc(c.notas)}</div>` : ''}
      </div>
    </div>`;
  }

  function pintarPainel(atual: any, fila: any[]) {
    const box = el('painel-turno');
    if (!atual) { box.innerHTML = '<h3>Vez de</h3><p class="vazio">ninguém em campo</p>'; return; }
    const r = RESUMO[atual.id];
    // Sem a Vida, `tierDe(null, null)` responderia "Saudável", que é pior do
    // que não responder: o painel diria que o carrasco está inteiro. Com a
    // Vida escondida, o estado vem da porcentagem.
    const pct = pctVida(atual);
    const t = verVida(atual) === 'numero' ? tierDe(atual.pv_atual, atual.pv_max)
      : pct != null ? tierDe(pct, 100) : null;
    const a = ataqueAtual(atual);
    const cd = somarCondicoes(verCond(atual) ? condsDe(atual) : []);
    const prox = fila.slice(1, 4);
    box.innerHTML = `<h3>Vez de</h3>
      <div class="pt-quem">${avatarDe(atual)}
        <div><div class="pt-nome">${esc(atual.nome)}</div>
          <div class="pt-sub">tick ${atual.tick}${t ? ' · ' + esc(t.estado) : ''}${GRUPO_LBL[atual.grupo] ? ' · ' + GRUPO_LBL[atual.grupo] : ''}</div></div>
      </div>
      <div class="pt-stats">
        ${r?.ataque ? `<div><b>Acerto</b> ${esc(r.ataque)}${a.flat ? ` <span class="ruim">${sinal(a.flat)}</span>` : ''}${a.dados ? ` <span class="ruim">${sinal(a.dados)}d6</span>` : ''}</div>` : ''}
        ${r?.dano ? `<div><b>Dano</b> ${esc(r.dano)}</div>` : ''}
        ${r ? `<div><b>Absorve</b> I ${r.soak.impacto} · C ${r.soak.corte} · P ${r.soak.perfuracao}${r.resistPerf ? ` · gate N${r.resistPerf}` : ''}</div>` : ''}
        ${cd.porRodada ? `<div><b>Por rodada</b> <span class="ruim">−${cd.porRodada}</span> ao agir</div>` : ''}
        ${a.ferimento ? `<div><b>Ferimento</b> ${sinal(a.ferimento)} em ações</div>` : ''}
      </div>
      ${EH_MESTRE ? `<div class="pt-btns">
        <button class="btn primary mini agir" data-c="${atual.id}">Resolver ação</button>
        <button class="btn mini" id="pt-esperar" data-c="${atual.id}">Esperar 1 tick</button>
      </div>` : ''}
      ${prox.length ? `<div class="pt-prox">A seguir: ${prox.map((c) => `${avatarDe(c).replace('class="av', 'class="av av-p')} ${esc(c.nome)} <small>(t${c.tick})</small>`).join(' · ')}</div>` : ''}`;
    if (EH_MESTRE) {
      box.querySelector<HTMLElement>('.agir')?.addEventListener('click', () => abrirAcao(atual.id));
      el('pt-esperar')?.addEventListener('click', () => avancarTick(atual.id, 1, `${atual.nome} esperou 1 tick.`));
    }
  }

  // ==================================================================== log
  const fmtHora = (ts: string) => { try { return new Date(ts).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }); } catch { return ''; } };
  const persistLog = async () => { try { await SB.from('encontros').update({ log: LOG }).eq('id', ENC.id); } catch {} };
  /**
   * Escreve no registro em duas redações.
   *
   * `txt` é a do mestre, com tudo. `pub` é a que o jogador lê: por padrão a
   * mesma, `null` quando a linha é assunto interno (um ajuste de bloco, uma
   * emboscada entrando em campo). Sem isso o card escondia a Vida e a linha de
   * baixo do registro entregava, o que é o pior tipo de vazamento: o que está
   * escrito na tela.
   */
  async function logar(txt: string, classe = '', pub: string | null = txt) {
    LOG.push({ id: novoId(), ts: new Date().toISOString(), txt, cl: classe, pub });
    if (LOG.length > 400) LOG = LOG.slice(-400);
    pintarLog();
    await persistLog();
  }

  /** Como esta mudança de Vida se conta em voz alta, para quem não vê a ficha. */
  function fraseVida(c: any, corpo: string) {
    const vida = revelaVida(c);
    if (vida === 'numero') return `${corpo} · ${c.pv_atual}/${c.pv_max} (${tierDe(c.pv_atual, c.pv_max).estado}).`;
    if (vida === 'estado' && c.pv_max > 0) return `${corpo} · ${tierDe(c.pv_atual, c.pv_max).estado}.`;
    return `${corpo}.`;
  }
  function pintarLog() {
    const box = el('cmb-log');
    if (!LOG.length) { box.innerHTML = '<p class="vazio">Nada registrado ainda.</p>'; return; }
    box.innerHTML = LOG.slice().reverse().map((e: any) => `<div class="log-linha ${e.cl ? 'l-' + esc(e.cl) : ''}">
      <span class="log-hora">${fmtHora(e.ts)}</span>
      ${(EH_MESTRE && e.pub == null) ? '<span class="log-so" title="Só você lê esta linha">🔒</span>' : ''}
      <span class="log-txt" data-log="${e.id}">${esc(e.txt)}</span>
      ${EH_MESTRE ? `<button class="log-edit" data-log="${e.id}" title="Editar">✎</button><button class="log-del" data-log="${e.id}" title="Excluir">✕</button>` : ''}
    </div>`).join('');
    if (!EH_MESTRE) return;
    box.querySelectorAll<HTMLElement>('.log-del').forEach((b) => b.addEventListener('click', async () => {
      LOG = LOG.filter((e: any) => e.id !== b.dataset.log); pintarLog(); await persistLog();
    }));
    box.querySelectorAll<HTMLElement>('.log-edit').forEach((b) => b.addEventListener('click', () => {
      const span = box.querySelector<HTMLElement>(`.log-txt[data-log="${b.dataset.log}"]`);
      const e = LOG.find((x: any) => x.id === b.dataset.log);
      if (!span || !e) return;
      const inp = document.createElement('input'); inp.type = 'text'; inp.className = 'log-inp'; inp.value = e.txt;
      span.replaceWith(inp); inp.focus(); inp.select();
      // Editar a linha edita as duas redações quando elas eram a mesma; se o
      // mestre tinha escrito uma versão pública diferente, ela é preservada.
      const salvar = async () => {
        if (e.pub === e.txt) e.pub = inp.value;
        e.txt = inp.value;
        pintarLog(); await persistLog();
      };
      inp.addEventListener('blur', salvar);
      inp.addEventListener('keydown', (ev) => { if (ev.key === 'Enter') { ev.preventDefault(); inp.blur(); } else if (ev.key === 'Escape') pintarLog(); });
    }));
  }

  // ================================================= dados: Vida e Ticks
  function registrarDesfazer(rotulo: string, volta: () => Promise<void>) {
    DESFAZER.push({ rotulo, volta });
    if (DESFAZER.length > 20) DESFAZER.shift();
    const b = el('btn-desfazer') as HTMLButtonElement;
    b.disabled = false; b.title = 'Desfazer: ' + rotulo;
  }

  const feedback = (cid: string, txt: string) => {
    const fb = document.querySelector<HTMLElement>(`.hp-fb[data-c="${CSS.escape(cid)}"]`);
    if (!fb) return;
    fb.textContent = txt; fb.classList.add('mostra');
    setTimeout(() => fb.classList.remove('mostra'), 2600);
  };

  /** Aplica delta de Vida, anima a barra e devolve o novo valor. */
  async function mexerVida(cid: string, delta: number, semDesfazer = false) {
    const c = COMBS.find((x) => x.id === cid);
    if (!c || c.pv_atual == null || c.pv_max == null) return null;
    const antes = c.pv_atual;
    const novo = Math.max(0, Math.min(c.pv_max, c.pv_atual + delta));
    if (novo === antes) return novo;
    c.pv_atual = novo;
    atualizarBarra(document, cid, novo, c.pv_max);
    await upComb(cid, { pv_atual: novo });
    if (!semDesfazer) registrarDesfazer(`Vida de ${c.nome} (${antes} → ${novo})`, async () => {
      c.pv_atual = antes; await upComb(cid, { pv_atual: antes }); await carregar();
    });
    // Zerou: marca como caído para o mestre não precisar lembrar disso no meio
    // da narração. É uma condição comum, e ele pode tirar num clique.
    if (novo === 0 && antes > 0) {
      const conds = Array.isArray(c.condicoes) ? c.condicoes : [];
      if (!conds.some((k: any) => COND[k.id]?.foraDeCombate)) {
        c.condicoes = [...conds, { id: 'inconsciente' }];
        await upComb(cid, { condicoes: c.condicoes });
        await logar(`${c.nome} caiu: Inconsciente.`, 'dano');
      }
    }
    return novo;
  }

  async function aplicarDano(cid: string, bruto: number, tipo: string, origem = '') {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const r = RESUMO[cid];
    const cd = somarCondicoes(condsDe(c));
    const soakBase = r?.soak?.[CAT_SOAK[tipo]] ?? 0;
    const soak = soakBase + (cd.soak || 0);
    const liquido = Math.max(0, bruto - soak);
    await mexerVida(cid, -liquido);
    feedback(cid, soak > 0 ? `−${liquido} (${bruto}−${soak})` : `−${liquido}`);
    const est = tierDe(c.pv_atual, c.pv_max).estado;
    const conta = soak > 0 ? ` [${bruto} − ${soak} abs]` : '';
    // A absorção só entra na versão pública se os números dele estiverem à
    // vista: `[9 − 7 abs]` é a ficha da armadura dita em voz alta.
    await logar(
      `${origem}${c.nome} sofreu ${liquido} de dano (${TIPO_LBL[tipo]})${conta} · ${c.pv_atual}/${c.pv_max} (${est}).`,
      'dano',
      fraseVida(c, `${origem}${c.nome} sofreu ${liquido} de dano (${TIPO_LBL[tipo]})${revelaStats(c) ? conta : ''}`),
    );
    return liquido;
  }

  async function avancarTick(cid: string, quanto: number, txt: string) {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const antes = c.tick;
    const cd = somarCondicoes(condsDe(c));
    const novo = Math.max(0, antes + Math.max(0, quanto + (cd.velocidade || 0)));
    c.tick = novo;
    await upComb(cid, { tick: novo });
    registrarDesfazer(`Tick de ${c.nome} (${antes} → ${novo})`, async () => {
      c.tick = antes; await upComb(cid, { tick: antes }); await carregar();
    });
    await logar(`${txt} · tick ${antes} → ${novo}.`);
    // Efeitos por rodada disparam quando o combatente age: é assim que a regra
    // de Sangramento define "início da rodada do personagem".
    if (cd.porRodada > 0) {
      await mexerVida(cid, -cd.porRodada, true);
      await logar(`${c.nome} perdeu ${cd.porRodada} por condição contínua · ${c.pv_atual}/${c.pv_max}.`, 'dano',
        fraseVida(c, `${c.nome} perdeu ${cd.porRodada} por condição contínua`));
    }
    await carregar();
  }

  // ================================================================ ligações
  function ligarBarra() {
    const btns = el('enc-btns');
    btns.innerHTML = EH_MESTRE ? `
      <button class="btn mini" id="btn-revelar" title="O que os jogadores enxergam dos inimigos">👁 ${esc(resumoRevelar())}</button>
      <button class="btn mini" id="btn-encontros">Encontros</button>
      <button class="btn mini" id="btn-reiniciar">Reiniciar</button>
      <button class="btn mini perigo" id="btn-encerrar">Encerrar</button>` : '';
    el('enc-add').hidden = !EH_MESTRE;
    el('enc-add2').hidden = !EH_MESTRE;
    el('log-add').hidden = !EH_MESTRE;
    if (!EH_MESTRE) return;

    el('btn-revelar').onclick = () => abrirRevelar();
    el('btn-encontros').onclick = () => abrirEncontros();
    el('btn-reiniciar').onclick = () => abrirReiniciar();
    el('btn-encerrar').onclick = async () => {
      if (!await uiConfirmar('Encerrar este encontro? O registro fica salvo nele.', { titulo: 'Encerrar encontro', ok: 'Encerrar' })) return;
      await logar('Encontro encerrado.', 'sistema');
      const upd: any = { ativo: false, estado: 'encerrado' };
