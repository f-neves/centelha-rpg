  .cbt-acoes .abortar { border-color: color-mix(in srgb, var(--gold) 55%, transparent); }

  /* ---------------- log ---------------- */
  .log-caixa { border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); padding: .6rem .75rem; }
  .log-cab { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
