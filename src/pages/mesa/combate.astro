      row.revelar?.stats == null ? '' : (row.revelar.stats ? '1' : '0');

    el('edit-cancelar').onclick = () => dlg.close();
    el('edit-salvar').onclick = async () => {
      const numN = (v: string) => { const n = parseInt(v, 10); return v.trim() === '' || isNaN(n) ? null : n; };
      const num0 = (v: string) => { const n = parseInt(v, 10); return isNaN(n) ? 0 : n; };
      const pvmax = numN(g('edit-pvmax').value);
      let pvat = numN(g('edit-pvat').value);
      if (pvat == null && pvmax != null) pvat = pvmax;
      if (pvat != null && pvmax != null) pvat = Math.min(pvat, pvmax);
      const cols: any = {
        nome: g('edit-nome').value.trim() || row.nome || 'Combatente',
        grupo: (el('edit-grupo') as HTMLSelectElement).value,
        pv_max: pvmax, pv_atual: pvat,
        energia_max: numN(g('edit-enmax').value), energia_atual: numN(g('edit-enat').value),
        iniciativa: num0(g('edit-ini').value), tick: Math.max(0, num0(g('edit-tick').value)),
        imagem: g('edit-img').value.trim() || null,
        notas: (el('edit-notas') as HTMLTextAreaElement).value,
        oculto: g('edit-oculto').checked,
        // Chave ausente = segue a mesa. Guardar `null` não serviria: o coalesce
        // da view trata ausência, e um null explícito viraria "esconder".
        revelar: (() => {
          const v = (el('edit-rev-vida') as HTMLSelectElement).value;
          const s = (el('edit-rev-stats') as HTMLSelectElement).value;
          const o: any = {};
          if (v) o.vida = v;
          if (s) o.stats = s === '1';
          return o;
        })(),
        dados: {
          ataque: g('edit-atq').value.trim(), dano: g('edit-dano').value.trim(),
          defesa: numN(g('edit-def').value), defesaSocial: numN(g('edit-defs').value),
          defesaMental: numN(g('edit-defm').value), resistPerf: num0(g('edit-rperf').value),
          velocidade: numN(g('edit-vel').value),
          soak: { impacto: num0(g('edit-abs-i').value), corte: num0(g('edit-abs-c').value), perfuracao: num0(g('edit-abs-p').value) },
        },
      };
      dlg.close();
      if (row.id) {
        const { error } = await upComb(row.id, cols);
        if (error) return uiErro('Erro: ' + error.message);
        await logar(`${cols.nome}: dados ajustados pelo mestre.`, 'sistema', null);
      } else {
        const { error } = await insComb([{ encontro_id: ENC.id, tipo: row.tipo || 'custom', condicoes: [], ...cols }]);
        if (error) return uiErro('Erro: ' + error.message);
        await logar(`${cols.nome} entrou.`, 'sistema');
      }
      await carregar();
    };
    dlg.showModal();
  }

