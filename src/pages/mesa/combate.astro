    g('edit-abs-c').value = sk.corte != null ? String(sk.corte) : '';
    g('edit-abs-p').value = sk.perfuracao != null ? String(sk.perfuracao) : '';
    g('edit-rperf').value = r.resistPerf ? String(r.resistPerf) : '';
    g('edit-vel').value = r.velocidade != null ? String(r.velocidade) : '';
    g('edit-img').value = row.imagem || '';
    (el('edit-notas') as HTMLTextAreaElement).value = row.notas || '';
    g('edit-oculto').checked = !!row.oculto;
    (el('edit-rev-vida') as HTMLSelectElement).value = row.revelar?.vida || '';
