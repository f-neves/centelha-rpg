  .add-item.sel { background: color-mix(in srgb, var(--accent) 22%, transparent); }
  .add-item .av { --av-t: 2rem; }
  .add-item .ai-n { flex: 1; font-size: var(--fs-rotulo); }
  .add-item .ai-m { font-size: var(--fs-micro); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .enc-novo-linha { display: flex; gap: .35rem; flex-wrap: wrap; }
  .enc-novo-linha input { flex: 1; min-width: 10rem; }
  .enc-lista { display: flex; flex-direction: column; gap: .3rem; max-height: 40vh; overflow-y: auto; }
  .enc-item { display: flex; align-items: center; gap: .5rem; padding: .35rem .5rem;
    border: 1px solid var(--rule); border-radius: var(--r-md); }
  .enc-item .ei-n { flex: 1; font-size: var(--fs-rotulo); }
  .enc-item .ei-e { font-size: var(--fs-micro); padding: .05rem .4rem; border-radius: 999px; }
  .ei-e.e-ativo { background: color-mix(in srgb, var(--accent) 26%, transparent); }
  .ei-e.e-preparado { background: color-mix(in srgb, var(--gold) 26%, transparent); }
  .ei-e.e-encerrado { background: color-mix(in srgb, var(--ink) 12%, transparent); }
</style>

<script>
  import {
    abrirMesa, u, esc, norm, sinal, avatarHTML, urlsImagens, hpBarHTML, estadoChipHTML, atualizarBarra,
    tierDe, pctDe, condChipHTML, somarCondicoes, COND, COND_LISTA, COND_GRUPOS, novoId, bancoAntigo,
    revelarDaMesa, REVELAR_PADRAO, semMigracao14, nomesDe,
  } from '../../lib/mesa-core';
  import { abrirCanal, nomeParaPresenca, type Canal } from '../../lib/mesa-tempo-real';
  import type { Condicao, NivelVida, Revelar } from '../../lib/mesa-core';
  import { abrirRevelacao, resumoRevelacao } from '../../lib/mesa-revelacao';
  import {
    abrirEscolhaDoTempo, resumoDoTempo, fitaHTML, seloFaseHTML, abrirAbortar, podeAbortar,
    itensDaFila,
  } from '../../lib/mesa-tempo-ui';
  import {
    combateDaMesa, COMBATE_PADRAO, anatomia, declarar, faseEm, defesaPerdida, acaoVazia,
    classeDeTempo, velocidadeDaArma, tetoDaRajada, temGesto, FASE_ROTULO,
    type CombateMesa, type Manobra,
  } from '../../lib/combate-tempo';
  import { MON, MON_LIST, cardCriaturaHTML, criaturaCompleta, resumoDe, iniDeMonstro, d6 } from '../../lib/mesa-bestiario';
  import { rolarIniciativaPC } from '../../lib/mesa-ficha';
  import { pv as pvDe, mana as manaDe } from '../../lib/calc';
  import { armaDoSlot } from '../../lib/equip';
  import { rolarExpr, descreverRolada, tipoDeDano } from '../../lib/rolagem';
  import { uiConfirmar, uiErro, uiPerguntar } from '../../lib/ui-dialog';

  const el = (i: string) => document.getElementById(i)!;
  const CAT_SOAK: Record<string, 'impacto' | 'corte' | 'perfuracao'> = { impacto: 'impacto', corte: 'corte', perfurante: 'perfuracao' };
  const TIPO_LBL: Record<string, string> = { impacto: 'Impacto', corte: 'Cortante', perfurante: 'Perfurante' };
  const GRUPO_LBL: Record<string, string> = { aliado: 'Aliado', inimigo: 'Inimigo', neutro: 'Neutro' };

  // ---- estado da página ----
  let SB: any, MESA_ID = '', EH_MESTRE = false, MESA: any = null, CTX: any = null;
  let REV: Revelar = { ...REVELAR_PADRAO };
  // Como o tempo passa nesta mesa: o sistema (normal ou P/G/R) e a marcação
  // (fita ou só os números). Mora em `mesas.combate` (migração 27); sem ela, o
  // padrão do sistema, que é o combate de sempre.
  let TEMPO: CombateMesa = { ...COMBATE_PADRAO };
  // O relógio do encontro: o Tick de quem está na vez, que é o menor da fila.
  // É contra ele que toda fase se lê.
  let AGORA = 0;
  // O jogador lê pela view `combate_visao`, que já desce mascarada. Quando o
  // banco ainda não tem a migração 14 isto cai para false e a máscara passa a
  // ser só de tela: o que muda é a honestidade da coisa, não o desenho.
  let PELA_VISTA = false;
  let ENC: any = null;
  let COMBS: any[] = [];
  let FICHAS: Record<string, any> = {};
  let IMGS: Record<string, string> = {};
  let RESUMO: Record<string, any> = {};
  let LOG: any[] = [];
  let VER_OCULTOS = true;
  // O canal da mesa (o mesmo do Grid). Null até a página abrir, e null para
  // sempre se o realtime não subir: tudo que depende dele é opcional.
  let RT: Canal | null = null;
  const DESFAZER: { rotulo: string; volta: () => Promise<void> }[] = [];

  /**
   * Atualiza um combatente tolerando banco sem a migração 11: se o Postgres
   * reclamar de uma coluna, ela sai do pacote e a gravação segue com o resto.
   */
  async function upComb(cid: string, cols: Record<string, any>): Promise<any> {
    const { error } = await SB.from('combatentes').update(cols).eq('id', cid);
    if (error) {
      const m = /column "?([a-z_]+)"?/i.exec(error.message || '');
      if (m && m[1] in cols) { const c2 = { ...cols }; delete c2[m[1]]; return upComb(cid, c2); }
    }
    // Todo dano, toda condição e todo tick desta aba passam por aqui: é o lugar
    // certo para tocar a campainha uma vez só, em vez de espalhar o aviso por
    // vinte chamadas.
    if (!error) RT?.avisar('combatentes');
    return { error };
  }
  async function insComb(linhas: Record<string, any>[]): Promise<any> {
    const { error } = await SB.from('combatentes').insert(linhas);
    if (error) {
      const m = /column "?([a-z_]+)"?/i.exec(error.message || '');
      if (m && linhas[0] && m[1] in linhas[0]) {
        return insComb(linhas.map((l) => { const c = { ...l }; delete c[m[1]]; return c; }));
      }
    }
    if (!error) RT?.avisar('combatentes');
    return { error };
  }

  // ================================================================ carregar
  async function main() {
    const ctx = await abrirMesa('combate');
    if (!ctx) return;
    SB = ctx.sb; MESA_ID = ctx.id; EH_MESTRE = ctx.ehMestre; MESA = ctx.mesa; CTX = ctx;
    REV = revelarDaMesa(MESA);
    TEMPO = combateDaMesa(MESA);
    await carregar();
    ligarTira();
    await ligarTempoReal(ctx);
    // O pulso de oito segundos deixou de ser o motor e virou a rede: ele só
    // corre enquanto o canal estiver fora do ar. Antes ele recarregava a página
    // inteira do jogador 450 vezes por hora, tivesse acontecido alguma coisa ou
    // não; agora, com o canal de pé, ele não corre nenhuma.
    if (!EH_MESTRE) setInterval(() => { if (!RT?.ligado()) carregar(true); }, 8000);
  }

  /**
   * A aba do combate no mesmo canal do Grid.
   *
   * O mesmo aviso serve as duas telas: o mestre que aplica o dano aqui move o
   * anel de Vida no tabuleiro da TV, e a peça movida no tabuleiro reordena a
   * fila daqui. São a mesma cena vista de dois ângulos, e até agora cada ângulo
   * tinha a sua própria verdade até alguém apertar F5.
   *
   * O que chega aqui é sempre `carregar(true)`: esta página não tem estado
   * parcial que valha costurar, e a recarga silenciosa é a mesma que o pulso já
   * fazia, só que agora quando algo de fato mudou.
   */
  async function ligarTempoReal(ctx: any) {
    const papel: 'mestre' | 'jogador' = EH_MESTRE ? 'mestre' : 'jogador';
    let perfil = '';
    try { perfil = (await nomesDe(SB, [ctx.user.id]))[ctx.user.id] || ''; } catch {}
    RT = abrirCanal({
      sb: SB, mesa: MESA_ID,
      eu: { id: ctx.user.id, nome: nomeParaPresenca(perfil, papel), papel, aba: 'combate' },
      // Redesenhar embaixo de um diálogo aberto ou de um campo em edição perde
      // o que a pessoa estava escrevendo. O aviso espera a mão sair.
      ocupado: () => {
        if (document.querySelector('dialog[open]')) return true;
        const a = document.activeElement as HTMLElement | null;
        return !!a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.isContentEditable);
      },
      aoAvisar: () => { carregar(true); },
    });
  }

  async function carregar(silencioso = false) {
    // O log mora numa coluna de `encontros`, e o log conta tudo. Para o jogador
    // o encontro também vem por uma view, que entrega só as linhas com redação
    // pública.
    const buscarEnc = (t: string) => SB.from(t).select('*').eq('mesa_id', MESA_ID)
      .eq('ativo', true).order('criado_em', { ascending: false }).limit(1);
    let { data: encs, error } = await buscarEnc(EH_MESTRE ? 'encontros' : 'encontro_visao');
    if (error && !EH_MESTRE && semMigracao14(error)) ({ data: encs, error } = await buscarEnc('encontros'));
    if (error) { el('enc-vazio').hidden = false; el('enc-vazio').innerHTML = `<p class="erro">${esc(error.message)}</p>`; return; }
    ENC = (encs || [])[0] || null;
    if (!ENC) return semEncontro();

    el('enc-vazio').hidden = true;
    el('enc-tudo').hidden = false;

    COMBS = await lerCombatentes();
    LOG = Array.isArray(ENC.log) ? ENC.log.slice() : [];

    // Fichas dos PCs em campo: a base dos números que o rastreador mostra.
    const pcIds = [...new Set(COMBS.filter((c) => c.tipo === 'pc' && c.personagem_id).map((c) => c.personagem_id))];
    if (pcIds.length) {
      const { data: fichas } = await SB.from('personagens').select('id, ficha, imagem_path').in('id', pcIds);
      FICHAS = Object.fromEntries((fichas || []).map((f: any) => [f.id, f.ficha]));
      const caminhos = (fichas || []).map((f: any) => f.imagem_path).filter(Boolean);
      const m1 = await urlsImagens(SB, caminhos, 'personagens');
      for (const f of fichas || []) if (f.imagem_path && m1[f.imagem_path]) IMGS['pc:' + f.id] = m1[f.imagem_path];
    }
    const proprias = COMBS.map((c) => c.imagem).filter(Boolean);
    if (proprias.length) {
      const m2 = await urlsImagens(SB, proprias, 'mesa');
      for (const c of COMBS) if (c.imagem && m2[c.imagem]) IMGS['own:' + c.id] = m2[c.imagem];
    }
    // O retrato dos OUTROS personagens: o jogador não lê a ficha do colega, mas
    // a view manda o caminho da imagem, e o bucket libera os arquivos
    // `retrato-*` para quem é da mesa. Sem isto o companheiro de anos vira uma
    // letra dentro de um círculo.
    const retratos = COMBS.map((c) => c.retrato).filter(Boolean);
    if (retratos.length) {
      const m3 = await urlsImagens(SB, retratos, 'personagens');
      for (const c of COMBS) if (c.retrato && m3[c.retrato]) IMGS['pc:' + c.personagem_id] = m3[c.retrato];
    }

    // O resumo NÃO é montado para quem está com os números escondidos. Ele sai
    // do `monsters.json`, que mora no próprio bundle: se eu montasse e só
    // deixasse de desenhar, o bloco de combate do inimigo estaria no
    // navegador do jogador, a um `console.log` de distância.
    RESUMO = {};
    for (const c of COMBS) {
      if (!verStats(c)) continue;
      // Do companheiro o jogador não tem a ficha, e sem ficha não há conta: o
      // bloco dele vem pronto do cache de derivados, que a view manda quando a
      // mesa abre "Status". `dados` do combatente continua mandando por cima.
      const r = resumoDe(c, FICHAS) || (c.resumo_pc ? resumoDe({ ...c, dados: { ...c.resumo_pc, ...(c.dados || {}) } }) : null);
      if (r) RESUMO[c.id] = r;
    }

    pintar();
    // Depois de pintar, e só o mestre: `pintar` é quem descobre o Tick de agora,
    // e a varredura escreve no banco. Pintar antes deixa a tela certa de
    // imediato; a limpeza é higiene, e pode chegar no quadro seguinte.
    if (EH_MESTRE) { const mudou = await limparAcoesVencidas(); if (mudou) pintar(); }
    if (!silencioso) ligarBarra();
  }

  /**
   * Lê os combatentes pelo caminho certo para quem está olhando.
   *
   * Mestre lê a tabela (precisa escrever nela). Jogador lê a view, que devolve
   * a linha já sem a Vida, sem os números e sem as notas do mestre quando a
   * mesa mandou esconder. É a diferença entre não desenhar e não enviar.
   */
  async function lerCombatentes(): Promise<any[]> {
    if (EH_MESTRE) {
      const { data } = await SB.from('combatentes').select('*').eq('encontro_id', ENC.id);
      return data || [];
    }
    const { data, error } = await SB.from('combate_visao').select('*').eq('encontro_id', ENC.id);
    if (!error) { PELA_VISTA = true; return data || []; }
    if (!semMigracao14(error)) { PELA_VISTA = false; return []; }
    PELA_VISTA = false;
    const r = await SB.from('combatentes').select('*').eq('encontro_id', ENC.id);
    return r.data || [];
  }

  // ------------------------------------------------------- o que se revela
  // Duas perguntas diferentes, e confundi-las é o bug clássico daqui: "o que a
  // mesa mostra deste combatente" (a regra, do ponto de vista do jogador) e "o
  // que ESTA tela desenha" (que para o mestre é sempre tudo). O registro
  // precisa da primeira mesmo estando na tela do mestre, porque ele escreve a
  // linha que o jogador vai ler.
  /** A regra, do ponto de vista do jogador. */
  function revelaVida(c: any): NivelVida {
    if (c.tipo === 'pc') return 'numero';
    return (c.revelar?.vida as NivelVida) || REV.vidaInimigo;
  }
  function revelaStats(c: any): boolean {
    if (c.tipo === 'pc') return true;
    if (c.revelar?.stats != null) return !!c.revelar.stats;
    return REV.statsInimigo;
  }
  /**
   * Energia e Mana são recurso, e recurso é plano: só do próprio personagem.
   * `FICHAS` responde isso de graça, porque a RLS de `personagens` só devolve
   * ao jogador a ficha dele (e ao mestre, todas).
   */
  const verEnergia = (c: any) => EH_MESTRE || !!FICHAS[c.personagem_id];

  /** O que esta tela desenha. O jogador já recebeu a linha mascarada. */
  const verVida = (c: any): NivelVida =>
    EH_MESTRE ? 'numero' : ((c.ver_vida as NivelVida) || revelaVida(c));
  const verStats = (c: any): boolean =>
    EH_MESTRE ? true : (c.ver_stats != null ? !!c.ver_stats : revelaStats(c));
  /** Vida restante em porcentagem, que é o que pinta o retrato. */
  function pctVida(c: any): number | null {
    if (c.pv_pct != null) return c.pv_pct;
    if (c.pv_max == null || c.pv_max <= 0 || c.pv_atual == null) return null;
    return pctDe(c.pv_atual, c.pv_max);
  }

  function semEncontro() {
    el('enc-tudo').hidden = true;
    const vazio = el('enc-vazio'); vazio.hidden = false;
    vazio.innerHTML = EH_MESTRE
      ? `<div class="painel"><p class="vazio">Nenhum combate em andamento.</p>
         <div class="bloco-acoes"><button class="btn primary" id="ini-agora">Iniciar um encontro</button>
         <button class="btn" id="ini-lista">Ver encontros preparados</button></div></div>`
      : '<div class="painel"><p class="vazio">Sem combate ativo. O mestre avisa quando começar.</p></div>';
    if (!EH_MESTRE) return;
    el('ini-agora').onclick = async () => {
      const nome = await uiPerguntar('Nome do encontro', 'Encontro', { titulo: 'Iniciar encontro', ok: 'Iniciar' });
      if (nome === null) return;
      await criarEncontro(nome.trim() || 'Encontro', true);
    };
    el('ini-lista').onclick = () => abrirEncontros();
  }

  async function criarEncontro(nome: string, ativar: boolean) {
    if (ativar) await SB.from('encontros').update({ ativo: false, estado: 'encerrado' }).eq('mesa_id', MESA_ID).eq('ativo', true);
    const linha: any = { mesa_id: MESA_ID, nome, ativo: ativar, estado: ativar ? 'ativo' : 'preparado' };
    let { error } = await SB.from('encontros').insert(linha);
    if (error && /estado/i.test(error.message)) { delete linha.estado; ({ error } = await SB.from('encontros').insert(linha)); }
    if (error) return uiErro('Erro: ' + error.message);
    await carregar();
    RT?.avisar('encontro');
  }

  // ================================================================== pintar
  const avatarDe = (c: any) => {
    const src = IMGS['own:' + c.id]
      || (c.tipo === 'pc' ? IMGS['pc:' + c.personagem_id] : null)
      || (c.tipo === 'criatura' && MON[c.monstro_id]?.imagem ? u(MON[c.monstro_id].imagem) : null);
    const cls = c.tipo === 'criatura' && !IMGS['own:' + c.id] ? 'av-besta' : '';
    return avatarHTML(c.nome, src, cls, pctVida(c));
  };

  /** Condições: o mestre vê sempre; o jogador vê se a mesa deixar. */
  const verCondJogador = (c: any) => c.tipo === 'pc' || REV.condInimigo;
  const verCond = (c: any) => EH_MESTRE || verCondJogador(c);
  const condsDe = (c: any): Condicao[] =>
    (Array.isArray(c.condicoes) ? c.condicoes : []).map((k: any) => ({ ...(COND[k.id] || {}), ...k }));

  /** Defesa que vale AGORA: base do bloco + ferimento + condições. */
  function defesaAtual(c: any, alcance: 'cac' | 'dist' = 'cac') {
    const base = RESUMO[c.id]?.defesa ?? null;
    if (base == null) return null;
    const ferimento = tierDe(c.pv_atual, c.pv_max).penDefesa ?? 0;
    const cd = somarCondicoes(condsDe(c));
    const cond = alcance === 'dist' ? cd.defesaDist : cd.defesaCaC;
    // A escada: estar comprometido com uma ação custa Defesa, e a moeda é o −2
    // da Guarda sob pressão do capítulo IX. Vale nos DOIS sistemas: no normal
    // ela colapsa para o −4 no Tick em que o golpe sai, mais −2 por golpe dado
    // até a próxima ação. Ver `combate-tempo.ts` e Combate_Tempo.md §14.11.
    const dv = defesaPerdida(acaoDe(c), AGORA, { segura: acaoDe(c)?.tipo === 'segura' });
    return { base, ferimento, cond, escada: dv.acao, pressao: dv.pressao, fase: dv.fase,
      total: base + ferimento + cond + dv.total };
  }

  /** A ação declarada de um combatente, tolerando banco sem a migração 27. */
  const acaoDe = (c: any) => (c && c.acao && !acaoVazia(c.acao) ? c.acao : null);

  /** Ajustes que entram na jogada de acerto de quem está agindo. */
  function ataqueAtual(c: any) {
    const ferimento = tierDe(c.pv_atual, c.pv_max).penAcao ?? 0;
    const cd = somarCondicoes(condsDe(c));
    return { ferimento, acao: cd.acao, ataque: cd.ataque, dados: cd.dados, flat: ferimento + cd.acao + cd.ataque };
  }

  const ordenar = (a: any, b: any) => (a.tick - b.tick) || ((b.iniciativa || 0) - (a.iniciativa || 0)) || String(a.nome).localeCompare(String(b.nome));

  function visiveis() {
    return COMBS.filter((c) => (EH_MESTRE ? (VER_OCULTOS || !c.oculto) : !c.oculto));
  }

  function pintar() {
    const emCampo = visiveis().filter((c) => c.ativo !== false).sort(ordenar);
    const fora = visiveis().filter((c) => c.ativo === false).sort(ordenar);
    const atual = emCampo[0] || null;

    el('enc-nome').textContent = ENC.nome;
    const tick = atual?.tick ?? 0;
    AGORA = tick;
    el('enc-rodada').textContent = `Rodada ${Math.floor(tick / 6) + 1}`;
    // Só o número: a palavra "Tick" é estática, ao lado dele, na tira.
    el('enc-tick').textContent = String(tick);
    pintarTira(emCampo, tick);

    el('cmb-lista').innerHTML = emCampo.length
      ? emCampo.map((c, i) => cardCombatente(c, i === 0)).join('')
      : '<p class="vazio">Ninguém em campo. Adicione personagens e criaturas.</p>';
    el('cmb-fora-wrap').hidden = !fora.length;
    el('cmb-fora').innerHTML = fora.map((c) => cardCombatente(c, false)).join('');

    pintarPainel(atual, emCampo);
    pintarLog();
    ligarCards();
  }

  /**
   * A TIRA DA ORDEM, a mesma do Grid.
   *
   * A grade de cards mostra cada um por inteiro e responde "como está fulano".
   * O que ela não responde é "quem age quando": os cards têm o mesmo tamanho,
   * enchem a linha da esquerda para a direita, e a ordem do tick vira uma
   * convenção de leitura que ninguém enxerga no meio da luta. A tira responde
   * isso e só isso, em degraus, e cabe numa faixa.
   *
   * Quem monta os cartões é `itensDaFila`; aqui só se traduz o combatente do
   * rastreador para o molde dela, e se guarda a altura para a coluna lateral
   * grudada saber onde começar.
   */
  function pintarTira(emCampo: any[], tick: number) {
    const box = el('cmb-fila');
    const age = emCampo[0]?.id;
    box.innerHTML = emCampo.length
      ? itensDaFila(emCampo.map((c) => ({
        id: c.id, nome: c.nome, tick: c.tick ?? 0, iniciativa: c.iniciativa ?? 0,
        grupo: c.grupo, avatar: avatarDe(c),
        // A porcentagem só sai quando a mesa deixa ver a vida: a tira não é
        // atalho para furar o que o painel de revelação fechou.
        pct: verVida(c) === 'numero' ? pctVida(c) : null,
        acao: acaoDe(c), segura: acaoDe(c)?.tipo === 'segura',
        vez: (c.tick ?? 0) === tick, age: c.id === age,
      })), tick, { marcacao: TEMPO.marcacao }).map((i) => i.html).join('')
      : '<p class="ini-vazio">Ninguém em campo.</p>';
    medirTira();
  }

  /** A altura da tira vira variável: a coluna lateral gruda logo abaixo dela. */
  function medirTira() {
    const t = document.getElementById('cmb-tira');
    if (!t) return;
    // Recolhida ela continua grudada, e continua ocupando o topo: medir a
    // altura de verdade, e não zerar por estar recolhida, senão o painel do
    // turno gruda DEBAIXO dela e some.
    const h = getComputedStyle(t).position !== 'sticky'
      ? 0 : Math.round(t.getBoundingClientRect().height + 8);
    document.documentElement.style.setProperty('--cmb-tira-h', h + 'px');
  }

  /**
   * O clique na tira leva ao card cheio.
   *
   * Ligado uma vez, no contêiner: a tira é reescrita a cada repintura, e
   * ouvintes presos aos cartões morreriam com eles. Rolar não basta numa grade
   * de doze iguais, então o card pisca ao chegar.
   */
  function ligarTira() {
    el('cmb-fila').addEventListener('click', (ev) => {
      const it = (ev.target as HTMLElement).closest<HTMLElement>('.ini-item');
      if (!it) return;
      const card = document.querySelector<HTMLElement>(`.cbt[data-c="${CSS.escape(it.dataset.c!)}"]`);
      if (!card) return;
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.remove('achei');
      void card.offsetWidth;   // reinicia a animação quando é o mesmo card
      card.classList.add('achei');
    });
    const btn = el('cmb-tira-dobrar');
    const CHAVE = 'centelha:combate:tira-dobrada';
    let dobrada = false;
    try { dobrada = localStorage.getItem(CHAVE) === '1'; } catch {}
    const aplica = () => {
      el('cmb-tira').classList.toggle('fila-dobrada', dobrada);
      btn.setAttribute('aria-expanded', String(!dobrada));
      btn.title = dobrada ? 'Mostrar a ordem de combate' : 'Recolher a tira e dar a altura aos cards';
      medirTira();
    };
    aplica();
    btn.onclick = () => {
      dobrada = !dobrada; aplica();
      try { localStorage.setItem(CHAVE, dobrada ? '1' : '0'); } catch {}
    };
    addEventListener('resize', medirTira);
  }

  /**
   * O selo de revelação: diz o que os jogadores veem deste combatente e abre o
   * painel dele num clique.
   *
   * Fica no cabeçalho do card e não na fileira de botões porque é sobretudo
   * INFORMAÇÃO. O mestre precisa saber de relance qual bicho está com regra
   * própria; virar botão foi só a consequência de já estar ali.
   */
  function seloRevelar(c: any) {
    const exc = !!(c.revelar && (c.revelar.vida || c.revelar.stats != null));
    const v = revelaVida(c);
    const comoVe = v === 'numero' ? 'vida à vista' : v === 'estado' ? 'estado' : 'só a cor';
    const txt = c.oculto ? '🙈 fora da tela' : c.tipo === 'pc' ? '👁' : `👁 ${comoVe}${revelaStats(c) ? ' + números' : ''}`;
    const dica = c.oculto
      ? `${c.nome} não aparece na tela dos jogadores: nem na lista de ordem, nem na resposta do banco. Clique para mudar.`
      : c.tipo === 'pc'
        ? 'Personagem do grupo: o card aparece inteiro para todos. Clique para tirá-lo da tela deles (o ladino que sumiu na sombra).'
        : `Os jogadores veem: ${comoVe}${revelaStats(c) ? ', mais os números de ataque e defesa' : ', sem os números'}.`
          + (exc ? ' Este tem regra própria.' : ' Seguindo o painel da mesa.') + ' Clique para mudar.';
    return `<button type="button" class="cbt-selo cbt-rev${exc ? ' exc' : ''}${c.oculto ? ' off' : ''}"
      data-rev1="${c.id}" title="${esc(dica)}">${txt}</button>`;
  }

  /**
   * A fita do card, quando a mesa pediu fita e há o que desenhar.
   *
   * O jogador vê QUE alguém está montando alguma coisa; o que ele não vê é O
   * QUÊ, e disso quem cuida é a view (`combate_visao` devolve `acao` sem os
   * campos `arma` e `alvo`). Aqui só se decide se desenha.
   */
  function fitaDoCard(c: any) {
    if (TEMPO.marcacao !== 'fita') return '';
    const a = acaoDe(c);
    // `temGesto` e nao `acaoDe`: quem so acumulou Pressao nao tem gesto no ar, e
    // uma fita inteira apagada ao lado do card diria "esta montando alguma
    // coisa" para quem esta parado apanhando.
    if (!temGesto(a)) return '';
    // A ARMA E O ALVO SÃO DE QUEM DECLAROU, e não só do mestre.
    //
    // A view já resolve o sigilo: a migração 27 manda os dois campos para o
    // DONO da peça (`m1.meu`) e os corta para o resto da mesa. A condição aqui
    // era `EH_MESTRE`, e com ela o cliente ficava mais restrito que o banco:
    // quem declarou um ataque não conseguia conferir contra quem o declarou.
    // `FICHAS` serve de prova de posse porque a RLS de `personagens` só devolve
    // ao jogador a ficha dele (para o mestre vêm todas, e aí ele já passou).
    const meu = EH_MESTRE || !!(c.personagem_id && FICHAS[c.personagem_id]);
    const o = a.arma && meu ? `<span class="fita-alvo">${esc(String(a.arma))}${a.alvo ? ` → ${esc(nomeDe(a.alvo))}` : ''}</span>` : '';
    return `<div class="cbt-fita">${fitaHTML(a, AGORA, { largura: 12, rotulo: true })}${o}</div>`;
  }
  const nomeDe = (id: string) => COMBS.find((x) => x.id === id)?.nome || 'alguém';

  function cardCombatente(c: any, atual: boolean) {
    const r = RESUMO[c.id];
    const mostra = verStats(c);
    const vida = verVida(c);
    const pct = pctVida(c);
    const conds = verCond(c) ? condsDe(c) : [];
    const def = defesaAtual(c);
    const tipoTxt = c.tipo === 'pc' ? 'PC' : c.tipo === 'criatura' ? (MON[c.monstro_id]?.nome || 'Criatura') : 'NPC';
    // A ordem segue a pergunta que se faz no meio da luta: primeiro o que
    // atrapalha quem bate NESTE card (as Defesas e a Absorção), depois o que
    // ele devolve no turno dele. Antes vinha ao contrário.
    //
    // A Defesa Social saiu daqui de propósito: dentro da iniciativa ninguém
    // rola contra ela, e cada pastilha a menos é um card a mais na tela. Ela
    // continua no bloco da criatura, na ficha e no diálogo de ação, que é onde
    // um ataque social de fato acontece.
    const pl = (l: string, v: string, t = '') =>
      `<span class="pl"${t ? ` title="${esc(t)}"` : ''}><span class="pl-l">${l}</span><span class="pl-v">${v}</span></span>`;
    const stats = (mostra && r) ? `<div class="cbt-stats pilha">
      ${def ? pl('Def', `${def.total}${def.total !== def.base ? '*' : ''}`,
        `base ${def.base}${def.ferimento ? ` · ferimento ${def.ferimento}` : ''}${def.cond ? ` · condições ${sinal(def.cond)}` : ''}`
        + `${def.escada ? ` · ${FASE_ROTULO[def.fase]} ${def.escada}` : ''}${def.pressao ? ` · pressão ${def.pressao}` : ''}`) : ''}
      ${r.defesaMental != null ? pl('Mental', String(r.defesaMental)) : ''}
      ${pl('Abs', `${r.soak.impacto}/${r.soak.corte}/${r.soak.perfuracao}${r.resistPerf ? `·N${r.resistPerf}` : ''}`)}
      ${r.ataque ? pl('Atq', esc(r.ataque)) : ''}
      ${r.dano ? pl('Dano', esc(r.dano)) : ''}
    </div>` : '';
    // Barra só quando há número para pôr dentro dela. Sem número, o estado sai
    // como etiqueta lá em cima, junto do nome: uma barra vazia seria uma régua
    // para medir o que o mestre acabou de esconder.
    const barras = vida === 'numero' && c.pv_max != null ? `<div class="cbt-barras">
      <div class="cbt-linha">${hpBarHTML(c.pv_atual, c.pv_max, c.id)}<span class="hp-fb" data-c="${c.id}"></span></div>
      ${(c.energia_max && verEnergia(c)) ? `<div class="cbt-linha"><div class="hpbar mini enbar"><div class="hpbar-fill" style="width:${Math.max(0, Math.min(100, ((c.energia_atual ?? 0) / c.energia_max) * 100))}%"></div><span class="hpbar-txt">En ${c.energia_atual ?? 0}<span class="hp-sep">/</span>${c.energia_max}</span></div></div>` : ''}
      ${c.mana_max ? `<div class="cbt-linha"><div class="hpbar mini mnbar" title="Mana"><div class="hpbar-fill" style="width:${Math.max(0, Math.min(100, ((c.mana_atual ?? 0) / c.mana_max) * 100))}%"></div><span class="hpbar-txt">Mn ${c.mana_atual ?? 0}<span class="hp-sep">/</span>${c.mana_max}</span></div></div>` : ''}
    </div>` : '';
    const chip = vida !== 'numero' && vida !== 'nada' ? estadoChipHTML(pct) : '';
    // O botão que SÓ ACENDE QUANDO CABE: abortar aparece exclusivamente para
    // quem está em Preparo. Assim o jogador nunca pergunta "posso?", e a regra
    // (no Golpe não se aborta, na Recuperação não há o que abortar) se ensina
    // pela ausência do botão em vez de por um aviso depois do clique.
    const abt = podeAbortar(acaoDe(c), AGORA)
      ? `<button class="btn mini abortar" data-c="${c.id}" title="Desistir do gesto: perde os Ticks já investidos e fica livre agora. Só para mover, desviar ou se interpor.">✋ abortar</button>` : '';
    const acoes = EH_MESTRE ? `<div class="cbt-acoes">
      <button class="btn mini agir" data-c="${c.id}">agir ▸</button>${abt}
      <input type="number" class="hp-amt" data-c="${c.id}" min="1" value="5" title="Quantidade" aria-label="Quantidade" />
      <select class="hp-tipo" data-c="${c.id}" title="Tipo de dano"><option value="impacto">I</option><option value="corte">C</option><option value="perfurante">P</option></select>
      <button class="btn mini perigo hp-dano" data-c="${c.id}" title="Aplicar dano abatendo a Absorção">−</button>
      <button class="btn mini ok hp-cura" data-c="${c.id}" title="Curar">＋</button>
      <button class="btn-fant cond-btn" data-c="${c.id}" title="Condições">✚cond</button>
      <button class="btn-fant editc" data-c="${c.id}" title="Editar">✎</button>
      <button class="btn-fant fora-btn" data-c="${c.id}" title="${c.ativo === false ? 'Voltar ao combate' : 'Tirar de combate'}">${c.ativo === false ? '↩' : '⏏'}</button>
      <button class="btn-fant perigo rm" data-c="${c.id}" title="Remover do encontro">✕</button>
    </div>` : '';
    // O retrato e o nome de uma criatura ABREM o card do bestiário, como na aba
    // Criaturas. Reaproveitam o mesmo `.ver-card` que o botão ☰ usava, e ele sai
    // daqui: com a arte inteira clicável, virou um nono botão redundante numa
    // fileira que já tinha oito. Só para o mestre, porque `ligarCards` não liga
    // nada para o jogador, e um alvo que não responde é pior do que nenhum.
    const abreCard = EH_MESTRE && c.tipo === 'criatura' && !!MON[c.monstro_id];
    const cCard = abreCard ? ' ver-card' : '';
    const aCard = abreCard ? ` data-mon="${esc(c.monstro_id)}" title="Ver o card de ${esc(MON[c.monstro_id].nome)}"` : '';
    return `<article class="cbt g-${esc(c.grupo || 'inimigo')}${atual ? ' atual' : ''}${c.ativo === false ? ' fora' : ''}${c.oculto ? ' oculto' : ''}" data-c="${c.id}">
      <header class="cbt-cab">
        <span class="cbt-tick">${c.tick}<small>tick</small></span>
        ${seloFaseHTML(acaoDe(c), AGORA)}
        <span class="espaco"></span>
        ${chip}
        ${!EH_MESTRE && c.oculto ? '<span class="cbt-selo" title="Oculto dos jogadores">🙈</span>' : ''}
        ${EH_MESTRE ? seloRevelar(c) : ''}
      </header>
      <div class="cbt-av${cCard}"${aCard}>${avatarDe(c)}</div>
      <div class="cbt-id">
        <span class="cbt-nome${cCard}"${aCard}>${esc(c.nome)}</span>
        <span class="cbt-meta">${esc(tipoTxt)} · ini ${c.iniciativa ?? 0} · ${GRUPO_LBL[c.grupo] || 'Inimigo'}</span>
      </div>
      ${barras}${stats}${fitaDoCard(c)}
      ${conds.length ? `<div class="conds">${conds.map((x) => condChipHTML(x, EH_MESTRE, c.id)).join('')}</div>` : ''}
      ${acoes}
      ${(EH_MESTRE && c.notas) ? `<div class="cbt-nota">${esc(c.notas)}</div>` : ''}
    </article>`;
  }

  /**
   * O que está no ar agora, para quem vai agir.
   *
   * Duas perguntas, e as duas se respondem sozinhas quando estão desenhadas:
   * quem está com o gesto montado (e portanto dá para interromper) e quem já
   * golpeou (e portanto está com a guarda aberta). No sistema normal a primeira
   * lista fica vazia quase sempre, porque só a Arte tem montagem visível, e é
   * exatamente essa a diferença que o P/G/R compra.
   */
  function lidoNaFila(fila: any[]) {
    if (TEMPO.marcacao !== 'fita') return '';
    const linhas = fila.filter((c) => temGesto(acaoDe(c))).slice(0, 6);
    if (!linhas.length) return '';
    const prep = linhas.filter((c) => faseEm(acaoDe(c), AGORA) === 'preparo');
    return `<div class="pt-fitas">
      ${linhas.map((c) => `<div class="pt-fita-l" title="${esc(c.nome)}">
        <span class="pt-fita-n">${esc(c.nome)}</span>${fitaHTML(acaoDe(c), AGORA, { largura: 10 })}
        ${EH_MESTRE && podeAbortar(acaoDe(c), AGORA)
          ? `<button class="btn-fant pt-abortar" data-c="${c.id}" title="Abortar o gesto de ${esc(c.nome)}">✋</button>` : ''}
      </div>`).join('')}
      ${prep.length ? `<div class="pt-fita-dica">Montando o gesto: <b>${prep.map((c) => esc(c.nome)).join(', ')}</b>.
        Só quem está em Preparo pode ser interrompido, e interromper atrasa o alvo em tantos Ticks quantos você pagar.
        Quem está montando também é quem ainda pode <b>desistir</b>: o ✋ aborta, perdendo os Ticks já investidos.</div>` : ''}
    </div>`;
  }

  function pintarPainel(atual: any, fila: any[]) {
    const box = el('painel-turno');
    if (!atual) { box.innerHTML = '<h3>Vez de</h3><p class="vazio">ninguém em campo</p>'; return; }
    const r = RESUMO[atual.id];
    // Sem a Vida, `tierDe(null, null)` responderia "Saudável", que é pior do
    // que não responder: o painel diria que o carrasco está inteiro. Com a
    // Vida escondida, o estado vem da porcentagem.
    const pct = pctVida(atual);
    const t = verVida(atual) === 'numero' ? tierDe(atual.pv_atual, atual.pv_max)
      : pct != null ? tierDe(pct, 100) : null;
    const a = ataqueAtual(atual);
    const cd = somarCondicoes(verCond(atual) ? condsDe(atual) : []);
    const prox = fila.slice(1, 4);
    box.innerHTML = `<h3>Vez de</h3>
      <div class="pt-quem">${avatarDe(atual)}
        <div><div class="pt-nome">${esc(atual.nome)}</div>
          <div class="pt-sub">tick ${atual.tick}${t ? ' · ' + esc(t.estado) : ''}${GRUPO_LBL[atual.grupo] ? ' · ' + GRUPO_LBL[atual.grupo] : ''}</div></div>
      </div>
      ${lidoNaFila(fila)}
      <div class="pt-stats">
        ${r?.ataque ? `<div><b>Acerto</b> ${esc(r.ataque)}${a.flat ? ` <span class="ruim">${sinal(a.flat)}</span>` : ''}${a.dados ? ` <span class="ruim">${sinal(a.dados)}d6</span>` : ''}</div>` : ''}
        ${r?.dano ? `<div><b>Dano</b> ${esc(r.dano)}</div>` : ''}
        ${r ? `<div><b>Absorve</b> I ${r.soak.impacto} · C ${r.soak.corte} · P ${r.soak.perfuracao}${r.resistPerf ? ` · gate N${r.resistPerf}` : ''}</div>` : ''}
        ${cd.porRodada ? `<div><b>Por rodada</b> <span class="ruim">−${cd.porRodada}</span> ao agir</div>` : ''}
        ${a.ferimento ? `<div><b>Ferimento</b> ${sinal(a.ferimento)} em ações</div>` : ''}
      </div>
      ${EH_MESTRE ? `<div class="pt-btns">
        <button class="btn primary mini agir" data-c="${atual.id}">Resolver ação</button>
        <button class="btn mini" id="pt-esperar" data-c="${atual.id}">Esperar 1 tick</button>
      </div>` : ''}
      ${prox.length ? `<div class="pt-prox">A seguir: ${prox.map((c) => `${avatarDe(c).replace('class="av', 'class="av av-p')} ${esc(c.nome)} <small>(t${c.tick})</small>`).join(' · ')}</div>` : ''}`;
    if (EH_MESTRE) {
      box.querySelector<HTMLElement>('.agir')?.addEventListener('click', () => abrirAcao(atual.id));
      el('pt-esperar')?.addEventListener('click', () => avancarTick(atual.id, 1, `${atual.nome} esperou 1 tick.`));
      // `pt-abortar` e não `abortar`: este painel está DENTRO de `enc-tudo`, que
      // é onde `ligarCards` varre. Com a mesma classe dos cards, o botão ganharia
      // dois ouvintes e abriria duas caixas empilhadas.
      box.querySelectorAll<HTMLElement>('.pt-abortar').forEach((b) =>
        b.addEventListener('click', () => abortarGesto(b.dataset.c!)));
    }
  }

  // ==================================================================== log
  const fmtHora = (ts: string) => { try { return new Date(ts).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }); } catch { return ''; } };
  const persistLog = async () => {
    try { await SB.from('encontros').update({ log: LOG }).eq('id', ENC.id); RT?.avisar('registro'); } catch {}
  };
  /**
   * Escreve no registro em duas redações.
   *
   * `txt` é a do mestre, com tudo. `pub` é a que o jogador lê: por padrão a
   * mesma, `null` quando a linha é assunto interno (um ajuste de bloco, uma
   * emboscada entrando em campo). Sem isso o card escondia a Vida e a linha de
   * baixo do registro entregava, o que é o pior tipo de vazamento: o que está
   * escrito na tela.
   */
  async function logar(txt: string, classe = '', pub: string | null = txt) {
    LOG.push({ id: novoId(), ts: new Date().toISOString(), txt, cl: classe, pub });
    if (LOG.length > 400) LOG = LOG.slice(-400);
    pintarLog();
    await persistLog();
  }

  /** Como esta mudança de Vida se conta em voz alta, para quem não vê a ficha. */
  function fraseVida(c: any, corpo: string) {
    const vida = revelaVida(c);
    if (vida === 'numero') return `${corpo} · ${c.pv_atual}/${c.pv_max} (${tierDe(c.pv_atual, c.pv_max).estado}).`;
    if (vida === 'estado' && c.pv_max > 0) return `${corpo} · ${tierDe(c.pv_atual, c.pv_max).estado}.`;
    return `${corpo}.`;
  }
  function pintarLog() {
    const box = el('cmb-log');
    if (!LOG.length) { box.innerHTML = '<p class="vazio">Nada registrado ainda.</p>'; return; }
    box.innerHTML = LOG.slice().reverse().map((e: any) => `<div class="log-linha ${e.cl ? 'l-' + esc(e.cl) : ''}">
      <span class="log-hora">${fmtHora(e.ts)}</span>
      ${(EH_MESTRE && e.pub == null) ? '<span class="log-so" title="Só você lê esta linha">🔒</span>' : ''}
      <span class="log-txt" data-log="${e.id}">${esc(e.txt)}</span>
      ${EH_MESTRE ? `<button class="log-edit" data-log="${e.id}" title="Editar">✎</button><button class="log-del" data-log="${e.id}" title="Excluir">✕</button>` : ''}
    </div>`).join('');
    if (!EH_MESTRE) return;
    box.querySelectorAll<HTMLElement>('.log-del').forEach((b) => b.addEventListener('click', async () => {
      LOG = LOG.filter((e: any) => e.id !== b.dataset.log); pintarLog(); await persistLog();
    }));
    box.querySelectorAll<HTMLElement>('.log-edit').forEach((b) => b.addEventListener('click', () => {
      const span = box.querySelector<HTMLElement>(`.log-txt[data-log="${b.dataset.log}"]`);
      const e = LOG.find((x: any) => x.id === b.dataset.log);
      if (!span || !e) return;
      const inp = document.createElement('input'); inp.type = 'text'; inp.className = 'log-inp'; inp.value = e.txt;
      span.replaceWith(inp); inp.focus(); inp.select();
      // Editar a linha edita as duas redações quando elas eram a mesma; se o
      // mestre tinha escrito uma versão pública diferente, ela é preservada.
      const salvar = async () => {
        if (e.pub === e.txt) e.pub = inp.value;
        e.txt = inp.value;
        pintarLog(); await persistLog();
      };
      inp.addEventListener('blur', salvar);
      inp.addEventListener('keydown', (ev) => { if (ev.key === 'Enter') { ev.preventDefault(); inp.blur(); } else if (ev.key === 'Escape') pintarLog(); });
    }));
  }

  // ================================================= dados: Vida e Ticks
  function registrarDesfazer(rotulo: string, volta: () => Promise<void>) {
    DESFAZER.push({ rotulo, volta });
    if (DESFAZER.length > 20) DESFAZER.shift();
    const b = el('btn-desfazer') as HTMLButtonElement;
    b.disabled = false; b.title = 'Desfazer: ' + rotulo;
  }

  const feedback = (cid: string, txt: string) => {
    const fb = document.querySelector<HTMLElement>(`.hp-fb[data-c="${CSS.escape(cid)}"]`);
    if (!fb) return;
    fb.textContent = txt; fb.classList.add('mostra');
    setTimeout(() => fb.classList.remove('mostra'), 2600);
  };

  /** Aplica delta de Vida, anima a barra e devolve o novo valor. */
  async function mexerVida(cid: string, delta: number, semDesfazer = false) {
    const c = COMBS.find((x) => x.id === cid);
    if (!c || c.pv_atual == null || c.pv_max == null) return null;
    const antes = c.pv_atual;
    const novo = Math.max(0, Math.min(c.pv_max, c.pv_atual + delta));
    if (novo === antes) return novo;
    c.pv_atual = novo;
    atualizarBarra(document, cid, novo, c.pv_max);
    await upComb(cid, { pv_atual: novo });
    if (!semDesfazer) registrarDesfazer(`Vida de ${c.nome} (${antes} → ${novo})`, async () => {
      c.pv_atual = antes; await upComb(cid, { pv_atual: antes }); await carregar();
    });
    // Zerou: marca como caído para o mestre não precisar lembrar disso no meio
    // da narração. É uma condição comum, e ele pode tirar num clique.
    if (novo === 0 && antes > 0) {
      const conds = Array.isArray(c.condicoes) ? c.condicoes : [];
      if (!conds.some((k: any) => COND[k.id]?.foraDeCombate)) {
        c.condicoes = [...conds, { id: 'inconsciente' }];
        await upComb(cid, { condicoes: c.condicoes });
        await logar(`${c.nome} caiu: Inconsciente.`, 'dano');
      }
    }
    return novo;
  }

  async function aplicarDano(cid: string, bruto: number, tipo: string, origem = '') {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const r = RESUMO[cid];
    const cd = somarCondicoes(condsDe(c));
    const soakBase = r?.soak?.[CAT_SOAK[tipo]] ?? 0;
    const soak = soakBase + (cd.soak || 0);
    const liquido = Math.max(0, bruto - soak);
    await mexerVida(cid, -liquido);
    feedback(cid, soak > 0 ? `−${liquido} (${bruto}−${soak})` : `−${liquido}`);
    const est = tierDe(c.pv_atual, c.pv_max).estado;
    const conta = soak > 0 ? ` [${bruto} − ${soak} abs]` : '';
    // A absorção só entra na versão pública se os números dele estiverem à
    // vista: `[9 − 7 abs]` é a ficha da armadura dita em voz alta.
    await logar(
      `${origem}${c.nome} sofreu ${liquido} de dano (${TIPO_LBL[tipo]})${conta} · ${c.pv_atual}/${c.pv_max} (${est}).`,
      'dano',
      fraseVida(c, `${origem}${c.nome} sofreu ${liquido} de dano (${TIPO_LBL[tipo]})${revelaStats(c) ? conta : ''}`),
    );
    return liquido;
  }

  /**
   * Ataque recebido: abre a guarda de quem o recebe.
   *
   * Guarda sob pressão, do capítulo IX: −2 por ataque, acumulando sem teto até
   * o ciclo do defensor fechar. Quem não tem ação declarada acumula do mesmo
   * jeito, numa ação mínima que só carrega a pressão: sem isso, quem está
   * parado seria o único imune à regra que existe justamente para punir quem
   * fica parado apanhando.
   */
  async function somarPressao(cid: string, quantos = 1) {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const a = acaoDe(c) || { golpes: [], livre: c.tick, tipo: 'simples' as Manobra };
    const novo = { ...a, pressao: (a.pressao || 0) + quantos };
    c.acao = novo;
    await upComb(cid, { acao: novo });
  }

  /**
   * Limpa a ação de quem já saiu dela.
   *
   * O ciclo fechado é um estado que ninguém escreve: ele chega porque o relógio
   * andou. Varrer aqui, ao pintar, evita uma coluna de "livre desde" e evita a
   * fita fantasma de um golpe que saiu há três rodadas.
   */
  async function limparAcoesVencidas() {
    const vencidas = COMBS.filter((c) => {
      const a = acaoDe(c);
      return a && AGORA >= a.livre && c.tick <= AGORA;
    });
    for (const c of vencidas) {
      // A Pressao SOBREVIVE ao fim do ciclo: ela so zera quando a pessoa AGE,
      // e quem age passa por `avancarTick`, que troca a acao inteira. Apagar
      // aqui devolveria a guarda de graca a quem so ficou esperando.
      const p = c.acao?.pressao || 0;
      const novo = p > 0 ? { golpes: [], livre: c.tick, pressao: p } : {};
      c.acao = novo; await upComb(c.id, { acao: novo });
    }
    return vencidas.length > 0;
  }

  /**
   * Abortar o gesto de alguém que está em Preparo.
   *
   * Ao contrário de `avancarTick`, aqui o Tick novo é um valor ABSOLUTO e não
   * um acréscimo: quem aborta fica livre no Tick de agora (mais o deslocamento),
   * e não no Tick em que teria terminado. Somar não serviria, porque o que se
   * faz é justamente cancelar uma soma que já foi feita.
   *
   * A ação sai junto: sem ela a fita continuaria desenhando um golpe que não
   * vai sair, e a escada continuaria cobrando a Defesa de um gesto abortado.
   */
  function abortarGesto(cid: string) {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const a = acaoDe(c); if (!a) return;
    abrirAbortar({ nome: c.nome, acao: a, tick: AGORA }, async (r) => {
      const antesTick = c.tick, antesAcao = c.acao;
      c.tick = r.novoTick; c.acao = {};
      await upComb(cid, { tick: r.novoTick, acao: {} });
      registrarDesfazer(`Abortar de ${c.nome} (tick ${antesTick} → ${r.novoTick})`, async () => {
        c.tick = antesTick; c.acao = antesAcao;
        await upComb(cid, { tick: antesTick, acao: antesAcao || {} }); await carregar();
      });
      // A frase pública é a mesma: abortar é gesto visível, e esconder que o
      // ogro desistiu do golpe tiraria do grupo a informação que eles
      // compraram prestando atenção. O que fica de fora é só a conta.
      await logar(`${r.frase} · próxima ação no tick ${r.novoTick} (sairia no ${a.livre}).`,
        'sistema', `${r.frase}.`);
      await carregar();
    });
  }

  async function avancarTick(cid: string, quanto: number, txt: string, acao: any = null) {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const antes = c.tick;
    const antesAcao = c.acao;
    const cd = somarCondicoes(condsDe(c));
    const novo = Math.max(0, antes + Math.max(0, quanto + (cd.velocidade || 0)));
    c.tick = novo;
    // A ação e o Tick andam juntos: a ação diz o que acontece DENTRO do ciclo
    // que o Tick acabou de reservar. Gravar em duas idas daria uma janela em
    // que a fita mostra um ciclo e o relógio mostra outro.
    c.acao = acao || {};
    await upComb(cid, { tick: novo, acao: c.acao });
    registrarDesfazer(`Tick de ${c.nome} (${antes} → ${novo})`, async () => {
      c.tick = antes; c.acao = antesAcao;
      await upComb(cid, { tick: antes, acao: antesAcao || {} }); await carregar();
    });
    await logar(`${txt} · tick ${antes} → ${novo}.`);
    // Efeitos por rodada disparam quando o combatente age: é assim que a regra
    // de Sangramento define "início da rodada do personagem".
    if (cd.porRodada > 0) {
      await mexerVida(cid, -cd.porRodada, true);
      await logar(`${c.nome} perdeu ${cd.porRodada} por condição contínua · ${c.pv_atual}/${c.pv_max}.`, 'dano',
        fraseVida(c, `${c.nome} perdeu ${cd.porRodada} por condição contínua`));
    }
    await carregar();
  }

  // ================================================================ ligações
  function ligarBarra() {
    const btns = el('enc-btns');
    btns.innerHTML = EH_MESTRE ? `
      <button class="btn mini" id="btn-revelar" title="Abrir o painel: o que os jogadores veem dos inimigos, das fichas uns dos outros, e o placar do que já está liberado nas outras abas">👁 ${esc(resumoRevelacao(REV))}</button>
      <button class="btn mini" id="btn-tempo" title="Como o tempo passa nesta mesa: o sistema de combate (normal ou em três fases) e como a mesa o desenha">⏱ ${esc(resumoDoTempo(TEMPO))}</button>
      <button class="btn mini" id="btn-encontros">Encontros</button>
      <button class="btn mini" id="btn-reiniciar">Reiniciar</button>
      <button class="btn mini perigo" id="btn-encerrar">Encerrar</button>` : '';
    el('enc-add').hidden = !EH_MESTRE;
    el('enc-add2').hidden = !EH_MESTRE;
    el('log-add').hidden = !EH_MESTRE;
    if (!EH_MESTRE) return;

    el('btn-revelar').onclick = () => abrirRevelacao(CTX!, async (novo) => {
      REV = novo;
      await logar(`Revelação: vida ${novo.vidaInimigo}, números ${novo.statsInimigo ? 'à vista' : 'ocultos'}.`, 'sistema', null);
      await carregar();
    });
    el('btn-tempo').onclick = () => abrirEscolhaDoTempo(
      CTX!, { emAndamento: COMBS.filter((c) => temGesto(acaoDe(c))).length },
      async (novo) => {
        TEMPO = novo;
        await logar(`O combate desta mesa passa a ser: ${resumoDoTempo(novo)}.`, 'sistema',
          `O combate desta mesa passa a ser: ${resumoDoTempo(novo)}.`);
        await carregar();
      });
    el('btn-encontros').onclick = () => abrirEncontros();
    el('btn-reiniciar').onclick = () => abrirReiniciar();
    el('btn-encerrar').onclick = async () => {
      if (!await uiConfirmar('Encerrar este encontro? O registro fica salvo nele.', { titulo: 'Encerrar encontro', ok: 'Encerrar' })) return;
      await logar('Encontro encerrado.', 'sistema');
      const upd: any = { ativo: false, estado: 'encerrado' };
      let { error } = await SB.from('encontros').update(upd).eq('id', ENC.id);
      if (error && /estado/i.test(error.message)) await SB.from('encontros').update({ ativo: false }).eq('id', ENC.id);
      await carregar();
      RT?.avisar('encontro');
    };
    el('add-pcs').onclick = adicionarPCs;
    el('add-criatura').onclick = () => abrirAdicionar('criatura');
    el('add-npc').onclick = () => abrirAdicionar('npc');
    el('add-avulso').onclick = () => abrirEditar({ tipo: 'custom', nome: '', grupo: 'inimigo', tick: 0, iniciativa: 0 }, null);
    (el('ver-ocultos') as HTMLInputElement).onchange = (e) => { VER_OCULTOS = (e.target as HTMLInputElement).checked; pintar(); };
    el('btn-recarregar').onclick = () => carregar();
    el('btn-desfazer').onclick = async () => {
      const d = DESFAZER.pop(); if (!d) return;
      await d.volta();
      const b = el('btn-desfazer') as HTMLButtonElement;
      b.disabled = !DESFAZER.length;
      b.title = DESFAZER.length ? 'Desfazer: ' + DESFAZER[DESFAZER.length - 1].rotulo : '';
    };
    el('log-nota-btn').onclick = async () => {
      const inp = el('log-nota') as HTMLInputElement;
      const v = inp.value.trim(); if (!v) return;
      inp.value = ''; await logar(v, 'sistema');
    };
    el('log-nota').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); (el('log-nota-btn') as HTMLElement).click(); } });
  }

  function ligarCards() {
    const raiz = el('enc-tudo');
    if (!EH_MESTRE) return;
    const qtd = (cid: string) => Math.max(1, parseInt((raiz.querySelector(`.hp-amt[data-c="${CSS.escape(cid)}"]`) as HTMLInputElement)?.value || '1', 10) || 1);
    raiz.querySelectorAll<HTMLElement>('.hp-dano').forEach((b) => b.addEventListener('click', async () => {
      const cid = b.dataset.c!;
      const tipo = (raiz.querySelector(`.hp-tipo[data-c="${CSS.escape(cid)}"]`) as HTMLSelectElement)?.value || 'impacto';
      await aplicarDano(cid, qtd(cid), tipo);
      pintar();
    }));
    raiz.querySelectorAll<HTMLElement>('.hp-cura').forEach((b) => b.addEventListener('click', async () => {
      const cid = b.dataset.c!; const q = qtd(cid);
      await mexerVida(cid, +q); feedback(cid, `+${q}`);
      const c = COMBS.find((x) => x.id === cid);
      await logar(`${c?.nome} recuperou ${q} · ${c?.pv_atual}/${c?.pv_max}.`, 'cura',
        c ? fraseVida(c, `${c.nome} recuperou ${q}`) : null);
      pintar();
    }));
    raiz.querySelectorAll<HTMLElement>('.agir').forEach((b) => b.addEventListener('click', () => abrirAcao(b.dataset.c!)));
    raiz.querySelectorAll<HTMLElement>('.abortar').forEach((b) => b.addEventListener('click', () => abortarGesto(b.dataset.c!)));
    raiz.querySelectorAll<HTMLElement>('.editc').forEach((b) => b.addEventListener('click', () => {
      const c = COMBS.find((x) => x.id === b.dataset.c); if (c) abrirEditar(c, RESUMO[c.id]);
    }));
    raiz.querySelectorAll<HTMLElement>('.cond-btn').forEach((b) => b.addEventListener('click', () => abrirCondicoes(b.dataset.c!)));
    raiz.querySelectorAll<HTMLElement>('.cond-x').forEach((b) => b.addEventListener('click', async () => {
      const cid = b.dataset.dono!, cid2 = b.dataset.cond!;
      const c = COMBS.find((x) => x.id === cid); if (!c) return;
      c.condicoes = (c.condicoes || []).filter((k: any) => k.id !== cid2);
      await upComb(cid, { condicoes: c.condicoes });
      const t = `${c.nome}: fim de ${COND[cid2]?.nome || cid2}.`;
      await logar(t, 'sistema', verCondJogador(c) ? t : null);
      pintar();
    }));
    raiz.querySelectorAll<HTMLElement>('[data-rev1]').forEach((b) =>
      b.addEventListener('click', () => abrirRevelarUm(b.dataset.rev1!)));
    raiz.querySelectorAll<HTMLElement>('.fora-btn').forEach((b) => b.addEventListener('click', async () => {
      const c = COMBS.find((x) => x.id === b.dataset.c); if (!c) return;
      c.ativo = c.ativo === false;
      await upComb(c.id, { ativo: c.ativo });
      await logar(`${c.nome} ${c.ativo ? 'voltou ao combate' : 'saiu de combate'}.`, 'sistema');
      pintar();
    }));
    raiz.querySelectorAll<HTMLElement>('.rm').forEach((b) => b.addEventListener('click', async () => {
      const c = COMBS.find((x) => x.id === b.dataset.c); if (!c) return;
      if (!await uiConfirmar(`Remover ${c.nome} do encontro?`, { titulo: 'Remover', ok: 'Remover', perigo: true })) return;
      await SB.from('combatentes').delete().eq('id', c.id);
      RT?.avisar('combatentes');
      await logar(`${c.nome} saiu da lista.`, 'sistema', c.oculto ? null : `${c.nome} saiu da lista.`);
      await carregar();
    }));
    // A prosa da criatura não vem no pacote da página (ver mesa-bestiario): a
    // janela abre com o bloco de jogo e o texto entra quando a busca voltar.
    raiz.querySelectorAll<HTMLElement>('.ver-card').forEach((b) => b.addEventListener('click', async () => {
      const id = b.dataset.mon!;
      const m = MON[id]; if (!m) return;
      el('card-modal-body').innerHTML = cardCriaturaHTML(m);
      el('card-modal').hidden = false; document.body.style.overflow = 'hidden';
      const cheia = await criaturaCompleta(id);
      if (cheia && !el('card-modal').hidden) el('card-modal-body').innerHTML = cardCriaturaHTML(cheia);
    }));
  }

  // ============================================================ adicionar PCs
  async function adicionarPCs() {
    const { data: pcs } = await SB.from('personagens').select('id, nome, ficha').eq('mesa_id', MESA_ID);
    const jaTem = new Set(COMBS.map((c) => c.personagem_id).filter(Boolean));
    const novos = (pcs || []).filter((p: any) => !jaTem.has(p.id)).map((p: any) => {
      const S = p.ficha || {}; const at = S.attrs || {};
      const pvv = pvDe(at.vigor || 0);
      const en = (Math.floor(((at.vigor || 0) + (at.compostura || 0) + (at.raciocinio || 0) + (S.willpower || 0)) / 2) + (S.centelha || 0) * 2);
      // Mana só para quem despertou: a reserva sai da Centelha, e um mortal de
      // Vontade alta continua sem uma gota. Nulo aqui quer dizer "não lida com
      // Mana", que é diferente de uma reserva vazia.
      const mn = (S.centelha || 0) > 0
        ? manaDe({ centelha: S.centelha || 0, vontade: S.willpower || 0,
                   manipulacao: S?.arte?.['manipulacao-mana'] || 0 })
        : null;
      return {
        encontro_id: ENC.id, tipo: 'pc', personagem_id: p.id, nome: p.nome || 'PC',
        pv_max: pvv, pv_atual: pvv, energia_max: en, energia_atual: en,
        mana_max: mn, mana_atual: mn,
        tick: 0, iniciativa: rolarIniciativaPC(S), grupo: 'aliado', condicoes: [],
      };
    });
    if (!novos.length) { await uiErro('Todos os personagens da mesa já estão no encontro.'); return; }
    const { error } = await insComb(novos);
    if (error) return uiErro('Erro: ' + error.message);
    for (const n of novos) await logar(`${n.nome} entrou (ini ${n.iniciativa}).`, 'sistema');
    await carregar();
  }

  // ====================================================== adicionar em lote
  let ADD_SEL: any = null;
  async function abrirAdicionar(modo: 'criatura' | 'npc') {
    const dlg = el('add-dlg') as HTMLDialogElement;
    (el('add-titulo') as HTMLElement).textContent = modo === 'criatura' ? 'Adicionar criatura' : 'Adicionar NPC do compêndio';
    ADD_SEL = null;
    (el('add-confirmar') as HTMLButtonElement).disabled = true;
    (el('add-qtd') as HTMLInputElement).value = '1';
    (el('add-oculto') as HTMLInputElement).checked = false;
    const busca = el('add-busca') as HTMLInputElement; busca.value = '';

    let fonte: any[] = [];
    if (modo === 'criatura') {
      // O bestiário da campanha vem primeiro: é o que o mestre separou.
      const { data: sep } = await SB.from('mesa_criaturas').select('monstro_id').eq('mesa_id', MESA_ID);
      const ids = new Set((sep || []).map((s: any) => s.monstro_id));
      const daCampanha = MON_LIST.filter((m) => ids.has(m.id)).map((m) => ({ ...m, sep: true }));
      fonte = [...daCampanha, ...MON_LIST.filter((m) => !ids.has(m.id))];
    } else {
      const { data: npcs, error } = await SB.from('mesa_codex').select('*').eq('mesa_id', MESA_ID).eq('tipo', 'npc').order('nome');
      if (error && bancoAntigo(error)) { await uiErro('O compêndio chega com a migração 11.'); return; }
      fonte = (npcs || []).map((n: any) => ({ id: n.id, nome: n.nome, npc: n }));
    }

    const desenhar = () => {
      const q = norm(busca.value.trim());
      const hits = (q ? fonte.filter((f: any) => (f.busca || norm(f.nome)).includes(q)) : fonte).slice(0, 60);
      el('add-lista').innerHTML = hits.length ? hits.map((f: any) => `<div class="add-item" data-k="${esc(f.id)}">
        ${avatarHTML(f.nome, f.imagem ? u(f.imagem) : (f.npc?.imagem && /^https?:/.test(f.npc.imagem) ? f.npc.imagem : null), f.imagem ? 'av-besta av-p' : 'av-p')}
        <span class="ai-n">${esc(f.nome)}${f.sep ? ' <small class="muted">· da campanha</small>' : ''}</span>
        <span class="ai-m">${f.ameaca != null ? `A${f.ameaca} · PV ${f.pv ?? '—'} · Def ${f.defesa ?? '—'}` : esc(f.npc?.resumo || '')}</span>
      </div>`).join('') : '<p class="vazio" style="padding:.5rem">nada encontrado</p>';
      el('add-lista').querySelectorAll<HTMLElement>('.add-item').forEach((it) => it.addEventListener('click', () => {
        el('add-lista').querySelectorAll('.add-item').forEach((x) => x.classList.remove('sel'));
        it.classList.add('sel');
        ADD_SEL = hits.find((f: any) => String(f.id) === it.dataset.k) || null;
        (el('add-confirmar') as HTMLButtonElement).disabled = !ADD_SEL;
      }));
    };
    busca.oninput = desenhar; desenhar();

    el('add-cancelar').onclick = () => dlg.close();
    el('add-confirmar').onclick = async () => {
      if (!ADD_SEL) return;
      const n = Math.max(1, Math.min(24, parseInt((el('add-qtd') as HTMLInputElement).value, 10) || 1));
      const grupo = (el('add-grupo') as HTMLSelectElement).value;
      const oculto = (el('add-oculto') as HTMLInputElement).checked;
      dlg.close();
      const linhas: any[] = [];
      for (let i = 0; i < n; i++) {
        const sufixo = n > 1 ? ` ${i + 1}` : '';
        if (modo === 'criatura') {
          const m = MON[ADD_SEL.id];
          linhas.push({
            encontro_id: ENC.id, tipo: 'criatura', monstro_id: m.id, nome: `${m.nome}${sufixo}`,
            pv_max: m.combate?.pv ?? null, pv_atual: m.combate?.pv ?? null,
            tick: 0, iniciativa: iniDeMonstro(m), grupo, oculto, condicoes: [],
          });
        } else {
          const npc = ADD_SEL.npc;
          const d = npc.dados || {};
          linhas.push({
            encontro_id: ENC.id, tipo: 'custom', codex_id: npc.id, nome: `${npc.nome}${sufixo}`,
            pv_max: d.pv ?? null, pv_atual: d.pv ?? null, tick: 0,
            iniciativa: d6() + (d.iniciativa || 0), grupo, oculto, imagem: npc.imagem || null,
            condicoes: [],
            dados: {
              ataque: d.ataque || '', dano: d.dano || '', defesa: d.defesa ?? null,
              defesaSocial: d.defesaSocial ?? null, defesaMental: d.defesaMental ?? null,
              soak: d.soak || { impacto: 0, corte: 0, perfuracao: 0 }, resistPerf: d.resistPerf || 0,
            },
          });
        }
      }
      const { error } = await insComb(linhas);
      if (error) return uiErro('Erro: ' + error.message);
      // Entrada oculta não vira linha de registro: a emboscada seria anunciada
      // por escrito antes de acontecer.
      const entrou = `${n > 1 ? n + '× ' : ''}${linhas[0].nome.replace(/ \d+$/, '')} ${n > 1 ? 'entraram' : 'entrou'}`;
      await logar(`${entrou}${oculto ? ' (oculto)' : ''}.`, 'sistema', oculto ? null : `${entrou}.`);
      await carregar();
    };
    dlg.showModal();
  }

  // ========================================================= editar combatente
  function abrirEditar(row: any, resumo: any) {
    const dlg = el('edit-dlg') as HTMLDialogElement;
    const g = (i: string) => el(i) as HTMLInputElement;
    const r = resumo || {}; const sk = r.soak || {};
    (el('edit-titulo') as HTMLElement).textContent = row.id ? `Editar ${row.nome}` : 'Novo combatente avulso';
    g('edit-nome').value = row.nome || '';
    (el('edit-grupo') as HTMLSelectElement).value = row.grupo || 'inimigo';
    g('edit-pvmax').value = row.pv_max != null ? String(row.pv_max) : '';
    g('edit-pvat').value = row.pv_atual != null ? String(row.pv_atual) : '';
    g('edit-ini').value = String(row.iniciativa ?? 0);
    g('edit-enmax').value = row.energia_max != null ? String(row.energia_max) : '';
    g('edit-enat').value = row.energia_atual != null ? String(row.energia_atual) : '';
    g('edit-mnmax').value = row.mana_max != null ? String(row.mana_max) : '';
    g('edit-mnat').value = row.mana_atual != null ? String(row.mana_atual) : '';
    g('edit-tick').value = String(row.tick ?? 0);
    g('edit-atq').value = r.ataque || '';
    g('edit-dano').value = r.dano || '';
    g('edit-def').value = r.defesa != null ? String(r.defesa) : '';
    g('edit-defs').value = r.defesaSocial != null ? String(r.defesaSocial) : '';
    g('edit-defm').value = r.defesaMental != null ? String(r.defesaMental) : '';
    g('edit-abs-i').value = sk.impacto != null ? String(sk.impacto) : '';
    g('edit-abs-c').value = sk.corte != null ? String(sk.corte) : '';
    g('edit-abs-p').value = sk.perfuracao != null ? String(sk.perfuracao) : '';
    g('edit-rperf').value = r.resistPerf ? String(r.resistPerf) : '';
    g('edit-vel').value = r.velocidade != null ? String(r.velocidade) : '';
    g('edit-img').value = row.imagem || '';
    (el('edit-notas') as HTMLTextAreaElement).value = row.notas || '';
    g('edit-oculto').checked = !!row.oculto;

    el('edit-cancelar').onclick = () => dlg.close();
    el('edit-salvar').onclick = async () => {
      const numN = (v: string) => { const n = parseInt(v, 10); return v.trim() === '' || isNaN(n) ? null : n; };
      const num0 = (v: string) => { const n = parseInt(v, 10); return isNaN(n) ? 0 : n; };
      const pvmax = numN(g('edit-pvmax').value);
      let pvat = numN(g('edit-pvat').value);
      if (pvat == null && pvmax != null) pvat = pvmax;
      if (pvat != null && pvmax != null) pvat = Math.min(pvat, pvmax);
      const cols: any = {
        nome: g('edit-nome').value.trim() || row.nome || 'Combatente',
        grupo: (el('edit-grupo') as HTMLSelectElement).value,
        pv_max: pvmax, pv_atual: pvat,
        energia_max: numN(g('edit-enmax').value), energia_atual: numN(g('edit-enat').value),
        mana_max: numN(g('edit-mnmax').value), mana_atual: numN(g('edit-mnat').value),
        iniciativa: num0(g('edit-ini').value), tick: Math.max(0, num0(g('edit-tick').value)),
        imagem: g('edit-img').value.trim() || null,
        notas: (el('edit-notas') as HTMLTextAreaElement).value,
        oculto: g('edit-oculto').checked,
        dados: {
          ataque: g('edit-atq').value.trim(), dano: g('edit-dano').value.trim(),
          defesa: numN(g('edit-def').value), defesaSocial: numN(g('edit-defs').value),
          defesaMental: numN(g('edit-defm').value), resistPerf: num0(g('edit-rperf').value),
          velocidade: numN(g('edit-vel').value),
          soak: { impacto: num0(g('edit-abs-i').value), corte: num0(g('edit-abs-c').value), perfuracao: num0(g('edit-abs-p').value) },
        },
      };
      dlg.close();
      if (row.id) {
        const { error } = await upComb(row.id, cols);
        if (error) return uiErro('Erro: ' + error.message);
        await logar(`${cols.nome}: dados ajustados pelo mestre.`, 'sistema', null);
      } else {
        const { error } = await insComb([{ encontro_id: ENC.id, tipo: row.tipo || 'custom', condicoes: [], ...cols }]);
        if (error) return uiErro('Erro: ' + error.message);
        await logar(`${cols.nome} entrou.`, 'sistema');
      }
      await carregar();
    };
    dlg.showModal();
  }

  // ============================================================== condições
  function abrirCondicoes(cid: string) {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const dlg = el('cond-dlg') as HTMLDialogElement;
    (el('cond-titulo') as HTMLElement).textContent = `Condições de ${c.nome}`;
    const busca = el('cond-busca') as HTMLInputElement; busca.value = '';

    const gravar = async () => {
      const { error } = await upComb(cid, { condicoes: c.condicoes });
      if (error) await uiErro('A coluna "condicoes" ainda não existe. Rode supabase/migracao-11.sql.');
      desenhar(); pintar();
    };
    const desenhar = () => {
      const ativas = condsDe(c);
      el('cond-ativas').innerHTML = ativas.length
        ? ativas.map((x) => condChipHTML(x, true, cid)).join('')
        : '<span class="muted" style="font-size:var(--fs-micro)">nenhuma condição</span>';
      el('cond-ativas').querySelectorAll<HTMLElement>('.cond-x').forEach((b) => b.addEventListener('click', async () => {
        c.condicoes = (c.condicoes || []).filter((k: any) => k.id !== b.dataset.cond);
        await gravar();
      }));
      const q = norm(busca.value.trim());
      const temIds = new Set((c.condicoes || []).map((k: any) => k.id));
      el('cond-catalogo').innerHTML = COND_GRUPOS.map((gp) => {
        const itens = COND_LISTA.filter((x) => x.grupo === gp.id && (!q || norm(x.nome + ' ' + (x.nota || '')).includes(q)) && !temIds.has(x.id));
        if (!itens.length) return '';
        return `<div class="cond-grupo"><div class="cond-grupo-t">${esc(gp.nome)}</div>
          <div class="conds">${itens.map((x) => condChipHTML(x)).join('')}</div></div>`;
      }).join('') || '<p class="vazio">nada encontrado</p>';
      el('cond-catalogo').querySelectorAll<HTMLElement>('.cond').forEach((chip, i) => {
        const nome = chip.querySelector('.cond-n')?.textContent || '';
        chip.addEventListener('click', async () => {
          const achou = COND_LISTA.find((x) => x.nome === nome); if (!achou) return;
          c.condicoes = [...(c.condicoes || []), { id: achou.id }];
          await logar(`${c.nome}: ${achou.nome}.`, 'sistema', verCondJogador(c) ? `${c.nome}: ${achou.nome}.` : null);
          await gravar();
        });
      });
    };
    busca.oninput = desenhar; desenhar();

    el('cc-add').onclick = async () => {
      const nome = (el('cc-nome') as HTMLInputElement).value.trim();
      if (!nome) return;
      const n = (i: string) => parseInt((el(i) as HTMLInputElement).value, 10) || 0;
      c.condicoes = [...(c.condicoes || []), {
        id: 'x-' + norm(nome).replace(/\W+/g, '-'), nome, cor: 'neutro', icone: '◆',
        acao: n('cc-acao'), dados: n('cc-dados'), defesa: n('cc-defesa'), porRodada: n('cc-rodada'),
        nota: (el('cc-nota') as HTMLInputElement).value,
      }];
      (el('cc-nome') as HTMLInputElement).value = '';
      await logar(`${c.nome}: ${nome} (condição caseira).`, 'sistema',
        verCondJogador(c) ? `${c.nome}: ${nome}.` : null);
      await gravar();
    };
    el('cond-fechar').onclick = () => dlg.close();
    dlg.showModal();
  }

  // ================================================================== ação

  function abrirAcao(cid: string) {
    const ator = COMBS.find((x) => x.id === cid); if (!ator) return;
    const dlg = el('acao-dlg') as HTMLDialogElement;
    const r = RESUMO[cid];
    const aj = ataqueAtual(ator);
    const alvos = visiveis().filter((x) => x.id !== cid && x.ativo !== false).sort(ordenar);

    (el('acao-titulo') as HTMLElement).textContent = `Ação de ${ator.nome}`;
    const tipoSel = el('acao-tipo') as HTMLSelectElement;
    const alcSel = el('acao-alcance') as HTMLSelectElement;
    const alvoSel = el('acao-alvo') as HTMLSelectElement;
    const outroInp = el('acao-outro') as HTMLInputElement;
    const danoInp = el('acao-dano') as HTMLInputElement;
    const danoTipo = el('acao-dano-tipo') as HTMLSelectElement;
    const spdInp = el('acao-speed') as HTMLInputElement;

    tipoSel.value = 'ataque'; alcSel.value = 'cac';
    alvoSel.innerHTML = alvos.map((x) => `<option value="${x.id}">${esc(x.nome)}</option>`).join('')
      + '<option value="__outro__">Outro (digitar)…</option>';
    outroInp.value = ''; danoInp.value = '';
    (el('acao-res-atq') as HTMLElement).textContent = '';
    (el('acao-dano-conta') as HTMLElement).hidden = true;
    spdInp.value = String(r?.velocidade ?? 5);

    const alvoAtual = () => alvos.find((x) => x.id === alvoSel.value) || null;
    const ehAtaque = () => ['ataque', 'social', 'mental'].includes(tipoSel.value);

    // ---- a manobra manda no tempo -------------------------------------
    // A classe da arma dá o Preparo; a manobra dá quantos Golpes e quanto o
    // ciclo cresce. Tudo sai de `combate-tempo.ts`, que lê `regras.json`: aqui
    // não há régua escrita à mão.
    const manSel = el('acao-manobra') as HTMLSelectElement;
    const golpesInp = el('acao-golpes') as HTMLInputElement;
    const classe = classeDeTempo(r?.arma, r?.velocidade);
    const velBase = r?.velocidade ?? velocidadeDaArma(r?.arma, 5);
    // SÓ OFERECE O QUE CABE. A rajada é corpo a corpo (não se dispara duas
    // flechas no mesmo gesto), e a dupla precisa de arma na mão inábil. Deixar
    // as duas sempre na lista fazia o mestre escolher uma manobra impossível e
    // descobrir pelo aviso em letra miúda, depois de escolher.
    const cj = (FICHAS[ator.personagem_id]?.conjuntos || []).find((x: any) => x.ativo);
    const inabil = cj ? armaDoSlot(cj.inabil) : null;
    const duasMaos = cj ? armaDoSlot(cj.habil)?.maos === 2 : false;
    // Sem ficha (criatura, NPC) o mestre decide: as opções ficam, porque o
    // bestiário não diz quantas mãos o bicho tem.
    const podeDupla = !cj || (!!inabil && !duasMaos);
    const podeRajada = tetoDaRajada(classe) > 1;
    for (const o of Array.from(manSel.options)) {
      const cabe = o.value === 'simples'
        || (o.value === 'rajada' ? podeRajada : podeDupla);
      o.hidden = !cabe; o.disabled = !cabe;
    }
    manSel.value = 'simples'; golpesInp.value = '2';
    golpesInp.max = String(Math.max(2, tetoDaRajada(classe)));

    const anat = () => anatomia({
      classe, velocidade: velBase, sistema: TEMPO.sistema,
      manobra: manSel.value as Manobra,
      golpes: Math.max(2, parseInt(golpesInp.value || '2', 10) || 2),
    });

    /** Redesenha a caixa do tempo e joga a Velocidade da manobra no campo. */
    const syncTempo = () => {
      const atk = tipoSel.value === 'ataque';
      el('acao-manobra-wrap').style.display = atk ? '' : 'none';
      el('acao-tempo').hidden = !atk;
      el('acao-golpes-wrap').style.display = manSel.value === 'rajada' ? '' : 'none';
      if (!atk) return;
      const a = anat();
      spdInp.value = String(a.ciclo);
      const dados = a.penDados.map((p, i) => `${i + 1}º ${p ? `${p}d6` : 'cheio'}`).join(' · ');
      const linha = TEMPO.sistema === 'pgr'
        ? `<b>Preparo ${a.preparo}</b> · <b>Golpe ${a.golpes}</b> · <b>Recuperação ${a.recuperacao}</b> = ${a.ciclo} Ticks`
        : `Resolve agora · <b>${a.ciclo} Ticks</b> até a próxima ação`;
      const quando = a.offs.map((o) => AGORA + o).join(', ');
      (el('acao-tempo') as HTMLElement).innerHTML =
        `<div>${linha}</div>
         <div class="muted">golpe${a.golpes > 1 ? 's' : ''} no Tick ${quando} · livre no ${AGORA + a.ciclo} · dados: ${esc(dados)}</div>
         ${a.aviso ? `<div class="ruim">${esc(a.aviso)}</div>` : ''}`;
    };
    manSel.onchange = syncTempo; golpesInp.oninput = syncTempo;

    const sync = () => {
      const atk = ehAtaque();
      el('acao-alvo-wrap').style.display = atk ? '' : 'none';
      el('acao-alcance-wrap').style.display = tipoSel.value === 'ataque' ? '' : 'none';
      el('acao-outro-wrap').style.display = (!atk || alvoSel.value === '__outro__') ? '' : 'none';
      outroInp.placeholder = atk ? 'nome do alvo / detalhe' : 'descreva a ação (opcional)';
      const alvo = atk ? alvoAtual() : null;
      const podeDano = tipoSel.value === 'ataque' && !!alvo && alvo.pv_max != null;
      el('acao-dano-wrap').style.display = podeDano ? '' : 'none';
      el('acao-rolar').hidden = !atk;
      // A conta que o mestre faria de cabeça: o número que o ataque precisa bater.
      const caixa = el('acao-conta') as HTMLElement;
      if (!atk || !alvo) { caixa.hidden = true; return; }
      const rz = RESUMO[alvo.id];
      let alvoDef: number | null = null, detalhe = '';
      if (tipoSel.value === 'ataque') {
        const d = defesaAtual(alvo, alcSel.value as 'cac' | 'dist');
        if (d) { alvoDef = d.total; detalhe = `base ${d.base}${d.ferimento ? ` · ferimento ${d.ferimento}` : ''}${d.cond ? ` · condições ${sinal(d.cond)}` : ''}`; }
      } else if (tipoSel.value === 'social') { alvoDef = rz?.defesaSocial ?? null; detalhe = 'Defesa Social'; }
      else { alvoDef = rz?.defesaMental ?? null; detalhe = 'Defesa Mental'; }
      const meuPool = r?.ataque || '—';
      caixa.hidden = false;
      caixa.innerHTML = alvoDef == null
        ? `<div>Defesa do alvo não registrada. Ajuste em <b>✎ editar</b>, ou resolva na mão.</div>`
        : `<div>Precisa <b>superar ${alvoDef}</b> <span class="muted">(${esc(detalhe)})</span></div>
           <div>Seu acerto: <b>${esc(meuPool)}</b>${aj.flat ? ` <span class="ruim">${sinal(aj.flat)}</span>` : ''}${aj.dados ? ` <span class="ruim">${sinal(aj.dados)}d6</span>` : ''}
             ${aj.ferimento ? `<span class="muted"> · ferimento ${sinal(aj.ferimento)}</span>` : ''}</div>
           ${(RESUMO[alvo.id]?.resistPerf && tipoSel.value === 'ataque') ? `<div class="muted">Gate de Perfuração do alvo: N${RESUMO[alvo.id].resistPerf} — abaixo disso o Perfurante resvala.</div>` : ''}`;
    };
    const syncTudo = () => { sync(); syncTempo(); };
    tipoSel.onchange = syncTudo; alvoSel.onchange = syncTudo; alcSel.onchange = syncTudo; syncTudo();

    el('acao-rolar-atq').onclick = () => {
      const alvo = alvoAtual();
      const d = alvo
        ? (tipoSel.value === 'ataque' ? defesaAtual(alvo, alcSel.value as 'cac' | 'dist')?.total
          : tipoSel.value === 'social' ? RESUMO[alvo.id]?.defesaSocial : RESUMO[alvo.id]?.defesaMental)
        : null;
      // Um golpe, uma rolagem. A rajada e a empunhadura dupla têm penalidade
      // PRÓPRIA por golpe (−1d6 acumulativo na rajada, −1d6 nas duas mãos da
      // dupla), então somá-las numa jogada só seria mentir na primeira e na
      // última ao mesmo tempo.
      const pen = tipoSel.value === 'ataque' ? anat().penDados : [0];
      const linhas = pen.map((p, i) => {
        const rolagem = rolarExpr(r?.ataque || '0d6', aj.dados + p, aj.flat);
        let veredito = '';
        if (d != null) {
          const erroPor = d - rolagem.total + 1;
          veredito = rolagem.total > d
            ? ` <span class="ok">acertou (${rolagem.total} &gt; ${d})</span>`
            : ` <span class="ruim">errou por ${erroPor}</span>${erroPor <= 3 ? ' <span class="muted">· cabe Quase-Acerto?</span>' : ''}`;
        }
        const rot = pen.length > 1 ? `<b>${i + 1}º</b>${p ? ` <span class="ruim">${p}d6</span>` : ''} ` : '';
        return `<div>${rot}${esc(descreverRolada(rolagem))}${veredito}</div>`;
      });
      (el('acao-res-atq') as HTMLElement).innerHTML = linhas.join('');
    };

    el('acao-rolar-dano').onclick = () => {
      const rolagem = rolarExpr(r?.dano || '0d6');
      danoInp.value = String(rolagem.total);
      const alvo = alvoAtual();
      const caixa = el('acao-dano-conta') as HTMLElement;
      caixa.hidden = false;
      if (alvo) {
        const rz = RESUMO[alvo.id];
        const cd = somarCondicoes(condsDe(alvo));
        const soak = (rz?.soak?.[CAT_SOAK[danoTipo.value]] ?? 0) + (cd.soak || 0);
        caixa.innerHTML = `${esc(descreverRolada(rolagem))} bruto · absorção ${soak} → <b>${Math.max(0, rolagem.total - soak)}</b> em ${esc(alvo.nome)}`;
      } else {
        caixa.innerHTML = esc(descreverRolada(rolagem));
      }
    };

    el('acao-cancelar').onclick = () => dlg.close();
    el('acao-confirmar').onclick = async () => {
      const spd = Math.max(0, parseInt(spdInp.value || '0', 10) || 0);
      const atk = ehAtaque();
      const alvo = atk ? alvoAtual() : null;
      const nomeAlvo = atk ? (alvoSel.value === '__outro__' ? (outroInp.value.trim() || 'alvo indefinido') : (alvo?.nome || 'alvo')) : '';
      const verbo = tipoSel.value === 'ataque' ? 'atacou' : tipoSel.value === 'social' ? 'pressionou' : 'invadiu a mente de';
      const txt = atk
        ? `${ator.nome} ${verbo} ${nomeAlvo}`
        : tipoSel.value === 'esperar'
          ? `${ator.nome} esperou${outroInp.value.trim() ? ` (${outroInp.value.trim()})` : ''}`
          : (outroInp.value.trim() ? `${ator.nome}: ${outroInp.value.trim()}` : `${ator.nome} agiu`);
      const bruto = Math.max(0, parseInt(danoInp.value || '0', 10) || 0);
      dlg.close();
      // A ação declarada, antes do Tick andar: ela nasce no Tick de AGORA, que
      // é onde o ator está, e é dela que a fita e a escada saem.
      // O tipo gravado é o que a manobra VIROU, e não o que se pediu: uma
      // rajada com arma de arremesso degenera para um golpe só, e guardá-la
      // como "rajada" faria a fita e o registro contarem uma história que não
      // aconteceu.
      const an = anat();
      const decl = tipoSel.value === 'ataque'
        ? declarar(ator.tick, an, {
            tipo: (an.golpes > 1 ? manSel.value : 'simples') as Manobra,
            arma: r?.arma || null,
            alvo: alvo?.id || null,
          })
        : null;
      await avancarTick(cid, spd, txt, decl);
      // A Guarda sob pressão: cada ataque recebido abre a guarda de quem o
      // recebe em −2, acumulando até o ciclo dele fechar. Conta o ataque, e não
      // o acerto: quem se defende gasta a guarda mesmo quando o golpe erra.
      if (alvo && tipoSel.value === 'ataque') await somarPressao(alvo.id, decl ? decl.golpes.length : 1);
      if (alvo && alvo.pv_max != null && bruto > 0 && tipoSel.value === 'ataque') {
        await aplicarDano(alvo.id, bruto, danoTipo.value);
        await carregar();
      }
    };
    dlg.showModal();
  }

  // =============================================================== revelar
  /**
   * A exceção de um combatente. Três escolhas com o mesmo desenho do painel
   * geral, mais uma opção que ele não tem: "como a mesa manda", que é o
   * estado normal e precisa ser fácil de voltar.
   */
  function abrirRevelarUm(cid: string) {
    const c = COMBS.find((x) => x.id === cid); if (!c) return;
    const dlg = el('rev1-dlg') as HTMLDialogElement;
    const rev = c.revelar || {};
    const padraoVida = REV.vidaInimigo === 'numero' ? 'barra e número'
      : REV.vidaInimigo === 'estado' ? 'só a palavra' : 'só a cor do retrato';

    (el('rev1-t') as HTMLElement).textContent = `O que veem de ${c.nome}`;
    (el('rev1-sub') as HTMLElement).textContent = c.tipo === 'pc'
      ? 'Este é um personagem do grupo: a ficha dele já está na mesa, e o card aparece inteiro para todos.'
      : 'Vale só para ele. Em branco, segue o painel da mesa.';
    (el('rev1-oculto') as HTMLInputElement).checked = !!c.oculto;

    const grupo = (nome: string, rot: string, ops: [string, string, string][], atual: string) =>
      `<div class="rev-h rev-h2">${rot}</div><div class="rev-ops">${ops.map(([v, t, d]) => `
        <label class="rev-op" title="${esc(d)}">
          <input type="radio" name="${nome}" value="${v}"${v === atual ? ' checked' : ''} />
          <span class="rev-op-corpo"><span class="rev-op-t">${t}</span><span class="rev-op-d">${esc(d)}</span></span>
        </label>`).join('')}</div>`;

    el('rev1-vida').innerHTML = c.tipo === 'pc' ? '' : grupo('r1-vida', 'Vida', [
      ['', 'Como a mesa manda', `Hoje: ${padraoVida}.`],
      ['numero', 'Barra e número', 'Só este mostra a conta, mesmo com a mesa fechada.'],
      ['estado', 'Só a palavra', 'Ferido, Grave, Caído.'],
      ['nada', 'Só a cor do retrato', 'Nada escrito.'],
    ], rev.vida || '');
    el('rev1-stats').innerHTML = c.tipo === 'pc' ? '' : grupo('r1-stats', 'Números de ataque e defesa', [
      ['', 'Como a mesa manda', `Hoje: ${REV.statsInimigo ? 'à vista' : 'escondidos'}.`],
      ['1', 'Mostrar', 'O grupo já estudou este: sabe o que ele acerta e o que ele aguenta.'],
      ['0', 'Esconder', 'Nem que a mesa esteja aberta.'],
    ], rev.stats == null ? '' : (rev.stats ? '1' : '0'));

    const marcado = (n: string) => (dlg.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement)?.value ?? '';
    const gravar = async (novo: any, oculto: boolean) => {
      dlg.close();
      const { error } = await upComb(cid, { revelar: novo, oculto });
      if (error) return uiErro('Erro: ' + error.message);
      await carregar();
    };
    el('rev1-cancelar').onclick = () => dlg.close();
    el('rev1-mesa').onclick = () => gravar({}, (el('rev1-oculto') as HTMLInputElement).checked);
    el('rev1-salvar').onclick = () => {
      const o: any = {};
      const v = marcado('r1-vida'); if (v) o.vida = v;
      const s = marcado('r1-stats'); if (s) o.stats = s === '1';
      return gravar(o, (el('rev1-oculto') as HTMLInputElement).checked);
    };
    dlg.showModal();
  }

  // ============================================================== reiniciar
  function abrirReiniciar() {
    const dlg = el('reset-dlg') as HTMLDialogElement;
    el('rs-cancelar').onclick = () => dlg.close();
    el('rs-ok').onclick = async () => {
      const on = (i: string) => (el(i) as HTMLInputElement).checked;
      const zTick = on('rs-tick'), zIni = on('rs-ini'), zPv = on('rs-pv'),
        zCond = on('rs-cond'), zFora = on('rs-fora'), zLog = on('rs-log');
      dlg.close();
      for (const c of COMBS) {
        const cols: any = {};
        // Zerar os Ticks apaga a ação junto: uma fita que aponta para o Tick 9
        // de um relógio que voltou ao zero é pior que fita nenhuma.
        if (zTick) { cols.tick = 0; cols.acao = {}; }
        if (zPv && c.pv_max != null) { cols.pv_atual = c.pv_max; if (c.energia_max != null) cols.energia_atual = c.energia_max; }
        if (zCond) cols.condicoes = [];
        if (zFora) cols.ativo = true;
        if (zIni) {
          cols.iniciativa = c.tipo === 'pc' && FICHAS[c.personagem_id]
            ? rolarIniciativaPC(FICHAS[c.personagem_id])
            : c.tipo === 'criatura' && MON[c.monstro_id] ? iniDeMonstro(MON[c.monstro_id]) : d6();
        }
        if (Object.keys(cols).length) await upComb(c.id, cols);
      }
      if (zLog) { LOG = []; await persistLog(); }
      await logar('Combate reiniciado.', 'sistema');
      await carregar();
    };
    dlg.showModal();
  }

  // ============================================================== encontros
  async function abrirEncontros() {
    const dlg = el('enc-dlg') as HTMLDialogElement;
    const { data } = await SB.from('encontros').select('*').eq('mesa_id', MESA_ID).order('criado_em', { ascending: false }).limit(40);
    const estadoDe = (e: any) => e.estado || (e.ativo ? 'ativo' : 'encerrado');
    el('enc-lista').innerHTML = (data || []).length ? (data || []).map((e: any) => {
      const st = estadoDe(e);
      return `<div class="enc-item" data-e="${e.id}">
        <span class="ei-e e-${st}">${st}</span>
        <span class="ei-n">${esc(e.nome)}</span>
        ${st !== 'ativo' ? '<button type="button" class="btn mini ei-ativar">Ativar</button>' : ''}
        <button type="button" class="btn-fant perigo ei-rm" title="Excluir">✕</button>
      </div>`;
    }).join('') : '<p class="vazio">Nenhum encontro registrado.</p>';

    el('enc-lista').querySelectorAll<HTMLElement>('.ei-ativar').forEach((b) => b.addEventListener('click', async () => {
      const eid = b.closest('.enc-item')!.getAttribute('data-e')!;
      dlg.close();
      await SB.from('encontros').update({ ativo: false }).eq('mesa_id', MESA_ID).eq('ativo', true);
      const upd: any = { ativo: true, estado: 'ativo' };
      let { error } = await SB.from('encontros').update(upd).eq('id', eid);
      if (error && /estado/i.test(error.message)) await SB.from('encontros').update({ ativo: true }).eq('id', eid);
      await carregar();
      RT?.avisar('encontro');
    }));
    el('enc-lista').querySelectorAll<HTMLElement>('.ei-rm').forEach((b) => b.addEventListener('click', async () => {
      const eid = b.closest('.enc-item')!.getAttribute('data-e')!;
      if (!await uiConfirmar('Excluir este encontro e tudo que estava nele?', { titulo: 'Excluir encontro', ok: 'Excluir', perigo: true })) return;
      dlg.close();
      await SB.from('encontros').delete().eq('id', eid);
      await carregar();
      RT?.avisar('encontro');
    }));
    const nomeInp = el('enc-novo-nome') as HTMLInputElement;
    el('enc-novo-prep').onclick = async () => { dlg.close(); await criarEncontro(nomeInp.value.trim() || 'Encontro', false); };
    el('enc-novo-agora').onclick = async () => { dlg.close(); await criarEncontro(nomeInp.value.trim() || 'Encontro', true); };
    el('enc-fechar').onclick = () => dlg.close();
    dlg.showModal();
  }

  main();
</script>
