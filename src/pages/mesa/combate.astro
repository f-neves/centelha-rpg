      if (error && /estado/i.test(error.message)) await SB.from('encontros').update({ ativo: false }).eq('id', ENC.id);
      await carregar();
    };
    el('add-pcs').onclick = adicionarPCs;
    el('add-criatura').onclick = () => abrirAdicionar('criatura');
    el('add-npc').onclick = () => abrirAdicionar('npc');
    el('add-avulso').onclick = () => abrirEditar({ tipo: 'custom', nome: '', grupo: 'inimigo', tick: 0, iniciativa: 0 }, null);
    (el('ver-ocultos') as HTMLInputElement).onchange = (e) => { VER_OCULTOS = (e.target as HTMLInputElement).checked; pintar(); };
    el('btn-recarregar').onclick = () => carregar();
