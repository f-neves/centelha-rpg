---
import Base from '../../layouts/Base.astro';
import MesaCab from '../../components/MesaCab.astro';
import { url } from '../../lib/site';
import { regras } from '../../lib/calc';
import CONDICOES from '../../data/condicoes.json';

// O escudo de papel tem quatro painéis e cabe o que cabe. Este não tem limite,
// então cabe tudo: as tabelas ficam calculadas no build, sem uma linha de JS.

// ---- Dificuldade: a régua e as âncoras ----
function distN(n: number): number[] {
  let d = [1];
  for (let i = 0; i < n; i++) {
    const nd = new Array(d.length + 6).fill(0);
    for (let a = 0; a < d.length; a++) for (let f = 1; f <= 6; f++) nd[a + f] += d[a] / 6;
    d = nd;
  }
  return d;
}
function totais(soma: number): [number, number][] {
  const n = Math.floor(soma / 2), flat = soma % 2 ? 2 : 0;
  const d = distN(n); const o: [number, number][] = [];
  for (let s = 0; s < d.length; s++) if (d[s] > 0) o.push([s + flat, d[s]]);
  return o;
}
const pSucesso = (soma: number, D: number) => totais(soma).reduce((p, [v, pr]) => p + (v > D ? pr : 0), 0);
const dadosStr = (soma: number) => { const n = Math.floor(soma / 2), flat = soma % 2 ? 2 : 0; return `${n}d6${flat ? ' +2' : ''}`; };
const somas = Array.from({ length: 13 }, (_, i) => i + 2); // 2..14
const regua = somas.map((s) => {
  const f = Math.round(s * 4 / 3), m = Math.round(s * 5 / 3), d = s * 2;
  return { soma: s, dados: dadosStr(s), f: { D: f, p: Math.round(pSucesso(s, f) * 100) }, m: { D: m, p: Math.round(pSucesso(s, m) * 100) }, d: { D: d, p: Math.round(pSucesso(s, d) * 100) } };
});

const ANCORAS = regras.dificuldade as { dif: number; desafio: string; aaltura: string }[];
const FERIMENTOS = regras.ferimentos as any[];
const CT = regras.combateTatico as any;
const PORTE = regras.porteAcerto as any;
const BLOQ = regras.bloqueioLimite as any;
const SANG = regras.sangramento as any;
const QA = regras.quaseAcerto as any;
const DANO = regras.dano as any;
const HORDA = regras.horda as any;
const ESC_HAB = regras.escalaHabilidade as any[];
const ESC_CENT = regras.escalaCentelha as any[];
const COND_GRUPOS = (CONDICOES as any).grupos as { id: string; nome: string }[];
const COND_LISTA = (CONDICOES as any).lista as any[];

const sinal = (n: number) => (n > 0 ? `+${n}` : String(n));
const modEfeito = (c: any) => {
  const p: string[] = [];
  if (c.acao) p.push(`ação ${sinal(c.acao)}`);
  if (c.dados) p.push(`${sinal(c.dados)}d6`);
  if (c.defesaCaC != null || c.defesaDist != null) {
    if ((c.defesaCaC ?? 0) !== (c.defesaDist ?? 0)) p.push(`Defesa ${sinal(c.defesaCaC ?? 0)} de perto / ${sinal(c.defesaDist ?? 0)} de longe`);
    else if (c.defesaCaC) p.push(`Defesa ${sinal(c.defesaCaC)}`);
  } else if (c.defesa) p.push(`Defesa ${sinal(c.defesa)}`);
  if (c.ataque) p.push(`acerto ${sinal(c.ataque)}`);
  if (c.velocidade) p.push(`Velocidade ${sinal(c.velocidade)}`);
  if (c.soak) p.push(`Absorção ${sinal(c.soak)}`);
  if (c.porRodada) p.push(`−${c.porRodada} por rodada`);
  if (c.foraDeCombate) p.push('fora de combate');
  return p.join(' · ') || '—';
};

const PORTES = ['minusculo', 'pequeno', 'medio', 'grande', 'enorme', 'imenso', 'colossal'];
const PORTE_NOME: Record<string, string> = {
  minusculo: 'Minúsculo', pequeno: 'Pequeno', medio: 'Médio', grande: 'Grande',
  enorme: 'Enorme', imenso: 'Imenso', colossal: 'Colossal',
};
---
<Base title="Referência" largura="wide" descricao="O escudo do mestre: todas as tabelas de consulta rápida.">
  <MesaCab aba="referencia">

    <p class="ref-intro muted">Tudo que um escudo de papel teria, sem o limite de quatro painéis. Cada bloco abre e
      fecha; o que você usa mais fica aberto. Os números saem de <code>regras.json</code>, então mudam junto com o sistema.</p>

    <nav class="ref-indice">
      <a href="#dificuldade">Dificuldade</a><a href="#ferimentos">Ferimentos</a><a href="#condicoes">Condições</a>
      <a href="#combate">Modificadores</a><a href="#porte">Porte</a><a href="#dano">Dano &amp; Absorção</a>
      <a href="#qa">Quase-Acerto</a><a href="#horda">Hordas</a><a href="#escalas">Escalas</a>
    </nav>

    <!-- ============ DIFICULDADE ============ -->
    <section class="ref-bloco" id="dificuldade">
      <h2>Dificuldade</h2>
      <p class="ref-nota">Rola-se <strong>[(Atributo + Habilidade) ÷ 2]d6</strong>, com <strong>+2</strong> se a soma for
        ímpar. É <strong>sucesso quando o total supera</strong> a Dificuldade; cada <strong>6 pontos acima</strong> é uma
        <strong>Margem</strong>.</p>

      <h3>Âncoras</h3>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th class="num">Dif</th><th>Desafio</th><th>À altura de</th></tr></thead>
        <tbody>{ANCORAS.map((a) => (<tr><td class="num">{a.dif}</td><td>{a.desafio}</td><td class="muted">{a.aaltura}</td></tr>))}</tbody>
      </table></div>

      <h3>Régua relativa <small>· quando a dificuldade sai do próprio personagem</small></h3>
      <p class="ref-nota">Fácil ×4/3 · Média ×5/3 · Difícil ×2 sobre a soma Atributo + Habilidade. A porcentagem é a
        chance real de passar.</p>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th class="num">Soma</th><th>Pool</th><th class="num">Fácil</th><th class="num">%</th>
          <th class="num">Média</th><th class="num">%</th><th class="num">Difícil</th><th class="num">%</th></tr></thead>
        <tbody>{regua.map((r) => (
          <tr><td class="num">{r.soma}</td><td>{r.dados}</td>
            <td class="num">{r.f.D}</td><td class="num muted">{r.f.p}%</td>
            <td class="num">{r.m.D}</td><td class="num muted">{r.m.p}%</td>
            <td class="num">{r.d.D}</td><td class="num muted">{r.d.p}%</td></tr>))}</tbody>
      </table></div>
      <p class="ref-nota"><a href={url('mestre')}>Área do Mestre ›</a> tem o mapa de calor completo e os exemplos.</p>
    </section>

    <!-- ============ FERIMENTOS ============ -->
    <section class="ref-bloco" id="ferimentos">
      <h2>Ferimentos, Sangramento e queda</h2>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th class="num">Vida restante</th><th>Estado</th><th class="num">Ações</th><th class="num">Defesa</th></tr></thead>
        <tbody>{FERIMENTOS.map((f) => (
          <tr><td class="num">{f.minPct === f.maxPct ? f.minPct : `${f.minPct}–${f.maxPct}`}%</td>
            <td>{f.estado}</td>
            <td class="num">{f.penAcao == null ? '—' : (f.penAcao || '0')}</td>
            <td class="num">{f.penDefesa == null ? '—' : (f.penDefesa || '0')}</td></tr>))}</tbody>
      </table></div>
      <h3>Sangramento</h3>
      <p class="ref-nota">Começa no estado <strong>{SANG.gatilhoEstado}</strong>: <strong>{SANG.valorEstado}</strong> de
        Letal no início da rodada do personagem, já <strong>ignorando a Absorção</strong>. A etiqueta de sangramento vai
        até <strong>{SANG.valorTagMax}</strong>, e o total tem teto de <strong>{SANG.teto}</strong>.
        Estabilizar: <strong>{SANG.estabilizar.pericia}</strong> contra Dif <strong>{SANG.estabilizar.dif}</strong>,
        ou <em>{SANG.estabilizar.alternativa}</em>.</p>
      <p class="ref-nota muted">{SANG.nota}</p>
    </section>

    <!-- ============ CONDIÇÕES ============ -->
    <section class="ref-bloco" id="condicoes">
      <h2>Condições</h2>
      <p class="ref-nota">O rastreador de combate aplica estas com um clique, e o número entra sozinho na conta do
        acerto e da Defesa. Aqui elas ficam para consulta.</p>
      {COND_GRUPOS.map((g) => (
        <>
          <h3>{g.nome}</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Condição</th><th>Efeito</th><th>O que é</th></tr></thead>
            <tbody>{COND_LISTA.filter((c) => c.grupo === g.id).map((c) => (
              <tr><td><span class={`cond cond-${c.cor || 'neutro'}`}>{c.icone && <span class="cond-i">{c.icone}</span>}<span class="cond-n">{c.nome}</span></span></td>
                <td class="col-efeito">{modEfeito(c)}</td>
                <td class="muted">{c.nota}</td></tr>))}</tbody>
          </table></div>
        </>
      ))}
    </section>

    <!-- ============ MODIFICADORES ============ -->
    <section class="ref-bloco" id="combate">
      <h2>Modificadores de combate</h2>
      <p class="ref-nota">{CT.nota} Teto de <strong>±{CT.modificadorCap}</strong> somando tudo.</p>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th>Situação</th><th class="num">Valor</th><th>Onde incide</th><th>Quando</th></tr></thead>
        <tbody>{CT.modificadores.map((m: any) => (
          <tr><td>{m.nome}</td><td class="num">{sinal(m.valor)}</td>
            <td class="muted">{m.alvo === 'defesa-propria' ? 'a sua Defesa' : 'a Defesa do alvo'}</td>
            <td class="muted">{m.nota}</td></tr>))}</tbody>
      </table></div>

      <h3>Bloqueio: quando não dá</h3>
      <p class="ref-nota">{BLOQ.nota}</p>
      <ul class="ref-lista">
        <li>Porte: bloqueia até <strong>{BLOQ.porteMaxDiferenca}</strong> categoria acima, <strong>+{BLOQ.centelhaSobePorte}</strong> por ponto de Centelha, <strong>+{BLOQ.escudoGrandeBonusPorte}</strong> com escudo grande plantado.</li>
        <li>Força: trava se a do atacante for <strong>≥ {BLOQ.forcaRatio}×</strong> a do defensor <em>e</em> pelo menos <strong>{BLOQ.forcaGapMin}</strong> pontos acima.</li>
        {BLOQ.centelhaIgnoraForca && <li>Centelha do defensor <strong>≥</strong> a do atacante ignora a regra de Força.</li>}
      </ul>
    </section>

    <!-- ============ PORTE ============ -->
    <section class="ref-bloco" id="porte">
      <h2>Porte no acerto</h2>
      <p class="ref-nota">{PORTE.nota}</p>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th class="num">Diferença de categorias</th>{PORTE.porDiferenca.map((_: number, i: number) => (<th class="num">{i}</th>))}</tr></thead>
        <tbody><tr><td>Modificador ao acerto</td>{PORTE.porDiferenca.map((v: number) => (<td class="num">{v ? `±${v}` : '0'}</td>))}</tr></tbody>
      </table></div>
      <p class="ref-nota muted">Ordem dos portes: {PORTE.ordem.map((p: string) => PORTE_NOME[p] || p).join(' · ')}. Teto de {PORTE.capCategorias} categorias.</p>

      <h3>Couraça de Porte</h3>
      <p class="ref-nota">{DANO.couracaPorte.nota}</p>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th>Porte</th><th class="num">Couraça (Corte e Perfuração)</th><th class="num">Gate natural de Perfuração</th></tr></thead>
        <tbody>{PORTES.map((p) => (
          <tr><td>{PORTE_NOME[p]}</td>
            <td class="num">{DANO.couracaPorte[p]?.couraca ?? 0}</td>
            <td class="num">{DANO.couracaPorte[p]?.resistPerf ? `N${DANO.couracaPorte[p].resistPerf}` : '—'}</td></tr>))}</tbody>
      </table></div>
      <h3>Vida por porte</h3>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th>Porte</th><th class="num">Base</th><th class="num">× Vigor</th><th class="num">Exemplo (Vigor 3)</th></tr></thead>
        <tbody>{PORTES.map((p) => {
          const t = (regras.derivados as any).pv.porte[p];
          return (<tr><td>{PORTE_NOME[p]}</td><td class="num">{t.base}</td><td class="num">×{t.vigorMult}</td>
            <td class="num muted">{t.base + 3 * t.vigorMult}</td></tr>);
        })}</tbody>
      </table></div>
    </section>

    <!-- ============ DANO ============ -->
    <section class="ref-bloco" id="dano">
      <h2>Os três modos e a Absorção</h2>
      <p class="ref-nota">{DANO.nota}</p>
      <div class="tab-wrap"><table class="tab-mesa">
        <thead><tr><th>Modo</th><th>Sigla</th><th>Absorção natural</th><th>Absorção da armadura</th><th>Passa por gate?</th></tr></thead>
        <tbody>{DANO.modos.map((m: any) => (
          <tr><td>{m.nome}</td><td class="num">{m.sigla}</td>
            <td>{m.natural === 'vigor' ? 'Vigor + Centelha' : 'só a Centelha'}</td>
            <td>{m.soakArmadura}</td><td>{m.gate ? 'sim' : 'não'}</td></tr>))}</tbody>
      </table></div>
      <h3>Gate de Perfuração</h3>
      <p class="ref-nota">{DANO.gatePerfuracao.nota}</p>
    </section>

    <!-- ============ QUASE-ACERTO ============ -->
    <section class="ref-bloco" id="qa">
      <h2>Quase-Acerto</h2>
      <p class="ref-nota">Margem = <strong>{QA.margem}</strong>. Dano = <strong>{QA.dano}</strong>.
        {QA.ignoraSoak ? ' O raspão ignora a Absorção normal.' : ''}</p>
      <div class="ref-duas">
        <div>
          <h3>Pela arma</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Classe</th><th class="num">Dado</th><th class="num">Bônus à margem</th><th class="num">Dano do raspão</th></tr></thead>
            <tbody>{Object.entries(QA.porClasseArma).map(([k, v]: any) => {
              const dado = Object.entries(QA.pesoPorDado).find(([, c]) => c === k)?.[0];
              return (<tr><td>{k}</td><td class="num">{dado ? `${dado}d6` : '—'}</td>
                <td class="num">+{v.bonus}</td><td class="num">{v.dano}</td></tr>);
            })}</tbody>
          </table></div>
        </div>
        <div>
          <h3>Pela armadura do alvo</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Classe</th><th class="num">Bônus à margem</th><th class="num">Redução do raspão</th></tr></thead>
            <tbody>{Object.entries(QA.porClasseArmadura).map(([k, v]: any) => (
              <tr><td>{k}</td><td class="num">+{v.bonus}</td><td class="num">−{v.reducao}</td></tr>))}</tbody>
          </table></div>
        </div>
      </div>
      <p class="ref-nota muted">{QA.nota}</p>
    </section>

    <!-- ============ HORDAS ============ -->
    <section class="ref-bloco" id="horda">
      <h2>Hordas</h2>
      <p class="ref-nota">{HORDA.nota}</p>
      <div class="ref-duas">
        <div>
          <h3>Magnitude</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Membros</th><th class="num">Magnitude</th></tr></thead>
            <tbody>{HORDA.magnitude.tabela.map((t: any) => (<tr><td>{t.membros}</td><td class="num">{t.magnitude}</td></tr>))}</tbody>
          </table></div>
          <p class="ref-nota muted">{HORDA.magnitude.formula}</p>
        </div>
        <div>
          <h3>Vida por capanga</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Tipo</th><th class="num">Vida de horda</th></tr></thead>
            <tbody>{Object.entries(HORDA.pv.porTier).map(([k, v]: any) => (<tr><td>{k}</td><td class="num">{v}</td></tr>))}</tbody>
          </table></div>
          <p class="ref-nota muted">{HORDA.pv.nota}</p>
        </div>
      </div>
      <ul class="ref-lista">
        <li><strong>Ataques</strong> — {HORDA.ataquesPorRodada}. {HORDA.ataque}</li>
        <li><strong>Defesa</strong> — {HORDA.defesaNota}</li>
        <li><strong>Baixas</strong> — {HORDA.baixas}</li>
        <li><strong>Fim</strong> — {HORDA.fim}</li>
      </ul>
    </section>

    <!-- ============ ESCALAS ============ -->
    <section class="ref-bloco" id="escalas">
      <h2>As escalas</h2>
      <div class="ref-duas">
        <div>
          <h3>Habilidade</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th class="num">Nível</th><th>Rótulo</th><th>O que é</th></tr></thead>
            <tbody>{ESC_HAB.map((e) => (<tr><td class="num">{e.nivel}</td><td>{e.rotulo}</td><td class="muted">{e.texto}</td></tr>))}</tbody>
          </table></div>
        </div>
        <div>
          <h3>Centelha</h3>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th class="num">Nível</th><th>Rótulo</th><th>O que é</th></tr></thead>
            <tbody>{ESC_CENT.map((e) => (<tr><td class="num">{e.nivel}</td><td>{e.rotulo}</td><td class="muted">{e.texto}</td></tr>))}</tbody>
          </table></div>
        </div>
      </div>
      <p class="ref-nota">Capítulos completos: <a href={url('regras/combate')}>Combate Físico</a> ·
        <a href={url('regras/vida-ferimentos-cura')}>Vida, Ferimentos &amp; Cura</a> ·
        <a href={url('regras/quase-acerto')}>Quase-Acerto</a> ·
        <a href={url('regras/acoes-e-sistema')}>Ações &amp; Sistema</a> ·
        <a href={url('regras/defesas')}>As Três Defesas</a> ·
        <a href={url('regras/acoes-resistir')}>Resistir</a>.</p>
    </section>

  </MesaCab>
</Base>

<style is:global>
  .ref-intro { font-size: var(--fs-rotulo); max-width: 46rem; margin: 0 0 1rem; }
  .ref-indice { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: 1.4rem; }
  .ref-indice a { font-family: 'Cinzel'; font-size: var(--fs-micro); text-decoration: none;
    padding: .18rem .6rem; border: 1px solid var(--rule); border-radius: 999px; color: var(--ink-soft); }
  .ref-indice a:hover { border-color: var(--accent); color: var(--accent-texto); }
  .ref-bloco { margin-bottom: 2rem; scroll-margin-top: 3.4rem; }
  .ref-bloco > h2 { font-size: var(--fs-h3); border-bottom: 1px solid var(--rule); padding-bottom: .25rem; margin: 0 0 .6rem; }
  .ref-bloco h3 { font-family: 'Cinzel'; font-size: var(--fs-rotulo); color: var(--accent-strong);
    margin: 1rem 0 .35rem; }
  .ref-bloco h3 small { font-weight: 400; font-family: 'EB Garamond'; font-size: var(--fs-micro); color: var(--ink-soft); }
  .ref-nota { font-size: var(--fs-rotulo); margin: .3rem 0 .6rem; max-width: 52rem; }
  .ref-lista { font-size: var(--fs-rotulo); margin: .3rem 0 .6rem; padding-left: 1.1rem; }
  .ref-lista li { margin-bottom: .25rem; }
  .ref-duas { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; align-items: start; }
  @media (max-width: 820px) { .ref-duas { grid-template-columns: 1fr; } }
  .tab-mesa .col-efeito { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ref-bloco .tab-mesa td { vertical-align: top; }
</style>

<script>
  // As tabelas já vieram prontas do build; o que falta é abrir a mesa para o
  // cabeçalho, as abas e a trilha saberem em qual campanha estamos.
  import { abrirMesa } from '../../lib/mesa-core';
  abrirMesa('referencia');
</script>
