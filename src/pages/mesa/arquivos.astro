---
import Base from '../../layouts/Base.astro';
import MesaCab from '../../components/MesaCab.astro';
---
<Base title="Arquivos" largura="full" telaCheia descricao="Handouts, documentos e links da mesa.">
  <MesaCab aba="arquivos">

    <section class="bloco">
      <div class="bloco-cab">
        <h2>Handouts &amp; documentos</h2>
        <div class="bloco-acoes" id="aq-acoes"></div>
      </div>
      <p class="muted nota-mini" id="aq-dica" hidden>Marque <strong>todos</strong> para liberar o arquivo à mesa inteira,
        ou abra <strong>por jogador</strong> para entregar a carta só a quem ela é endereçada. Mapas ficam na aba Mapas.</p>
      <ul id="aq-lista" class="aq-lista"><li class="vazio">Carregando…</li></ul>
    </section>

  </MesaCab>

  <dialog id="link-dlg" class="mesa-dlg">
    <form method="dialog">
      <h3>Adicionar um link</h3>
      <label>Nome <input type="text" id="lk-nome" placeholder="Playlist da campanha" /></label>
      <label>Endereço <input type="text" id="lk-url" placeholder="https://…" /></label>
      <label class="chk"><input type="checkbox" id="lk-vis" /> visível para todos os jogadores</label>
      <div class="dlg-btns">
        <button type="button" class="btn" id="lk-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="lk-salvar">Adicionar</button>
      </div>
    </form>
  </dialog>
</Base>

<style is:global>
  .aq-lista { list-style: none; padding: 0; display: flex; flex-direction: column; gap: .2rem; }
  .aq-lista li { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap;
    padding: .45rem .2rem; border-bottom: 1px solid var(--rule); }
  .aq-icone { font-size: var(--fs-aux); opacity: .7; width: 1.4rem; text-align: center; }
  .aq-nome { flex: 1; min-width: 10rem; color: var(--accent-texto); text-decoration: none; font-size: var(--fs-aux); }
  .aq-nome:hover { text-decoration: underline; }
  .aq-tipo { font-size: var(--fs-micro); text-transform: uppercase; color: var(--ink-soft); }
  .aq-vis { display: inline-flex; align-items: center; gap: .25rem; font-size: var(--fs-micro); color: var(--ink-soft); }
  .aq-alvo { font-size: var(--fs-micro); color: var(--ink-soft); }
  .aq-alvo summary { cursor: pointer; }
  .aq-alvo label { display: flex; align-items: center; gap: .3rem; padding: .12rem 0 .12rem .6rem; }
  .nota-mini { font-size: var(--fs-micro); }
  .mesa-dlg label.chk { flex-direction: row; align-items: center; gap: .4rem; text-transform: none; }
</style>

<script>
  import { abrirMesa, esc, nomesDe } from '../../lib/mesa-core';
  import { uiConfirmar, uiErro } from '../../lib/ui-dialog';

  const el = (i: string) => document.getElementById(i)!;
  let SB: any, ID = '', MESTRE = false, EU = '';
  let MEMBROS: { id: string; nome: string }[] = [];

  const ICONE = (a: any) => {
    if (a.url) return '🔗';
    const t = String(a.tipo || '');
    if (t.startsWith('image/')) return '🖼';
    if (t.includes('pdf')) return '📕';
    if (t.startsWith('audio/')) return '♪';
    if (t.startsWith('video/')) return '▶';
    return '📄';
  };

  async function main() {
    const ctx = await abrirMesa('arquivos');
    if (!ctx) return;
    SB = ctx.sb; ID = ctx.id; MESTRE = ctx.ehMestre; EU = ctx.user.id;
    if (MESTRE) {
      el('aq-dica').hidden = false;
      el('aq-acoes').innerHTML = `<label class="btn primary mini">Enviar arquivo<input type="file" id="aq-file" hidden /></label>
        <button class="btn mini" id="aq-link">+ link</button>`;
      (el('aq-file') as HTMLInputElement).addEventListener('change', (e) => subir((e.target as HTMLInputElement).files?.[0]));
      el('aq-link').addEventListener('click', abrirLink);
      const { data } = await SB.from('mesa_membros').select('user_id, papel').eq('mesa_id', ID).eq('papel', 'jogador');
      const nomes = await nomesDe(SB, (data || []).map((m: any) => m.user_id));
      MEMBROS = (data || []).map((m: any) => ({ id: m.user_id, nome: nomes[m.user_id] || '(jogador)' }));
    }
    await carregar();
  }

  async function subir(file?: File) {
    if (!file) return;
    const seguro = file.name.replace(/[^\w.\-]+/g, '_');
    const path = `${ID}/${Date.now()}-${seguro}`;
    const { error } = await SB.storage.from('mesa').upload(path, file, { contentType: file.type });
    if (error) return uiErro('Erro ao enviar: ' + error.message);
    const { error: e2 } = await SB.from('arquivos').insert({
      mesa_id: ID, dono_id: EU, nome: file.name, storage_path: path,
      bucket: 'mesa', tipo: file.type, categoria: 'handout-mestre', visivel_jogadores: false,
    });
    if (e2) return uiErro('Enviado, mas erro ao registrar: ' + e2.message);
    await carregar();
  }

  function abrirLink() {
    const dlg = el('link-dlg') as HTMLDialogElement;
    (el('lk-nome') as HTMLInputElement).value = '';
    (el('lk-url') as HTMLInputElement).value = '';
    (el('lk-vis') as HTMLInputElement).checked = false;
    el('lk-cancelar').onclick = () => dlg.close();
    el('lk-salvar').onclick = async () => {
      const url = (el('lk-url') as HTMLInputElement).value.trim();
      if (!url) return;
      dlg.close();
      const { error } = await SB.from('arquivos').insert({
        mesa_id: ID, dono_id: EU, nome: (el('lk-nome') as HTMLInputElement).value.trim() || url,
        url, bucket: 'mesa', tipo: 'link', categoria: 'handout-mestre',
        visivel_jogadores: (el('lk-vis') as HTMLInputElement).checked,
      });
      if (error) return uiErro(/url/i.test(error.message)
        ? 'A coluna "url" ainda não existe. Rode supabase/migracao-7.sql.'
        : 'Erro: ' + error.message);
      await carregar();
    };
    dlg.showModal();
  }

  async function carregar() {
    const ul = el('aq-lista');
    const { data, error } = await SB.from('arquivos').select('*').eq('mesa_id', ID).eq('bucket', 'mesa')
      .order('criado_em', { ascending: false });
    if (error) { ul.innerHTML = `<li class="erro">${esc(error.message)}</li>`; return; }
    // Mapas têm aba própria; aqui fica o resto.
    const itens = (data || []).filter((a: any) => a.categoria !== 'mapa');
    if (!itens.length) {
      ul.innerHTML = `<li class="vazio">${MESTRE
        ? 'Nenhum arquivo ainda. Envie handouts, cartas, documentos, ou cole um link.'
        : 'O mestre ainda não compartilhou arquivos.'}</li>`;
      return;
    }
    ul.innerHTML = itens.map((a: any) => {
      const alvo = a.visivel_para || [];
      const picker = (MESTRE && MEMBROS.length) ? `<details class="aq-alvo"><summary>por jogador${alvo.length ? ` (${alvo.length})` : ''}</summary>
        ${MEMBROS.map((m) => `<label><input type="checkbox" class="aq-alvo-cb" data-u="${m.id}"${alvo.includes(m.id) ? ' checked' : ''}/> ${esc(m.nome)}</label>`).join('')}</details>` : '';
      return `<li data-aq="${a.id}" data-path="${esc(a.storage_path || '')}" data-url="${esc(a.url || '')}">
        <span class="aq-icone">${ICONE(a)}</span>
        <a href="#" class="aq-nome">${esc(a.nome)}</a>
        <span class="aq-tipo">${esc(a.url ? 'link' : (a.tipo || '').split('/')[1] || '')}</span>
        ${MESTRE ? `<label class="aq-vis" title="Liberar para todos"><input type="checkbox" class="aq-vis-cb"${a.visivel_jogadores ? ' checked' : ''}/> todos</label>
          ${picker}<button class="btn-fant perigo aq-rm" title="Remover">✕</button>` : ''}
      </li>`;
    }).join('');

    ul.querySelectorAll<HTMLElement>('.aq-nome').forEach((a) => a.addEventListener('click', async (e) => {
      e.preventDefault();
      const li = a.closest('li')!;
      if (li.dataset.url) { window.open(li.dataset.url, '_blank', 'noopener'); return; }
      const { data: s } = await SB.storage.from('mesa').createSignedUrl(li.dataset.path!, 3600);
      if (s?.signedUrl) window.open(s.signedUrl, '_blank', 'noopener');
    }));
    if (!MESTRE) return;
    ul.querySelectorAll<HTMLInputElement>('.aq-vis-cb').forEach((cb) => cb.addEventListener('change', async () => {
      await SB.from('arquivos').update({ visivel_jogadores: cb.checked }).eq('id', cb.closest('li')!.dataset.aq);
    }));
    ul.querySelectorAll<HTMLElement>('.aq-alvo').forEach((det) => det.querySelectorAll<HTMLInputElement>('.aq-alvo-cb').forEach((cb) =>
      cb.addEventListener('change', async () => {
        const li = cb.closest('li')!;
        const ids = [...det.querySelectorAll<HTMLInputElement>('.aq-alvo-cb')].filter((x) => x.checked).map((x) => x.dataset.u);
        await SB.from('arquivos').update({ visivel_para: ids }).eq('id', li.dataset.aq);
        det.querySelector('summary')!.textContent = 'por jogador' + (ids.length ? ` (${ids.length})` : '');
      })));
    ul.querySelectorAll<HTMLElement>('.aq-rm').forEach((b) => b.addEventListener('click', async () => {
      const li = b.closest('li')!;
      if (!await uiConfirmar('Remover este item? Ele sai da mesa para todo mundo.', { titulo: 'Remover', ok: 'Remover', perigo: true })) return;
      if (li.dataset.path) await SB.storage.from('mesa').remove([li.dataset.path]);
      await SB.from('arquivos').delete().eq('id', li.dataset.aq);
      await carregar();
    }));
  }

  main();
</script>
