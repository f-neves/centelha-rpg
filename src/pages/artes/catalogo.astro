---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
import VoltarAoTopo from '../../components/VoltarAoTopo.astro';
import { loadData } from '../../lib/data';
const d = await loadData();
const elem = d.artes.filter((a) => a.categoria === 'elemental');
const univ = d.artes.filter((a) => a.categoria === 'universal');
const txtDe = (a: any) => (a.nome + ' ' + a.niveis.map((n: any) => n.nome + ' ' + n.efeito).join(' ')).toLowerCase();
---
<Base title={`As ${d.artes.length} Artes`} largura="wide" descricao="O catálogo das Artes da feitiçaria: os seis níveis de cada uma, com exemplos do que aquele patamar alcança.">
  <p class="muted cinzel" style="letter-spacing:.3em;text-transform:uppercase;font-size: var(--fs-micro);margin:0">Capítulo XV · <a href={url('artes/regras')}>As Artes</a></p>
  <h1>As {d.artes.length} Artes</h1>
  <p class="lead">Os seis níveis de cada Arte são <em>exemplos de alocação típica</em> daquele patamar, não a regra: a mecânica de verdade vem dos <a href={url('artes/regras') + '#parametros'}>parâmetros</a>. Sob cada nível vão outros exemplos do que aquele patamar alcança, gastando os pontos de formas diferentes.</p>

  <div class="filtros panel">
    <div class="f-linha">
      <label class="f-busca">Buscar <input type="search" data-fa="q" placeholder="fogo, cura, sorte…" /></label>
      <button class="btn" type="button" id="limpar-filtros">Limpar</button>
    </div>
    {[['Elementais', elem], ['Universais', univ]].map(([titulo, lista]) => (
      <div class="f-grupo">
        <button class="f-tit" type="button" data-grupo={titulo}>{titulo}</button>
        <div class="f-chips">
          {(lista as any[]).map((a) => (
            <label class="f-chip"><input type="checkbox" data-fa="arte" value={a.id} />{a.nome}</label>
          ))}
        </div>
      </div>
    ))}
  </div>

  {[['Artes Elementais', elem], ['Artes Universais', univ]].map(([titulo, lista]) => (
    <section class="arte-sec">
      <h2 style="text-align:center;border:none">{titulo}</h2>
      <div class="grid-cards" style="grid-template-columns:repeat(auto-fill,minmax(min(var(--card-min-lg),100%),1fr))">
        {(lista as any[]).map((a) => (
          <div class="panel arte" id={a.id} data-permalink data-cat={a.categoria} data-txt={txtDe(a)}>
            <div class="arte-head">
              <span class="cinzel arte-nome">{a.nome}</span>
              <button class="bm" data-bm={`arte:${a.id}`} title="Marcar" aria-label={`Marcar ${a.nome}`}>☆</button>
            </div>
            <ul class="niveis">
              {a.niveis.map((n: any) => (
                <li>
                  <span class="lvl">{n.nivel}</span>
                  <span class="nv-corpo">
                    <strong>{n.nome}</strong>: {n.efeito}{n.custo?.mana ? <span class="muted"> ({n.custo.mana} Mana)</span> : null}
                    {n.exemplos?.length ? <span class="nv-ex muted">{n.exemplos.map((e: string) => <span>{e}</span>)}</span> : null}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}

  <nav class="artes-nav" data-pagefind-ignore>
    <a class="btn" href={url('artes/efeitos')}>← Efeitos Especiais</a>
    <a class="btn" href={url('artes/regras')}>Regras das Artes</a>
  </nav>
  <VoltarAoTopo />
</Base>

<style>
  .filtros { margin: .6rem 0; display: flex; flex-direction: column; gap: .5rem; }
  .f-linha { display: flex; align-items: center; gap: .6rem; }
  .f-busca { font-family: 'Cinzel'; font-size: var(--fs-micro); color: var(--ink-soft); flex: 1; }
  .f-busca input { min-width: 12rem; }
  .f-grupo { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .f-tit { font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .06em; text-transform: uppercase;
    color: var(--ink-soft); background: none; border: none; cursor: pointer; padding: 0; width: 6rem; text-align: left; }
  .f-tit:hover { color: var(--accent-texto); }
  .f-chips { display: flex; flex-wrap: wrap; gap: .3rem .35rem; flex: 1; }
  .f-chip { font-size: var(--fs-rotulo); border: 1px solid var(--panel-border); border-radius: 999px;
    padding: .1rem .6rem; cursor: pointer; user-select: none; background: var(--bg); }
  .f-chip:hover { border-color: var(--accent); }
  .f-chip.on { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .f-chip input { position: absolute; opacity: 0; width: 0; height: 0; }
  /* mesmo desenho dos cartões de Efeito Especial: corpo em 1.18rem, sem itálico,
     cabeçalho separado por filete e a lista com a bolinha do nível na coluna da esquerda */
  .arte { display: flex; flex-direction: column; gap: .4rem; font-size: var(--fs-corpo); line-height: 1.45; }
  .arte-head { display: flex; align-items: center; gap: .5rem; border-bottom: 1px solid var(--rule); padding-bottom: .35rem; }
  .arte-nome { color: var(--accent-texto); font-size: var(--fs-h3); flex: 1; }
  .arte-conj { color: var(--ink-soft); margin: 0; }
  .arte .muted { font-style: normal; }
  .niveis { list-style: none; margin: .1rem 0 0; padding: .4rem 0 0; border-top: 1px solid var(--rule); }
  .niveis > li { display: grid; grid-template-columns: 1.6rem 1fr; gap: 0 .5rem; margin-bottom: .35rem; }
  .niveis .lvl { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%;
    background: var(--gold); color: var(--on-accent); font-family: 'Cinzel'; font-size: var(--fs-rotulo); }
  .nv-ex { display: block; font-size: .82em; margin-top: .1rem; }
  .nv-ex span { display: block; position: relative; padding-left: .8rem; }
  .nv-ex span::before { content: '·'; position: absolute; left: .15rem; color: var(--accent-texto); }
  .bm { background: none; border: none; cursor: pointer; font-size: var(--fs-corpo); color: var(--gold); }
  @media (max-width: 900px) { .bm { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; } }
  .bm[aria-pressed='true'] { color: var(--accent-texto); }
  .artes-nav { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: space-between; margin: 2rem 0 .5rem; }
</style>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.arte[data-cat]'));
  const secs = Array.from(document.querySelectorAll<HTMLElement>('.arte-sec'));
  const caixas = () => Array.from(document.querySelectorAll<HTMLInputElement>('[data-fa="arte"]'));
  const q = () => (document.querySelector('[data-fa="q"]') as HTMLInputElement).value.trim().toLowerCase();
  const escolhidas = () => caixas().filter((c) => c.checked).map((c) => c.value);
  const apply = () => {
    const t = q(), ids = escolhidas();
    for (const el of cards) el.style.display = (!ids.length || ids.includes(el.id)) && (!t || el.dataset.txt!.includes(t)) ? '' : 'none';
    for (const s of secs) s.style.display = Array.from(s.querySelectorAll<HTMLElement>('.arte[data-cat]')).some((el) => el.style.display !== 'none') ? '' : 'none';
    for (const c of caixas()) c.closest('.f-chip')!.classList.toggle('on', c.checked);
  };
  document.querySelectorAll('[data-fa]').forEach((e) => e.addEventListener('input', apply));
  // o título do grupo marca ou desmarca o grupo inteiro
  document.querySelectorAll<HTMLButtonElement>('.f-tit').forEach((b) => b.addEventListener('click', () => {
    const cx = Array.from(b.parentElement!.querySelectorAll<HTMLInputElement>('[data-fa="arte"]'));
    const marcar = cx.some((c) => !c.checked);
    cx.forEach((c) => { c.checked = marcar; });
    apply();
  }));
  document.getElementById('limpar-filtros')!.addEventListener('click', () => {
    caixas().forEach((c) => { c.checked = false; });
    (document.querySelector('[data-fa="q"]') as HTMLInputElement).value = '';
    apply();
  });
  apply();
</script>
