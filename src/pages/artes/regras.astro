---
import Base from '../../layouts/Base.astro';
import FormasPop from '../../components/FormasPop.astro';
import VoltarAoTopo from '../../components/VoltarAoTopo.astro';
import { url, numeralDe } from '../../lib/site';
import { loadData } from '../../lib/data';
import { formaDe } from '../../lib/artes-fmt';
import regras from '../../data/regras.json';
const d = await loadData();
const G = (regras as any).arcano.improviso.graus;
const ESTICAR = (regras as any).arcano.esticar;
// Linhas da tabela de graus (0 a 6), na ordem em que aparecem na página. O Volume tem
// duas réguas, como a Duração: a da manifestação é a do improviso, a da matéria é a do
// Efeito que cria elemento que fica. A Área é só dos Efeitos, e está de saída (virou molde).
const LINHAS_GRAU: [string, string[], string][] = [
  ['Alcance', G.alcance, ''],
  ['Volume · manifestação', G.volumeImproviso, 'lado da base, no improviso'],
  ['Volume · matéria', G.volume, 'lado, no Efeito Especial'],
  ['Área', G.area, 'diâmetro, no Efeito Especial'],
  ['Alvos', G.alvos, ''],
  ['Dano', G.dano, ''],
  ['Duração breve', G.duracaoBreve, ''],
  ['Duração longa', G.duracaoLonga, ''],
];
const GRAU_COLS = [0, 1, 2, 3, 4, 5, 6];
const COMB = (regras as any).arcano.improviso.combinacoes;
const MANI = (regras as any).arcano.improviso.manifestacao;
const MOLDES = (regras as any).arcano.moldes;
const TEMPO = (regras as any).arcano.tempoDaArte;
const RITUAL = (regras as any).arcano.ritual;
const FONTE = (regras as any).arcano.fonteElemental;
const CURA = (regras as any).arcano.cura;
const FRAQ = (regras as any).arcano.fraquezas;
const RECUP = (regras as any).arcano.recuperacaoMana;
// conjurações de exemplo: [descrição, contas, total]
const EX_CONTA: [string, string, number][] = [
  ['Acender uma vela: tudo no grau 0', '0', 0],
  ['Toque ardente: Dano 1 (1d6)', '1', 1],
  ['Dardo: Alcance 3 (4 m) + Dano 2 (2d6)', '3 + 2', 5],
  ['Labareda de 12 Ticks: Volume 3 (3 m de base) + Dano 2 (2d6) + Duração 2 (12 Ticks)', '3 + 2 + 2', 7],
];
---
<Base title="Regras das Artes" largura="wide" descricao="Como se conjura no Centelha: parâmetros, custo em Mana, a fonte do elemento, esticar, Rituais e o que o alvo opõe.">
  <p class="muted cinzel" style="letter-spacing:.3em;text-transform:uppercase;font-size: var(--fs-micro);margin:0">Capítulo {numeralDe('artes/regras')}</p>
  <h1>Regras das Artes</h1>
  <p class="lead">Como se conjura, o que custa e o que o alvo pode fazer a respeito. Cada <strong>Arte</strong> tem <strong>6 níveis</strong>: não é preciso <strong>Centelha</strong> para tocar a magia (o mortal conjura com a Mana, uma reserva própria com o valor da Força de Vontade, que não se mistura com ela), e o <strong>nível máximo</strong> de cada Arte é <strong>Centelha + 2</strong>, até 6 (Centelha 0 → 2; 1 → 3; 2 → 4; 3 → 5; 4, 5 ou 6 → 6); a profundidade (o nível da Arte) você compra e evolui um a um. Dentro do seu nível, você monta o efeito girando os parâmetros. O panorama, os nomes da feitiçaria e as Tradições de ensino estão em <a href={url('arcano')}>O Arcano</a>.</p>

  <nav class="artes-nav artes-nav-topo" data-pagefind-ignore>
    <a class="cap-card" href={url('artes/efeitos')}>
      <span class="cc-tit">Efeitos Especiais</span>
      <span class="cc-sub">Os {d.efeitos.length} efeitos com nome próprio, agrupados por Arte: o que fazem, o que custam em XP e quais parâmetros você escolhe na conjuração.</span>
    </a>
    <a class="cap-card" href={url('artes/catalogo')}>
      <span class="cc-tit">As {d.artes.length} Artes</span>
      <span class="cc-sub">O catálogo: os seis níveis de cada Arte, com exemplos do que aquele patamar alcança.</span>
    </a>
  </nav>

  <div class="callout regra"><span class="lbl">Os dois modos</span><strong>Feitiço</strong>, rápido, em combate: custa Ticks como uma ação (<strong>5</strong> quando o maior grau investido na conjuração vai de 0 a 3, <strong>6</strong> quando é 4, <strong>7</strong> quando é 5 ou 6; o nível da Arte de quem conjura não entra nessa conta), mais o Mana. Esses Ticks são de <strong>preparo</strong>, e a Arte sai no <a href="#tempo"><strong>último</strong></a> deles, ao contrário da ação comum, que resolve no primeiro. &nbsp; <strong><a href="#rituais">Ritual</a></strong>, estendido: a conjuração passa a levar minutos ou horas e, em troca, sai mais barato ou alcança mais alto do que a sua Arte permitiria.</div>

  <section class="arcano-regras">
    <h2>Como se aprende uma Arte</h2>
    <p>Nenhuma Arte se aprende no vácuo: você chega a ela por uma <a href={url('arcano') + '#trilhas'}>Tradição de Feitiçaria</a>, o método que explica <em>como</em> aquele personagem passou a lançá-la, e que ele declara por Arte. A mesma Arte chega por Tradições diferentes (a do erudito, a do monge, a do pactuário). Comprar e subir uma Arte custa <strong>XP</strong> como qualquer traço, e a Tradição <strong>não muda número nenhum</strong>: ela diz o que é preciso ter vivido para aquilo fazer sentido, e com que cara o feitiço sai. Preço: cada nível de Arte custa 10 + 5 × o nível em XP, pagos um a um (a Arte 4 inteira custa 15 + 20 + 25 + 30 = 90 XP). Cada Efeito Especial custa 4 × o nível dele, pago cheio, sem somar os de baixo.</p>
  </section>

  <section class="arcano-regras">
    <h2>Conjurar e resistir</h2>
    <p>O que o alvo opõe depende da <em>natureza</em> do efeito: magia que voa se esquiva, magia que invade o corpo se aguenta, magia que toca a mente se enfrenta com a alma.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Natureza do efeito</th><th>Como o alvo resiste</th><th>Exemplos</th></tr></thead>
        <tbody>
          <tr><td><strong>Dano e projéteis</strong></td><td><strong>Defesa</strong> para acertar (Esquiva; Bloqueio só contra o que deixou matéria no mundo); depois o dano − <strong>Absorção</strong></td><td>dardo de fogo, raio, lança de gelo</td></tr>
          <tr><td><strong>Corpo e veneno</strong></td><td><strong>Vigor + Resistência</strong> (fortitude)</td><td>transmutação, doença, frio que enrijece, paralisia</td></tr>
          <tr><td><strong>Mente e alma</strong></td><td><strong>Defesa Mental</strong> (passiva), ou <strong>Defesa Social</strong> nos Efeitos que persuadem; sem projétil, quem conjura rola Influência + uma Habilidade social</td><td>medo, fascínio, ilusão, domínio</td></tr>
          <tr><td><strong>Aprisionamento e contato</strong></td><td><strong>Defesa</strong> para prender; o preso fica <strong>Preso</strong> (não se desloca, mas age) e escapa com <strong>Força + Atletismo</strong> contra a Dificuldade do Efeito, uma tentativa por ação</td><td>correntes, lama, agarrão telecinético</td></tr>
          <tr><td><strong>Em aliado, objeto ou cenário</strong></td><td>sem resistência</td><td>cura, escudo, muralha, luz</td></tr>
        </tbody>
      </table>
    </div>
    <p><strong>A Arte que toca a mente.</strong> Sem projétil, conjurar contra a mente é uma interação com o alvo: quem conjura rola <strong>Influência + uma Habilidade social</strong>, com 2 × o menor entre a Centelha e essa Habilidade (a conta do ataque social, em <a href={url('regras/relacoes-sociais')}>Relações Sociais</a>, sem o Acerto da Abordagem). Cada Efeito diz a Habilidade na linha <strong>Conjurar</strong>; uma Arte da mente usada sem Efeito (as Sugestões, Simpatias e Encantos do catálogo) pede a Habilidade que a intenção declarada pedir, escolhida pelo Mestre como em qualquer cena social. O nível da Arte não entra na jogada: compra o tamanho do efeito (Alvos, Área, Duração). O total é comparado à Defesa que o Efeito nomeia na linha <strong>Dificuldade</strong>: a <strong>Defesa Social</strong> nos Efeitos que persuadem (Boa Impressão), a <strong>Defesa Mental</strong> nos que impõem, plantam ou apagam algo na cabeça do alvo (ver <a href={url('regras/defesas')}>As Três Defesas</a>). Com projétil, o efeito que sai da mão e voa até o alvo, a jogada é Percepção + Acerto Arcano, contra a Defesa Mental. Um total vale para todos os alvos do Efeito: na área, ele é comparado à Defesa de cada um que estiver dentro; nos Efeitos em você, à de cada um que olhar enquanto durar; no Círculo, à de cada criatura da categoria que tentar cruzar a linha. A Margem é a de sempre, cada 6 pontos acima da Defesa, e a Força de Vontade do alvo vale como em toda Defesa. Como o alvo resiste depois que o total passou está em <strong>Resistir a um Efeito da mente</strong>, logo abaixo.</p>
    <p><strong>Resistir a um Efeito da mente.</strong> Depois que o total superou a Defesa, o alvo pode pagar Força de Vontade para recusar o Efeito: <strong>1 + Margem</strong>, com teto de 4, fora do limite de 1 ponto por ação (ver <a href={url('regras/defesas')}>As Três Defesas</a>, Queimar Força de Vontade). Com Margem 1 ou mais, pode pagar só <strong>1</strong>: o Efeito pega, mas dura <strong>um grau a menos na régua de Duração dele</strong>, a Breve ou a Longa da tabela dos parâmetros, a que o Efeito usa. Se o Efeito já está no menor grau, pagar 1 o anula: é o caso do Efeito sem linha de Duração, que é instantâneo, grau 0. Exemplos: um Pavor de Duração breve 3 (24 Ticks) cai para 12 Ticks; uma Sugestão Plantada de Duração longa 2 (1 hora) cai para 10 minutos; um Pavor de Duração breve 1 (6 Ticks) cai para o grau 0, no máximo 1 Tick; Esquecer, que não tem Duração, é anulado. Nos Efeitos contra a Defesa Social (Boa Impressão), o Resistir é o de Relações Sociais, que só tem recusar ou ceder: quem paga 1 + Margem recusa, e quem não paga sofre o Efeito inteiro.</p>
    <p><strong>A Centelha nas Artes.</strong> A jogada de uma Arte soma 2 × o menor entre a sua Centelha e a Habilidade da jogada, como toda jogada do livro: no efeito mirado, Percepção + Acerto Arcano + 2 × o menor entre a Centelha e o Acerto Arcano (Acerto Arcano 0 dá bônus 0); na Arte que toca a mente sem projétil, o mesmo com a Habilidade social do Efeito. O dano soma a sua Centelha inteira, uma vez por pulso, em toda Arte que causa dano. O alvo usa as próprias regras: as Defesas já trazem a Centelha dele, e jogadas como Vigor + Resistência somam 2 × o menor entre a Centelha e a Habilidade usada. O desconto de Mana é outra conta: a Centelha inteira, tirada do total de pontos. O mortal (Centelha 0) não soma nada em nenhuma das três. Exemplo: Veil, Centelha 4, Percepção 3 e Acerto Arcano 3, rola 3d6 + 6; com Acerto Arcano 0 rolaria 1d6 + 2.</p>
    <p><strong>Área é a exceção da primeira linha.</strong> O que voa se esquiva, mas o que ocupa espaço não: contra área não há Esquiva nem Bloqueio, e a saída é <a href="#tempo">sair do lugar</a>, gastando um Tick do próprio deslocamento se você ainda tem a vez, ou um Tick por metro se já agiu. A jogada é a mesma nos dois casos.</p>
    <p>Bloquear uma Arte segue o mesmo critério da armadura. O que deixou matéria no mundo se bloqueia como a arma de arremesso do mesmo tamanho, pelo <a href={url('regras/combate')}>Cap. IX</a>: o Projétil Conjurado de Gelo, Água ou Terra, do tamanho de flecha, virote, dardo ou adaga, é projétil rápido, e só se bloqueia com escudo hábil e estando apto; a lança de gelo arremessada e a pedra grande (a da Terra, a do Arremesso de Forças) são lentas, e se bloqueiam com arma, escudo ou mão. Fogo, raio, luz, sombra e o gelo que evapora ao acertar não se bloqueiam: contra eles, só Esquiva. Quando o Efeito diz que é imbloqueável (a Prisão, a Paralisia), vale o Efeito.</p>
    <p>Nos Efeitos com Ataque, a Dificuldade é a de resistir ao efeito secundário; o Mestre pede o teste que fizer sentido.</p>
    <p class="muted">A <strong>Margem</strong> funciona como no combate: cada 6 pontos acima da resistência rende +1d6 de dano ou um efeito mais forte. A armadura só protege contra dano <strong>físico</strong>: o que decide é se o efeito deixou matéria no mundo. Fogo, raio e o gelo que evapora ao acertar são absorvidos só pela Centelha; a lança de gelo que se pega na mão, ou o cascalho que a Terra arranca do chão, entram nas trilhas normais. Nos Efeitos vale o mesmo critério. O que é feito de Gelo, Água ou Terra e acerta como corpo (o projétil, a arma, as lascas) é matéria, e a armadura absorve normalmente, no modo do formato. O dano de Fogo, Raio, Luz e Sombra só a Centelha de quem recebe absorve, e a resistência ao elemento corta pela metade o que passar.</p>
    <p class="muted">Dentro de uma ação Longa (<a href={url('regras/acoes-e-sistema#longa')}>Cap. VIII</a>), que não rola, o Efeito só conta se durar o intervalo inteiro, ou se for relançado sem falha, pagando a Mana a cada vez. Cada +1d6 de bônus do Efeito vale +3, e um bônus fixo entra como o próprio valor. Nova rolagem e bônus atado a uma rolagem só (como o de Maré da Sorte) não valem na Longa.</p>

    <h2 id="parametros">Os parâmetros</h2>
    <p>Você não decora feitiços prontos: você <strong>monta</strong> cada conjuração investindo pontos nos parâmetros. Cada grau custa <strong>1 ponto</strong>, e nenhum parâmetro passa do <strong>nível da Arte</strong> que você tem.</p>
    <p><strong>O grau 0 é o piso de tudo, e é grátis.</strong> Toque, uma manifestação mínima do elemento, nenhum alvo escolhido, nenhum dano, instantâneo. Um feitiço inteiro no grau 0 custa zero pontos, e é assim que se acende uma vela.</p>
    <p class="muted">A tabela abaixo vale para as <strong>Artes elementais</strong> e, até cada uma ganhar régua própria, também para as universais: Alcance, Alvos, Área e as duas Durações saem daqui, e os parâmetros de efeito (Dano, Cura, Bônus, Absorção) estão em cada Efeito. A Cura é a exceção: tem régua própria (<a href="#cura">A economia da Cura</a>).</p>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Parâmetro</th>{GRAU_COLS.map((g) => <th>{g}</th>)}</tr></thead>
        <tbody>
          {LINHAS_GRAU.map(([nome, vals, escopo]) => (
            <tr>
              <td>
                <strong data-formas={formaDe(nome)} tabindex={formaDe(nome) ? 0 : undefined}>{nome}</strong>
                {escopo && <small class="p-escopo">{escopo}</small>}
              </td>
              {vals.map((v) => <td>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout regra"><span class="lbl">O Volume tem duas réguas</span>
      {G.notaVolumeImproviso}
    </div>
    <p class="muted">A régua da matéria em números redondos: {G.volumeAncora.map((a: string, i: number) => `grau ${i}, ${a}`).join(' · ')}.</p>

    <div class="callout regra"><span class="lbl">Área ou Volume, nunca as duas</span>
      {G.notaAreaOuVolume}
    </div>
    <p>{G.volumePorEstado.nota}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Estado</th><th>Volume</th><th>Artes</th><th>Por quê</th></tr></thead>
        <tbody>
          {G.volumePorEstado.tabela.map((e: any) => (
            <tr><td><strong>{e.estado}</strong></td><td>{e.fator}</td><td>{e.artes}</td><td class="muted">{e.porque}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="formula">{G.volumePorEstado.exemplo}</p>
    <p class="muted">{G.volumePorEstado.notaGranular} Sobre as Escolas, ver <a href={url('arcano') + '#escolas'}>O Arcano</a>.</p>
    <p class="muted">{G.notaVolume}</p>
    <p class="muted">{G.notaArea}</p>
    <p class="muted">{G.notaAlcance}</p>
    <p class="muted">{G.notaAlvos}</p>

    <h2 id="combinacoes">O que o improviso pode combinar</h2>
    <p>{COMB.nota}</p>
    <p>{COMB.definicoes}</p>
    <div class="callout regra"><span class="lbl">As três travas</span>
      <strong>1.</strong> {COMB.areaNuncaColocada}<br />
      <strong>2.</strong> {COMB.duracaoPedeConcentracao}<br />
      <strong>3.</strong> {COMB.teto}
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Improviso</th><th>O que paga</th><th>Como se manifesta</th><th>Quem é atingido</th></tr></thead>
        <tbody>
          {COMB.lista.map((c: any) => (
            <tr><td><strong>{c.nome}</strong></td><td>{c.paga}</td><td>{c.forma}</td><td>{c.atinge}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout regra"><span class="lbl">O que sai de graça</span>
      {COMB.grauZero}
    </div>
    <p><strong>Sustentar cobra a cada 6 Ticks.</strong> Cada janela de 6 Ticks gasta a ação daquele lance e não cobra Mana: a Duração se paga uma vez, na conjuração. A janela não se soma à Duração comprada: é a Duração sendo sustentada, e quem para de sustentar perde o resto. A janela é de 6 Ticks mesmo quando a conjuração levou 5, porque é a régua da Duração (6, 12, 24 Ticks) que a define. Sustentar {COMB.concentracao.acao}, {COMB.concentracao.posicao}, e {COMB.concentracao.defesa}. Ao sofrer dano, {COMB.concentracao.aoSofrerDano}.</p>
    <p>A Duração 1 de um sustentado compra só presença: a chama fica de pé 6 Ticks e fere quem estiver nela no fim da janela. Quem sair antes do 6º Tick não leva o pulso. Para ferir duas vezes é preciso Duração 2 (12 Ticks, dois pulsos).</p>
    <ul class="fraq">
      {COMB.consequencias.map((x: string) => <li>{x}</li>)}
    </ul>
    <p class="muted">{COMB.escopo}</p>

    <h2 id="manifestacao">Como a Arte crua se manifesta</h2>
    <p>{MANI.nota}</p>
    <div class="callout regra"><span class="lbl">Quem paga a base</span>
      {MANI.oParametro}
    </div>
    <ol class="mani-regra">
      {MANI.regra.map((r: string) => <li>{r}</li>)}
    </ol>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Grau</th>{GRAU_COLS.map((g) => <th>{g}</th>)}</tr></thead>
        <tbody>
          <tr><td><strong>Lado da base</strong></td>{MANI.ladoBase.map((v: string) => <td>{v}</td>)}</tr>
        </tbody>
      </table>
    </div>
    <p class="formula mat">{MANI.formula}</p>
    <p class="muted">{MANI.formulaNota}</p>

    <h3>As três aberturas</h3>
    <p>{MANI.aberturas.porque}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Abertura</th><th>Distância</th><th>Lado do triângulo</th><th>Volume</th><th>Fração</th></tr></thead>
        <tbody>
          {MANI.aberturas.tabela.map((a: any) => (
            <tr><td><strong>{a.abertura}</strong></td><td>{a.distancia}</td><td>{a.lado}</td><td>{a.volume}</td><td class="muted">{a.fracao}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">{MANI.aberturas.nota}</p>

    <div class="callout regra"><span class="lbl">A trava das fatias</span>
      {MANI.travaFatias.regra}
      <ul class="fraq">
        {MANI.travaFatias.consequencias.map((c: string) => <li>{c}</li>)}
      </ul>
    </div>

    <h3>O que sobe e o que desce quando se abre</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Botão</th><th>O que sobe</th><th>O que desce</th></tr></thead>
        <tbody>
          {MANI.botoes.tabela.map((b: any) => (
            <tr><td><strong>{b.botao}</strong></td><td>{b.sobe}</td><td>{b.desce}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{MANI.botoes.cercarSe}</p>

    <h3>As duas alturas: o ápice e o pé da base</h3>
    <p>{MANI.alturas.regra}</p>
    <p class="muted">{MANI.alturas.exemplo}</p>
    <p class="muted">{MANI.alturas.deGraca}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ápice</th><th>A face de baixo é</th><th>Toca o chão</th></tr></thead>
        <tbody>
          {MANI.alturas.tabela.map((t: any) => (
            <tr><td><strong>{t.apice}</strong></td><td>{t.faceDeBaixo}</td><td>{t.tocaOChao}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{MANI.alturas.consequencia}</p>

    <p class="formula">{MANI.estadoNoLado.formula}</p>
    <p class="muted">{MANI.estadoNoLado.nota}</p>

    <div class="callout regra"><span class="lbl">O que a manifestação não faz</span>
      <ul class="fraq">
        {MANI.naoFaz.map((n: string) => <li>{n}</li>)}
      </ul>
    </div>
    <p class="muted">{MANI.escopo}</p>

    <h2 id="moldes">Os moldes: o chão se compra por forma</h2>
    <p>{MOLDES.nota}</p>
    <p class="muted">{MOLDES.porque}</p>
    <div class="callout regra"><span class="lbl">A fronteira</span>
      {MOLDES.fronteira.nota}<br />
      <strong>Improviso:</strong> {MOLDES.fronteira.improviso}<br />
      <strong>Efeito Especial:</strong> {MOLDES.fronteira.efeito}
    </div>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Molde</th><th>Compra</th>{GRAU_COLS.map((g) => <th>{g}</th>)}</tr></thead>
        <tbody>
          {MOLDES.lista.map((m: any) => (
            <>
              <tr><td><strong>{m.nome}</strong></td><td class="muted">{m.compra}</td>{m.escala.map((v: string) => <td>{v}</td>)}</tr>
              {m.hexagonos && (
