---
import Base from '../../layouts/Base.astro';
import FormasPop from '../../components/FormasPop.astro';
import VoltarAoTopo from '../../components/VoltarAoTopo.astro';
import { url } from '../../lib/site';
import { loadData } from '../../lib/data';
import { formaDe } from '../../lib/artes-fmt';
import regras from '../../data/regras.json';
const d = await loadData();
const G = (regras as any).arcano.improviso.graus;
const ESTICAR = (regras as any).arcano.esticar;
// Linhas da tabela de graus (0 a 6), na ordem em que aparecem na página. O Volume tem
// duas réguas, como a Duração: a da manifestação é a do improviso, a da matéria é a do
// Efeito que cria elemento que fica. A Área é só dos Efeitos, e está de saída (virou molde).
const LINHAS_GRAU: [string, string[], string][] = [
  ['Alcance', G.alcance, ''],
  ['Volume · manifestação', G.volumeImproviso, 'lado da base, no improviso'],
  ['Volume · matéria', G.volume, 'lado, no Efeito Especial'],
  ['Área', G.area, 'diâmetro, no Efeito Especial'],
  ['Alvos', G.alvos, ''],
  ['Dano', G.dano, ''],
  ['Duração breve', G.duracaoBreve, ''],
  ['Duração longa', G.duracaoLonga, ''],
];
const GRAU_COLS = [0, 1, 2, 3, 4, 5, 6];
const COMB = (regras as any).arcano.improviso.combinacoes;
const MANI = (regras as any).arcano.improviso.manifestacao;
const MOLDES = (regras as any).arcano.moldes;
const TEMPO = (regras as any).arcano.tempoDaArte;
const RITUAL = (regras as any).arcano.ritual;
const FONTE = (regras as any).arcano.fonteElemental;
const CURA = (regras as any).arcano.cura;
const FRAQ = (regras as any).arcano.fraquezas;
const RECUP = (regras as any).arcano.recuperacaoMana;
// conjurações de exemplo: [descrição, contas, total]
const EX_CONTA: [string, string, number][] = [
  ['Acender uma vela: tudo no grau 0', '0', 0],
  ['Toque ardente: Dano 1 (1d6)', '1', 1],
  ['Dardo: Alcance 3 (4 m) + Dano 2 (2d6)', '3 + 2', 5],
  ['Labareda de dois turnos: Volume 3 (50 cm de lado) + Dano 2 (2d6) + Duração 2 (2 turnos)', '3 + 2 + 2', 7],
];
---
<Base title="Regras das Artes" largura="wide" descricao="Como se conjura no Centelha: parâmetros, custo em Mana, a fonte do elemento, esticar, Rituais e o que o alvo opõe.">
  <p class="muted cinzel" style="letter-spacing:.3em;text-transform:uppercase;font-size: var(--fs-micro);margin:0">Capítulo XV</p>
  <h1>Regras das Artes</h1>
  <p class="lead">Como se conjura, o que custa e o que o alvo pode fazer a respeito. Cada <strong>Arte</strong> tem <strong>6 níveis</strong>: basta <strong>Centelha &gt; 0</strong> (qualquer fagulha) para tocar a magia; a profundidade (o nível da Arte) você compra e evolui um a um. Dentro do seu nível, você monta o efeito girando os parâmetros. O panorama, os nomes da feitiçaria e as Trilhas de ensino estão em <a href={url('arcano')}>O Arcano</a>.</p>

  <nav class="artes-nav artes-nav-topo" data-pagefind-ignore>
    <a class="cap-card" href={url('artes/efeitos')}>
      <span class="cc-tit">Efeitos Especiais</span>
      <span class="cc-sub">Os {d.efeitos.length} efeitos com nome próprio, agrupados por Arte: o que fazem, o que custam em XP e quais parâmetros você escolhe no cast.</span>
    </a>
    <a class="cap-card" href={url('artes/catalogo')}>
      <span class="cc-tit">As {d.artes.length} Artes</span>
      <span class="cc-sub">O catálogo: os seis níveis de cada Arte, com exemplos do que aquele patamar alcança.</span>
    </a>
  </nav>

  <div class="callout regra"><span class="lbl">Os dois modos</span><strong>Feitiço</strong>, rápido, em combate: custa Ticks como uma ação (<strong>5</strong> nos níveis 1 a 3, <strong>6</strong> no 4, <strong>7</strong> nos 5 e 6), mais o Mana. Esses Ticks são de <strong>preparo</strong>, e a Arte sai no <a href="#tempo"><strong>último</strong></a> deles, ao contrário da ação comum, que resolve no primeiro. &nbsp; <strong>Ritual</strong>, estendido: o cast passa a levar minutos ou horas e, em troca, sai mais barato ou alcança mais alto do que a sua Arte permitiria.</div>

  <section class="arcano-regras">
    <h2>Como se aprende uma Arte</h2>
    <p>Nenhuma Arte se aprende no vácuo: você chega a ela por uma <a href={url('arcano') + '#trilhas'}>Trilha de Feitiçaria</a>, o caminho que explica <em>como</em> aquele personagem passou a lançá-la. A mesma Arte tem Trilhas diferentes (a do erudito, a do monge, a do pactuário), e cada uma cobra o seu preço em treino e em ficção. Comprar e subir uma Arte custa <strong>XP</strong> como qualquer traço; a Trilha diz o que mais é preciso ter vivido para que aquilo faça sentido. O mapa de cada Arte com suas Trilhas vem num próximo passo.</p>
  </section>

  <section class="arcano-regras">
    <h2>Conjurar e resistir</h2>
    <p>O que o alvo opõe depende da <em>natureza</em> do efeito: magia que voa se esquiva, magia que invade o corpo se aguenta, magia que toca a mente se enfrenta com a alma.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Natureza do efeito</th><th>Como o alvo resiste</th><th>Exemplos</th></tr></thead>
        <tbody>
          <tr><td><strong>Dano e projéteis</strong></td><td><strong>Defesa</strong> (Esquiva) para acertar; depois o dano − <strong>Absorção</strong></td><td>dardo de fogo, raio, lança de gelo</td></tr>
          <tr><td><strong>Corpo e veneno</strong></td><td><strong>Vigor + Convicção</strong> (fortitude)</td><td>transmutação, doença, frio que enrijece, paralisia</td></tr>
          <tr><td><strong>Mente e alma</strong></td><td><strong>Defesa Mental</strong> (passiva)</td><td>medo, fascínio, ilusão, domínio</td></tr>
          <tr><td><strong>Aprisionamento e contato</strong></td><td><strong>Defesa</strong> para prender; escapar com <strong>Força/Atletismo</strong> vs o nível</td><td>correntes, lama, agarrão telecinético</td></tr>
          <tr><td><strong>Em aliado, objeto ou cenário</strong></td><td>sem resistência</td><td>cura, escudo, muralha, luz</td></tr>
        </tbody>
      </table>
    </div>
    <p><strong>Área é a exceção da primeira linha.</strong> O que voa se esquiva, mas o que ocupa espaço não: contra área não há Esquiva nem Bloqueio, e a saída é <a href="#tempo">sair do lugar</a>, de graça na própria vez ou pagando Ticks fora dela.</p>
    <p class="muted">A <strong>Margem</strong> funciona como no combate: cada 6 pontos acima da resistência rende +1d6 de dano ou um efeito mais forte. A armadura só protege contra dano <strong>físico</strong>: o que decide é se o efeito deixou matéria no mundo. Fogo, raio e o gelo que evapora ao acertar são absorvidos só pela Centelha; a lança de gelo que se pega na mão, ou o cascalho que a Terra arranca do chão, entram nas trilhas normais.</p>

    <h2 id="parametros">Os parâmetros</h2>
    <p>Você não decora feitiços prontos: você <strong>monta</strong> cada conjuração investindo pontos nos parâmetros. Cada grau custa <strong>1 ponto</strong>, e nenhum parâmetro passa do <strong>nível da Arte</strong> que você tem.</p>
    <p><strong>O grau 0 é o piso de tudo, e é grátis.</strong> Toque, uma manifestação mínima do elemento, nenhum alvo escolhido, nenhum dano, instantâneo. Um feitiço inteiro no grau 0 custa zero pontos, e é assim que se acende uma vela.</p>
    <p class="muted">A tabela abaixo vale para as <strong>Artes elementais</strong>. As demais Artes têm parâmetros próprios, definidos caso a caso.</p>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Parâmetro</th>{GRAU_COLS.map((g) => <th>{g}</th>)}</tr></thead>
        <tbody>
          {LINHAS_GRAU.map(([nome, vals, escopo]) => (
            <tr>
              <td>
                <strong data-formas={formaDe(nome)} tabindex={formaDe(nome) ? 0 : undefined}>{nome}</strong>
                {escopo && <small class="p-escopo">{escopo}</small>}
              </td>
              {vals.map((v) => <td>{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout regra"><span class="lbl">O Volume tem duas réguas</span>
      {G.notaVolumeImproviso}
    </div>
    <p class="muted">A régua da matéria em números redondos: {G.volumeAncora.map((a: string, i: number) => `grau ${i}, ${a}`).join(' · ')}.</p>

    <div class="callout regra"><span class="lbl">Área ou Volume, nunca as duas</span>
      {G.notaAreaOuVolume}
    </div>
    <p>{G.volumePorEstado.nota}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Estado</th><th>Volume</th><th>Artes</th><th>Por quê</th></tr></thead>
        <tbody>
          {G.volumePorEstado.tabela.map((e: any) => (
            <tr><td><strong>{e.estado}</strong></td><td>{e.fator}</td><td>{e.artes}</td><td class="muted">{e.porque}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="formula">{G.volumePorEstado.exemplo}</p>
    <p class="muted">{G.volumePorEstado.notaGranular} Sobre as Escolas, ver <a href={url('arcano') + '#escolas'}>O Arcano</a>.</p>
    <p class="muted">{G.notaVolume}</p>
    <p class="muted">{G.notaArea}</p>
    <p class="muted">{G.notaAlcance}</p>
    <p class="muted">{G.notaAlvos}</p>

    <h2 id="combinacoes">O que o improviso pode combinar</h2>
    <p>{COMB.nota}</p>
    <p>{COMB.definicoes}</p>
    <div class="callout regra"><span class="lbl">As três travas</span>
      <strong>1.</strong> {COMB.areaNuncaColocada}<br />
      <strong>2.</strong> {COMB.duracaoPedeConcentracao}<br />
      <strong>3.</strong> {COMB.teto}
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Improviso</th><th>O que paga</th><th>Como se manifesta</th><th>Quem é atingido</th></tr></thead>
        <tbody>
          {COMB.lista.map((c: any) => (
            <tr><td><strong>{c.nome}</strong></td><td>{c.paga}</td><td>{c.forma}</td><td>{c.atinge}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout regra"><span class="lbl">O que sai de graça</span>
      {COMB.grauZero}
    </div>
    <p><strong>Sustentar cobra por turno.</strong> {COMB.concentracao.acao}, {COMB.concentracao.posicao}, e {COMB.concentracao.defesa}. Ao sofrer dano, {COMB.concentracao.aoSofrerDano}.</p>
    <ul class="fraq">
      {COMB.consequencias.map((x: string) => <li>{x}</li>)}
    </ul>
    <p class="muted">{COMB.escopo}</p>

    <h2 id="manifestacao">Como a Arte crua se manifesta</h2>
    <p>{MANI.nota}</p>
    <div class="callout regra"><span class="lbl">Quem paga a base</span>
      {MANI.oParametro}
    </div>
    <ol class="mani-regra">
      {MANI.regra.map((r: string) => <li>{r}</li>)}
    </ol>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Grau</th>{GRAU_COLS.map((g) => <th>{g}</th>)}</tr></thead>
        <tbody>
          <tr><td><strong>Lado da base</strong></td>{MANI.ladoBase.map((v: string) => <td>{v}</td>)}</tr>
        </tbody>
      </table>
    </div>
    <p class="formula mat">{MANI.formula}</p>
    <p class="muted">{MANI.formulaNota}</p>

    <h3>As três aberturas</h3>
    <p>{MANI.aberturas.porque}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Abertura</th><th>Distância</th><th>Lado do triângulo</th><th>Volume</th><th>Fração</th></tr></thead>
        <tbody>
          {MANI.aberturas.tabela.map((a: any) => (
            <tr><td><strong>{a.abertura}</strong></td><td>{a.distancia}</td><td>{a.lado}</td><td>{a.volume}</td><td class="muted">{a.fracao}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">{MANI.aberturas.nota}</p>

    <div class="callout regra"><span class="lbl">A trava das fatias</span>
      {MANI.travaFatias.regra}
      <ul class="fraq">
        {MANI.travaFatias.consequencias.map((c: string) => <li>{c}</li>)}
      </ul>
    </div>

    <h3>O que sobe e o que desce quando se abre</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Botão</th><th>O que sobe</th><th>O que desce</th></tr></thead>
        <tbody>
          {MANI.botoes.tabela.map((b: any) => (
            <tr><td><strong>{b.botao}</strong></td><td>{b.sobe}</td><td>{b.desce}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{MANI.botoes.cercarSe}</p>

    <h3>As duas alturas: o ápice e o pé da base</h3>
    <p>{MANI.alturas.regra}</p>
    <p class="muted">{MANI.alturas.exemplo}</p>
    <p class="muted">{MANI.alturas.deGraca}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ápice</th><th>A face de baixo é</th><th>Toca o chão</th></tr></thead>
        <tbody>
          {MANI.alturas.tabela.map((t: any) => (
            <tr><td><strong>{t.apice}</strong></td><td>{t.faceDeBaixo}</td><td>{t.tocaOChao}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{MANI.alturas.consequencia}</p>

    <p class="formula">{MANI.estadoNoLado.formula}</p>
    <p class="muted">{MANI.estadoNoLado.nota}</p>

    <div class="callout regra"><span class="lbl">O que a manifestação não faz</span>
      <ul class="fraq">
        {MANI.naoFaz.map((n: string) => <li>{n}</li>)}
      </ul>
    </div>
    <p class="muted">{MANI.escopo}</p>

    <h2 id="moldes">Os moldes: o chão se compra por forma</h2>
    <p>{MOLDES.nota}</p>
    <p class="muted">{MOLDES.porque}</p>
    <div class="callout regra"><span class="lbl">A fronteira</span>
      {MOLDES.fronteira.nota}<br />
      <strong>Improviso:</strong> {MOLDES.fronteira.improviso}<br />
      <strong>Efeito Especial:</strong> {MOLDES.fronteira.efeito}
    </div>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Molde</th><th>Compra</th>{GRAU_COLS.map((g) => <th>{g}</th>)}</tr></thead>
        <tbody>
          {MOLDES.lista.map((m: any) => (
            <>
              <tr><td><strong>{m.nome}</strong></td><td class="muted">{m.compra}</td>{m.escala.map((v: string) => <td>{v}</td>)}</tr>
              {m.hexagonos && (
                <tr class="hex-row"><td></td><td class="muted"><em>hexágonos</em></td>{m.hexagonos.map((v: string) => <td><em>{v}</em></td>)}</tr>
              )}
            </>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">{MOLDES.hexagonosNota}</p>
    <ul class="fraq">
      {MOLDES.lista.map((m: any) => <li><strong>{m.nome}:</strong> {m.serve}</li>)}
    </ul>
    <p>{MOLDES.alcance.nota}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Molde</th><th>g3</th><th>g4</th><th>g5</th><th>g6</th></tr></thead>
        <tbody>
          {MOLDES.alcance.tabela.map((a: any) => (
            <tr><td><strong>{a.molde}</strong></td><td>{a.g3}</td><td>{a.g4}</td><td>{a.g5}</td><td>{a.g6}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">{MOLDES.aura}</p>
    <p>{MOLDES.cadeiaRessalva}</p>
    <p>{MOLDES.cuboide}</p>
    <p class="muted">{MOLDES.volume}</p>

    <h3 id="solidos">Os moldes do volume: a matéria também tem forma</h3>
    <p>{MOLDES.solidos.nota}</p>
    <p class="muted">{MOLDES.solidos.porque}</p>
    <div class="callout regra"><span class="lbl">A proporção é fixa</span>
      {MOLDES.solidos.trava}
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Molde</th><th>Proporção</th><th>Pegada</th></tr></thead>
        <tbody>
          {MOLDES.solidos.lista.map((m: any) => (
            <tr>
              <td><strong>{m.nome}</strong></td>
              <td class="muted">{m.proporcao}</td>
              <td class="muted">{m.pegada === 'circulo' ? 'redonda' : 'quadrada'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="fraq">
      {MOLDES.solidos.lista.map((m: any) => <li><strong>{m.nome}:</strong> {m.serve}</li>)}
    </ul>
    <p class="muted">{MOLDES.solidos.padraoPorque}</p>
    <p class="muted">{MOLDES.solidos.aRevisar}</p>

    <h2 id="tempo">O tempo da Arte, e quem está no caminho</h2>
    <p>{TEMPO.nota}</p>
    <div class="callout regra"><span class="lbl">A Arte sai no último Tick</span>
      {TEMPO.ultimoTick.regra}
    </div>
    <p class="muted">{TEMPO.ultimoTick.excecao}</p>
    <p>{TEMPO.ultimoTick.porque}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Momento</th><th>O que fica decidido</th></tr></thead>
        <tbody>
          {TEMPO.ultimoTick.tabela.map((t: any) => (
            <tr><td><strong>{t.momento}</strong></td><td>{t.decide}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p><strong>{TEMPO.ultimoTick.resumo}</strong></p>

    <h3>Ler o sinal: identificar o que está sendo conjurado</h3>
    <p>{TEMPO.identificar.nota}</p>
    <p><strong>De graça, por conhecer o ofício.</strong> {TEMPO.identificar.deGraca}</p>
    <p><strong>Por teste, para todos os outros.</strong> {TEMPO.identificar.teste}</p>
    <ul class="fraq">
      {TEMPO.identificar.regras.map((r: string) => <li>{r}</li>)}
    </ul>
    <p class="muted">{TEMPO.identificar.ocultismo}</p>

    <h3>A área não se esquiva nem se bloqueia. Ela se abandona.</h3>
    <p>{TEMPO.area.regra}</p>
    <p><strong>1. {TEMPO.area.deslocamentoLivre.titulo}.</strong> {TEMPO.area.deslocamentoLivre.texto}</p>
    <p class="muted">{TEMPO.area.deslocamentoLivre.semGabarito}</p>
    <p><strong>2. {TEMPO.area.desvio.titulo}.</strong> {TEMPO.area.desvio.texto}</p>
    <p class="formula">{TEMPO.area.desvio.formula}</p>
    <p>{TEMPO.area.desvio.dificuldadeEDaTarefa}</p>
    <p class="muted">{TEMPO.area.desvio.escada}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Metros até ficar fora</th><th>Custa</th><th>Dif. metade do dano</th><th>Dif. dano nenhum</th></tr></thead>
        <tbody>
          {TEMPO.area.desvio.tabela.map((l: any) => (
            <tr><td><strong>{l.metros}</strong></td><td>{l.custa}</td><td>{l.metade}</td><td>{l.nada}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout regra"><span class="lbl">Como se lê o resultado</span>
      {TEMPO.area.desvio.leitura.nota}
      <ul class="fraq">
        {TEMPO.area.desvio.leitura.tabela.map((l: any) => (
          <li>{l.resultado}: o alvo sofre <strong>{l.sofre}</strong>.</li>
        ))}
      </ul>
    </div>
    <p>{TEMPO.area.desvio.leitura.porqueDobrar}</p>
    <ul class="fraq">
      {TEMPO.area.desvio.condicoes.map((c: string) => <li>{c}</li>)}
    </ul>
    <p>{TEMPO.area.desvio.ficarParado}</p>
    <p class="muted">{TEMPO.area.desvio.retorno.nota}</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Quem tenta</th><th>Borda, 1 m</th><th>2 m</th><th>3 m</th><th>Núcleo, 4 m</th></tr></thead>
        <tbody>
          {TEMPO.area.desvio.retorno.tabela.map((l: any) => (
            <tr><td><strong>{l.quem}</strong></td><td class="num">{l.m1}</td><td class="num">{l.m2}</td><td class="num">{l.m3}</td><td class="num">{l.m4}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{TEMPO.area.desvio.direcoes}</p>
    <div class="callout regra"><span class="lbl">O molde medido contra o passo grátis</span>
      {TEMPO.area.contraOPasso}
    </div>

    <h2 id="custo">O que custa, e o desconto da Centelha</h2>
    <div class="callout regra"><span class="lbl">A conta</span>
      Some os níveis investidos: <strong>1 ponto por nível</strong>, igual em todos os parâmetros. Do total, subtraia a sua <strong>Centelha</strong>. O que sobrar é o custo em <strong>Mana</strong>, um por um. Se o total couber dentro da Centelha, o efeito é <strong>grátis e ilimitado</strong>.
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Conjuração</th><th>Conta</th><th>Pontos</th><th>Mana com Centelha 2</th><th>com Centelha 4</th></tr></thead>
        <tbody>
          {EX_CONTA.map(([desc, conta, total]) => (
            <tr>
              <td>{desc}</td>
              <td class="muted">{conta}</td>
              <td class="num">{total}</td>
              <td class="num">{Math.max(0, total - 2) || 'grátis'}</td>
              <td class="num">{Math.max(0, total - 4) || 'grátis'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>O desconto muda o jeito de jogar conforme a Centelha sobe: o mesmo dardo que era caro no começo vira troco, e lá pelo fim os truques pequenos deixam de ter custo nenhum. E o que está escrito nos seis níveis de cada Arte, mais abaixo, é <em>exemplo de alocação típica</em> daquele patamar, não a regra.</p>

    <h2 id="fonte">A fonte do elemento</h2>
    <p>{FONTE.resumo}</p>
    <div class="callout regra"><span class="lbl">Mais um de desconto</span>
      Conjurar a partir de uma fonte do elemento vale <strong>+{FONTE.desconto}</strong>, somado à sua Centelha, na hora de calcular o Mana. {FONTE.requisito}
    </div>
    <p><strong>A fonte se gasta.</strong> {FONTE.consumo}</p>
    <p><strong>O que fica no mundo.</strong> {FONTE.permanencia.comMateria} {FONTE.permanencia.semMateria}</p>
    <p class="muted">{FONTE.permanencia.excecao}</p>
    <div class="table-wrap">
      <table class="ab-tab">
        <thead><tr><th>Elemento</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th></tr></thead>
        <tbody>
          {FONTE.abundancia.map((a: any) => (
            <tr>
              <td><strong>{d.artes.find((x: any) => x.id === a.arte)?.nome || a.arte}</strong></td>
              {a.niveis.map((n: string) => <td class="ab-cel">{n}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">{FONTE.notaAr}</p>
    <p><strong>No Ritual.</strong> {FONTE.ritual.texto} {FONTE.ritual.contrapartida}</p>
    <p class="muted">{FONTE.zeraCusto} {FONTE.penalidade}</p>
    <h3>Focos das Artes que não têm elemento</h3>
    <p>{FONTE.focos.texto}</p>
    <ul class="focos">
      {FONTE.focos.lista.map((f: any) => (
        <li><strong>{d.artes.find((x: any) => x.id === f.arte)?.nome || f.arte}</strong>: {f.foco}</li>
      ))}
    </ul>

    <h2 id="cura">A economia da Cura</h2>
    <p>{CURA.resumo}</p>
    <div class="table-wrap">
      <table class="graus-tab">
        <thead><tr><th>Parâmetro</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th></tr></thead>
        <tbody>
          {([['Alcance', CURA.graus.alcance], ['Alvos', CURA.graus.alvos], ['Cura', CURA.graus.cura]] as [string, string[]][]).map(([nome, vals]) => (
            <tr><td><strong>{nome}</strong></td>{vals.map((v) => <td>{v}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout regra"><span class="lbl">Dobro do preço</span>
      Cada nível de parâmetro da Cura custa <strong>{CURA.custoPorNivel} de Mana</strong>, não 1. Um toque que devolve 2d6 é Cura 4 mais Alcance 1: <strong>10 de Mana</strong> antes do desconto da Centelha.
    </div>
    <p><strong>Vale para toda Arte que cura.</strong> {CURA.outrasArtes}</p>
    <p><strong>Sem área.</strong> {CURA.semArea}</p>
    <p><strong>Dividida entre os alvos.</strong> {CURA.divide}</p>
    <p class="muted">{CURA.nota}</p>

    <h2>Passar do seu limite</h2>
    <p>Investir mais Mana não fura o teto sozinho: quem tem Fogo 3 leva todos os parâmetros até o nível 3 pagando o preço normal, mas para alcançar o <strong>4</strong> precisa esticar. Cada nível acima do seu nível de Arte <strong>encarece o parâmetro</strong> e <strong>alonga a ação</strong>.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Níveis acima</th><th>Custo do parâmetro</th><th>Velocidade</th></tr></thead>
        <tbody>
          {ESTICAR.tabela.map((e: any) => (
            <tr><td class="num">{e.acima}</td><td>{e.custo}</td><td class="num">{e.speed}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="formula">Centelha 2, Arte 2, um jorro sustentado. Volume 2 + Dano 2 + Duração 2 = <strong>6 pontos</strong>, Velocidade 5. Puxando para Volume 3, um nível acima: 3×2 + 2 + 2 = <strong>10 pontos</strong>, Velocidade 10. Para Volume 4, dois acima: 4×3 + 2 + 2 = <strong>16 pontos</strong>, Velocidade 15.</p>
    <div class="callout regra"><span class="lbl">Você decide no fim</span>
      Não é preciso anunciar de saída até onde vai. No <strong>tick final de cada Velocidade</strong> você escolhe: soltar o efeito agora, ou segurar e subir mais um nível de um parâmetro. Numa ação de Velocidade 5, você decide no tick 5; se esticar, decide de novo no 10, e outra vez no 15. Quem interromper você no meio leva a conjuração junto.
    </div>
    <p class="muted">O preço sobe rápido de propósito: forçar o limite é recurso de momento decisivo, não atalho para o estudo. E o desconto da Centelha continua valendo sobre o total.</p>

    <h2>Conjuração composta</h2>
    <p>Você pode trançar <strong>várias Artes numa única conjuração</strong>, o mesmo idioma dos combos de Técnica. Junte K Artes e pague a <strong>soma dos Manas + uma sobretaxa progressiva de +(k−1)</strong> (a 2ª Arte +1, a 3ª +2…). É uma <strong>só rolagem</strong> (você escolhe a Arte condutora); o nível efetivo para gating é o do maior componente, e os Ticks seguem a escada dele.</p>
    <p class="formula">Fogo (Labareda, nível 3) + Forças (nível 1) = uma chama que persegue o alvo. Mana = 3 + 1 + <strong>1</strong> de sobretaxa = <strong>5</strong>, numa conjuração só.</p>

    <h2>Rituais</h2>
    <p><strong>Ritual é a conjuração estendida</strong>, não uma categoria de magia à parte. Um efeito que dura a cena não é Ritual: é um feitiço com o parâmetro de duração alto. O que faz um Ritual é <em>o tempo que você gasta conjurando</em>, subindo esta escada:</p>
    <p class="formula">{RITUAL.escalaTempo.join(' · ')}</p>
    <p>Subir a escada compra uma de duas coisas, e você escolhe qual em cada conjuração.</p>

    <h3>Mais barato</h3>
    <p>Cada grau de tempo acima do normal <strong>soma outra vez o desconto de Centelha</strong>: um grau dá Centelha × 2, dois graus dão Centelha × 3.</p>
    <p class="formula">{RITUAL.modoDesconto.exemplo}</p>

    <h3>Mais alto</h3>
    <p>Cada grau de tempo acima permite usar parâmetros <strong>um nível acima do seu nível de Arte</strong>, custando <strong>1 de Força de Vontade por grau</strong>. Aqui o Mana é o normal: você não paga o multiplicador do esticar, como se tivesse mesmo aquele nível de Arte.</p>
    <p class="formula">{RITUAL.modoAcima.exemplo}</p>

    <div class="callout regra"><span class="lbl">Ritual não é discreto</span>
      Nada disso é silencioso. Ritual tem luz, som e às vezes cheiro, e chama atenção de longe. Quem conjura por uma hora num lugar habitado está anunciando o que faz, e isso é parte do preço.
    </div>
    <p>Vários feiticeiros que conheçam a Arte <strong>cooperam</strong>, somando Mana e Força de Vontade. Não há recuo mágico (<em>backlash</em>); uma falha apenas desperdiça o tempo e o Mana investidos.</p>

    <h2>Quando o Mana volta</h2>
    <p>A reserva <strong>não</strong> volta por cena: quem se esvazia numa luta precisa de horas, não de um respiro. Você recupera <strong>{RECUP.normal}</strong>, e <strong>{RECUP.descanso}</strong>.</p>
    <p class="muted">É o que separa a economia do Arcano da das Proezas: a Energia é o combustível da cena, o Mana é o combustível do dia. Quem investe na Arte <a href={url('artes/catalogo') + '#manipulacao-mana'}>Mana</a> aumenta as duas coisas, a reserva e a velocidade com que ela volta.</p>

    <div class="callout regra"><span class="lbl">O lugar do feiticeiro</span>
      Feitiçaria não é build barata nem para personagem iniciante: no começo as conjurações são escassas, como as do mago nos primeiros níveis de outros sistemas. O feiticeiro do Centelha precisa de um <strong>papel secundário</strong>, e não necessariamente de combate: quando o Mana acaba, é dele que você vive.
    </div>

    <h2>Guardar um feitiço</h2>
    <p>Dá para conjurar agora e soltar depois. O Mana é pago na hora de guardar, e o feitiço fica <strong>comitado</strong>: parte da cabeça do feiticeiro continua segurando aquilo o tempo todo. Enquanto estiver guardado, o <strong>Raciocínio</strong> paga a conta.</p>
    <div class="callout regra"><span class="lbl">O preço da espera</span>
      <strong>Passivo:</strong> o Raciocínio conta como <strong>um nível mais baixo</strong> em tudo que é calculado com ele (Iniciativa, Defesa Mental e afins). &nbsp; <strong>Ativo:</strong> <strong>−1d6</strong> em qualquer rolagem que use Raciocínio. Soltar o feitiço, ou desfazê-lo, devolve o Raciocínio na hora.
    </div>

    <h2>Fraqueza e resistência</h2>
    <p>Quase nenhuma criatura tem uma. Elas aparecem no sobrenatural (o vampiro e o sol, a prata e o lobisomem, o demônio e o sagrado, o anjo e o profano) e no material de que a criatura é feita: o que é de folha, madeira, palha ou gelo teme o fogo; o que é de fogo ou de terra teme a água; o que é de metal ou pedra resiste ao fogo.</p>
    <p>Acertar a fraqueza de alguém não é um bônus qualquer, é outra categoria de golpe:</p>
    <ul class="fraq">
      <li>O dano <strong>ignora toda a Absorção</strong>, natural e de armadura.</li>
      <li>O dano é <strong>agravado</strong>: não fecha com descanso nem com a perícia Cura, só com tratamento específico ou com a Arte de Cura.</li>
      <li><strong>Aparar de mãos nuas fere</strong>: quem tenta bloquear o golpe com o corpo sofre o dano do mesmo jeito.</li>
    </ul>
    <p class="formula">Um elemental de madeira que tenta aparar uma lâmina feita inteira de fogo leva o dano cheio, sem absorver nada, e a queimadura não fecha sozinha.</p>

    <p>A <strong>resistência</strong> é o avesso disso, e é bem mais comum:</p>
    <div class="callout regra"><span class="lbl">O que a resistência faz</span>
      {FRAQ.resistencia}
    </div>
    <ul class="fraq">
      {FRAQ.resistenciaExemplos.map((x: string) => <li>{x}</li>)}
    </ul>

    <div class="callout revisao"><span class="lbl">Em revisão</span>
      Esta parte do capítulo está sendo reescrita. Ainda falta definir:
      <ul>
        <li>Como as Artes rolam de vez (o acerto pela perícia Acerto Arcano e a conjuração por Tradição), e a ligação de cada Arte com suas Trilhas.</li>
        <li>Revisar a <strong>primeira leva</strong> de Efeitos das Artes não elementais: os números e os limites de cada um ainda não passaram por mesa.</li>
        <li>Como o Efeito Especial entra no <strong>bestiário</strong> (na ficha ele já tem lugar).</li>
        {FONTE.pendencias.map((p: string) => <li>{p}</li>)}
        <li>Preencher <strong>fraquezas</strong> e <strong>resistências</strong> nas 308 criaturas do bestiário; a regra das duas já está fechada acima.</li>
        <li>Se o campo <strong>escalonavel</strong> dos Efeitos vira "sucede" (pagar só a diferença de um Efeito para o irmão maior) ou some de vez.</li>
        <li>Treze Efeitos <strong>elementais</strong> ainda estão sem número, e Fogo, Raio e Luz não têm nenhum de nível 1.</li>
        <li>Se a penalidade de guardar feitiço acumula por feitiço, e se há teto de quantos dá para carregar.</li>
        <li>A <strong>dificuldade do teste de concentração</strong> ao sofrer dano sustentando um improviso: fixa, ou subindo com o tamanho do golpe.</li>
        <li><strong>Área × Volume está em revisão.</strong> A escada de Volume, a tabela de estado da matéria e o corte entre corpo e jurisdição podem mudar juntos.</li>
        {MANI.emAvaliacao.map((p: string) => <li><strong>Manifestação:</strong> {p}</li>)}
        {TEMPO.aRevisar.map((p: string) => <li><strong>Tempo e área:</strong> {p}</li>)}
        <li><strong>Moldes:</strong> {MOLDES.aRevisar}</li>
        <li>A <strong>Fonte do Elemento</strong> tem uma escada por elemental e nenhuma para <strong>Areia</strong>, <strong>Som</strong> e o que mais vier. Hoje um deserto cai perto do fundo da régua da Terra, que trata material solto como fraco.</li>
        <li>Uma <strong>régua de luz</strong> (escuro, penumbra, tocha, dia): o que cada degrau faz nas rolagens e o que cada raça enxerga. Dela depende o <strong>halo</strong> de Luz e Sombra, que vaza para fora do volume comprado e muda a luz do lugar sem causar o efeito.</li>
        <li><strong>Os 46 Efeitos que ainda declaram Área precisam de molde.</strong> A Área ficou sem dono quando o chão passou a se comprar por forma e o improviso passou a comprar a base com o Volume: ela só segue na tabela acima porque esses Efeitos ainda a usam. Cada um precisa do molde que lhe cabe, e isso é julgamento de Efeito, um a um. Doze deles nem chão medem, medem corpo, e deveriam usar Volume (Lascas, Onda, Maremoto, Sopro do Norte, Tromba, Sarçal, Erguer a Montanha, Clarão, Aurora, Escudo de Força). A Aura chama de <strong>Volume</strong> um parâmetro que é raio, e a escala própria da <strong>Neblina</strong> (125 m³ no topo) precisa ser reconciliada com o gás da tabela acima (64 m³).</li>
      </ul>
    </div>
  </section>

