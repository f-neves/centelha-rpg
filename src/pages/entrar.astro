---
import Base from '../layouts/Base.astro';

// Os dois ícones do botão de ver senha vão juntos no markup e quem troca é o CSS,
// pelo aria-pressed: assim o estado visual e o estado anunciado nunca divergem.
// Fica numa variável porque o mesmo botão aparece nos dois formulários.
const olhos = `
  <svg class="i-ver" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
  <svg class="i-ocultar" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20C5 20 1 12 1 12a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
`;
---
<Base title="Entrar" descricao="Acesse sua conta para gerenciar personagens e mesas.">
  <h1>Entrar</h1>

  <div id="auth-setup" class="aviso" hidden>
    <strong>Área de contas ainda não configurada.</strong>
    <p class="muted">Falta ligar o Supabase (banco + login). Veja <code>supabase/README.md</code> no projeto.</p>
  </div>

  <div id="auth-logado" class="painel" hidden>
    <p>Você já está logado como <strong id="logado-nome"></strong>.</p>
    <div class="btn-row">
      <a class="btn primary" id="ir-mesas">Mesas / Fichas</a>
      <button class="btn" id="btn-sair">Sair</button>
    </div>
  </div>

  <div id="auth-forms">
    <div class="tabs" role="tablist">
      <button class="tab primary" data-tab="entrar" role="tab" aria-selected="true">Entrar</button>
      <button class="tab" data-tab="criar" role="tab" aria-selected="false">Criar conta</button>
    </div>

    <form id="form-entrar" class="painel" data-painel="entrar">
      <label>E-mail<input type="email" name="email" autocomplete="email" required /></label>
      <label>Senha
        <span class="campo-senha">
          <input type="password" name="senha" autocomplete="current-password" required />
          <button type="button" class="ver-senha" aria-pressed="false" aria-label="Mostrar senha" title="Mostrar senha"><Fragment set:html={olhos} /></button>
        </span>
      </label>
      <div class="btn-row">
        <button class="btn primary" type="submit">Entrar</button>
        <button class="btn linkish" type="button" id="btn-esqueci">Esqueci a senha</button>
      </div>
    </form>

    <form id="form-criar" class="painel" data-painel="criar" hidden>
      <label>Nome (como aparece na mesa)<input type="text" name="nome" autocomplete="nickname" required /></label>
      <label>E-mail<input type="email" name="email" autocomplete="email" required /></label>
      <label>Senha (mín. 6)
        <span class="campo-senha">
          <input type="password" name="senha" autocomplete="new-password" minlength="6" required />
          <button type="button" class="ver-senha" aria-pressed="false" aria-label="Mostrar senha" title="Mostrar senha"><Fragment set:html={olhos} /></button>
        </span>
      </label>
      <div class="btn-row">
        <button class="btn primary" type="submit">Criar conta</button>
      </div>
    </form>

    <p id="auth-msg" class="auth-msg" role="status" aria-live="polite"></p>
  </div>
</Base>

<script>
  import { entrar, cadastrar, recuperarSenha, sair, usuarioAtual, perfilNome, supabaseConfigurado } from '../lib/auth';
  const base = import.meta.env.BASE_URL;
  const u = (p: string) => `${base.replace(/\/$/, '')}/${p}`;
  const q = new URLSearchParams(location.search);
  const proximo = q.get('proximo');
  const destino = proximo && proximo.startsWith('/') ? location.origin + proximo : u('mesas');

  const msg = document.getElementById('auth-msg')!;
  const setMsg = (t: string, erro = true) => { msg.textContent = t; msg.classList.toggle('erro', erro); msg.classList.toggle('ok', !t ? false : !erro); };

  async function init() {
    if (!supabaseConfigurado) {
      document.getElementById('auth-setup')!.hidden = false;
      document.getElementById('auth-forms')!.hidden = true;
      return;
    }
    const user = await usuarioAtual();
    if (user) {
      document.getElementById('auth-forms')!.hidden = true;
      const box = document.getElementById('auth-logado')!;
      box.hidden = false;
      document.getElementById('logado-nome')!.textContent = (await perfilNome()) || user.email || '';
      (document.getElementById('ir-mesas') as HTMLAnchorElement).href = u('mesas');
      document.getElementById('btn-sair')!.addEventListener('click', async () => { await sair(); location.reload(); });
    }
  }
  init();

  // abas
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) => t.addEventListener('click', () => {
    const alvo = t.dataset.tab!;
    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => {
      const on = b === t; b.classList.toggle('primary', on); b.setAttribute('aria-selected', String(on));
    });
    document.querySelectorAll<HTMLElement>('[data-painel]').forEach((p) => { p.hidden = p.dataset.painel !== alvo; });
    setMsg('');
  }));

  // ver / ocultar senha. O foco volta para o campo porque quem clica no olho quase
  // sempre está no meio de digitar, e perder o cursor custa mais do que o botão vale.
  document.querySelectorAll<HTMLButtonElement>('.ver-senha').forEach((b) => b.addEventListener('click', () => {
    const inp = b.parentElement!.querySelector('input') as HTMLInputElement;
    const mostrar = inp.type === 'password';
    inp.type = mostrar ? 'text' : 'password';
    b.setAttribute('aria-pressed', String(mostrar));
    const rotulo = mostrar ? 'Ocultar senha' : 'Mostrar senha';
    b.setAttribute('aria-label', rotulo);
    b.title = rotulo;
    const fim = inp.value.length;
    inp.focus({ preventScroll: true });
    try { inp.setSelectionRange(fim, fim); } catch {}
  }));

  document.getElementById('form-entrar')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    setMsg('Entrando…', false);
    const { erro } = await entrar((f.email as any).value, (f.senha as any).value);
    if (erro) return setMsg(erro);
    location.href = destino;
  });

  document.getElementById('form-criar')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    setMsg('Criando conta…', false);
    const { erro } = await cadastrar((f.email as any).value, (f.senha as any).value, (f.nome as any).value);
    if (erro) return setMsg(erro);
    // Se a confirmação de e-mail estiver ligada, não há sessão ainda.
    const user = await usuarioAtual();
    if (user) { location.href = destino; }
    else setMsg('Conta criada. Confirme pelo link enviado ao seu e-mail e depois entre.', false);
  });

  document.getElementById('btn-esqueci')!.addEventListener('click', async () => {
    const email = (document.querySelector('#form-entrar input[name=email]') as HTMLInputElement).value;
    if (!email) return setMsg('Escreva seu e-mail no campo acima primeiro.');
    const { erro } = await recuperarSenha(email, `${location.origin}${base}redefinir-senha`);
    setMsg(erro || 'Se houver conta com esse e-mail, enviamos um link de redefinição.', !!erro);
  });
</script>

<style>
  .tabs { display: flex; gap: .4rem; margin: 1rem 0 .8rem; }
  /* sem `color`, o <button> caía no preto do navegador: 1,3:1 sobre o painel escuro.
     E o estado ativo vinha de .primary, que só existe no CSS como .btn.primary, então
     as duas abas ficavam idênticas. O aria-selected já está no markup e é a fonte certa. */
  .tab { padding: .5rem 1rem; border: 1px solid var(--rule); background: var(--panel); color: var(--ink);
    font-family: 'Cinzel'; font-size: var(--fs-rotulo); border-radius: var(--r-md) 6px 0 0; cursor: pointer; }
  .tab:hover { border-color: var(--accent); color: var(--accent-texto); }
  /* --accent-strong (e não --accent) porque o par creme-sobre-teal-vivo do tema Clássico
     rende só 2,1:1; este é o mesmo par já usado nos cabeçalhos de tabela e passa nos três temas. */
  .tab[aria-selected='true'] { background: var(--accent-strong); color: var(--on-accent-strong); border-color: transparent; }
  .painel { border: 1px solid var(--rule); border-radius: var(--r-lg); padding: 1rem; max-width: 26rem; background: var(--panel); }
  form.painel label { display: block; margin-bottom: .7rem; font-weight: 600; }
  form.painel input { display: block; width: 100%; margin-top: .25rem; padding: .5rem; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--bg); color: var(--ink); font: inherit; }
  /* O botão do olho fica DENTRO do campo, e não ao lado, para o input continuar
     ocupando a largura inteira do painel como os outros. A margem sai do input e vem
     para o embrulho: com o input em display:block e sem borda no pai, a margem dele
     escaparia por cima e o `top: 50%` do botão cairia fora do centro. */
  .campo-senha { display: block; position: relative; margin-top: .25rem; }
  .campo-senha input { margin-top: 0; padding-right: 2.7rem; }
  .ver-senha { position: absolute; right: .3rem; top: 50%; transform: translateY(-50%);
    display: grid; place-items: center; width: 2.1rem; height: 2.1rem; padding: 0;
    border: none; border-radius: var(--r-md); background: none; color: var(--ink-soft); cursor: pointer; }
  .ver-senha:hover { color: var(--accent-texto); }
  .ver-senha:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  /* :global nos dois ícones porque eles entram por `set:html` e o Astro não carimba
     o atributo de escopo neles: sem isso os seletores não casam e os dois aparecem. */
  .ver-senha :global(.i-ocultar), .ver-senha[aria-pressed='true'] :global(.i-ver) { display: none; }
  .ver-senha[aria-pressed='true'] :global(.i-ocultar) { display: block; }
  .btn-row { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; margin-top: .4rem; }
  .btn.linkish { background: none; border: none; color: var(--accent-texto); cursor: pointer; padding: .3rem; }
  .auth-msg { margin-top: .8rem; max-width: 26rem; }
  .auth-msg.erro { color: var(--perigo); }
  .auth-msg.ok { color: var(--accent-strong, var(--accent)); }
  .aviso { border: 1px solid var(--gold, var(--rule)); border-radius: var(--r-lg); padding: 1rem; background: color-mix(in srgb, var(--gold, #caa) 12%, transparent); max-width: 40rem; }
</style>
