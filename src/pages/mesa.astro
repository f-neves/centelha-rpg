---
import Base from '../layouts/Base.astro';
import MesaCab from '../components/MesaCab.astro';
import RoladorDados from '../components/RoladorDados.astro';
import { regras } from '../lib/calc';

// A régua de dificuldade do Escudo sai calculada no build (as três colunas são
// função da soma Atributo + Habilidade), igual à da página /mestre.
const ANCORAS = regras.dificuldade as { dif: number; desafio: string; aaltura: string }[];
const FERIMENTOS = regras.ferimentos as { minPct: number; maxPct: number; estado: string; penAcao: number | null; penDefesa: number | null }[];
const MODS = (regras.combateTatico as any).modificadores as { nome: string; valor: number; alvo: string; nota: string }[];
---
<Base title="Mesa" largura="wide" descricao="Escudo do Mestre: o painel da campanha.">
  <MesaCab aba="escudo">

    <!-- ================= COMBATE ================= -->
    <section class="bloco" id="sec-combate">
      <div class="bloco-cab">
        <h2>Em cena</h2>
        <div class="bloco-acoes" id="combate-acoes"></div>
      </div>
      <div id="combate-faixa"></div>
    </section>

    <!-- ================= O GRUPO ================= -->
    <section class="bloco">
      <div class="bloco-cab">
        <h2>O grupo <small>· quem está em pé e como</small></h2>
        <div class="bloco-acoes">
          <a class="btn mini" id="ir-grupo" href="#">Ver fichas ›</a>
        </div>
      </div>
      <div id="grupo-faixa" class="grupo-faixa"><p class="vazio">Carregando o grupo…</p></div>
    </section>

    <!-- ================= RELÓGIOS ================= -->
    <section class="bloco">
      <div class="bloco-cab">
        <h2>Relógios <small>· o que avança sozinho</small></h2>
        <div class="bloco-acoes"><button class="btn mini" id="rel-novo" hidden>+ relógio</button></div>
      </div>
      <div id="relogios" class="relogios"></div>
    </section>

    <!-- ================= GANCHOS ================= -->
    <section class="bloco">
      <div class="bloco-cab">
        <h2>Ganchos &amp; próxima cena</h2>
        <div class="bloco-acoes"><a class="btn mini" id="ir-compendio" href="#">Compêndio ›</a></div>
      </div>
      <div id="ganchos"></div>
    </section>

    <!-- ================= NOTAS RÁPIDAS ================= -->
    <section class="bloco">
      <div class="bloco-cab">
        <h2>Notas rápidas</h2>
        <div class="bloco-acoes"><a class="btn mini" id="ir-diario" href="#">Diário ›</a></div>
      </div>
      <div id="notas-rapidas"></div>
    </section>

    <!-- ================= ROLAGEM ================= -->
    <section class="bloco" id="sec-rolagem">
      <div class="bloco-cab"><h2>Rolagem atrás do escudo</h2></div>
      <RoladorDados compact />
    </section>

    <!-- ================= REFERÊNCIA RELÂMPAGO ================= -->
    <section class="bloco">
      <div class="bloco-cab">
        <h2>Referência relâmpago</h2>
        <div class="bloco-acoes"><a class="btn mini" id="ir-referencia" href="#">Escudo completo ›</a></div>
      </div>
      <div class="ref-rapida">
        <details open>
          <summary>Dificuldades</summary>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th class="num">Dif</th><th>Desafio</th><th>À altura de</th></tr></thead>
            <tbody>{ANCORAS.map((a) => (<tr><td class="num">{a.dif}</td><td>{a.desafio}</td><td class="muted">{a.aaltura}</td></tr>))}</tbody>
          </table></div>
          <p class="muted nota-mini">Sucesso quando o <strong>total supera</strong> a Dificuldade. Cada 6 pontos acima é uma <strong>Margem</strong>.</p>
        </details>
        <details>
          <summary>Limiares de Ferimento</summary>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Vida</th><th>Estado</th><th class="num">Ação</th><th class="num">Defesa</th></tr></thead>
            <tbody>{FERIMENTOS.map((f) => (
              <tr><td class="num">{f.minPct === f.maxPct ? f.minPct : `${f.minPct}–${f.maxPct}`}%</td>
                <td>{f.estado}</td>
                <td class="num">{f.penAcao == null ? '—' : f.penAcao || '0'}</td>
                <td class="num">{f.penDefesa == null ? '—' : f.penDefesa || '0'}</td></tr>))}</tbody>
          </table></div>
        </details>
        <details>
          <summary>Modificadores de combate</summary>
          <div class="tab-wrap"><table class="tab-mesa">
            <thead><tr><th>Situação</th><th class="num">Defesa</th><th>Quando</th></tr></thead>
            <tbody>{MODS.map((m) => (
              <tr><td>{m.nome}</td>
                <td class="num">{m.valor > 0 ? `+${m.valor}` : m.valor}</td>
                <td class="muted">{m.nota}</td></tr>))}</tbody>
          </table></div>
          <p class="muted nota-mini">Teto de <strong>±{(regras.combateTatico as any).modificadorCap}</strong> somando tudo. O porte entra no <em>acerto</em>, fora deste teto.</p>
        </details>
      </div>
    </section>

  </MesaCab>

  <dialog id="rel-dlg" class="mesa-dlg">
    <form method="dialog">
      <h3 id="rel-titulo">Relógio</h3>
      <label>Nome <input type="text" id="rel-nome" placeholder="A guarda chega…" /></label>
      <div class="grade2">
        <label>Segmentos <input type="number" id="rel-seg" min="2" max="12" value="6" /></label>
        <label>Cheios <input type="number" id="rel-cheios" min="0" value="0" /></label>
      </div>
      <label>Cor
        <select id="rel-cor">
          <option value="perigo">Perigo (vermelho)</option>
          <option value="alerta">Alerta (dourado)</option>
          <option value="bom">Bom (verde)</option>
          <option value="arcano">Arcano (roxo)</option>
        </select>
      </label>
      <label>Nota <textarea id="rel-nota" rows="2" placeholder="O que acontece quando encher?"></textarea></label>
      <label class="chk"><input type="checkbox" id="rel-vis" /> visível para os jogadores</label>
      <div class="dlg-btns">
        <button type="button" class="btn mini perigo esq" id="rel-excluir" hidden>Excluir</button>
        <button type="button" class="btn" id="rel-cancelar">Cancelar</button>
        <button type="button" class="btn primary" id="rel-salvar">Salvar</button>
      </div>
    </form>
  </dialog>
</Base>

<style is:global>
  /* ---- faixa de combate ---- */
  .cmb-faixa { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap;
    border: 1px solid var(--accent); border-radius: var(--r-lg); padding: .7rem .9rem;
    background: color-mix(in srgb, var(--accent) 9%, var(--panel)); }
  .cmb-faixa .agora { display: flex; align-items: center; gap: .6rem; }
  .cmb-faixa .agora-rot { font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase;
    letter-spacing: .06em; color: var(--accent-strong); }
  .cmb-faixa .agora-nome { font-family: 'Cinzel'; font-size: var(--fs-h3); color: var(--ink); line-height: 1.1; }
  .cmb-faixa .fila { display: flex; align-items: center; gap: .3rem; flex-wrap: wrap; }
  .cmb-faixa .fila .av { --av-t: 2.1rem; }
  .cmb-faixa .fila .prox { opacity: .55; }
  .cmb-faixa .espaco { flex: 1; }
  .sem-combate { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }

  /* ---- faixa do grupo ---- */
  .grupo-faixa { display: grid; grid-template-columns: repeat(auto-fill, minmax(21rem, 1fr)); gap: .7rem; }
  .pj { display: grid; grid-template-columns: auto 1fr; gap: .1rem .7rem; align-items: start;
    border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); padding: .65rem .75rem;
    border-left: 3px solid var(--rule); }
  .pj.ferido { border-left-color: #e6a91d; }
  .pj.grave  { border-left-color: #e8791f; }
  .pj.critico{ border-left-color: #cf3327; }
  .pj.caido  { border-left-color: #6a6a6a; opacity: .82; }
  .pj-av { grid-row: span 4; }
  .pj-topo { display: flex; align-items: baseline; gap: .4rem; flex-wrap: wrap; min-width: 0; }
  .pj-nome { font-family: 'Cinzel'; font-weight: 700; font-size: var(--fs-aux); color: var(--ink);
    text-decoration: none; }
  .pj-nome:hover { color: var(--accent-texto); }
  .pj-sub { font-size: var(--fs-micro); color: var(--ink-soft); font-style: italic; }
  .pj-barras { display: flex; flex-direction: column; gap: .2rem; margin: .3rem 0 .25rem; }
  .pj-linha { display: flex; align-items: center; gap: .35rem; }
  .pj-linha .rot { flex: 0 0 2.6rem; }
  .pj-nums { display: flex; flex-wrap: wrap; gap: .15rem .5rem; font-size: var(--fs-micro); }
  .pj-conds { margin-top: .28rem; }

  /* ---- relógios ---- */
  .relogios { display: flex; flex-wrap: wrap; gap: .8rem; }
  .relogio { display: flex; flex-direction: column; align-items: center; gap: .25rem; width: 8.5rem;
    border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); padding: .6rem .5rem; }
  .relogio svg { width: 5rem; height: 5rem; cursor: pointer; }
  .relogio .rl-nome { font-family: 'Cinzel'; font-size: var(--fs-micro); text-align: center; line-height: 1.2; }
  .relogio .rl-n { font-variant-numeric: tabular-nums; font-size: var(--fs-micro); color: var(--ink-soft); }
  .relogio .rl-btns { display: flex; gap: .2rem; }
  .relogio.oculto { border-style: dashed; opacity: .75; }
  .rl-seg { transition: fill .25s ease; cursor: pointer; }
  .rl-seg.on.c-perigo { fill: #c1352c; }
  .rl-seg.on.c-alerta { fill: var(--gold); }
  .rl-seg.on.c-bom    { fill: #3f9e57; }
  .rl-seg.on.c-arcano { fill: #8a5bbf; }
  .rl-seg.off { fill: color-mix(in srgb, var(--ink) 10%, transparent); }
  .rl-seg:hover { filter: brightness(1.2); }

  /* ---- ganchos e notas ---- */
  .gancho-lista, .nota-lista { display: flex; flex-direction: column; gap: .45rem; }
  .gancho { display: flex; gap: .55rem; align-items: flex-start; padding: .5rem .7rem;
    border: 1px solid var(--rule); border-left: 3px solid var(--gold); border-radius: var(--r-md); background: var(--panel); }
  .gancho .g-t { font-family: 'Cinzel'; font-size: var(--fs-rotulo); }
  .gancho .g-r { font-size: var(--fs-rotulo); color: var(--ink-soft); }
  .nota-mini-card { border: 1px solid var(--rule); border-left: 3px solid var(--accent);
    border-radius: var(--r-md); background: var(--panel); padding: .5rem .7rem; }
  .nota-mini-card h4 { margin: 0 0 .2rem; font-family: 'Cinzel'; font-size: var(--fs-rotulo); }
  .nota-mini-card p { margin: 0; font-size: var(--fs-rotulo); white-space: pre-wrap; }

  /* ---- referência ---- */
  .ref-rapida details { border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--panel);
    padding: .45rem .7rem; margin-bottom: .5rem; }
  .ref-rapida summary { cursor: pointer; font-family: 'Cinzel'; font-size: var(--fs-rotulo); color: var(--accent-texto); }
  .ref-rapida .tab-wrap { margin-top: .5rem; }
  .nota-mini { font-size: var(--fs-micro); margin: .4rem 0 0; }
  .mesa-dlg label.chk { flex-direction: row; align-items: center; gap: .4rem; text-transform: none; }
</style>

<script>
  import {
    abrirMesa, ligarCabecalho, u, esc, avatarHTML, urlsImagens, hpBarHTML, tierDe, tierCls,
    condChipHTML, COND, nomesDe, norm, bancoAntigo,
  } from '../lib/mesa-core';
  import { resumoFicha } from '../lib/mesa-ficha';
  import { uiConfirmar, uiErro, uiFormulario } from '../lib/ui-dialog';

  const el = (i: string) => document.getElementById(i)!;

  async function main() {
    const ctx = await abrirMesa('escudo');
    if (!ctx) return;
    const { sb, ehMestre, id } = ctx;
    await ligarCabecalho(ctx, uiConfirmar, uiErro, uiFormulario);

    for (const [alvo, slug] of [['ir-grupo', 'mesa/grupo'], ['ir-compendio', 'mesa/compendio'],
      ['ir-diario', 'mesa/diario'], ['ir-referencia', 'mesa/referencia']] as [string, string][]) {
      (el(alvo) as HTMLAnchorElement).href = u(slug) + '?id=' + id;
    }
    if (!ehMestre) el('sec-rolagem').hidden = true;

    await Promise.all([
      pintarCombate(ctx),
      pintarGrupo(ctx),
      pintarRelogios(ctx),
      pintarGanchos(ctx),
      pintarNotas(ctx),
    ]);
  }

  // ------------------------------------------------------------ em cena
  async function pintarCombate({ sb, ehMestre, id }: any) {
    const faixa = el('combate-faixa'); const acoes = el('combate-acoes');
    const { data: encs } = await sb.from('encontros').select('*').eq('mesa_id', id)
      .eq('ativo', true).order('criado_em', { ascending: false }).limit(1);
    const enc = (encs || [])[0];
    const irCombate = `<a class="btn primary mini" href="${u('mesa/combate')}?id=${id}">Abrir o combate ›</a>`;
    if (!enc) {
      faixa.innerHTML = `<div class="sem-combate painel"><span class="muted">Nenhum encontro em andamento.</span>
        ${ehMestre ? `<a class="btn mini" href="${u('mesa/combate')}?id=${id}">Preparar um encontro ›</a>` : ''}</div>`;
      return;
    }
    const { data: combs } = await sb.from('combatentes').select('*').eq('encontro_id', enc.id);
    const lista = (combs || []).filter((c: any) => c.ativo !== false)
      .sort((a: any, b: any) => (a.tick - b.tick) || ((b.iniciativa || 0) - (a.iniciativa || 0)));
    const atual = lista[0];
    const mapaImg = await urlsImagens(sb, lista.map((c: any) => c.imagem).filter(Boolean), 'mesa');
    const av = (c: any, cls = '') => avatarHTML(c.nome, c.imagem ? (mapaImg[c.imagem] || null) : null, cls);
    faixa.innerHTML = `<div class="cmb-faixa">
      <div class="agora">
        ${atual ? av(atual) : ''}
        <div><div class="agora-rot">Agora · tick ${atual?.tick ?? 0}</div>
          <div class="agora-nome">${esc(atual?.nome || 'ninguém')}</div></div>
      </div>
      <div class="fila">${lista.slice(1, 7).map((c: any) => av(c, 'prox av-p')).join('')}
        ${lista.length > 7 ? `<span class="muted">+${lista.length - 7}</span>` : ''}</div>
      <span class="espaco"></span>
      <div><strong>${esc(enc.nome)}</strong> <span class="muted">· ${lista.length} em campo</span></div>
    </div>`;
    acoes.innerHTML = irCombate;
  }

  // ------------------------------------------------------------- o grupo
  async function pintarGrupo({ sb, id }: any) {
    const box = el('grupo-faixa');
    const { data: pcs, error } = await sb.from('personagens')
      .select('id, nome, conceito, dono_id, status, imagem_path, ficha')
      .eq('mesa_id', id).order('nome', { ascending: true });
    if (error) { box.innerHTML = `<p class="erro">${esc(error.message)}</p>`; return; }
    if (!pcs?.length) { box.innerHTML = '<p class="vazio">Nenhum personagem nesta mesa ainda.</p>'; return; }

    // As três buscas seguintes não dependem uma da outra: em série somavam mais
    // de um segundo de "Carregando o grupo…" numa conexão real.
    const [nomes, imgs, emCombate] = await Promise.all([
      nomesDe(sb, pcs.map((p: any) => p.dono_id)),
      urlsImagens(sb, pcs.map((p: any) => p.imagem_path), 'personagens'),
      // Havendo combate, a Vida e as condições vêm de lá: é o número que está
      // valendo agora, e não o do papel.
      (async () => {
        const mapa: Record<string, any> = {};
        const { data: encs } = await sb.from('encontros').select('id').eq('mesa_id', id).eq('ativo', true).limit(1);
        if (!encs?.length) return mapa;
        const { data: combs } = await sb.from('combatentes').select('*').eq('encontro_id', encs[0].id);
        for (const c of combs || []) if (c.personagem_id) mapa[c.personagem_id] = c;
        return mapa;
      })(),
    ]);

    box.innerHTML = pcs.map((p: any) => {
      let R: any = null;
      try { R = resumoFicha(p.ficha || {}); } catch {}
      const c = emCombate[p.id];
      const pvMax = c?.pv_max ?? R?.pv ?? null;
      const pvAt = c?.pv_atual ?? R?.pv ?? null;
      const t = tierDe(pvAt, pvMax);
      const conds = (c?.condicoes || []).map((k: any) => condChipHTML({ ...(COND[k.id] || {}), ...k })).join('');
      const en = c?.energia_atual ?? R?.energia ?? null;
      const enMax = c?.energia_max ?? R?.energia ?? null;
      const nums = R ? `
        <span class="pl"><span class="pl-l">Def</span><span class="pl-v">${R.defEsquiva}</span></span>
        <span class="pl"><span class="pl-l">Soc</span><span class="pl-v">${R.defSocial}</span></span>
        <span class="pl"><span class="pl-l">Men</span><span class="pl-v">${R.defMental}</span></span>
        <span class="pl"><span class="pl-l">Abs</span><span class="pl-v">${R.soak.impacto}/${R.soak.corte}/${R.soak.perfuracao}</span></span>
        <span class="pl"><span class="pl-l">Ini</span><span class="pl-v">${esc(R.iniciativa)}</span></span>
        <span class="pl"><span class="pl-l">Percep</span><span class="pl-v">${R.passivos[0].media}</span></span>
        <span class="pl"><span class="pl-l">Furt</span><span class="pl-v">${R.passivos[3].media}</span></span>
        <span class="pl"><span class="pl-l">Cent</span><span class="pl-v">${R.centelha}</span></span>` : '<span class="muted">ficha em branco</span>';
      return `<div class="pj ${norm(t.estado).replace(/\s+/g, '-')}">
        <span class="pj-av">${avatarHTML(p.nome, imgs[p.imagem_path] || null, 'av-g')}</span>
        <div class="pj-topo">
          <a class="pj-nome" href="${u('personagem')}?id=${p.id}">${esc(p.nome || 'Personagem')}</a>
          <span class="pj-sub">${esc(p.conceito || '')}${p.conceito && nomes[p.dono_id] ? ' · ' : ''}${esc(nomes[p.dono_id] || '')}</span>
        </div>
        <div class="pj-barras">
          <div class="pj-linha"><span class="rot">Vida</span>${hpBarHTML(pvAt, pvMax, 'pj-' + p.id, 'mini')}</div>
          ${enMax ? `<div class="pj-linha"><span class="rot">Energia</span><div class="hpbar mini enbar"><div class="hpbar-fill" style="width:${enMax ? Math.max(0, Math.min(100, (en / enMax) * 100)) : 0}%"></div><span class="hpbar-txt">${en}<span class="hp-sep">/</span>${enMax}</span></div></div>` : ''}
        </div>
        <div class="pj-nums pilha">${nums}</div>
        ${conds ? `<div class="pj-conds conds">${conds}</div>` : ''}
      </div>`;
    }).join('');
  }

  // ---------------------------------------------------------- relógios
  function relogioSVG(seg: number, cheios: number, cor: string) {
    const n = Math.max(2, Math.min(12, seg | 0));
    const R = 46, cx = 50, cy = 50;
    const arco = (i: number) => {
      const a0 = (i / n) * 2 * Math.PI - Math.PI / 2;
      const a1 = ((i + 1) / n) * 2 * Math.PI - Math.PI / 2;
      const x0 = cx + R * Math.cos(a0), y0 = cy + R * Math.sin(a0);
      const x1 = cx + R * Math.cos(a1), y1 = cy + R * Math.sin(a1);
      const grande = (a1 - a0) > Math.PI ? 1 : 0;
      return `M ${cx} ${cy} L ${x0.toFixed(2)} ${y0.toFixed(2)} A ${R} ${R} 0 ${grande} 1 ${x1.toFixed(2)} ${y1.toFixed(2)} Z`;
    };
    const fatias = Array.from({ length: n }, (_, i) =>
      `<path class="rl-seg ${i < cheios ? 'on c-' + cor : 'off'}" data-seg="${i}" d="${arco(i)}" stroke="var(--rule)" stroke-width="1.2" />`).join('');
    return `<svg viewBox="0 0 100 100" role="img" aria-label="${cheios} de ${n} segmentos">${fatias}
      <circle cx="50" cy="50" r="46" fill="none" stroke="var(--rule)" stroke-width="2" /></svg>`;
  }

  async function pintarRelogios(ctx: any) {
    const { sb, ehMestre, id } = ctx;
    const box = el('relogios');
    const { data, error } = await sb.from('mesa_relogios').select('*').eq('mesa_id', id)
      .order('ordem', { ascending: true }).order('criado_em', { ascending: true });
    if (error) {
      if (bancoAntigo(error)) { box.innerHTML = '<p class="vazio">Relógios chegam com a migração 11.</p>'; return; }
      box.innerHTML = `<p class="erro">${esc(error.message)}</p>`; return;
    }
    if (ehMestre) el('rel-novo').hidden = false;
    if (!data?.length) {
      box.innerHTML = `<p class="vazio">${ehMestre ? 'Nenhum relógio. Crie um para marcar o que avança nas costas do grupo.' : 'Nada em contagem.'}</p>`;
    } else {
      box.innerHTML = data.map((r: any) => `<div class="relogio ${r.visivel_jogadores ? '' : 'oculto'}" data-rl="${r.id}">
        ${relogioSVG(r.segmentos, r.preenchidos, r.cor)}
        <span class="rl-nome">${esc(r.nome || '(sem nome)')}</span>
        <span class="rl-n">${r.preenchidos}/${r.segmentos}${r.visivel_jogadores ? '' : ' · oculto'}</span>
        ${ehMestre ? `<span class="rl-btns"><button class="btn-fant rl-menos" title="−1">−</button><button class="btn-fant rl-mais" title="+1">+</button><button class="btn-fant rl-edit" title="Editar">✎</button></span>` : ''}
        ${r.nota ? `<span class="muted rl-nota" title="${esc(r.nota)}">${esc(r.nota.slice(0, 40))}${r.nota.length > 40 ? '…' : ''}</span>` : ''}
      </div>`).join('');
    }
    if (!ehMestre) return;

    const mexer = async (rid: string, delta: number) => {
      const r = data.find((x: any) => x.id === rid); if (!r) return;
      const novo = Math.max(0, Math.min(r.segmentos, r.preenchidos + delta));
      if (novo === r.preenchidos) return;
      r.preenchidos = novo;
      await sb.from('mesa_relogios').update({ preenchidos: novo }).eq('id', rid);
      await pintarRelogios(ctx);
    };
    box.querySelectorAll<HTMLElement>('.relogio').forEach((card) => {
      const rid = card.dataset.rl!;
      card.querySelector('.rl-mais')?.addEventListener('click', () => mexer(rid, +1));
      card.querySelector('.rl-menos')?.addEventListener('click', () => mexer(rid, -1));
      // Clicar direto num segmento leva o relógio até ali: mais rápido que somar de um em um.
      card.querySelectorAll<SVGElement>('.rl-seg').forEach((s) => s.addEventListener('click', async () => {
        const r = data.find((x: any) => x.id === rid); if (!r) return;
        const i = parseInt(s.dataset.seg || '0', 10) + 1;
        const novo = r.preenchidos === i ? i - 1 : i; // clicar no último cheio esvazia ele
        await sb.from('mesa_relogios').update({ preenchidos: novo }).eq('id', rid);
        await pintarRelogios(ctx);
      }));
      card.querySelector('.rl-edit')?.addEventListener('click', () => abrirRelogio(ctx, data.find((x: any) => x.id === rid)));
    });
    el('rel-novo').onclick = () => abrirRelogio(ctx, null);
  }

  function abrirRelogio(ctx: any, r: any) {
    const { sb, id } = ctx;
    const dlg = el('rel-dlg') as HTMLDialogElement;
    const g = (i: string) => el(i) as HTMLInputElement;
    (el('rel-titulo') as HTMLElement).textContent = r ? 'Editar relógio' : 'Novo relógio';
    g('rel-nome').value = r?.nome || '';
    g('rel-seg').value = String(r?.segmentos ?? 6);
    g('rel-cheios').value = String(r?.preenchidos ?? 0);
    (el('rel-cor') as HTMLSelectElement).value = r?.cor || 'perigo';
    (el('rel-nota') as HTMLTextAreaElement).value = r?.nota || '';
    g('rel-vis').checked = !!r?.visivel_jogadores;
    (el('rel-excluir') as HTMLElement).hidden = !r;
    el('rel-cancelar').onclick = () => dlg.close();
    el('rel-excluir').onclick = async () => {
      if (!await uiConfirmar('Excluir este relógio?', { titulo: 'Excluir relógio', ok: 'Excluir', perigo: true })) return;
      dlg.close();
      await sb.from('mesa_relogios').delete().eq('id', r.id);
      await pintarRelogios(ctx);
    };
    el('rel-salvar').onclick = async () => {
      const seg = Math.max(2, Math.min(12, parseInt(g('rel-seg').value, 10) || 6));
      const linha = {
        mesa_id: id, nome: g('rel-nome').value.trim() || 'Relógio', segmentos: seg,
        preenchidos: Math.max(0, Math.min(seg, parseInt(g('rel-cheios').value, 10) || 0)),
        cor: (el('rel-cor') as HTMLSelectElement).value,
        nota: (el('rel-nota') as HTMLTextAreaElement).value,
        visivel_jogadores: g('rel-vis').checked,
      };
      dlg.close();
      const { error } = r
        ? await sb.from('mesa_relogios').update(linha).eq('id', r.id)
        : await sb.from('mesa_relogios').insert(linha);
      if (error) return uiErro('Erro: ' + error.message);
      await pintarRelogios(ctx);
    };
    dlg.showModal();
  }

  // ----------------------------------------------------------- ganchos
  async function pintarGanchos({ sb, ehMestre, id }: any) {
    const box = el('ganchos');
    const { data, error } = await sb.from('mesa_codex').select('id, nome, resumo, tipo, visivel_jogadores')
      .eq('mesa_id', id).eq('tipo', 'gancho').order('ordem', { ascending: true }).limit(8);
    if (error) {
      box.innerHTML = bancoAntigo(error)
        ? '<p class="vazio">O compêndio chega com a migração 11.</p>'
        : `<p class="erro">${esc(error.message)}</p>`;
      return;
    }
    // A última sessão costuma trazer o "para a próxima": puxa junto.
    let proxima = '';
    const { data: ses } = await sb.from('mesa_sessoes').select('numero, titulo, ganchos')
      .eq('mesa_id', id).order('numero', { ascending: false }).limit(1);
    if (ses?.[0]?.ganchos) {
      proxima = `<div class="gancho"><span>▸</span><div><div class="g-t">Da sessão ${ses[0].numero}${ses[0].titulo ? ' · ' + esc(ses[0].titulo) : ''}</div>
        <div class="g-r">${esc(ses[0].ganchos)}</div></div></div>`;
    }
    const itens = (data || []).map((g: any) => `<div class="gancho"><span>▸</span><div>
      <div class="g-t">${esc(g.nome)}${g.visivel_jogadores ? '' : ' <span class="muted" title="Só o mestre vê">·oculto</span>'}</div>
      ${g.resumo ? `<div class="g-r">${esc(g.resumo)}</div>` : ''}</div></div>`).join('');
    box.innerHTML = (proxima || itens)
      ? `<div class="gancho-lista">${proxima}${itens}</div>`
      : `<p class="vazio">${ehMestre ? 'Sem ganchos anotados. Crie no Compêndio o que você quer puxar na próxima cena.' : 'Nada por aqui ainda.'}</p>`;
  }

  // ------------------------------------------------------------- notas
  async function pintarNotas({ sb, ehMestre, id }: any) {
    const box = el('notas-rapidas');
    const { data, error } = await sb.from('mesa_notas').select('id, titulo, corpo, visivel_jogadores')
      .eq('mesa_id', id).order('ordem', { ascending: true }).order('criado_em', { ascending: true }).limit(6);
    if (error) { box.innerHTML = `<p class="erro">${esc(error.message)}</p>`; return; }
    if (!data?.length) {
      box.innerHTML = `<p class="vazio">${ehMestre ? 'Nenhuma nota. O Diário guarda as suas.' : 'O mestre ainda não compartilhou notas.'}</p>`;
      return;
    }
    box.innerHTML = `<div class="nota-lista">${data.map((n: any) => `<div class="nota-mini-card">
      <h4>${esc(n.titulo || '(sem título)')}${n.visivel_jogadores ? '' : ' <span class="muted">·oculta</span>'}</h4>
      <p>${esc((n.corpo || '').slice(0, 320))}${(n.corpo || '').length > 320 ? '…' : ''}</p>
    </div>`).join('')}</div>`;
  }

  main();
</script>
