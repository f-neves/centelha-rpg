---
import Base from '../layouts/Base.astro';
import FichaSkeleton from '../components/FichaSkeleton.astro';
---
<Base title="Personagem" largura="wide" descricao="Ficha do personagem ligada à sua conta.">
  <div id="setup" class="aviso" hidden>
    <strong>Área de contas ainda não configurada.</strong>
    <p class="muted">Falta ligar o Supabase. Veja <code>supabase/README.md</code>.</p>
  </div>

  <div id="carregando" class="muted">Carregando…</div>
  <div id="erro" class="erro" hidden></div>

  <div id="pg" hidden>
    <p class="voltar"><a id="link-mesa" href="#">‹ voltar</a></p>

    <header class="pers-cab">
      <div class="retrato">
        <div class="retrato-frame" id="retrato-frame" title="Clique para ampliar" hidden>
          <img id="retrato-img" alt="Retrato do personagem" />
          <!-- As ações da imagem vivem SOBRE ela, no rodapé do quadro. No modo de
               ajuste a mesma faixa vira a barra de zoom, e assim o quadro não muda
               de tamanho ao entrar e sair do enquadramento. -->
          <div class="retrato-barra" id="retrato-barra" hidden>
            <div class="retrato-dupla">
              <button type="button" class="btn retrato-bt" id="retrato-ajustar">Ajustar enquadramento</button>
              <button type="button" class="btn retrato-bt perigo" id="retrato-del">Excluir imagem</button>
            </div>
            <div class="retrato-ajuste">
              <input type="range" class="retrato-range" id="retrato-range" min="1" max="3" step="0.05" value="1" aria-label="Zoom da imagem" />
              <button type="button" class="btn retrato-bt" id="retrato-concluir">Concluir</button>
            </div>
          </div>
        </div>
        <div class="retrato-acoes" id="retrato-acoes">
          <label class="btn retrato-btn" id="retrato-lbl" hidden>Enviar imagem
            <input type="file" id="retrato-file" accept="image/*" hidden />
          </label>
        </div>
      </div>
      <div class="pers-ident">
        <span id="pers-mesa" class="muted pers-mesa"></span>
        <h1 id="pers-nome" class="cinzel">Personagem</h1>
        <div class="ident-slot" id="ident-slot"></div>
        <div class="xp-linha">
          <span id="xp-nota" class="xp-nota"></span>
          <div id="mestre-xp" class="mestre-xp" hidden>
            <label>XP do personagem <input type="number" id="xp-input" min="0" /></label>
            <button class="btn primary" id="xp-salvar">Salvar XP</button>
            <span id="xp-salvo" class="salvo"></span>
          </div>
          <span id="status-acoes" class="status-acoes"></span>
        </div>
      </div>
    </header>

    <div class="retrato-lb" id="retrato-lb" hidden><img id="retrato-lb-img" alt="Retrato ampliado" /></div>

    <div id="revisao-box" class="aviso revisao" hidden></div>

    <div id="ficha-wrap" hidden>
      <FichaSkeleton />
    </div>

    {/* No celular esta seção é a aba "História" da ficha: o invólucro leva a classe
        .ftab, que é o que o painel de abas do FichaSkeleton procura no documento
        inteiro (os estilos dele são globais). É invólucro e não a própria <section>
        porque no desktop .ftab vira display:contents, e a caixa da seção some junto
        com a margem dela. */}
    <div class="ftab" data-ftab="historia">
    <section class="bloco">
      <h2 class="barh">Descrição, História, Background &amp; Anotações</h2>
      <div class="textos">
        <label>Descrição<textarea data-campo="descricao" rows="4" placeholder="Aparência, personalidade, traços marcantes…"></textarea></label>
        <label>História<textarea data-campo="historia" rows="6" placeholder="De onde vem, o que viveu…"></textarea></label>
        <label>Background<textarea data-campo="background" rows="5" placeholder="Origem, laços, motivações…"></textarea></label>
        <label>Anotações<textarea data-campo="anotacoes" rows="5" placeholder="Notas livres do jogador…"></textarea></label>
      </div>
      <span id="txt-status" class="salvo"></span>
    </section>
    </div>

    <section class="bloco">
      <h2 class="barh">Arquivos <small>(imagens, PDFs, documentos, links)</small></h2>
      <div class="arq-tools" id="arq-tools" hidden>
        <label class="btn" id="arq-lbl">Enviar arquivo
          <input type="file" id="arq-file" hidden />
        </label>
        <span class="arq-link-row">
          <input type="url" id="arq-link-url" placeholder="Colar link (https://…)" />
          <input type="text" id="arq-link-nome" placeholder="Nome (opcional)" />
          <button class="btn" id="arq-link-add" type="button">+ link</button>
        </span>
      </div>
      <ul id="arqs" class="arqs"></ul>
    </section>
  </div>
</Base>

<script>
  import { getSupabase } from '../lib/supabase';
  import { montarFicha } from '../lib/ficha-engine';
  import { exigirLogin, supabaseConfigurado } from '../lib/auth';
  import { uiAviso, uiConfirmar, uiErro, uiPerguntar } from '../lib/ui-dialog';
  import { atualizarUltimoCrumb, definirCrumbs } from '../lib/crumbs';

  const base = import.meta.env.BASE_URL;
  const u = (p: string) => `${base.replace(/\/$/, '')}/${p}`;
  const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const debounce = (fn: (...a: any[]) => void, ms: number) => { let t: any; return (...a: any[]) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
  const q = new URLSearchParams(location.search);
  const mostraErro = (t: string) => { document.getElementById('carregando')!.hidden = true; const el = document.getElementById('erro')!; el.hidden = false; el.textContent = t; };
  const BUCKET = 'personagens';

  async function main() {
    if (!supabaseConfigurado) { document.getElementById('carregando')!.hidden = true; document.getElementById('setup')!.hidden = false; return; }
    const user = await exigirLogin(base);
    if (!user) return;
    const sb = getSupabase();

    // Criação de personagem novo: ?novo=1[&mesa=<id>]
    let id = q.get('id');
    if (!id && q.get('novo')) {
      const mesa = q.get('mesa');
      const { data, error } = await sb.from('personagens')
        .insert({ dono_id: user.id, mesa_id: mesa || null, nome: 'Novo personagem' })
        .select('id').single();
      if (error) return mostraErro('Não deu para criar o personagem: ' + error.message);
      location.replace(u('personagem') + '?id=' + data.id);
      return;
    }
    if (!id) return mostraErro('Personagem não informado.');

    const { data: pers, error } = await sb.from('personagens').select('*').eq('id', id).maybeSingle();
    if (error) return mostraErro('Erro: ' + error.message);
    if (!pers) return mostraErro('Personagem não encontrado ou você não tem acesso a ele.');

    const ehDono = pers.dono_id === user.id;
    document.getElementById('carregando')!.hidden = true;
    document.getElementById('pg')!.hidden = false;

    // voltar
    const linkMesa = document.getElementById('link-mesa') as HTMLAnchorElement;
    if (pers.mesa_id) { linkMesa.href = u('mesa') + '?id=' + pers.mesa_id; linkMesa.textContent = '‹ voltar à mesa'; }
    else { linkMesa.href = u('mesas'); linkMesa.textContent = '‹ mesas / fichas'; }

    document.getElementById('pers-nome')!.textContent = pers.nome || 'Personagem';

    // nome da mesa (se houver) + saber se o espectador é o mestre da mesa
    let ehMestre = false;
    let mesaRow: any = null;
    const nomePers = pers.nome || 'Personagem';
    if (pers.mesa_id) {
      const { data: mesa } = await sb.from('mesas').select('*').eq('id', pers.mesa_id).maybeSingle();
      mesaRow = mesa;
      if (mesa) {
        document.getElementById('pers-mesa')!.textContent = 'Mesa: ' + mesa.nome;
        ehMestre = mesa.mestre_id === user.id;
        definirCrumbs([
          { label: 'Mesas / Fichas', href: u('mesas') },
          { label: mesa.nome, href: u('mesa') + '?id=' + pers.mesa_id },
          { label: nomePers },
        ]);
      }
    } else {
      document.getElementById('pers-mesa')!.textContent = 'Sem mesa (personagem avulso)';
      definirCrumbs([{ label: 'Mesas / Fichas', href: u('mesas') }, { label: nomePers }]);
    }

    const status = pers.status || 'rascunho';
    const canEdit = (ehDono && status === 'rascunho') || ehMestre;

    // ---- Retrato: exibição, enquadramento (pan/zoom só no card) e lightbox ----
    const podeRetrato = ehDono && status === 'rascunho';
    let retratoPath: string | null = pers.imagem_path || null;
    // A moldura não tem mais tamanho fixo (acompanha a altura do cabeçalho), então
    // o arrasto mede o quadro na hora em vez de confiar numa constante.
    const posPadrao = () => ({ x: 50, y: 50, z: 1 });
    let pos = (pers.imagem_pos && typeof pers.imagem_pos === 'object')
      ? { x: pers.imagem_pos.x ?? 50, y: pers.imagem_pos.y ?? 50, z: pers.imagem_pos.z ?? 1 } : posPadrao();
    const imgEl = document.getElementById('retrato-img') as HTMLImageElement;
    const frameEl = document.getElementById('retrato-frame')!;
    const rangeEl = document.getElementById('retrato-range') as HTMLInputElement;
    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
    /**
     * O quadro toma a proporção da própria foto, e assim ela aparece inteira: sem
     * corte e sem tarja. A razão vem do ARQUIVO (naturalWidth/Height), que é um
     * número fixo, e não do layout — se viesse do layout, o retrato mais largo
     * espremeria a coluna do lado, que ficaria mais alta, que cresceria o retrato.
     * Limitada entre 1:2 e 7:5 para uma foto muito deitada não engolir a página;
     * passando disso ela sobra em tarja, que é o mal menor.
     */
    // escrita na COLUNA, e não no quadro: é ela que dimensiona, e propriedade
    // personalizada desce na árvore, não sobe
    const colunaEl = frameEl.parentElement!;
    const razaoDaFoto = () => {
      const w = imgEl.naturalWidth, h = imgEl.naturalHeight;
      if (!w || !h) return;
      colunaEl.style.setProperty('--retrato-ar', String(clamp(w / h, 0.5, 1.4)));
    };
    imgEl.addEventListener('load', razaoDaFoto);
    const aplicarPos = () => {
      imgEl.style.objectPosition = `${pos.x}% ${pos.y}%`;
      imgEl.style.transformOrigin = `${pos.x}% ${pos.y}%`;
      imgEl.style.transform = `scale(${pos.z})`;
      rangeEl.value = String(pos.z);
    };
    const salvarPos = debounce(async () => { try { await sb.from('personagens').update({ imagem_pos: pos }).eq('id', id); } catch {} }, 500);

    if (retratoPath) { await mostrarRetrato(sb, retratoPath, podeRetrato); aplicarPos(); }
    else estadoRetrato(false, podeRetrato);

    if (podeRetrato) {
      (document.getElementById('retrato-file') as HTMLInputElement).addEventListener('change', async (e) => {
        const novo = await subirRetrato(sb, id!, (e.target as HTMLInputElement).files?.[0]);
        if (novo) { retratoPath = novo; pos = posPadrao(); aplicarPos(); salvarPos(); }
      });
      document.getElementById('retrato-del')!.addEventListener('click', async () => {
        if (!retratoPath || !await uiConfirmar('Excluir a imagem do personagem? Você poderá enviar outra.', { titulo: 'Excluir imagem', ok: 'Excluir', perigo: true })) return;
        await excluirRetrato(sb, id!, retratoPath, podeRetrato);
        retratoPath = null;
      });
      // modo de ajuste: arrastar posiciona, a barra dá zoom — só muda o card
      let ajuste = false, arrastando = false, lx = 0, ly = 0;
      const modo = (v: boolean) => { ajuste = v; frameEl.classList.toggle('ajustando', v); };
      document.getElementById('retrato-ajustar')!.addEventListener('click', () => modo(true));
      document.getElementById('retrato-concluir')!.addEventListener('click', () => modo(false));
      frameEl.addEventListener('pointerdown', (e) => {
        // a faixa de ações é dela mesma: apertar um botão não arrasta a foto
        if (!ajuste || (e.target as HTMLElement).closest('.retrato-barra')) return;
        const pe = e as PointerEvent; arrastando = true;
        frameEl.setPointerCapture?.(pe.pointerId); lx = pe.clientX; ly = pe.clientY;
      });
      frameEl.addEventListener('pointermove', (e) => {
        if (!ajuste || !arrastando) return; const pe = e as PointerEvent;
        const dx = pe.clientX - lx, dy = pe.clientY - ly; lx = pe.clientX; ly = pe.clientY;
        // o quadro muda de tamanho com a página: mede na hora
        const r = frameEl.getBoundingClientRect();
        pos.x = clamp(pos.x - (dx / (r.width * pos.z)) * 100, 0, 100);
        pos.y = clamp(pos.y - (dy / (r.height * pos.z)) * 100, 0, 100);
        aplicarPos();
      });
      const soltar = () => { if (arrastando) { arrastando = false; salvarPos(); } };
      frameEl.addEventListener('pointerup', soltar);
      frameEl.addEventListener('pointercancel', soltar);
      rangeEl.addEventListener('input', () => { pos.z = parseFloat(rangeEl.value) || 1; aplicarPos(); salvarPos(); });
    }

    // ampliar imagem (lightbox) — mostra a imagem inteira, sem o enquadramento do card
    const lb = document.getElementById('retrato-lb')!;
    frameEl.addEventListener('click', (e) => {
      // clicar num botão da faixa não pode abrir a ampliação por tabela
      if (frameEl.classList.contains('ajustando') || (e.target as HTMLElement).closest('.retrato-barra')) return;
      lb.hidden = false; document.body.style.overflow = 'hidden';
    });
    lb.addEventListener('click', () => { lb.hidden = true; document.body.style.overflow = ''; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.hidden) { lb.hidden = true; document.body.style.overflow = ''; } });

    // XP: se estiver em mesa, o mestre define (input travado); senão o jogador escolhe.
    // Sem XP individual, vale o XP inicial que o mestre definiu na mesa.
    let budgetValor: number | null = null;
    let budgetLocked = false;
    if (pers.mesa_id) {
      budgetLocked = true;
      const { data: xpRow } = await sb.from('personagem_xp').select('xp').eq('personagem_id', id).maybeSingle();
      const xpInicial = Number(mesaRow?.xp_inicial ?? 0) || 0;
      budgetValor = xpRow?.xp ?? xpInicial;
      document.getElementById('xp-nota')!.textContent = xpRow
        ? `XP definido pelo mestre: ${budgetValor}`
        : xpInicial
          ? `XP inicial da mesa: ${xpInicial}`
          : 'Aguardando o mestre definir seu XP.';
    }

    // textos (editáveis por quem pode editar a ficha)
    (['descricao', 'historia', 'background', 'anotacoes'] as const).forEach((campo) => {
      const ta = document.querySelector<HTMLTextAreaElement>(`textarea[data-campo="${campo}"]`)!;
      ta.value = pers[campo] || '';
      if (!canEdit) { ta.readOnly = true; return; }
      const salvarTexto = debounce(async (valor: string) => {
        await sb.from('personagens').update({ [campo]: valor }).eq('id', id);
        const st = document.getElementById('txt-status')!; st.textContent = 'Salvo'; setTimeout(() => (st.textContent = ''), 1200);
      }, 700);
      ta.addEventListener('input', () => salvarTexto(ta.value));
    });

    // arquivos (o dono gerencia os próprios anexos e links; o mestre também vê/baixa)
    if (ehDono) {
      document.getElementById('arq-tools')!.hidden = false;
      (document.getElementById('arq-file') as HTMLInputElement).addEventListener('change', (e) => subirArquivo(sb, id!, pers.mesa_id, user.id, (e.target as HTMLInputElement).files?.[0]));
      document.getElementById('arq-link-add')!.addEventListener('click', () => subirLink(sb, id!, pers.mesa_id, user.id));
    }
    await listarArquivos(sb, id, ehDono);

    // ficha: editável para o dono em rascunho e para o mestre; senão leitura
    document.getElementById('ficha-wrap')!.hidden = false;
    const salvarFicha = debounce(async (S: any) => {
      await sb.from('personagens').update({
        ficha: S,
        nome: (S.id?.nome || pers.nome || 'Personagem'),
        conceito: (S.id?.conceito || ''),
        atualizado_em: new Date().toISOString(),
      }).eq('id', id);
      const nomeAtual = S.id?.nome || pers.nome || 'Personagem';
      document.getElementById('pers-nome')!.textContent = nomeAtual;
      atualizarUltimoCrumb(nomeAtual);
    }, 900);
    // Campos de identidade da ficha da mesa (ordem clássica). Reconstruído ANTES de montarFicha
    // para o motor ligar cada .txt por data-id (salva em S.id) e o #raca-sel por id.
    // 1ª linha: Nome · Título · Jogador · Raça — 2ª linha: Altura · Peso · Idade · Conceito.
    const idrowEl = document.querySelector('.idrow');
    if (idrowEl) idrowEl.innerHTML =
      '<label>Nome<input class="txt" data-id="nome" placeholder="Seu herói" /></label>'
      + '<label>Título<input class="txt" data-id="titulo" placeholder="ex.: o Bravo" /></label>'
      + '<label>Jogador<input class="txt" data-id="jogador" /></label>'
      + '<label>Raça<select class="racasel" id="raca-sel"></select></label>'
      + '<label>Altura<input class="txt" data-id="altura" placeholder="ex.: 1,85 m" /></label>'
      + '<label>Peso<input class="txt" data-id="peso" placeholder="ex.: 90 kg" /></label>'
      + '<label>Idade<input class="txt" data-id="idade" placeholder="ex.: 24 anos" /></label>'
      + '<label>Conceito<input class="txt" data-id="conceito" placeholder="ex.: Paladino" /></label>';

    montarFicha({
      carregar: () => (pers.ficha && Object.keys(pers.ficha).length ? pers.ficha : null),
      salvar: canEdit ? (S) => salvarFicha(S) : () => {},
      readOnly: !canEdit,
      budgetLocked, budgetValor,
      aoResetar: () => {},
    });

    // Layout clássico: sobe os campos de identidade (Nome/Conceito/Jogador/Raça) para o cabeçalho.
    // O motor liga tudo por seletores globais, então mover os nós não quebra os bindings.
    const identSlot = document.getElementById('ident-slot');
    const idrow = document.querySelector('.idrow');
    if (identSlot && idrow) identSlot.appendChild(idrow);
    // A descrição da raça não entra na ficha da mesa; mantém o elemento (o motor escreve nele).
    const racaInfo = document.getElementById('raca-info');
    if (racaInfo) racaInfo.style.display = 'none';

    // editor de XP (mestre)
    if (ehMestre) {
      document.getElementById('mestre-xp')!.hidden = false;
      const xpInput = document.getElementById('xp-input') as HTMLInputElement;
      xpInput.value = String(budgetValor ?? 0);
      document.getElementById('xp-salvar')!.addEventListener('click', async () => {
        const xp = Math.max(0, +xpInput.value || 0);
        const { error } = await sb.from('personagem_xp').upsert(
          { personagem_id: id, xp, definido_por: user.id, atualizado_em: new Date().toISOString() },
          { onConflict: 'personagem_id' },
        );
        const st = document.getElementById('xp-salvo')!;
        if (error) { st.textContent = 'Erro: ' + error.message; st.style.color = 'var(--perigo)'; return; }
        st.textContent = 'XP salvo (recarregando…)'; st.style.color = '';
        setTimeout(() => location.reload(), 700);
      });
    }

    // aprovação (as ações vivem na linha de XP, junto do que o mestre decide)
    montarAcoes(sb, id, pers, ehDono, ehMestre, status);
  }

  /**
   * As ações de fluxo da ficha: enviar, cancelar, aprovar, devolver, reabrir.
   * Moram na linha do XP porque é a mesma conversa entre jogador e mestre.
   * Excluir NÃO está aqui: é decisão do mestre, e mora na página da Mesa.
   */
  function montarAcoes(sb: any, id: string, pers: any, ehDono: boolean, ehMestre: boolean, status: string) {
    const acoes = document.getElementById('status-acoes')!;
    const btn = (rotulo: string, cls2 = '') => { const b = document.createElement('button'); b.className = 'btn ' + cls2; b.textContent = rotulo; acoes.appendChild(b); return b; };
    const rpc = async (fn: string, args: any = {}) => { const { error } = await sb.rpc(fn, { p_id: id, ...args }); if (error) return uiErro('Erro: ' + error.message); location.reload(); };

    // recado de devolução (para o dono)
    if (ehDono && status === 'rascunho' && (pers.revisao_nota || '').trim()) {
      const rb = document.getElementById('revisao-box')!; rb.hidden = false;
      rb.innerHTML = `<strong>O mestre pediu ajustes:</strong> ${esc(pers.revisao_nota)}`;
    }

    // ações do jogador (quando não é também o mestre)
    if (ehDono && !ehMestre) {
      if (status === 'rascunho') btn('Enviar para aprovação', 'primary').onclick = () => rpc('enviar_ficha');
      else if (status === 'enviado') btn('Cancelar envio').onclick = () => rpc('cancelar_envio');
    }
    // ações do mestre
    if (ehMestre) {
      if (status !== 'aprovado') btn('Aprovar', 'primary').onclick = async () => {
        const rem = parseInt(document.getElementById('xpRem')?.textContent || '0', 10);
        if (rem < 0 && !await uiConfirmar(`Atenção: XP estourado (restam ${rem}). Aprovar mesmo assim?`, { titulo: 'Aprovar ficha', ok: 'Aprovar assim mesmo' })) return;
        rpc('aprovar_ficha');
      };
      if (status === 'enviado') btn('Devolver com recado').onclick = async () => {
        const nota = await uiPerguntar('Recado para o jogador', '', {
          titulo: 'Devolver ficha',
          msg: 'A ficha volta a rascunho e o jogador vê o recado no topo da página.',
          placeholder: 'O que precisa ser ajustado…', longo: true, ok: 'Devolver',
        });
        if (nota === null) return;
        rpc('devolver_ficha', { p_nota: nota });
      };
      if (status === 'aprovado') btn('Reabrir para edição').onclick = () => rpc('reabrir_ficha');
    }
  }

  function estadoRetrato(temImg: boolean, pode: boolean) {
    const frame = document.getElementById('retrato-frame')!;
    frame.hidden = !temImg;
    // O botão só existe para PÔR a primeira imagem. Trocar sai de cena: com uma
    // imagem no lugar, as ações são enquadrar e excluir, e quem quiser outra
    // exclui esta e envia a nova.
    const mostrarEnviar = pode && !temImg;
    document.getElementById('retrato-lbl')!.hidden = !mostrarEnviar;
    // some com a caixa junto, e não só com o botão: vazia ela ainda cobrava o
    // espaçamento da coluna, e o quadro ficava 8px menor que o cabeçalho
    document.getElementById('retrato-acoes')!.hidden = !mostrarEnviar;
    // a faixa de ações fica sobre a imagem, e só para quem pode editar
    document.getElementById('retrato-barra')!.hidden = !(pode && temImg);
    if (!(pode && temImg)) frame.classList.remove('ajustando');
    // sem foto não há razão a seguir: volta para a moldura clássica
    if (!temImg) frame.parentElement?.style.removeProperty('--retrato-ar');
  }
  async function mostrarRetrato(sb: any, path: string, pode: boolean) {
    const { data } = await sb.storage.from(BUCKET).createSignedUrl(path, 3600);
    if (!data?.signedUrl) return;
    (document.getElementById('retrato-img') as HTMLImageElement).src = data.signedUrl;
    (document.getElementById('retrato-lb-img') as HTMLImageElement).src = data.signedUrl;
    estadoRetrato(true, pode);
  }
  async function subirRetrato(sb: any, id: string, file?: File): Promise<string | null> {
    if (!file) return null;
    const ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
    const path = `${id}/retrato-${Date.now()}.${ext}`;
    const { error } = await sb.storage.from(BUCKET).upload(path, file, { upsert: true, contentType: file.type });
    if (error) { await uiErro('Erro ao enviar imagem: ' + error.message); return null; }
    await sb.from('personagens').update({ imagem_path: path }).eq('id', id);
    await mostrarRetrato(sb, path, true);
    return path;
  }
  async function excluirRetrato(sb: any, id: string, path: string, pode: boolean) {
    const { error } = await sb.storage.from(BUCKET).remove([path]);
    if (error) { await uiErro('Erro ao excluir imagem: ' + error.message); return; }
    await sb.from('personagens').update({ imagem_path: null }).eq('id', id);
    (document.getElementById('retrato-img') as HTMLImageElement).src = '';
    (document.getElementById('retrato-lb-img') as HTMLImageElement).src = '';
    (document.getElementById('retrato-file') as HTMLInputElement).value = '';
    estadoRetrato(false, pode);
  }

  async function subirArquivo(sb: any, id: string, mesaId: string | null, userId: string, file?: File) {
    if (!file) return;
    const nomeSeguro = file.name.replace(/[^\w.\-]+/g, '_');
    const path = `${id}/anexo-${Date.now()}-${nomeSeguro}`;
    const { error } = await sb.storage.from(BUCKET).upload(path, file, { contentType: file.type });
    if (error) return uiErro('Erro ao enviar arquivo: ' + error.message);
    const { error: e2 } = await sb.from('arquivos').insert({
      mesa_id: mesaId, personagem_id: id, dono_id: userId, nome: file.name,
      storage_path: path, bucket: BUCKET, tipo: file.type, categoria: 'anexo-jogador',
    });
    if (e2) return uiErro('Enviado, mas erro ao registrar: ' + e2.message);
    await listarArquivos(sb, id, true);
  }
  function linkSeguro(u: string) { return /^https?:\/\//i.test((u || '').trim()) ? u.trim() : ''; }
  async function subirLink(sb: any, id: string, mesaId: string | null, userId: string) {
    const urlEl = document.getElementById('arq-link-url') as HTMLInputElement;
    const nomeEl = document.getElementById('arq-link-nome') as HTMLInputElement;
    const url = linkSeguro(urlEl.value);
    if (!url) { await uiAviso('Cole um link válido começando com http:// ou https://', { titulo: 'Link inválido' }); return; }
    const nome = (nomeEl.value || '').trim() || url;
    const { error } = await sb.from('arquivos').insert({
      mesa_id: mesaId, personagem_id: id, dono_id: userId, nome, url, tipo: 'link', categoria: 'link-jogador',
    });
    if (error) return uiErro('Erro ao adicionar link: ' + error.message);
    urlEl.value = ''; nomeEl.value = '';
    await listarArquivos(sb, id, true);
  }
  async function listarArquivos(sb: any, id: string, ehDono: boolean) {
    const { data, error } = await sb.from('arquivos').select('*').eq('personagem_id', id).order('criado_em', { ascending: false });
    const ul = document.getElementById('arqs')!;
    if (error) { ul.innerHTML = `<li class="erro">${esc(error.message)}</li>`; return; }
    if (!data?.length) { ul.innerHTML = '<li class="muted">Nenhum arquivo ainda.</li>'; return; }
    ul.innerHTML = data.map((a: any) => {
      const rm = ehDono ? '<button class="btn arq-rm" title="Remover">✕</button>' : '';
      if (a.url) {
        const href = linkSeguro(a.url);
        return `<li data-arq="${a.id}" data-link="1">
          <a href="${esc(href)}" class="arq-link" target="_blank" rel="noopener noreferrer">${esc(a.nome)}</a>
          <span class="muted arq-tipo">link</span>${rm}
        </li>`;
      }
      return `<li data-arq="${a.id}" data-path="${esc(a.storage_path)}" data-bucket="${esc(a.bucket || BUCKET)}">
        <a href="#" class="arq-abrir">${esc(a.nome)}</a>
        <span class="muted arq-tipo">${esc((a.tipo || '').split('/')[1] || '')}</span>${rm}
      </li>`;
    }).join('');
    ul.querySelectorAll<HTMLElement>('.arq-abrir').forEach((a) => a.addEventListener('click', async (e) => {
      e.preventDefault();
      const li = a.closest('li')!; const { data: s } = await sb.storage.from(li.dataset.bucket!).createSignedUrl(li.dataset.path!, 3600);
      if (s?.signedUrl) window.open(s.signedUrl, '_blank');
    }));
    ul.querySelectorAll<HTMLElement>('.arq-rm').forEach((b) => b.addEventListener('click', async () => {
      const li = b.closest('li')!;
      if (!await uiConfirmar('Remover este item?', { titulo: 'Remover', ok: 'Remover', perigo: true })) return;
      if (!li.dataset.link) await sb.storage.from(li.dataset.bucket!).remove([li.dataset.path!]);
      await sb.from('arquivos').delete().eq('id', li.dataset.arq);
      await listarArquivos(sb, id, true);
    }));
  }

  main();
</script>

<!-- is:global: cabeçalho, listas e ficha são preenchidos via JS -->
<style is:global>
  .voltar { margin: 0 0 .6rem; }
  .voltar a { color: var(--accent-texto); text-decoration: none; }
  .pers-cab { display: flex; gap: 1.2rem; align-items: stretch; flex-wrap: wrap; margin-bottom: 1rem; }
  .retrato { display: flex; flex-direction: column; gap: .5rem; align-items: center; flex: 0 0 auto; }
  /* a moldura em si mora em styles/global.css (compartilhada com os cards de Mesas / Fichas);
     aqui ficam só os comportamentos de edição desta página. */
  .retrato-frame { cursor: zoom-in; }
  .retrato-frame.ajustando { cursor: grab; box-shadow: 0 0 0 2px var(--accent); }
  .retrato-frame.ajustando:active { cursor: grabbing; }
  .retrato-frame.ajustando img { transition: none; }
  .retrato-range { -webkit-appearance: none; appearance: none; width: 172px; height: 16px; background: transparent; cursor: pointer; margin: 0; }
  .retrato-range::-webkit-slider-runnable-track { height: 3px; border-radius: var(--r-sm); background: color-mix(in srgb, var(--accent) 40%, var(--rule)); }
  .retrato-range::-moz-range-track { height: 3px; border-radius: var(--r-sm); background: color-mix(in srgb, var(--accent) 40%, var(--rule)); }
  .retrato-range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 14px; height: 14px; margin-top: -5.5px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); box-shadow: 0 1px 3px rgba(0,0,0,.35); }
  .retrato-range::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); box-shadow: 0 1px 3px rgba(0,0,0,.35); }
  .retrato-range:focus-visible { outline: none; }
  .retrato-range:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .retrato-range:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent); }
  .retrato-acoes { display: flex; flex-direction: column; gap: .35rem; width: 100%; }
  .retrato-acoes:empty { display: none; }
  .retrato-btn { cursor: pointer; font-size: var(--fs-micro); text-align: center; justify-content: center; }

  /* ---- faixa de ações SOBRE a imagem ----
     Ocupa os 20% de baixo do quadro, e os dois botões dividem a largura ao meio.
     No modo de ajuste a mesma faixa vira a barra de zoom mais o Concluir: assim o
     quadro não muda de tamanho ao entrar e sair do enquadramento, que era o que
     aconteceria com a barra morando abaixo dele.
     Só aparece no hover: a foto é o assunto, e os controles são visita. */
  .retrato-barra { position: absolute; left: 0; right: 0; bottom: 0; min-height: 20%; z-index: 3;
    display: flex; align-items: center; gap: .4rem; padding: .3rem .45rem;
    background: linear-gradient(to top, color-mix(in srgb, var(--bg) 88%, transparent), transparent);
    opacity: 0; transition: opacity .14s; pointer-events: none; }
  .retrato-barra[hidden] { display: none; }
  .retrato-frame:hover .retrato-barra,
  .retrato-frame:focus-within .retrato-barra,
  .retrato-frame.ajustando .retrato-barra { opacity: 1; pointer-events: auto; }
  /* sem mouse não há hover: no toque a faixa fica sempre à mão */
  @media (hover: none) { .retrato-barra { opacity: 1; pointer-events: auto; } }
  /* Sempre lado a lado, com metade da largura cada. */
  .retrato-dupla { display: flex; gap: .35rem; width: 100%; }
  .retrato-ajuste { display: none; width: 100%; align-items: center; gap: .5rem; }
  .retrato-frame.ajustando .retrato-dupla { display: none; }
  .retrato-frame.ajustando .retrato-ajuste { display: flex; }
  .retrato-ajuste .retrato-range { flex: 1; width: auto; min-width: 0; }
  /* Os botões são os `.btn` do site; aqui só ganham meia largura cada, o rótulo
     miúdo que cabe num quadro estreito e o fundo mais opaco, que é o que os
     separa da foto por baixo. */
  /* Lado a lado num quadro estreito sobra pouca largura por botão: fonte miúda
     para "enquadramento" caber numa linha e a quebra cair no espaço, e não no
     meio da palavra. */
  .retrato-bt { flex: 1 1 0; min-width: 0; padding: .3rem .35rem;
    background: color-mix(in srgb, var(--panel) 88%, transparent); backdrop-filter: blur(3px);
    font-size: .55rem; line-height: 1.25; text-align: center; overflow-wrap: break-word; }
  .retrato-ajuste .retrato-bt { flex: 0 0 auto; }
  .retrato-bt.perigo { color: var(--perigo); border-color: color-mix(in srgb, var(--perigo) 55%, transparent); }
  .retrato-bt.perigo:hover { background: var(--perigo-bg); color: var(--on-perigo); border-color: var(--perigo); }
  .retrato-lb { position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center; padding: 2rem; background: color-mix(in srgb, #000 80%, transparent); cursor: zoom-out; }
  .retrato-lb[hidden] { display: none; }
  .retrato-lb img { max-width: 92vw; max-height: 88vh; border-radius: var(--r-lg); box-shadow: 0 12px 44px rgba(0,0,0,.5); }

  /* A moldura padrão (172×208) mora em global.css e é a mesma dos cards de
     Mesas / Fichas. Aqui ela é outra coisa: toma toda a altura do cabeçalho, e a
     largura sai da proporção. Quem passa a mandar na altura é o painel de
     identificação ao lado, já que as ações da imagem saíram de baixo do retrato
     e foram para dentro dele. */
  /* A largura da coluna do retrato é DEFINIDA, e não tirada da altura.
     Já tentei os dois caminhos "elegantes" e nenhum funciona: em flexbox a
     largura de um item é resolvida ANTES da altura esticada, então uma razão de
     aspecto nunca consegue converter "a altura do cabeçalho" em largura. Com a
     razão no quadro, a coluna se media pelo tamanho mínimo dele e o quadro
     crescia POR FORA dela, sobrando dos dois lados (213px de cada lado numa foto
     deitada, um deles para fora do cabeçalho). Com a razão na coluna, a largura
     dava zero.
     Então: a largura sai da razão da FOTO vezes uma altura de referência, presa
     entre um piso e um teto. A foto deitada ganha coluna larga, a em pé ganha
     coluna estreita, e nada depende do layout — logo, nada vaza e nada
     realimenta. A altura continua sendo a do cabeçalho, e o `contain` mostra a
     foto inteira dentro dela. */
  .pers-cab .retrato { align-self: stretch;
    width: clamp(9rem, calc(var(--retrato-ar, .827) * 22rem), 38%); }
  /* `position: relative` é o que ancora a faixa de ações DENTRO do quadro; a regra
     de global.css não tem, e sem isto a faixa se prendia ao ancestral posicionado
     mais próximo e saía com a largura da página. */
  /* O quadro toma a proporção da FOTO (o script lê o tamanho natural dela e
     escreve --retrato-ar), então ela aparece inteira, sem tarja nem corte. A
     razão vem do arquivo, não do layout: é um número constante, e por isso não
     realimenta a largura. Sem foto, vale a moldura clássica de 215×260. */
  /* O quadro preenche a coluna inteira, que estica junto com o cabeçalho: dá
     exatamente a altura do painel de identificação ao lado. A largura da coluna
     vem da razão da foto, então a moldura chega perto do formato dela; o que
     sobrar aparece como tarja, porque o `contain` mantém a foto inteira. */
  .pers-cab .retrato-frame { position: relative; flex: 1; min-height: 0; width: 100%;
    height: auto; aspect-ratio: auto; }
  /* A foto sai do fluxo. Com ela dentro, a largura `auto` do quadro pegava o
     tamanho NATURAL da imagem em vez da razão: uma foto de 600px de largura
     esticava o retrato para 600px, que por sua vez espremia a coluna do lado, que
     ficava mais alta, que crescia o retrato de novo. */
  .pers-cab .retrato-frame img { position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; }
  /* A identificação cede a largura que o retrato pedir: agora ele é tão largo
     quanto a foto precisa para caber inteira, e uma foto deitada ocupa bem mais
     que os 215px de antes. */
  .pers-ident { flex: 1 1 12rem; min-width: 11rem; display: flex; flex-direction: column; gap: .4rem; border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--panel); padding: .8rem 1rem 1rem; }
  .pers-ident h1 { margin: .05rem 0 .2rem; }
  /* Havia um lápis que abria um menu flutuante com as ações da imagem, e ele
     existia porque o retrato era uma miniatura de 96px ao lado do nome. Com o
     retrato numa linha só para ele, as ações cabem embaixo e o menu saiu de cena
     — junto com o balão que escapava pela lateral: ancorado em `right: -10px` a
     partir de uma coluna de 96px, ele começava fora da margem esquerda. */
  @media (max-width: 900px) {
    /* uma coluna: retrato em cima, identificação embaixo. Aqui não há nada ao
       lado para igualar a altura, então quem manda é a largura da tela e a
       altura sai da proporção. */
    .pers-cab { display: flex; flex-direction: column; gap: .8rem; align-items: stretch; }
    .retrato { position: relative; }
    /* aqui não há nada ao lado: a coluna toma a largura toda e a altura sai da razão */
    .pers-cab .retrato { width: 100%; max-width: none; max-height: none; }
    .pers-cab .retrato-frame { flex: none; width: 100%; height: auto;
      aspect-ratio: var(--retrato-ar, .827); }
    .pers-ident { min-width: 0; }
  }

  .pers-mesa { font-style: italic; font-size: var(--fs-rotulo); }
  .ident-slot { margin-top: .2rem; }
  .ident-slot .idrow { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .55rem 1rem; margin: 0; }
  /* No celular os oito campos viram duas colunas, e a leitura desce em vez de
     atravessar: Nome · Título · Jogador · Raça numa, Altura · Peso · Idade ·
     Conceito na outra. Daí o `grid-auto-flow: column` com quatro linhas fixas —
     em duas colunas normais a ordem sairia aos pares (Nome/Título, Jogador/Raça),
     misturando quem é a pessoa com quanto ela mede. */
  @media (max-width: 720px) {
    .ident-slot .idrow { grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto); grid-auto-flow: column; gap: .5rem .8rem; }
  }
  .xp-linha { margin-top: auto; padding-top: .3rem; }
  .xp-nota { color: var(--muted); font-size: var(--fs-rotulo); }
  .mestre-xp { display: flex; align-items: flex-end; gap: .6rem; flex-wrap: wrap; margin-top: .4rem; }
  .mestre-xp label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); text-transform: uppercase; letter-spacing: .04em; color: var(--ink-soft); gap: .2rem; }
  .mestre-xp input { width: 7rem; padding: .4rem; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--bg); color: var(--ink); font: inherit; }
  .bloco { margin-top: 1.6rem; }
  .textos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 760px) { .textos { grid-template-columns: 1fr; } }
  .textos label { display: flex; flex-direction: column; font-family: 'Cinzel'; font-size: var(--fs-micro); letter-spacing: .04em; color: var(--ink-soft); text-transform: uppercase; gap: .3rem; }
  .textos textarea { font: inherit; font-family: 'EB Garamond'; text-transform: none; letter-spacing: 0; padding: .6rem; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--bg); color: var(--ink); resize: vertical; }
  .salvo { color: var(--accent-texto); font-size: var(--fs-micro); }
  .arq-tools { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .8rem; }
  .arq-link-row { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
  .arq-link-row input { font: inherit; font-family: 'EB Garamond'; font-size: var(--fs-aux); color: var(--ink); background: var(--bg); border: 1px solid var(--panel-border); border-radius: var(--r-md); padding: .35rem .5rem; }
  .arq-link-row #arq-link-url { min-width: 15rem; }
  .arq-link-row #arq-link-nome { min-width: 9rem; }
  .arqs { list-style: none; padding: 0; display: flex; flex-direction: column; gap: .3rem; margin-top: .6rem; }
  .arqs li { display: flex; align-items: center; gap: .6rem; padding: .35rem 0; border-bottom: 1px solid var(--rule); }
  .arqs .arq-abrir, .arqs .arq-link { flex: 1; color: var(--accent-texto); text-decoration: none; word-break: break-word; }
  .arqs .arq-link:hover { text-decoration: underline; }
  .arqs .arq-tipo { font-size: var(--fs-micro); text-transform: uppercase; }
  .arqs .arq-rm { background: none; border: none; color: var(--perigo); cursor: pointer; }
  .aviso { border: 1px solid var(--gold, var(--rule)); border-radius: var(--r-lg); padding: 1rem; background: color-mix(in srgb, var(--gold, #caa) 12%, transparent); max-width: 46rem; margin-bottom: 1rem; }
  .erro { color: var(--perigo); }

  /* As ações da ficha (enviar, aprovar, devolver, reabrir) na linha do XP */
  .status-acoes { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .4rem; }
  .status-acoes:empty { display: none; }
  .btn.perigo { border-color: var(--perigo); color: var(--perigo); }
  .btn.perigo:hover { background: var(--perigo-bg); color: var(--on-perigo); }
  .revisao { border-color: var(--gold, #b8860b); }
</style>
