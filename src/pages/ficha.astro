---
import Base from '../layouts/Base.astro';
import FichaSkeleton from '../components/FichaSkeleton.astro';
---
<Base title="Ficha de Personagem" largura="wide" descricao="Monte um personagem com XP ao vivo: atributos, habilidades, secundárias, Técnicas e Artes — tudo por bolinhas, com os derivados calculados.">
  <h1>Ficha de Personagem</h1>
  <FichaSkeleton />
</Base>

<script>
  import { montarFicha } from '../lib/ficha-engine';
  import { getSupabase, supabaseConfigurado } from '../lib/supabase';
  import { url } from '../lib/site';
  import { uiAviso, uiConfirmar, uiErro, uiEscolher } from '../lib/ui-dialog';
  const KEY = 'centelha:ficha';
  montarFicha({
    carregar: () => {
      const m = location.hash.match(/p=([^&]+)/);
      if (m) { try { return JSON.parse(decodeURIComponent(escape(atob(m[1])))); } catch {} }
      try { const raw = localStorage.getItem(KEY); if (raw) return JSON.parse(raw); } catch {}
      return null;
    },
    salvar: (S) => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {} },
    aoResetar: () => { try { localStorage.removeItem(KEY); } catch {}; location.hash = ''; },
  });

  // Id do personagem que esta ficha local já gerou, para "Salvar ficha" atualizar
  // o mesmo registro em vez de criar um novo a cada clique.
  const KEY_PERS = 'centelha:ficha:personagem-id';

  // ---- Botões de conta: "Salvar ficha" e "Enviar p/ mesa" ----
  if (supabaseConfigurado) {
    const btns = document.querySelector('.xp-btns');
    if (btns) {
      const enviar = document.createElement('button');
      enviar.className = 'btn'; enviar.type = 'button'; enviar.textContent = 'Enviar p/ mesa';
      enviar.title = 'Copiar esta ficha para uma das suas mesas';
      btns.insertBefore(enviar, btns.firstChild);
      enviar.addEventListener('click', () => enviarParaMesa().catch((e) => uiErro('Erro: ' + (e?.message || e))));

      const salvar = document.createElement('button');
      salvar.className = 'btn'; salvar.type = 'button'; salvar.textContent = 'Salvar ficha';
      salvar.title = 'Guardar esta ficha em Mesas / Fichas para editar depois';
      btns.insertBefore(salvar, enviar);   // antes de "Enviar p/ mesa"
      salvar.addEventListener('click', () => salvarFicha().catch((e) => uiErro('Erro: ' + (e?.message || e))));
    }
  }

  function lerFichaLocal(): any | null {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  }
  async function exigirUsuario(acao: string) {
    const { data: { user } } = await getSupabase().auth.getUser();
    if (user) return user;
    if (await uiConfirmar(`Você precisa entrar na sua conta para ${acao}. Ir para o login?`, { titulo: 'Entrar', ok: 'Ir para o login' })) location.href = url('entrar');
    return null;
  }

  // Guarda a ficha como personagem avulso (sem mesa). Reeditável em Mesas / Fichas.
  async function salvarFicha() {
    const sb = getSupabase();
    const user = await exigirUsuario('salvar a ficha');
    if (!user) return;
    const ficha = lerFichaLocal();
    if (!ficha) { await uiAviso('Nenhuma ficha para salvar.'); return; }
    const nome = (ficha.id?.nome || '').trim() || 'Personagem';
    const conceito = (ficha.id?.conceito || '').trim();

    const idSalvo = localStorage.getItem(KEY_PERS);
    if (idSalvo) {
      // confere se o registro ainda existe e é do usuário antes de atualizar
      const { data: atual } = await sb.from('personagens').select('id, nome, mesa_id').eq('id', idSalvo).maybeSingle();
      if (atual) {
        const alvo = atual.mesa_id ? `"${atual.nome}" (já enviada para uma mesa)` : `"${atual.nome}"`;
        const escolha = await uiEscolher('Salvar ficha', [
          { valor: 'atualizar', rotulo: 'Atualizar a ficha salva', nota: alvo },
          { valor: 'nova', rotulo: 'Salvar como um novo personagem' },
        ], { msg: 'Esta ficha já foi salva antes. O que você quer fazer?' });
        if (!escolha) return;
        if (escolha === 'atualizar') {
          const { error } = await sb.from('personagens').update({ nome, conceito, ficha, atualizado_em: new Date().toISOString() }).eq('id', idSalvo);
          if (error) { await uiErro('Não foi possível salvar: ' + error.message); return; }
          if (await uiConfirmar(`Ficha "${nome}" atualizada. Abrir em Mesas / Fichas?`, { titulo: 'Salva', ok: 'Abrir' })) location.href = url('personagem') + '?id=' + idSalvo;
          return;
        }
      }
    }
    const { data: nova, error } = await sb.from('personagens')
      .insert({ dono_id: user.id, mesa_id: null, nome, conceito, ficha })
      .select('id').single();
    if (error) { await uiErro('Não foi possível salvar: ' + error.message); return; }
    try { localStorage.setItem(KEY_PERS, nova.id); } catch {}
    if (await uiConfirmar(`Ficha "${nome}" salva em Mesas / Fichas. Abrir agora para pôr imagem e cabeçalho?`, { titulo: 'Salva', ok: 'Abrir' })) location.href = url('personagem') + '?id=' + nova.id;
  }

  async function enviarParaMesa() {
    const sb = getSupabase();
    const user = await exigirUsuario('enviar a ficha a uma mesa');
    if (!user) return;
    const ficha = lerFichaLocal();
    if (!ficha) { await uiAviso('Nenhuma ficha salva para enviar.'); return; }

    const { data: membros, error } = await sb
      .from('mesa_membros')
      .select('mesa_id, papel, mesas(nome)')
      .eq('user_id', user.id);
    if (error) { await uiErro('Erro ao buscar suas mesas: ' + error.message); return; }
    const mesas = (membros || [])
      .map((m: any) => ({ id: m.mesa_id, nome: m.mesas?.nome || 'Mesa', papel: m.papel }))
      .sort((a: any, b: any) => a.nome.localeCompare(b.nome, 'pt'));
    if (!mesas.length) {
      if (await uiConfirmar('Você ainda não participa de nenhuma mesa. Ir para Mesas para criar ou entrar em uma?', { titulo: 'Sem mesas', ok: 'Ir para Mesas' })) location.href = url('mesas');
      return;
    }

    const mesaId = await pedirMesa(mesas);
    if (!mesaId) return;
    const nome = (ficha.id?.nome || '').trim() || 'Personagem';
    const conceito = (ficha.id?.conceito || '').trim();
    const { data: nova, error: e2 } = await sb
      .from('personagens')
      .insert({ dono_id: user.id, mesa_id: mesaId, nome, conceito, ficha })
      .select('id')
      .single();
    if (e2) { await uiErro('Não foi possível enviar: ' + e2.message); return; }
    location.href = url('personagem') + '?id=' + nova.id;
  }

  function pedirMesa(mesas: { id: string; nome: string; papel: string }[]): Promise<string | null> {
    return uiEscolher(
      'Enviar ficha para uma mesa',
      mesas.map((m) => ({ valor: m.id, rotulo: m.nome, nota: `(${m.papel})` })),
      { msg: 'Cria uma cópia do personagem na mesa escolhida. A ficha local continua aqui, intacta.' },
    );
  }
</script>
