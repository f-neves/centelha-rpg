---
import Base from '../layouts/Base.astro';
import FichaSkeleton from '../components/FichaSkeleton.astro';
---
<Base title="Ficha de Personagem" largura="wide" descricao="Monte um personagem com XP ao vivo: atributos, habilidades, secundárias, Técnicas e Artes — tudo por bolinhas, com os derivados calculados.">
  <h1>Ficha de Personagem</h1>
  <FichaSkeleton />
</Base>

<script>
  import { montarFicha } from '../lib/ficha-engine';
  import { getSupabase, supabaseConfigurado } from '../lib/supabase';
  import { url } from '../lib/site';
  const KEY = 'centelha:ficha';
  montarFicha({
    carregar: () => {
      const m = location.hash.match(/p=([^&]+)/);
      if (m) { try { return JSON.parse(decodeURIComponent(escape(atob(m[1])))); } catch {} }
      try { const raw = localStorage.getItem(KEY); if (raw) return JSON.parse(raw); } catch {}
      return null;
    },
    salvar: (S) => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {} },
    aoResetar: () => { try { localStorage.removeItem(KEY); } catch {}; location.hash = ''; },
  });

  // ---- Enviar a ficha para uma mesa (cria um personagem no Supabase) ----
  if (supabaseConfigurado) {
    const btns = document.querySelector('.xp-btns');
    if (btns) {
      const b = document.createElement('button');
      b.className = 'btn'; b.type = 'button'; b.textContent = 'Enviar p/ mesa';
      b.title = 'Copiar esta ficha para uma das suas mesas';
      btns.insertBefore(b, btns.firstChild);
      b.addEventListener('click', () => enviarParaMesa().catch((e) => alert('Erro: ' + (e?.message || e))));
    }
  }

  async function enviarParaMesa() {
    const sb = getSupabase();
    const { data: { user } } = await sb.auth.getUser();
    if (!user) {
      if (confirm('Você precisa entrar para enviar a ficha a uma mesa. Ir para o login?')) location.href = url('entrar');
      return;
    }
    let ficha: any = null;
    try { ficha = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
    if (!ficha) { alert('Nenhuma ficha salva para enviar.'); return; }

    const { data: membros, error } = await sb
      .from('mesa_membros')
      .select('mesa_id, papel, mesas(nome)')
      .eq('user_id', user.id);
    if (error) { alert('Erro ao buscar suas mesas: ' + error.message); return; }
    const mesas = (membros || [])
      .map((m: any) => ({ id: m.mesa_id, nome: m.mesas?.nome || 'Mesa', papel: m.papel }))
      .sort((a: any, b: any) => a.nome.localeCompare(b.nome, 'pt'));
    if (!mesas.length) {
      if (confirm('Você ainda não participa de nenhuma mesa. Ir para Mesas para criar ou entrar em uma?')) location.href = url('mesas');
      return;
    }

    const mesaId = await pedirMesa(mesas);
    if (!mesaId) return;
    const nome = (ficha.id?.nome || '').trim() || 'Personagem';
    const { data: nova, error: e2 } = await sb
      .from('personagens')
      .insert({ dono_id: user.id, mesa_id: mesaId, nome, ficha })
      .select('id')
      .single();
    if (e2) { alert('Não foi possível enviar: ' + e2.message); return; }
    location.href = url('personagem') + '?id=' + nova.id;
  }

  function pedirMesa(mesas: { id: string; nome: string; papel: string }[]): Promise<string | null> {
    return new Promise((resolve) => {
      const dlg = document.createElement('dialog');
      dlg.className = 'mesa-dlg';
      dlg.innerHTML = `
        <h3>Enviar ficha para uma mesa</h3>
        <p class="mm">Cria uma cópia do personagem na mesa escolhida. A ficha local continua aqui, intacta.</p>
        <div class="mesa-list">${mesas.map((m) => `<button class="btn mesa-op" data-id="${m.id}">${m.nome} <small>(${m.papel})</small></button>`).join('')}</div>
        <div class="mesa-foot"><button class="btn cancel" type="button">Cancelar</button></div>`;
      document.body.appendChild(dlg);
      const done = (v: string | null) => { resolve(v); dlg.close(); dlg.remove(); };
      dlg.querySelectorAll('.mesa-op').forEach((op) => op.addEventListener('click', () => done((op as HTMLElement).dataset.id!)));
      dlg.querySelector('.cancel')!.addEventListener('click', () => done(null));
      dlg.addEventListener('cancel', () => done(null));
      dlg.showModal();
    });
  }
</script>

<style is:global>
  .mesa-dlg { border: 1px solid var(--panel-border); border-radius: 8px; padding: 1.2rem 1.4rem; max-width: 26rem; background: var(--panel); color: var(--ink); box-shadow: 0 8px 40px rgba(0,0,0,.3); }
  .mesa-dlg::backdrop { background: rgba(0,0,0,.45); }
  .mesa-dlg h3 { font-family: 'Cinzel'; color: var(--accent-strong); margin: 0 0 .3rem; }
  .mesa-dlg .mm { font-size: .85rem; color: var(--ink-soft); margin: 0 0 .8rem; }
  .mesa-dlg .mesa-list { display: flex; flex-direction: column; gap: .4rem; }
  .mesa-dlg .mesa-op { text-align: left; }
  .mesa-dlg .mesa-op small { opacity: .7; }
  .mesa-dlg .mesa-foot { margin-top: 1rem; text-align: right; }
</style>
