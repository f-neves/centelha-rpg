---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CentelhaSpark from '../../components/CentelhaSpark.astro';
import { url } from '../../lib/site';
import { MODULOS } from '../../lib/modulos';

export async function getStaticPaths() {
  // Capítulo de módulo opcional desligado: a página continua sendo gerada (os outros
  // capítulos linkam para ela e o link não pode quebrar), mas sai da corrente de
  // anterior/próximo, do mesmo jeito que já saiu da navegação em `site.ts`.
  // Precisa morar aqui dentro: `getStaticPaths` é içado e não enxerga o frontmatter.
  const OCULTOS = new Set(MODULOS.folego ? [] : ['folego']);
  const todos = (await getCollection('chapters')).sort((a, b) => a.data.ordem - b.data.ordem);
  const caps = todos.filter((c) => !OCULTOS.has(c.id));
  return todos.map((entry) => {
    const i = caps.findIndex((c) => c.id === entry.id);
    return {
      params: { slug: entry.id },
      props: { entry, prev: i > 0 ? caps[i - 1] : undefined, next: i >= 0 ? caps[i + 1] : undefined },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const slugOf = (e: any) => (['caminhos', 'arcano'].includes(e.id) ? e.id : `regras/${e.id}`);
---
<Base title={entry.data.titulo} descricao={entry.data.resumo}>
  <p class="muted cinzel" style="letter-spacing:.3em;text-transform:uppercase;font-size: var(--fs-micro);margin:0">
    Capítulo {entry.data.numeral}
  </p>
  <h1>{entry.data.titulo}</h1>
  <p class="tag-orn" style="text-align:left"><CentelhaSpark /></p>
  <Content />

  <nav class="cap-nav" aria-label="Navegação entre capítulos">
    {prev ? <a class="btn" href={url(slugOf(prev))}>← {prev.data.titulo}</a> : <span />}
    {next ? <a class="btn" href={url(slugOf(next))}>{next.data.titulo} →</a> : <span />}
  </nav>
</Base>

<style>
  .cap-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid var(--rule); }
  .cap-nav .btn { max-width: 48%; }
</style>

<!-- Tabelas ordenáveis: clique no cabeçalho para ordenar (a última coluna, normalmente descrição, não ordena). -->
<style is:global>
  main table th.ord { cursor: pointer; user-select: none; }
  main table th.ord::after { content: ' ⇅'; opacity: .35; font-size: .82em; }
  main table th.ord.asc::after { content: ' ↑'; opacity: .9; }
  main table th.ord.desc::after { content: ' ↓'; opacity: .9; }
  main table th.ord:hover, main table th.ord:focus-visible { color: var(--accent-strong); outline: none; }
</style>
<script>
  function ordenarTabelas() {
    document.querySelectorAll<HTMLTableElement>('main table').forEach((table) => {
      const head = table.tHead, body = table.tBodies[0];
      if (!head || !body || !head.rows[0]) return;
      const ths = Array.from(head.rows[0].cells);
      if (ths.length < 2) return;
      // Valor para ordenar: ciente de moeda (pc/pp/po/pl convertidos para cobre) e de frações (½ ¼ ¾).
      const FRAC: Record<string, number> = { '½': 0.5, '¼': 0.25, '¾': 0.75, '⅓': 1 / 3, '⅔': 2 / 3 };
      const CUR: Record<string, number> = { pc: 1, pp: 10, po: 100, pl: 1000 };
      const numOf = (raw: string) => {
        const s = raw.replace(/[−–]/g, '-').trim();
        const cm = s.match(/(-?)\s*([½¼¾⅓⅔]|\d+(?:[.,]\d+)?)\s*(pc|pp|po|pl)\b/i);
        if (cm) {
          const base = FRAC[cm[2]] ?? parseFloat(cm[2].replace(',', '.'));
          return (cm[1] === '-' ? -1 : 1) * base * CUR[cm[3].toLowerCase()];
        }
        if (FRAC[s] != null) return FRAC[s];
        const m = s.match(/-?\d+(?:[.,]\d+)?/);
        return m ? parseFloat(m[0].replace(',', '.')) : null;
      };
      ths.forEach((th, col) => {
        if (col === ths.length - 1) return; // pula a última coluna (descrições)
        th.classList.add('ord');
        th.tabIndex = 0;
        th.setAttribute('role', 'button');
        const ordenar = () => {
          const dir = th.classList.contains('asc') ? 'desc' : 'asc';
          ths.forEach((o) => o.classList.remove('asc', 'desc'));
          th.classList.add(dir);
          const rows = Array.from(body.rows);
          const val = (r: HTMLTableRowElement) => (r.cells[col]?.textContent || '').trim();
          const vazio = (s: string) => s === '' || s === '—' || s === '–';
          const numerico = rows.every((r) => { const v = val(r); return vazio(v) || numOf(v) !== null; });
          rows.sort((a, b) => {
            const A = val(a), B = val(b);
            let c: number;
            if (numerico) c = (vazio(A) ? -Infinity : numOf(A)!) - (vazio(B) ? -Infinity : numOf(B)!);
            else c = A.localeCompare(B, 'pt', { numeric: true, sensitivity: 'base' });
            return dir === 'asc' ? c : -c;
          });
          rows.forEach((r) => body.appendChild(r));
        };
        th.addEventListener('click', ordenar);
        th.addEventListener('keydown', (e) => {
          const k = (e as KeyboardEvent).key;
          if (k === 'Enter' || k === ' ') { e.preventDefault(); ordenar(); }
        });
      });
    });
  }
  ordenarTabelas();
</script>

<!-- Diagramas: o SVG já vem desenhado do build (scripts/gen-mermaid.mjs), então não há
     biblioteca para carregar nem nada para renderizar aqui. As cores saem em `var(--…)`,
     e por isso os desenhos seguem o tema do site, os três, e também as cores que o
     leitor personaliza — que era justamente o que o mermaid no cliente dava. -->
<style is:global>
  .diagrama-caixa { margin: 1.4rem 0; padding: .6rem; overflow-x: auto;
    border: 1px solid var(--rule); border-radius: var(--r-lg); background: var(--bg-soft, var(--bg)); }
  .diagrama-caixa svg.diagrama { display: block; margin: 0 auto; height: auto; max-width: 100%; }
  /* Nada de mexer na fonte daqui. As caixas do diagrama foram dimensionadas
     MEDINDO cada palavra em EB Garamond na hora de desenhar (gen-mermaid.mjs
     carrega a mesma fonte para isso); trocar a família depois faz o texto vazar
     por fora da caixa que o mede. */
</style>
