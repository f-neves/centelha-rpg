# build / deps
node_modules/
dist/
.astro/
# a bancada (astro.bancada.mjs): saída e cache do site rodando com banco de mentira
.bancada/

# segredos de ambiente (Supabase) — NUNCA versionar
.env
.env.local
.env.*.local

# temporários de inspeção (README.md documentado e versionado, o resto não)
_shots/*
!_shots/README.md
_pages/

# legado (saídas grandes — mantidas localmente, fora do repo do site)
legacy/*.pdf

# mapas originais em alta resolução (pesados; versionamos as cópias reduzidas Uldun_*.jpg)
lore/mapas/Mapa Teste.jpg
lore/mapas/Mapa Teste1.jpg

# material de referência (PDFs/artes de D&D e Pathfinder — pesado, fora do repo)
D&D/

# SO / editor
*.stackdump
.DS_Store
Thumbs.db
*.log
.~lock.*#

# arquivo compactado para conferir uma pasta por fora do repositorio. Duas vezes um .7z
# solto travou o `npm run rodada` (que exige arvore limpa) e virou decisao sobre arquivo de
# outra pessoa. Ignorado em 10/09/2026 para o arquivo poder ficar onde quem o criou deixou.
*.7z

# a saida das baterias de simulacao: cada uma tem o seu manifesto e e refeita
.sim/
.portoes/

# o modelo do Vosk (voz-bench.html): 31 MB, nao versionado, cada maquina baixa o seu
voz-bench-modelo/
