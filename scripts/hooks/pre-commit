#!/bin/sh
#
# O portão, rodando sem depender de lembrança.
#
# POR QUE ELE EXISTE, com o caso: em 04/09/2026 um commit de DOCUMENTO subiu sem
# `npm run validate`, e o `test-procedencia.mjs` (que existe justamente para o
# texto) derrubou o CI. E não parou aí: o `build` roda o `validate` antes do
# Astro, então o deploy caiu junto e o site ficou um commit atrás.
#
# O portão já estava no `validate` e o `validate` já era o certo a rodar. O que
# faltava era ele NÃO DEPENDER DE ALGUÉM LEMBRAR, e é a mesma forma do L25: o
# mecanismo existia e nada o executava.
#
# CUSTA 15,2 SEGUNDOS, medido nesta máquina em 15/09/2026, em duas amostras
# (15.173 ms e 15.208 ms). Dizia 7 aqui, e o número envelheceu com os testes que
# entraram depois dele. Ele roda inteiro em vez de escolher gates pelo que mudou:
# escolher exigiria um mapa de arquivo para portão, e esse mapa seria mais uma
# lista para ficar velha (é o caso 13).
#
# E O TYPECHECK ENTRA AQUI DESDE 15/09/2026, com UMA condição de caminho, que é
# coisa diferente de um mapa: só roda quando o commit toca `src/` ou `scripts/`.
# O caso que o comprou: `esc` foi chamado num arquivo que não tem `esc`
# (`ficha-engine.ts`), e passou por DOZE commits porque nem o `validate` nem o
# `astro build` checam tipo. Quem checava era o CI, e o resultado dele não
# chegava a ninguém: três horas de vermelho no ar, com o site publicado e a ficha
# estourando em `ReferenceError` para quem edita uma ficha de raça com piso.
#
# O `astro sync` VAI JUNTO e não é detalhe de instalação: ele gera
# `.astro/types.d.ts`, que o `.gitignore` não versiona. Sem ele, num clone que
# nunca rodou `astro dev`, o `tsc` cospe vinte erros de `astro:content` e de
# `import.meta.env`, e o primeiro commit de quem clonou ficaria vermelho por erro
# que não é dele. Custa 13,4 s somados (3,4 do sync + 10,0 do tsc), medidos no
# mesmo dia, e é por isso que commit de documento não paga: ele não pode quebrar
# tipo nenhum.
#
# NÃO USE `--no-verify`. Se o portão está vermelho, o commit está errado ou o
# portão está errado, e as duas coisas se resolvem olhando, não pulando.
#
# Instalação, uma vez por clone (a `core.hooksPath` é local e as worktrees a
# herdam, porque moram no mesmo diretório comum):
#
#   git config core.hooksPath scripts/hooks
#
# Quem confere que isso foi feito é o próprio `test-portoes.mjs`.

if ! command -v npm >/dev/null 2>&1; then
  echo "✘ pre-commit: npm não está no PATH, e sem ele o portão não roda."
  echo "  Rode \`npm run validate\` à mão antes de commitar, ou conserte o PATH."
  exit 1
fi

echo "· pre-commit: npm run validate"
if ! npm run --silent validate; then
  echo ""
  echo "✘ O portão falhou, e o commit não foi feito."
  echo "  Conserte o que ele apontou e commite de novo."
  exit 1
fi

# QUEM DECIDE É O COMMIT, QUEM É CONFERIDO É A ÁRVORE, e as duas metades desta
# frase são medidas.
#
# A decisão: num commit com pathspec (`git commit -m ... -- caminho`) o git monta
# um índice temporário e aponta o `GIT_INDEX_FILE` para ele, então `--cached`
# responde sobre o commit que está nascendo, e não sobre o índice compartilhado.
#
# A conferência: o `tsc` lê a ÁRVORE, e não o índice. A Revisora mediu na rodada
# 61, plantando erro de tipo em `src/lib/mesa-core.ts` com o índice VAZIO: o `tsc`
# acusou. Num diretório dividido por duas frentes, o commit de uma pode ser
# recusado por erro não commitado da outra, e pode passar por uma correção que não
# está nele. **Isto é de propósito e não se conserta checando só o que está
# staged:** tipo é global, um arquivo não commitado quebra o que o commit inclui,
# e um typecheck "só dos staged" ficaria verde sobre um repositório que não
# compila. O comentário existe para que ninguém tente.
#
# O RECORTE TEM UM FURO CONHECIDO, e ele está aqui escrito porque é mais honesto
# que fingir cobertura: `tsconfig.json`, `package.json` e `astro.config.mjs`
# DECIDEM o typecheck (o preset `strict`, o `include`, a versão do `typescript`) e
# nenhum casa o padrão abaixo. Por isso eles entraram no padrão em 15/09/2026:
# mexer em quem governa a conferência passou a disparar a conferência.
#
# E SOBRA UM FURO DE CLASSE, que é de desenho e não de esquecimento: o `include`
# do `tsconfig.json` é `**/*`, então o `tsc` confere TODO `.ts` do repositório,
# enquanto este padrão só dispara por `src/` e `scripts/`. Um `.ts` fora dessas
# duas pastas é checado pelo `tsc` e não dispara o `tsc`. **Contado em
# 16/09/2026, por mim e não herdado: são 51 `.ts`/`.tsx` rastreados, e ZERO fora
# de `src/` e `scripts/`**, então hoje o furo é vazio. Ele deixa de ser no dia em
# que alguém criar o primeiro, e é por isso que está escrito aqui em vez de
# virar mais uma alternância no padrão: um caminho que não existe na lista é
# regra sem caso, e ela envelhece sem ninguém notar.
ARQS=$(git diff --cached --name-only --diff-filter=ACMR)
if printf '%s\n' "$ARQS" | grep -Eq '^(src|scripts)/|^(tsconfig\.json|package\.json|package-lock\.json|astro\.config\.mjs)$'; then
  echo "· pre-commit: npx astro sync && npx tsc --noEmit (há código no commit)"
  # A SAÍDA DO `astro sync` SE GUARDA, e não se joga fora. Ele é a ÚNICA
  # conferência de schema que os `src/data/*.json` e o frontmatter dos capítulos
  # recebem no commit (medido pela Revisora na rodada 61: `ordem: "seis"` num
  # capítulo faz ele falhar, nomeando o arquivo). Com `>/dev/null` o autor lia
  # "erro de ambiente" onde podia estar o dado errado do próprio commit dele.
  if ! SYNC=$(npx astro sync 2>&1); then
    echo ""
    echo "$SYNC"
    echo ""
    echo "✘ O \`astro sync\` falhou, e o commit não foi feito."
    echo "  Ele valida o schema dos dados e o frontmatter dos capítulos, então a causa"
    echo "  pode ser deste commit. A saída dele está acima: leia antes de culpar o ambiente."
    exit 1
  fi
  if ! npx tsc --noEmit; then
    echo ""
    echo "✘ Os tipos não fecham, e o commit não foi feito."
    echo "  Isto NÃO é lint: nome que o TypeScript não acha é \`ReferenceError\` na mesa."
    exit 1
  fi
fi
exit 0
